#!/usr/bin/env bash
# sync-upstream: merge TJ's a.box (the `upstream` remote) into this fork's main on GitHub, so the
# app's auto-update fast-forwards this checkout and rebuilds what changed. The merge happens in a
# scratch worktree, never in this checkout: auto-update only rebuilds when it fast-forwards.
# Conflicts in files that only differ from upstream by the fork's renames are resolved by
# re-renaming upstream's version; anything else is left in the scratch worktree for a person (or
# an agent) to finish. Exit 0: nothing to do or merged and pushed; 2: conflicts left.
set -uo pipefail
cd "$(dirname "$0")/.."
src=$(pwd)
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
notify() { osascript -e "display notification \"$2\" with title \"Turtwig\" subtitle \"$1\"" > /dev/null 2>&1 || true; }
scratch="$HOME/.agent-box/sync-upstream-merge"

git fetch -q origin main || { log "fetch origin failed"; notify "Sync failed" "Could not fetch GitHub"; exit 1; }
git fetch -q upstream main || { log "fetch upstream failed"; notify "Sync failed" "Could not fetch TJ's repo"; exit 1; }
behind=$(git rev-list --count origin/main..upstream/main)
if [ "$behind" = 0 ]; then log "up to date with upstream"; exit 0; fi
if [ -d "$scratch" ]; then
  log "a merge is still in progress at $scratch; finish it (commit, then: git push origin HEAD:main) and remove the worktree"
  notify "Merge still waiting" "Finish the one in ~/.agent-box/sync-upstream-merge"
  exit 2
fi
log "upstream has $behind new commit(s):"
git log --oneline origin/main..upstream/main | sed 's/^/  /'

git worktree add -q --detach "$scratch" origin/main || { log "could not make the scratch worktree"; exit 1; }
cd "$scratch"
if git merge -q --no-edit upstream/main; then
  log "merged cleanly"
else
  fixed=(); left=()
  base=$(git merge-base HEAD upstream/main)
  for f in $(git diff --name-only --diff-filter=U); do
    # Rename-only file: upstream's old version, renamed, is exactly what we had. Then upstream's
    # new version, renamed, is the right resolution.
    if [ "$(git show "$base:$f" 2>/dev/null | "$src/bin/rename-fork")" = "$(git show "origin/main:$f")" ]; then
      git show "upstream/main:$f" | "$src/bin/rename-fork" > "$f" && git add "$f" && fixed+=("$f")
    else
      left+=("$f")
    fi
  done
  [ ${#fixed[@]} -gt 0 ] && log "re-renamed: ${fixed[*]}"
  if [ ${#left[@]} -gt 0 ]; then
    log "conflicts need a hand in $scratch: ${left[*]}"
    notify "Merge needs you" "${#left[@]} conflicted file(s) in ~/.agent-box/sync-upstream-merge"
    exit 2
  fi
  git commit -q --no-edit || { log "commit failed"; exit 2; }
  log "merged with renames reapplied"
fi
if git push -q origin HEAD:main; then
  log "pushed; the app fast-forwards and rebuilds on its own"
  notify "Synced with TJ" "$behind new commit(s); the app rebuilds on its own"
  cd "$src" && git worktree remove --force "$scratch"
else
  log "push failed; the merge is at $scratch"
  notify "Sync failed" "Push failed; merge left in ~/.agent-box/sync-upstream-merge"
  exit 1
fi
