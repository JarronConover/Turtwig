#!/usr/bin/env python3
"""Print this host's sidebar as JSON (see lib/sidebar.py). On the Mac it reads
super.engineering; env-push copies the result to the box for the dashboard."""

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import sidebar  # noqa: E402

host = "box" if os.environ.get("CODER_AGENT_URL") else "mac"


def sc(*args):
    r = subprocess.run(["sc", *args], capture_output=True, text=True, timeout=60)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else {}


print(json.dumps(sidebar.build(sc("workspace", "list", "--json"), sc("section", "list", "--json"), host)))
