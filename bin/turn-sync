#!/usr/bin/env bash
# Claude Code Stop / SubagentStop hook: queue this session's worktree, then
# sync in the background. Prints nothing, so it adds nothing to the context.
set -u
. "$(dirname "$0")/env.sh"

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<< "$input" 2> /dev/null)
session=$(jq -r '.session_id // empty' <<< "$input" 2> /dev/null)
# Where only registry chats are backed up (the Mac), every other local
# Claude session is left alone.
if [ "${AGENT_SYNC_TRANSCRIPTS:-}" != all ] && ! own_chat "$session"; then
  exit 0
fi
if [ -n "$cwd" ]; then
  mkdir -p "$AGENT_QUEUE_DIR"
  printf '%s\n' "$cwd" > "$AGENT_QUEUE_DIR/$(printf '%s' "$cwd" | git hash-object --stdin)"
fi
detach "$AGENT_BOX_DIR/bin/sync-worker"
exit 0
