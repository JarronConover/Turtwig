#!/usr/bin/env python3
"""Dashboard server for the Agent Box app: the sidebar (worktrees grouped into
projects and feature sections, with their chats and MR/CI status) as JSON, the
app's pages, and a small HTTP API over the same `chat` and `sc` commands the
agents use. Listens on localhost only; the Mac app reaches it through an ssh
tunnel. GET /api lists the endpoints."""

import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
REGISTRY = HOME / ".agent-box" / "state" / "registry" / "chats"
PROJECTS = HOME / ".claude" / "projects"
CHAT = ROOT / "bin" / "chat"
SC = ROOT / "shim" / "sc"
REPOS = {"redo": ("redo", "redo/redoapp/product/redo"),
         "internal-tools": ("redotech-internal-tools", "redo/redoapp/internal/redotech-internal-tools"),
         "redo-data": ("redo-data", "redo/redoapp/product/redo-data")}
sys.path.insert(0, str(ROOT / "lib"))
import sidebar as sidebar_lib  # noqa: E402

API = {
    "GET /api/sidebar": "projects and feature sections of worktrees, each with its chats, MR/CI, and status",
    "POST /api/chats": "{name, kind?, branch?, base?, dir?, repo?, prompt?, model?}: start a chat "
                       "(an orchestrator without a branch gets its own worktree)",
    "POST /api/chats/start|stop|archive": "{id}",
    "POST /api/chats/send": "{id, text}: type a message into a running chat",
    "POST /api/sections": "{name}: create a section",
    "POST /api/sections/rename": "{id, name}",
    "POST /api/sections/delete": "{id}",
    "POST /api/sections/assign": "{path, section}: put a worktree in a section (section null = out of it)",
    "POST /api/worktrees/delete": "{path}: delete a clean worktree",
    "POST /api/shell": "{path}: the tmux shell session for a worktree's terminal",
}


def now():
    return time.time()


def iso(ts):
    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def tmux_sessions():
    try:
        out = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True, text=True)
    except FileNotFoundError:
        return set()
    return set(out.stdout.split()) if out.returncode == 0 else set()


# A chat is waiting on TJ when its screen shows a question or a permission prompt.
WAITING = re.compile(r"Enter to select|Esc to cancel|Do you want to proceed|❯ 1\. Yes", re.I)


def waiting(session):
    out = subprocess.run(["tmux", "capture-pane", "-pt", "=" + session], capture_output=True, text=True)
    return bool(WAITING.search("\n".join(out.stdout.splitlines()[-25:]))) if out.returncode == 0 else False


def chats():
    alive = tmux_sessions()
    host = "box" if os.environ.get("CODER_AGENT_URL") else "mac"
    result = []
    for path in sorted(REGISTRY.glob("*.json")) if REGISTRY.exists() else []:
        c = read_json(path)
        if not c or c.get("status") == "archived":
            continue
        session = f"chat-{c['id'][:8]}"
        c["alive"] = c.get("host") == host and session in alive
        t = PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", c.get("dir") or "") / f"{c['id']}.jsonl"
        c["last_ts"] = t.stat().st_mtime if t.exists() else None
        c["last_activity"] = iso(c["last_ts"]) if c["last_ts"] else None
        c["working"] = bool(c["alive"] and c["last_ts"] and now() - c["last_ts"] < 20)
        c["waiting"] = bool(c["alive"] and not c["working"] and waiting(session))
        result.append(c)
    return result


class Cache:
    """Values refreshed in the background so /api/sidebar never waits on git or GitLab."""

    def __init__(self, ttl, fn):
        self.ttl, self.fn, self.data, self.busy = ttl, fn, {}, set()

    def get(self, key):
        hit = self.data.get(key)
        if (not hit or now() - hit[0] > self.ttl) and key not in self.busy:
            self.busy.add(key)
            threading.Thread(target=self._fill, args=(key,), daemon=True).start()
        return hit[1] if hit else None

    def _fill(self, key):
        try:
            self.data[key] = (now(), self.fn(key))
        except Exception:  # a failed refresh keeps the last value
            pass
        finally:
            self.busy.discard(key)


def _git_local(path):
    r = subprocess.run(["git", "-C", path, "status", "--porcelain", "--branch"], capture_output=True, text=True)
    if r.returncode:
        return {}
    lines = r.stdout.splitlines()
    head = lines[0] if lines else ""
    ahead = re.search(r"ahead (\d+)", head)
    return {"uncommitted": len(lines) - 1, "unpushed": int(ahead.group(1)) if ahead else 0,
            "behind_target": bool(re.search(r"behind \d+", head))}


def glab_json(path):
    r = subprocess.run(["glab", "api", path], capture_output=True, text=True, timeout=30)
    try:
        return json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        return None


def _mr(key):
    """The newest MR for a branch, shaped like super.engineering's: {state, number, url, checks}."""
    repo, branch = key
    project = REPOS.get(repo, (None, None))[1]
    if not project or not branch:
        return None
    pid = project.replace("/", "%2F")
    mrs = glab_json(f"projects/{pid}/merge_requests?source_branch={branch}&order_by=updated_at&per_page=1") or []
    if not mrs:
        return None
    m = glab_json(f"projects/{pid}/merge_requests/{mrs[0]['iid']}") or mrs[0]
    state = "draft" if m.get("draft") and m["state"] == "opened" else m["state"]
    pipe = (m.get("head_pipeline") or {}).get("status")
    checks = {"success": "passing", "failed": "failing", "running": "pending", "pending": "pending",
              "created": "pending"}.get(pipe or "")
    return {"state": state, "number": m["iid"], "url": m["web_url"], "checks": {"status": checks} if checks else None}


LOCAL = Cache(20, _git_local)
MRS = Cache(90, _mr)


def sc_run(args, path=None):
    env = dict(os.environ, **({"SUPER_ENGINEERING_WORKTREE_PATH": path} if path else {}))
    return subprocess.run([sys.executable, str(SC), *args, "--json"], capture_output=True, text=True,
                          timeout=600, env=env, cwd=path or str(HOME))


def sc_json(*args):
    r = sc_run(list(args))
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else {}


def sidebar():
    cs = chats()
    by_dir = {}
    for c in cs:
        if c.get("dir"):
            by_dir.setdefault(os.path.realpath(c["dir"]), []).append(c)
    repo_of = {name: key for key, (name, _) in REPOS.items()}
    box = sidebar_lib.build(sc_json("workspace", "list"), sc_json("section", "list"), "box")
    for group in box["projects"] + box["sections"]:
        for it in group["items"]:
            it["chats"] = by_dir.get(os.path.realpath(it["path"]), [])
            it["local"] = LOCAL.get(it["path"]) or {}
            if not it["is_primary"]:
                it["pr"] = MRS.get((repo_of.get(it.get("project")), it.get("branch")))
            if any(c["working"] for c in it["chats"]):
                it["agent_status"] = "working"
            elif any(c["waiting"] for c in it["chats"]):
                it["agent_status"] = "waiting"
            it["age"] = max([c["last_ts"] or 0 for c in it["chats"]] + [it.get("age") or 0]) or None
    return {"generated_at": iso(now()), "hosts": [box],
            "ssh_host": os.environ.get("AGENT_BOX_SSH_HOST", "coder.tj-agents")}


def shell_session(path):
    """A tmux shell in this worktree for the terminal pane; created on first use."""
    name = "sh-" + hashlib.sha1(os.path.realpath(path).encode()).hexdigest()[:10]
    if subprocess.run(["tmux", "has-session", "-t", "=" + name], capture_output=True).returncode != 0:
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", path,
                        str(ROOT / "bin" / "agent-env"), os.environ.get("SHELL", "bash"), "-l"], check=False)
        subprocess.run(["tmux", "set", "-t", name, "status", "off"], check=False)
    return name


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def page(self, name):
        self.send(200, (ROOT / "web" / name).read_bytes(), "text/html; charset=utf-8")

    def do_GET(self):
        if self.path == "/api":
            return self.send(200, API)
        if self.path == "/api/sidebar":
            return self.send(200, sidebar())
        if self.path in ("/", "/index.html"):
            return self.page("index.html")
        if self.path == "/main":
            return self.page("main.html")
        self.send(404, {"error": "not found"})

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(length) or b"{}")
        p = self.path
        if p == "/api/shell":
            return self.send(200, {"session": shell_session(body["path"])})
        if p == "/api/chats":
            args = [sys.executable, str(CHAT), "new", body["name"]]
            for key in ("branch", "base", "feature", "parent", "kind", "model", "prompt", "dir", "repo"):
                if body.get(key):
                    args += [f"--{key}", body[key]]
            out = subprocess.run(args, capture_output=True, text=True, timeout=900)
        elif p in ("/api/chats/stop", "/api/chats/start", "/api/chats/archive"):
            out = subprocess.run([sys.executable, str(CHAT), p.rsplit("/", 1)[1], body["id"]],
                                 capture_output=True, text=True, timeout=300)
        elif p == "/api/chats/send":
            out = subprocess.run([sys.executable, str(CHAT), "send", body["id"], body["text"]],
                                 capture_output=True, text=True, timeout=60)
        elif p == "/api/sections":
            out = sc_run(["section", "create", body["name"], "--manual"])
        elif p == "/api/sections/rename":
            out = sc_run(["section", "edit", body["id"], "--name", body["name"]])
        elif p == "/api/sections/delete":
            out = sc_run(["section", "delete", body["id"]])
        elif p == "/api/sections/assign":
            out = sc_run(["section", "assign", body["section"]] if body.get("section") else ["section", "unassign"],
                         path=body["path"])
        elif p == "/api/worktrees/delete":
            item = next((d for d in sidebar_lib.walk(sc_json("workspace", "list"))
                         if d.get("path") == body["path"] and d.get("id")), None)
            if not item:
                return self.send(404, {"stderr": "no such worktree"})
            out = sc_run(["worktree", "delete", item["id"]])
        else:
            return self.send(404, {"error": "not found"})
        self.send(200 if out.returncode == 0 else 500, {"stdout": out.stdout, "stderr": out.stderr})


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--port", type=int, default=8790)
    a = p.parse_args()
    ThreadingHTTPServer(("127.0.0.1", a.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
