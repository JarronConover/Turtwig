#!/usr/bin/env python3
"""Dashboard server: the orchestrator tree as JSON plus the web UI.

Reads the chat registry (agent-box `state` branch) and the ship-feature
dispatcher's durable files (~/.local/state/redo). Listens on localhost only;
the Mac app reaches it through an ssh tunnel.
"""

import argparse
import datetime
import json
import os
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
REGISTRY = HOME / ".agent-box" / "state" / "registry" / "chats"
# The box's own dispatcher state, then the Mac's (synced read-only by env-push).
STATE_ROOTS = [HOME / ".local" / "state" / "redo", HOME / ".agent-box" / "mac-state"]
PROJECTS = HOME / ".claude" / "projects"
CHAT = ROOT / "bin" / "chat"
SC = ROOT / "shim" / "sc"
MAC_SIDEBAR = HOME / ".agent-box" / "mac-state" / "sidebar.json"
sys.path.insert(0, str(ROOT / "lib"))
import sidebar as sidebar_lib  # noqa: E402

# ship.py DIGEST_EMOJI: a digest stage (before `:`) -> the stage chip.
STAGE_EMOJI = {
    **dict.fromkeys(("blocked", "todo", "waiting", "queued"), "⏳"),
    **dict.fromkeys(("implementing", "fixing", "ci-fixing"), "🛠️"),
    **dict.fromkeys(("handed-off", "verifying", "reviewed", "readying"), "🔍"),
    "reviewing": "👀", "error": "✋", "ci-running": "🧪", "ready": "🧪", "final-look": "🧐",
    "awaiting-approval": "🙋", "approved": "🟢",
    **dict.fromkeys(("merged", "deploying", "deployed", "after-merge"), "🚀"),
    "done": "🏁",
}
DONE_STAGES = {"done"}


def iso(ts):
    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def tmux_sessions():
    try:
        out = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True, text=True)
    except FileNotFoundError:
        return set()
    return set(out.stdout.split()) if out.returncode == 0 else set()


def chats():
    alive = tmux_sessions()
    host = "box" if os.environ.get("CODER_AGENT_URL") else "mac"
    result = []
    for path in sorted(REGISTRY.glob("*.json")) if REGISTRY.exists() else []:
        c = read_json(path)
        if not c or c.get("status") == "archived":
            continue
        c["alive"] = c.get("host") == host and f"chat-{c['id'][:8]}" in alive
        t = PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", c.get("dir") or "") / f"{c['id']}.jsonl"
        c["last_activity"] = iso(t.stat().st_mtime) if t.exists() else None
        result.append(c)
    return result


def parse_digest(digest):
    head, _, tail = (digest or "").partition("|")
    stages = dict(x.split("=", 1) for x in head.split() if "=" in x)
    needs = [x.strip() for x in tail.split(",") if x.strip()]
    return stages, needs


def features(chat_by_branch):
    result, seen = [], set()
    for root in STATE_ROOTS:
        ship, handoffs = root / "ship-feature", root / "handoffs"
        for fpath in sorted(ship.glob("*.feature.json")) if ship.exists() else []:
            parent = fpath.name.removesuffix(".feature.json")
            if parent in seen:
                continue
            seen.add(parent)
            result.append(feature_row(parent, fpath, ship, handoffs, chat_by_branch, root))
    result.sort(key=lambda f: (f["done"], -(datetime.datetime.fromisoformat(f["updated_at"].replace("Z", "+00:00")).timestamp()
                                             if f["updated_at"] else 0)))
    return result


def feature_row(parent, fpath, ship, handoffs, chat_by_branch, root):
    feature = read_json(fpath) or {}
    events = (read_json(ship / f"{parent}.json") or {}).get("events", {})
    printed = events.get("printed") or {}
    stages, needs = parse_digest(printed.get("digest"))
    short = feature.get("short", {})
    legs = []
    for ticket, raw in stages.items():
        stage, _, detail = raw.partition(":")
        base, _, leg_repo = ticket.partition("@")
        handoff = read_json(handoffs / ticket / "handoff.json") or {}
        branch = handoff.get("branch")
        legs.append({
            "ticket": ticket,
            "label": (short.get(ticket) or short.get(base) or base) + (f" · {leg_repo}" if leg_repo else ""),
            "stage": stage,
            "detail": detail,
            "emoji": "✋" if stage.startswith("parked") else STAGE_EMOJI.get(stage, "•"),
            "needs_you": ticket in needs or stage == "error" or stage.startswith("parked"),
            "mr": handoff.get("mr"),
            "branch": branch,
            "repo": handoff.get("repo"),
            "chat": chat_by_branch.get(branch),
            "url": f"https://linear.app/redo/issue/{base}",
        })
    active = [x for x in legs if x["stage"] not in DONE_STAGES]
    return {
        "host": "mac" if root.name == "mac-state" else "box",
        "parent": parent,
        "name": feature.get("name") or parent,
        "url": f"https://linear.app/redo/issue/{parent}",
        "updated_at": iso(printed["at"]) if printed.get("at") else None,
        "done": bool(legs) and not active,
        "legs": legs,
        "needs_you": [x["label"] for x in legs if x["needs_you"]],
    }


def state():
    cs = chats()
    by_branch = {c["branch"]: c for c in cs if c.get("branch")}
    fs = features(by_branch)
    attached = {leg["chat"]["id"] for f in fs for leg in f["legs"] if leg["chat"]}
    return {
        "generated_at": iso(datetime.datetime.now().timestamp()),
        "features": fs,
        "chats": [c for c in cs if c["id"] not in attached],
        "ssh_host": os.environ.get("AGENT_BOX_SSH_HOST", "coder.tj-agents"),
    }


_dirty_cache = {}


def uncommitted(path):
    """Changed-file count for a worktree, cached for 30 s (git status is slow on the monorepo)."""
    now = datetime.datetime.now().timestamp()
    hit = _dirty_cache.get(path)
    if hit and now - hit[0] < 30:
        return hit[1]
    r = subprocess.run(["git", "-C", path, "status", "--porcelain"], capture_output=True, text=True)
    n = len(r.stdout.splitlines()) if r.returncode == 0 else None
    _dirty_cache[path] = (now, n)
    return n


def box_sidebar():
    def sc(*args):
        r = subprocess.run([sys.executable, str(SC), *args], capture_output=True, text=True, timeout=60)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else {}
    return sidebar_lib.build(sc("workspace", "list", "--json"), sc("section", "list", "--json"), "box")


def sidebar():
    """Both hosts' sidebars, with each box worktree's chats attached."""
    cs = chats()
    by_dir = {}
    for c in cs:
        if c.get("dir"):
            by_dir.setdefault(os.path.realpath(c["dir"]), []).append(c)
    hosts = []
    if os.environ.get("CODER_AGENT_URL"):
        box = box_sidebar()
        for group in box["projects"] + box["sections"]:
            for it in group["items"]:
                it["chats"] = by_dir.get(os.path.realpath(it["path"]), [])
                it["local"] = {"uncommitted": uncommitted(it["path"])}
                if any(c["alive"] and c["last_activity"] and
                       datetime.datetime.now(datetime.timezone.utc).timestamp()
                       - datetime.datetime.fromisoformat(c["last_activity"].replace("Z", "+00:00")).timestamp() < 90
                       for c in it["chats"]):
                    it["agent_status"] = "working"
        hosts.append(box)
    mac = read_json(MAC_SIDEBAR)
    if mac:
        for group in mac["projects"] + mac["sections"]:
            for it in group["items"]:
                it["chats"] = [c for c in cs if c.get("host") == "mac"
                               and os.path.realpath(c.get("dir") or "") == it["path"]]
        hosts.append(mac)
    return {"generated_at": iso(datetime.datetime.now().timestamp()), "hosts": hosts,
            "ssh_host": os.environ.get("AGENT_BOX_SSH_HOST", "coder.tj-agents")}


def shell_session(path):
    """A tmux shell in this worktree for the terminal pane; created on first use."""
    import hashlib
    name = "sh-" + hashlib.sha1(os.path.realpath(path).encode()).hexdigest()[:10]
    if subprocess.run(["tmux", "has-session", "-t", "=" + name], capture_output=True).returncode != 0:
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", path,
                        str(ROOT / "bin" / "agent-env"), os.environ.get("SHELL", "bash"), "-l"], check=False)
    return name


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/api/state":
            return self.send(200, state())
        if self.path == "/api/sidebar":
            return self.send(200, sidebar())
        if self.path in ("/", "/index.html"):
            return self.send(200, (ROOT / "web" / "index.html").read_bytes(), "text/html; charset=utf-8")
        if self.path.startswith("/chrome"):
            return self.send(200, (ROOT / "web" / "chrome.html").read_bytes(), "text/html; charset=utf-8")
        self.send(404, {"error": "not found"})

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(length) or b"{}")
        if self.path == "/api/chats":
            args = [sys.executable, str(CHAT), "new", body["name"]]
            for key in ("branch", "base", "feature", "parent", "kind", "model", "prompt", "dir"):
                if body.get(key):
                    args += [f"--{key}", body[key]]
        elif self.path in ("/api/chats/stop", "/api/chats/start", "/api/chats/archive"):
            args = [sys.executable, str(CHAT), self.path.rsplit("/", 1)[1], body["id"]]
        elif self.path == "/api/shell":
            return self.send(200, {"session": shell_session(body["path"])})
        elif self.path == "/api/chats/send":
            args = [sys.executable, str(CHAT), "send", body["id"], body["text"]]
        else:
            return self.send(404, {"error": "not found"})
        out = subprocess.run(args, capture_output=True, text=True, timeout=600)
        self.send(200 if out.returncode == 0 else 500, {"stdout": out.stdout, "stderr": out.stderr})


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--port", type=int, default=8790)
    a = p.parse_args()
    ThreadingHTTPServer(("127.0.0.1", a.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
