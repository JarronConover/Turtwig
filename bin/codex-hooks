#!/usr/bin/env bash
# Merge agent-boxd's event log hook (chat states, what a chat waits on) into Codex's hooks.json, keeping
# every other hook. Usage: codex-hooks [--file PATH] [--dry-run]. Codex asks once to trust new hooks.
set -u
. "$(dirname "$0")/env.sh"

file="${CODEX_HOME:-$HOME/.codex}/hooks.json"
dry=false
while [ $# -gt 0 ]; do
  case "$1" in
    --file) file="$2"; shift 2 ;;
    --dry-run) dry=true; shift ;;
    *) echo "usage: codex-hooks [--file PATH] [--dry-run]" >&2; exit 2 ;;
  esac
done

boxd="$AGENT_BOX_DIR/rust/target/release/agent-boxd"
current=$( [ -s "$file" ] && cat "$file" || echo '{}')
merged=$(jq --arg boxd "$boxd hook 2> /dev/null || true" '
  # Codex trusts a hook by its place in the file, so one already there stays where it is.
  def ensure(event; cmd):
    if any(.hooks[event][]?.hooks[]?; .command == cmd) then .
    else .hooks[event] = ((.hooks[event] // []) + [{hooks: [{type: "command", command: cmd}]}]) end;
  reduce ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PermissionRequest", "Stop", "SessionEnd") as $e
    (.; ensure($e; $boxd))
' <<< "$current") || exit 1

if $dry; then
  printf '%s\n' "$merged"
  exit 0
fi
mkdir -p "$(dirname "$file")"
tmp=$(mktemp)
printf '%s\n' "$merged" > "$tmp" && cat "$tmp" > "$file"
rm -f "$tmp"
