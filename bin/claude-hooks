#!/usr/bin/env bash
# Merge agent-box's Claude Code hooks into ~/.claude/settings.json, keeping every
# other hook: turn sync, session start, and agent-boxd's event log (chat states
# and the prompts a chat waits on, on the agent's `hook_events`), then this
# host's `claude_settings` over the file (the box's bypass-permissions defaults).
set -u
. "$(dirname "$0")/env.sh"

settings="$HOME/.claude/settings.json"
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"
tmp=$(mktemp)
boxd="$AGENT_BOX_DIR/rust/target/release/agent-boxd"
events=$(cfg agents | jq -c '.claude.hook_events // empty' 2> /dev/null)
[ -n "$events" ] || events='["UserPromptSubmit","PreToolUse","PostToolUse","Notification","PermissionRequest","Stop","SubagentStop","SessionStart","SessionEnd"]'
overlay=$(cfg claude_settings 2> /dev/null)
if [ -z "$overlay" ] || [ "$overlay" = null ]; then
  overlay=$([ "$AGENT_HOST" = box ] && echo '{"enableAllProjectMcpServers":true,"permissions":{"defaultMode":"bypassPermissions"},"skipDangerousModePermissionPrompt":true}' || echo '{}')
fi
jq --arg sync "$AGENT_BOX_DIR/bin/turn-sync" --arg start "$AGENT_BOX_DIR/bin/session-start" \
  --arg boxd "$boxd hook 2> /dev/null || true" --argjson events "$events" --argjson overlay "$overlay" '
  def ensure(event; cmd):
    .hooks[event] = ((.hooks[event] // [])
      | map(select(any(.hooks[]?; .command == cmd) | not))
      + [{hooks: [{type: "command", command: cmd}]}]);
  ensure("Stop"; $sync) | ensure("SubagentStop"; $sync) | ensure("SessionStart"; $start)
  | reduce $events[] as $e (.; ensure($e; $boxd))
  | . * $overlay
' "$settings" > "$tmp" && cat "$tmp" > "$settings"
rm -f "$tmp"
