#!/usr/bin/env bash
# Install Turtwig on this Mac from this checkout: build the app and its daemon, put the app in
# ~/Applications, and open it. The app's setup guide does the rest. Safe to run again to update.
set -euo pipefail
dir="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v cargo > /dev/null && [ ! -x "$HOME/.cargo/bin/cargo" ]; then
  echo "Turtwig is built with Rust. Install it first, then run this again:"
  echo "  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
  exit 1
fi
if [ "$dir" != "$HOME/dev/turtwig" ]; then
  echo "note: Turtwig looks for its source at ~/dev/turtwig (settings app.source_dir); this checkout is $dir"
fi
echo "Building Turtwig (the first build takes a few minutes)…"
"$dir/rust/app/bundle.sh"
open "$HOME/Applications/Turtwig.app"
