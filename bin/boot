#!/usr/bin/env bash
# Idempotent box setup, safe to run at any time: packages, state clones,
# Claude Code hooks, and restoring transcripts missing from this machine.
# /tmp is wiped on every workspace start, so its marker means "booted
# since the last restart". --force runs again anyway.
set -u
. "$(dirname "$0")/env.sh"

marker=/tmp/agent-box-booted
[ "${1:-}" != "--force" ] && [ -f "$marker" ] && exit 0
exec 8> /tmp/agent-box-boot.lock
flock -n 8 || exit 0
log "boot start"

if [ "$AGENT_HOST" = box ]; then
  missing=()
  for pkg in tmux rsync jq ttyd; do command -v "$pkg" > /dev/null || missing+=("$pkg"); done
  if [ ${#missing[@]} -gt 0 ]; then
    sudo apt-get update -qq > /dev/null 2>&1
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" > /dev/null 2>&1 \
      || log "apt install failed: ${missing[*]}"
  fi
fi

ensure_branch_clone "$AGENT_STATE_DIR" state
ensure_branch_clone "$AGENT_SESSIONS_DIR" "$SESSIONS_BRANCH"
git -C "$AGENT_STATE_DIR" pull -q --ff-only 2>> "$AGENT_LOG" || log "state pull failed"

backup="$AGENT_SESSIONS_DIR/hosts/$AGENT_HOST/projects"
if [ -d "$backup" ]; then
  mkdir -p "$CLAUDE_PROJECTS_DIR"
  rsync -a --ignore-existing "$backup/" "$CLAUDE_PROJECTS_DIR/"
fi

settings="$HOME/.claude/settings.json"
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"
tmp=$(mktemp)
jq --arg sync "$AGENT_BOX_DIR/bin/turn-sync" --arg start "$AGENT_BOX_DIR/bin/session-start" '
  def ensure(event; cmd):
    .hooks[event] = ((.hooks[event] // [])
      | map(select(any(.hooks[]?; .command == cmd) | not))
      + [{hooks: [{type: "command", command: cmd}]}]);
  ensure("Stop"; $sync) | ensure("SubagentStop"; $sync) | ensure("SessionStart"; $start)
  | if $box then
      .enableAllProjectMcpServers = true
      | .permissions.defaultMode = "bypassPermissions"
      | .skipDangerousModePermissionPrompt = true
    else . end
' --argjson box "$([ "$AGENT_HOST" = box ] && echo true || echo false)" "$settings" > "$tmp" && cat "$tmp" > "$settings"
rm -f "$tmp"

if [ "$AGENT_HOST" = box ]; then
  # The template's startup claude otherwise sits on the first-run theme
  # picker (and, without enableAllProjectMcpServers above, on the project
  # MCP approval), and SessionStart, which runs this script, never fires.
  cfg="$HOME/.claude.json"
  [ -s "$cfg" ] || echo '{}' > "$cfg"
  tmp=$(mktemp)
  jq '.hasCompletedOnboarding = true | .theme = (.theme // "dark")' "$cfg" > "$tmp" && cat "$tmp" > "$cfg"
  rm -f "$tmp"

  # Second trigger: any ssh into the box runs boot if it hasn't run.
  line='[ -f /tmp/agent-box-booted ] || AGENT_BOX_TRIGGER=ssh "$HOME/agent-box/bin/session-start" < /dev/null'
  grep -qxF "$line" "$HOME/.bashrc" 2> /dev/null || printf '\n%s\n' "$line" >> "$HOME/.bashrc"
fi

touch "$marker"

# tmux's server outlives this script; keep it from inheriting the lock fd.
exec 8>&-

if [ "$AGENT_HOST" = box ]; then
  # The template's AgentAPI claude runs `--continue` in ~/project, which would
  # resume (and double-run) the newest primary chat. It has done its job of
  # firing SessionStart by now.
  pkill -f "^agentapi server" 2> /dev/null || true
  tmux has-session -t agent-box 2> /dev/null \
    || tmux new-session -d -s agent-box "$AGENT_BOX_DIR/bin/chat supervise 2>&1 | tee -a $AGENT_HOME/log/supervisor.log"
  tmux has-session -t agent-box-web 2> /dev/null \
    || tmux new-session -d -s agent-box-web "$AGENT_BOX_DIR/bin/dashboard --port 8790 2>&1 | tee -a $AGENT_HOME/log/dashboard.log"
  # Terminals: /?arg=<tmux session> attaches to that chat's tmux session.
  tmux has-session -t agent-box-tty 2> /dev/null \
    || tmux new-session -d -s agent-box-tty "ttyd -i 127.0.0.1 -p 8791 -W -a -t fontSize=13 tmux attach -t 2>&1 | tee -a $AGENT_HOME/log/ttyd.log"
fi
log "boot done"
