#!/usr/bin/env bash
# Idempotent machine setup, safe to run at any time: state clones, Claude Code
# hooks, restoring transcripts missing from this machine, then this host's
# `boot` steps (hosts.HOST.boot: packages, git insteadOf rules, the .bashrc
# trigger, processes to stop, and the tmux services to keep running).
# /tmp is wiped on every workspace start, so its marker means "booted
# since the last restart". --force runs again anyway.
set -u
. "$(dirname "$0")/env.sh"

marker=/tmp/agent-box-booted
[ "${1:-}" != "--force" ] && [ -f "$marker" ] && exit 0
exec 8> /tmp/agent-box-boot.lock
flock -n 8 || exit 0
log "boot start"

boot=$(cfg boot); [ -n "$boot" ] && [ "$boot" != null ] || boot='{}'
b() { jq -r "$1" <<< "$boot"; }
boxd="$AGENT_BOX_DIR/rust/target/release/agent-boxd"

missing=()
for pkg in $(b '.packages // [] | .[]'); do command -v "$pkg" > /dev/null || missing+=("$pkg"); done
if [ ${#missing[@]} -gt 0 ] && [ -n "$(b '.install // empty')" ]; then
  bash -c "$(b '.install' | sed "s|{packages}|${missing[*]}|g")" || log "package install failed: ${missing[*]}"
fi

ensure_branch_clone "$AGENT_STATE_DIR" "${STATE_BRANCH:-state}"
ensure_branch_clone "$AGENT_SESSIONS_DIR" "$SESSIONS_BRANCH"
git -C "$AGENT_STATE_DIR" pull -q --ff-only 2>> "$AGENT_LOG" || log "state pull failed"

# Each agent's backed-up transcripts this machine is missing.
while IFS=$'\t' read -r root dest; do
  backup="$AGENT_SESSIONS_DIR/hosts/$AGENT_HOST/$dest"
  [ -d "$backup" ] || continue
  mkdir -p "$root"
  rsync -a --ignore-existing "$backup/" "$root/"
done < <(python3 "$AGENT_BOX_DIR/bin/chat" _backup_roots 2>> "$AGENT_LOG")

"$AGENT_BOX_DIR/bin/claude-hooks"

if [ "$(b '.claude_onboarding // false')" = true ]; then
  # A startup claude otherwise sits on the first-run theme picker (and, without
  # enableAllProjectMcpServers, on the project MCP approval), and SessionStart,
  # which runs this script, never fires.
  cfgfile="$HOME/.claude.json"
  [ -s "$cfgfile" ] || echo '{}' > "$cfgfile"
  tmp=$(mktemp)
  jq '.hasCompletedOnboarding = true | .theme = (.theme // "dark")' "$cfgfile" > "$tmp" && cat "$tmp" > "$cfgfile"
  rm -f "$tmp"
fi

# git URL rewrites, {to: [from, ...]} (the box: GitLab refuses its ssh key, so
# every gitlab.com ssh URL goes over https through Coder's credential helper).
while IFS=$'\t' read -r to from; do
  [ -n "$to" ] || continue
  git config --global --get-all "url.$to.insteadOf" | grep -qxF "$from" \
    || git config --global --add "url.$to.insteadOf" "$from"
done < <(b '.git_insteadof // {} | to_entries[] | .key as $to | .value[] | [$to, .] | @tsv')

if [ "$(b '.bashrc_hook // false')" = true ]; then
  # Second trigger: any ssh into the machine runs boot if it hasn't run.
  dir=$AGENT_BOX_DIR
  [ "${dir#"$HOME"/}" != "$dir" ] && dir="\$HOME/${dir#"$HOME"/}"
  line="[ -f /tmp/agent-box-booted ] || AGENT_BOX_TRIGGER=ssh \"$dir/bin/session-start\" < /dev/null"
  grep -qxF "$line" "$HOME/.bashrc" 2> /dev/null || printf '\n%s\n' "$line" >> "$HOME/.bashrc"
fi

touch "$marker"

# tmux's server outlives this script; keep it from inheriting the lock fd.
exec 8>&-

# E.g. the box template's AgentAPI claude, which runs `--continue` in ~/project and would resume (and
# double-run) the newest primary chat; it has done its job of firing SessionStart by now.
while IFS= read -r pat; do
  [ -n "$pat" ] && { pkill -f "$pat" 2> /dev/null || true; }
done < <(b '.kill_patterns // [] | .[]')

# The daemon is rebuilt when its sources are newer than the binary (a service with "build": true).
build_daemon() {
  [ -d "$AGENT_BOX_DIR/rust/daemon" ] || return 1
  [ -x "$boxd" ] && [ -z "$(find "$AGENT_BOX_DIR/rust/daemon" "$AGENT_BOX_DIR/rust/protocol" \
    \( -name '*.rs' -o -name Cargo.toml \) -newer "$boxd" | head -1)" ] && return 1
  if (cd "$AGENT_BOX_DIR/rust" && "$HOME/.cargo/bin/cargo" build --release -q -p agent-boxd) \
    >> "$AGENT_HOME/log/boxd-build.log" 2>&1; then
    return 0
  fi
  log "agent-boxd build failed; see log/boxd-build.log"
  return 1
}

mkdir -p "$AGENT_HOME/log"
while IFS=$'\t' read -r name build cmd; do
  [ -n "$name" ] || continue
  cmd=${cmd//\{agent_box_dir\}/$AGENT_BOX_DIR}
  cmd=${cmd//\{agent_home\}/$AGENT_HOME}
  cmd=${cmd//\{boxd\}/$boxd}
  if [ "$build" = true ]; then
    build_daemon && tmux kill-session -t "=$name" 2> /dev/null
    [ -x "$boxd" ] || continue
  fi
  tmux has-session -t "=$name" 2> /dev/null || tmux new-session -d -s "$name" "$cmd"
  # The app's terminal pane is the chrome; tmux's own status line would be noise.
  [ "$(b '.tmux_status_off // false')" = true ] && tmux set -g status off 2> /dev/null
done < <(b '.services // [] | .[] | [.name, (.build // false | tostring), .cmd] | @tsv')
log "boot done"
