#!/usr/bin/env bash
# Make every queued worktree's WIP and all session transcripts durable on
# the remote. Workers serialize on a lock; each drains the whole queue.
set -u
. "$(dirname "$0")/env.sh"

# The app's `daemon` settings, as this machine's daemon last saved them.
opt() { jq -r --arg k "$1" '.[$k] // empty' "$AGENT_HOME/config.json" 2> /dev/null; }
lock_wait=$(opt sync_lock_wait_secs); lock_wait=${lock_wait:-600}
max_mb=$(opt sync_transcript_max_mb); max_mb=${max_mb:-95}
warn_mb=$(opt sync_bundle_warn_mb); warn_mb=${warn_mb:-50}

mkdir -p "$AGENT_HOME" "$AGENT_QUEUE_DIR"
exec 9> "$AGENT_HOME/sync.lock"
flock -w "$lock_wait" 9 || { log "lock timeout"; exit 1; }

# Snapshot the worktree (tracked changes, untracked non-ignored files, and
# unpushed commits) as a bundle. Never touches HEAD, the index, or a branch.
snapshot_worktree() {
  local top key head tree snap out tmpidx size
  top=$(git -C "$1" rev-parse --show-toplevel 2> /dev/null) || return 0
  key=$(wip_key "$top") || return 0
  head=$(git -C "$top" rev-parse HEAD 2> /dev/null) || return 0

  tmpidx=$(mktemp)
  cp "$(git -C "$top" rev-parse --absolute-git-dir)/index" "$tmpidx" 2> /dev/null || : > "$tmpidx"
  GIT_INDEX_FILE=$tmpidx git -C "$top" add -A 2> /dev/null
  tree=$(GIT_INDEX_FILE=$tmpidx git -C "$top" write-tree)
  rm -f "$tmpidx"

  out="$AGENT_SESSIONS_DIR/wip/$key"
  if [ -f "$out.json" ] && [ "$(jq -r '.head + " " + .tree' "$out.json")" = "$head $tree" ]; then
    return 0
  fi

  snap=$(git -C "$top" commit-tree "$tree" -p "$head" -m "agent-box wip")
  git -C "$top" update-ref refs/agent-box/wip "$snap"
  mkdir -p "$(dirname "$out")"
  if ! git -C "$top" bundle create "$out.bundle.tmp" refs/agent-box/wip --not --remotes=origin > /dev/null 2>&1; then
    rm -f "$out.bundle.tmp"
    log "bundle failed: $top"
    return 0
  fi
  mv "$out.bundle.tmp" "$out.bundle"
  jq -n --arg path "$top" --arg branch "$(git -C "$top" symbolic-ref --short HEAD)" \
    --arg head "$head" --arg tree "$tree" --arg snap "$snap" --arg host "$AGENT_HOST" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{path: $path, branch: $branch, head: $head, tree: $tree, snap: $snap, host: $host, at: $at}' > "$out.json"
  size=$(wc -c < "$out.bundle")
  [ "$size" -gt $((warn_mb * 1048576)) ] && log "large wip bundle ($size bytes): $top"
  return 0
}

sync_sessions() {
  local s=$AGENT_SESSIONS_DIR
  # GitLab refuses any file over 100MB, which fails the whole push (WIP included): transcripts over
  # sync_transcript_max_mb (screenshots add up) stay on their machine.
  if [ "$AGENT_HOST" = box ] && [ -d "$CLAUDE_PROJECTS_DIR" ]; then
    mkdir -p "$s/hosts/$AGENT_HOST/projects"
    rsync -a --max-size="${max_mb}m" "$CLAUDE_PROJECTS_DIR/" "$s/hosts/$AGENT_HOST/projects/"
    find "$s/hosts/$AGENT_HOST/projects" -type f -size +"${max_mb}M" -delete
  elif [ "$AGENT_HOST" = mac ]; then
    # Only the chats that live on the Mac, not every local session.
    local f id slug
    for f in "$AGENT_STATE_DIR"/registry/chats/*.json; do
      [ -f "$f" ] && [[ "$(jq -r '.host + " " + .status' "$f")" =~ ^mac\ (running|moving)$ ]] || continue
      id=$(jq -r .id "$f")
      slug=$(jq -r .dir "$f" | sed 's#[^A-Za-z0-9]#-#g')
      [ -f "$CLAUDE_PROJECTS_DIR/$slug/$id.jsonl" ] || continue
      mkdir -p "$s/hosts/mac/projects/$slug"
      rsync -a --max-size="${max_mb}m" "$CLAUDE_PROJECTS_DIR/$slug/$id.jsonl" "$s/hosts/mac/projects/$slug/"
      [ -d "$CLAUDE_PROJECTS_DIR/$slug/$id" ] && rsync -a --max-size="${max_mb}m" "$CLAUDE_PROJECTS_DIR/$slug/$id" "$s/hosts/mac/projects/$slug/"
    done
  fi
  find "$s/hosts" -type f -size +"${max_mb}M" -print -delete 2> /dev/null | while read -r big; do log "too big for the remote, kept local only: $big"; done
  git -C "$s" add -A
  if git -C "$s" rev-parse -q --verify HEAD > /dev/null; then
    git -C "$s" diff --cached --quiet && [ ! -f "$AGENT_HOME/push-pending" ] && return 0
    # One amended commit: the branch holds only the latest snapshot, and the
    # push stays a small delta against the commit the remote already has.
    git -C "$s" commit -q --amend --allow-empty -m "sessions snapshot ($AGENT_HOST)"
  else
    git -C "$s" commit -q --allow-empty -m "sessions snapshot ($AGENT_HOST)"
  fi
  local err
  if err=$(git -C "$s" push -q --force origin "HEAD:refs/heads/$SESSIONS_BRANCH" 2>&1); then
    rm -f "$AGENT_HOME/push-pending"
  else
    touch "$AGENT_HOME/push-pending"
    log "push failed, retrying on the next turn: $err"
  fi
}

ensure_branch_clone "$AGENT_SESSIONS_DIR" "$SESSIONS_BRANCH"

while :; do
  shopt -s nullglob
  entries=("$AGENT_QUEUE_DIR"/*)
  shopt -u nullglob
  for entry in ${entries[@]+"${entries[@]}"}; do
    snapshot_worktree "$(cat "$entry")"
    rm -f "$entry"
  done
  sync_sessions
  shopt -s nullglob
  remaining=("$AGENT_QUEUE_DIR"/*)
  shopt -u nullglob
  [ ${#remaining[@]} -eq 0 ] && break
done
