#!/usr/bin/env bash
# agent-env <command...>: run a command with this machine's agent environment (option agent_env and
# hosts.HOST.agent_env / env: the secrets file, PATH additions such as shim/sc, variables to set, the
# session markers to drop that a tmux server started inside another Claude Code or super.engineering
# session passes on, so the agent doesn't act as its child; auth stays).
if setup=$(python3 "$(dirname "$0")/abxcfg.py" agent-env 2> /dev/null); then
  eval "$setup"
else
  echo "agent-env: couldn't read the agent-box settings; running without them" >&2
fi
exec "$@"
