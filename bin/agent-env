#!/usr/bin/env bash
# agent-env <command...>: run a command with the box's agent secrets loaded
# (the Cursor key) and agent-box tools on PATH.
set -a
[ -f "$HOME/.config/agent-box/secrets.env" ] && . "$HOME/.config/agent-box/secrets.env"
set +a
if [ -n "${CODER_AGENT_URL:-}" ]; then
  # shim/sc: super.engineering's CLI, backed by git worktrees and the registry.
  export PATH="$HOME/agent-box/shim:$HOME/redo-monorepo-worktrees/bin:$HOME/.local/bin:$PATH"
  export WT_PRIMARY="$HOME/dev/redo" WT_BASE="$HOME/dev/redo-worktrees"
fi
exec "$@"
