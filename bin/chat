#!/usr/bin/env python3
"""Launch and track Claude Code chats that run under Remote Control.

Every chat is one interactive `claude --remote-control` process in its own
tmux session, recorded in the registry on the agent-box `state` branch
(registry/chats/<session id>.json). `supervise` keeps every running chat on
this host alive, so chats survive crashes and workspace restarts.
"""

import argparse
import datetime
import fcntl
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
ON_BOX = bool(os.environ.get("CODER_AGENT_URL"))
HOST = "box" if ON_BOX else "mac"
AGENT_HOME = HOME / ".agent-box"
STATE_DIR = AGENT_HOME / "state"
REGISTRY = STATE_DIR / "registry" / "chats"
CLAUDE_JSON = HOME / ".claude.json"
PROJECTS = HOME / ".claude" / "projects"


def option(key, default):
    """The app's `daemon` settings, as this machine's daemon last saved them (~/.agent-box/config.json)."""
    try:
        value = json.loads((AGENT_HOME / "config.json").read_text()).get(key)
    except (OSError, ValueError):
        return default
    return default if value is None else value

for key, value in (("GIT_AUTHOR_NAME", f"agent-box ({HOST})"), ("GIT_AUTHOR_EMAIL", "tj@getredo.com")):
    os.environ.setdefault(key, value)
    os.environ.setdefault(key.replace("AUTHOR", "COMMITTER"), value)

# Same layout on both machines (on the box ~/dev/redo links to the template's
# ~/project), so the factory skills' paths work unchanged.
PRIMARY = {"redo": HOME / "dev" / "redo", "internal-tools": HOME / "dev" / "redotech-internal-tools",
           "redo-data": HOME / "dev" / "redo-data"}
WORKTREES = HOME / "dev" / "redo-worktrees"
WT = HOME / "redo-monorepo-worktrees" / "bin" / "wt" if ON_BOX else Path("wt")


def repo_of(directory):
    real = os.path.realpath(str(directory))
    for repo, path in PRIMARY.items():
        if os.path.realpath(str(path)) == real:
            return repo
    return None


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd, **kw):
    kw.setdefault("check", True)
    kw.setdefault("text", True)
    return subprocess.run(cmd, **kw)


def git_state(*args, check=True):
    return run(["git", "-C", str(STATE_DIR), *args], capture_output=True, check=check)


class StateLock:
    def __enter__(self):
        AGENT_HOME.mkdir(parents=True, exist_ok=True)
        self.f = open(AGENT_HOME / "state.lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def commit_state(message):
    """Commit and push the state branch; a failed push retries next write."""
    git_state("add", "-A")
    if git_state("diff", "--cached", "--quiet", check=False).returncode != 0:
        git_state("commit", "-q", "-m", message)
    for _ in range(3):
        git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
        if git_state("push", "-q", "origin", "HEAD:state", check=False).returncode == 0:
            return
        time.sleep(2)
    print("warning: state push failed; it will go out with the next write", file=sys.stderr)


def load(chat_id):
    path = REGISTRY / f"{chat_id}.json"
    return json.loads(path.read_text()) if path.exists() else None


def save(chat, message, wait=False):
    """Write the registry entry now; the state branch commit and push happen in the background
    (they take seconds), unless wait."""
    with StateLock():
        REGISTRY.mkdir(parents=True, exist_ok=True)
        chat["updated_at"] = now()
        (REGISTRY / f"{chat['id']}.json").write_text(json.dumps(chat, indent=2) + "\n")
        if wait:
            commit_state(message)
    if not wait:
        background("_commit", message)


def background(*args):
    subprocess.Popen([sys.executable, __file__, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def cmd__commit(args):
    with StateLock():
        commit_state(args.message)


def cmd__rc(args):
    """After `new` returns: wait for the Remote Control link and record it."""
    chat = load(args.chat)
    if chat:
        url = wait_for_rc_url(tmux_name(chat))
        if url:
            chat = load(args.chat) or chat
            chat["rc_url"] = url
            save(chat, f"chat link: {chat['name']}")


def all_chats():
    if not REGISTRY.exists():
        return []
    return [json.loads(p.read_text()) for p in sorted(REGISTRY.glob("*.json"))]


def find(prefix):
    matches = [c for c in all_chats() if c["id"].startswith(prefix) or c["name"] == prefix]
    if len(matches) != 1:
        sys.exit(f"{'no' if not matches else 'ambiguous'} chat matching {prefix!r}")
    return matches[0]


def tmux_name(chat):
    return "chat-" + chat["id"][:8]


def tmux_alive(name):
    return run(["tmux", "has-session", "-t", "=" + name], check=False, capture_output=True).returncode == 0


def project_slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def trust_folder(path):
    """Pre-accept the folder trust dialog so a headless start never blocks on it."""
    with StateLock():
        cfg = json.loads(CLAUDE_JSON.read_text()) if CLAUDE_JSON.exists() else {}
        proj = cfg.setdefault("projects", {}).setdefault(str(path), {})
        if proj.get("hasTrustDialogAccepted"):
            return
        proj["hasTrustDialogAccepted"] = True
        tmp = CLAUDE_JSON.with_suffix(".json.agent-box")
        tmp.write_text(json.dumps(cfg, indent=2))
        tmp.replace(CLAUDE_JSON)


def checked_out(primary, branch):
    """The worktree that already has `branch` checked out, if any (git allows only one)."""
    out = run(["git", "-C", str(primary), "worktree", "list", "--porcelain"], check=False, capture_output=True).stdout
    path = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = line[9:]
        elif line == f"branch refs/heads/{branch}" and path:
            return Path(path)
    return None


def worktree_dir(chat):
    repo = chat.get("repo") or "redo"
    base = WORKTREES if repo == "redo" else HOME / "dev" / f"{PRIMARY[repo].name}-worktrees"
    return base / chat["branch"].replace("/", "-")


def ensure_worktree(chat, restore_from=None):
    """Create the chat's worktree if it's missing; returns its directory.
    restore_from: also apply that host's latest WIP (the worktree must be clean)."""
    if not chat.get("branch"):
        return Path(chat["dir"])
    repo = chat.get("repo") or "redo"
    primary = PRIMARY[repo]
    wt_dir = checked_out(primary, chat["branch"]) or worktree_dir(chat)
    if wt_dir.exists():
        if restore_from:
            wip_restore(wt_dir, restore_from)
        return wt_dir
    run(["git", "-C", str(primary), "fetch", "-q", "origin"], check=False)
    base = chat.get("base")
    local = run(["git", "-C", str(primary), "rev-parse", "-q", "--verify", f"refs/heads/{chat['branch']}"],
                check=False, capture_output=True).returncode == 0
    remote = run(["git", "-C", str(primary), "rev-parse", "-q", "--verify", f"refs/remotes/origin/{chat['branch']}"],
                 check=False, capture_output=True).returncode == 0
    if not local and not remote:
        run(["git", "-C", str(primary), "branch", "-q", "--no-track", chat["branch"], f"origin/{base or 'main'}"])
    if repo != "redo":
        # wt is redo-only; the other repos take plain worktrees.
        wt_dir.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "-C", str(primary), "worktree", "add", "-q", str(wt_dir), chat["branch"]])
        if restore_from:
            wip_restore(wt_dir, restore_from, fresh=True)
        return wt_dir
    env = dict(os.environ, WT_PRIMARY=str(primary), WT_BASE=str(WORKTREES))
    made = run([str(WT), chat["branch"], "--no-start"], env=env, capture_output=True, check=False)
    if not wt_dir.exists():
        sys.exit(f"wt didn't create {wt_dir}: {made.stderr.strip()}")
    if made.returncode != 0:
        # e.g. "no free slots": the worktree exists but has no stack config;
        # a chat doesn't need one, and `wt adopt` provisions it later.
        print(f"warning: wt: {made.stderr.strip().splitlines()[-1]} (run `wt adopt {wt_dir}` before starting its stack)",
              file=sys.stderr)
    if restore_from:
        wip_restore(wt_dir, restore_from, fresh=True)
    return wt_dir


def wip_restore(directory, host, fresh=False):
    args = [str(Path(__file__).parent / "wip-restore")] + (["--fresh"] if fresh else []) + [str(directory), host]
    out = run(args, check=False, capture_output=True)
    text = (out.stdout + out.stderr).strip()
    if out.returncode != 0 and "no WIP from" not in text:
        sys.exit(f"WIP restore failed: {text}")
    if text:
        print(text, file=sys.stderr)


def claude_bin():
    # On the Mac, super.engineering's `claude` wrapper comes first on PATH; a.box runs Claude itself.
    real = HOME / ".local" / "bin" / "claude"
    if not ON_BOX and real.exists():
        return str(real)
    return shutil.which("claude") or str(real)


def session_pids(chat_id):
    """Claude processes (and their wrappers) running this session outside a.box."""
    out = run(["ps", "-axo", "pid=,args="], capture_output=True, check=False).stdout
    pids = []
    for line in out.splitlines():
        pid, _, args = line.strip().partition(" ")
        words = args.split()[:2]
        if any(w.endswith("/claude") or w == "claude" for w in words) and re.search(
                rf"--(resume|session-id)[ =]{re.escape(chat_id)}\b", args):
            pids.append(int(pid))
    return pids


def close_in_super_engineering(chat):
    """Close the super.engineering tab running this chat, the way its UI would."""
    sc = HOME / ".super.engineering" / "bin" / "sc"
    if not sc.exists() or not chat.get("dir"):
        return
    env = {k: v for k, v in os.environ.items() if not k.startswith(("SUPER_ENGINEERING_", "SUPERCONDUCTOR_"))}

    def call(*args):
        out = run([str(sc), *args], capture_output=True, check=False, env=env, timeout=30)
        try:
            return json.loads(out.stdout)
        except json.JSONDecodeError:
            return {}
    ws = call("workspace", "list", "--json")
    items = []
    for sec in ws.get("response", {}).get("workspaces", [{}])[0].get("sections", []):
        items += sec.get("items", [])
        for proj in sec.get("projects", []):
            items += proj.get("items", [])
    real = os.path.realpath(chat["dir"])
    for it in items:
        if os.path.realpath(it.get("path", "")) != real:
            continue
        selectors = []
        for tab in it.get("sessions", []):
            parts = tab.get("id", "").split(".")
            if len(parts) == 3 and parts[0][1:].isdigit() and parts[2][1:].isdigit():
                selectors += ["--to", f"view:{parts[0][1:]}/tab:{int(parts[2][1:]) + 1}"]
        if not selectors:
            return
        state = call("layout", "state", "--worktree", it["path"], "--output", "json", *selectors)
        for t in state.get("response", {}).get("targets", []):
            if chat["id"] in (t.get("session_id"), (t.get("conversation_id") or "").removeprefix("conv:claude:")):
                call("agent", "stop", "--to", "id:" + t["stable_target_id"], "--close", "--worktree", it["path"],
                     "--output", "json")


def stop_elsewhere(chat):
    """Stop whatever else runs this session (super.engineering, usually) before a.box resumes it, so
    two processes never share one session. Exits if it won't stop."""
    if not session_pids(chat["id"]):
        return
    close_in_super_engineering(chat)
    for sig in (None, signal.SIGTERM):
        if sig:
            for pid in session_pids(chat["id"]):
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    pass
        deadline = time.time() + 15
        while time.time() < deadline and session_pids(chat["id"]):
            time.sleep(0.5)
        if not session_pids(chat["id"]):
            return
    sys.exit(f"another process still runs session {chat['id']}: {session_pids(chat['id'])}")


def launch(chat, resume, restore_from=None, wait_rc=True, fork_from=None):
    directory = ensure_worktree(chat, restore_from)
    trust_folder(directory)
    name = tmux_name(chat)
    if tmux_alive(name):
        return
    cmd = [claude_bin()]
    if fork_from:
        cmd += ["--resume", fork_from, "--fork-session", "--session-id", chat["id"]]
    elif resume:
        cmd += ["--resume", chat["id"]]
    else:
        cmd += ["--session-id", chat["id"]]
    cmd += ["--remote-control", chat["name"]]
    if chat.get("model"):
        cmd += ["--model", chat["model"]]
    if not resume and chat.get("prompt"):
        cmd.append(chat["prompt"])
    cmd = [str(Path(__file__).parent / "agent-env")] + cmd
    run(["tmux", "new-session", "-d", "-s", name, "-x", str(option("chat_tmux_cols", 220)), "-y", str(option("chat_tmux_rows", 60)), "-c", str(directory),
         shlex.join(cmd)])
    chat["dir"] = str(directory)
    if wait_rc:
        chat["rc_url"] = wait_for_rc_url(name) or chat.get("rc_url")


def wait_for_rc_url(name, timeout=None):
    """The claude.ai link Remote Control prints once the session connects."""
    deadline = time.time() + (timeout if timeout is not None else option("rc_url_wait_secs", 45))
    while time.time() < deadline:
        pane = run(["tmux", "capture-pane", "-pt", name, "-S", "-200"], check=False, capture_output=True).stdout
        m = re.findall(r"https://claude\.ai/code/session_[A-Za-z0-9]+", pane or "")
        if m:
            return m[-1]
        time.sleep(1)
    return None


def transcript(chat):
    return PROJECTS / project_slug(chat["dir"]) / f"{chat['id']}.jsonl"


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "chat"


def cmd_new(args):
    chat_id = str(uuid.uuid4())
    if args.dir and not args.repo:
        args.repo = repo_of(args.dir)
    args.repo = args.repo or "redo"
    if args.kind == "orchestrator" and not args.branch:
        # Like super.engineering, an orchestrator gets a blank worktree of its
        # own; /ship-feature renames its branch when it takes it over.
        args.branch = f"sc-{slug(args.name)}-{chat_id[:4]}"
    if args.branch:
        directory = None
    else:
        directory = Path(args.dir).expanduser().resolve() if args.dir else PRIMARY[args.repo]
    chat = {
        "id": chat_id,
        "name": args.name,
        "kind": args.kind,
        "parent": args.parent,
        "feature": args.feature,
        "repo": args.repo,
        "branch": args.branch,
        "base": args.base,
        "dir": str(directory) if directory else None,
        "model": args.model,
        "prompt": args.prompt,
        "host": HOST,
        "status": "running",
        "created_at": now(),
    }
    launch(chat, resume=False, wait_rc=False)
    chat.pop("prompt", None)
    save(chat, f"chat new: {args.name}")
    background("_rc", chat_id)
    print(f"{chat_id}  {args.name}  {chat['dir']}")


def cmd_fork(args):
    """A new chat that starts with a copy of this one's conversation, in the same folder."""
    src = find(args.chat)
    if src["host"] != HOST:
        sys.exit(f"{src['name']} lives on {src['host']}; fork it there")
    chat_id = str(uuid.uuid4())
    chat = {k: src.get(k) for k in ("kind", "parent", "feature", "repo", "branch", "base", "dir", "model")}
    chat.update({"id": chat_id, "name": args.name or f"{src['name']} (fork)", "host": HOST, "status": "running",
                 "created_at": now(), "forked_from": src["id"]})
    if chat["kind"] == "orchestrator":
        chat["kind"] = "feature"
    launch(chat, resume=False, wait_rc=False, fork_from=src["id"])
    save(chat, f"chat fork: {chat['name']}")
    background("_rc", chat_id)
    print(f"{chat_id}  {chat['name']}  {chat['dir']}")


def cmd_list(args):
    chats = all_chats()
    if args.json:
        for c in chats:
            c["alive"] = c["host"] == HOST and tmux_alive(tmux_name(c))
            t = transcript(c) if c.get("dir") else None
            c["last_activity"] = (datetime.datetime.fromtimestamp(t.stat().st_mtime, datetime.timezone.utc)
                                  .strftime("%Y-%m-%dT%H:%M:%SZ") if t and t.exists() else None)
        print(json.dumps(chats, indent=2))
        return
    for c in chats:
        if c["status"] == "archived" and not args.all:
            continue
        alive = "up" if c["host"] == HOST and tmux_alive(tmux_name(c)) else "--"
        print(f"{c['id'][:8]}  {alive}  {c['host']:3}  {c['status']:8}  {c['kind']:12}  {c['name']}  [{c.get('branch') or c.get('dir')}]")


def set_status(chat, status):
    if status != "running" and tmux_alive(tmux_name(chat)):
        run(["tmux", "kill-session", "-t", tmux_name(chat)], check=False)
    chat["status"] = status
    save(chat, f"chat {status}: {chat['name']}")


def cmd_stop(args):
    set_status(find(args.chat), "stopped")


def cmd_archive(args):
    set_status(find(args.chat), "archived")


def cmd_start(args):
    chat = find(args.chat)
    if chat["host"] != HOST:
        sys.exit(f"{chat['name']} lives on {chat['host']}; move it here first")
    if not tmux_alive(tmux_name(chat)):
        stop_elsewhere(chat)
    launch(chat, resume=True, wait_rc=False)
    chat["status"] = "running"
    save(chat, f"chat start: {chat['name']}")
    background("_rc", chat["id"])


def cmd_attach(args):
    os.execvp("tmux", ["tmux", "attach", "-t", tmux_name(find(args.chat))])


def cmd_send(args):
    """Type a message into a chat and submit it (a separate Enter, or the TUI
    treats the burst as a paste and doesn't submit)."""
    name = tmux_name(find(args.chat))
    if not tmux_alive(name):
        sys.exit("chat isn't running here")
    run(["tmux", "send-keys", "-t", name, "-l", args.text])
    time.sleep(option("chat_send_pause_secs", 0.5))
    run(["tmux", "send-keys", "-t", name, "C-m"])



BOX_SSH = os.environ.get("AGENT_BOX_SSH", "coder.tj-agents")


def on_box(*args):
    """Run this script on the box; returns its stdout."""
    remote = "$HOME/agent-box/bin/chat " + shlex.join(args)
    out = run(["ssh", "-n", BOX_SSH, remote], check=False, capture_output=True)
    if out.returncode != 0:
        sys.exit(f"box: {out.stderr.strip() or out.stdout.strip()}")
    return out.stdout


def release_here(chat):
    """Stop the chat here and make its latest WIP and transcript durable."""
    chat["status"] = "moving"
    save(chat, f"chat moving: {chat['name']}", wait=True)
    if tmux_alive(tmux_name(chat)):
        run(["tmux", "kill-session", "-t", tmux_name(chat)], check=False)
    if chat.get("branch") and chat.get("dir"):
        queue = AGENT_HOME / "queue"
        queue.mkdir(parents=True, exist_ok=True)
        (queue / f"move-{chat['id']}").write_text(chat["dir"] + "\n")
    run([str(Path(__file__).parent / "sync-worker")], check=False)


def take_over(chat, directory):
    chat["host"] = HOST
    chat["dir"] = str(directory)
    chat["status"] = "running"
    launch(chat, resume=True)
    save(chat, f"chat moved to {HOST}: {chat['name']}", wait=True)


def prepare_here(chat, frm):
    if chat.get("branch"):
        return ensure_worktree(chat, restore_from=frm)
    return PRIMARY[chat.get("repo", "redo")]


def real_dir(host, directory):
    """The folder with symlinks resolved, on its own machine (Claude Code files a session under that)."""
    if host == "box" and HOST != "box":
        out = run(["ssh", "-n", BOX_SSH, f"realpath -m {shlex.quote(str(directory))}"], check=False, capture_output=True)
        return out.stdout.strip().splitlines()[-1] if out.returncode == 0 and out.stdout.strip() else str(directory)
    return os.path.realpath(str(directory))


def copy_transcript(src_host, src_dir, dst_host, dst_dir, chat_id):
    """Copy a chat's transcript (and its subagent folder) between machines. Claude Code keeps a session
    under its folder's real path, so both ends use that (a box chat in ~/dev/redo lives under ~/project);
    the copy is checked, so a move never resumes a chat whose conversation didn't arrive."""
    src_real, dst_real = real_dir(src_host, src_dir), real_dir(dst_host, dst_dir)
    sources = [project_slug(src_real)] + ([project_slug(src_dir)] if project_slug(src_dir) != project_slug(src_real) else [])
    dst = f".claude/projects/{project_slug(dst_real)}/"
    remote_dst = f"{BOX_SSH}:{dst}" if dst_host == "box" else f"{HOME}/{dst}"
    if dst_host == "box":
        run(["ssh", "-n", BOX_SSH, f"mkdir -p {shlex.quote(dst)}"], check=False, capture_output=True)
    else:
        (HOME / dst).mkdir(parents=True, exist_ok=True)
    for slug in sources:
        src = f".claude/projects/{slug}/"
        remote_src = f"{BOX_SSH}:{src}" if src_host == "box" else f"{HOME}/{src}"
        run(["rsync", "-a", "--include", f"{chat_id}.jsonl", "--include", f"{chat_id}/***", "--exclude", "*",
             remote_src, remote_dst], check=False, capture_output=True)
        if dst_host == "box":
            arrived = run(["ssh", "-n", BOX_SSH, f"test -s {shlex.quote(dst + chat_id + '.jsonl')}"], check=False, capture_output=True).returncode == 0
        else:
            arrived = (HOME / dst / f"{chat_id}.jsonl").is_file()
        if arrived:
            return
    sys.exit(f"the conversation didn't copy to the {dst_host} (looked in {', '.join(sources)} on the {src_host})")


def adopt_worktree_branch(chat):
    """A chat brought in from super.engineering knows only its folder: when that's a worktree, take its
    repo and branch, so the box makes the same worktree (with the WIP) instead of using its main checkout."""
    d = chat.get("dir")
    if chat.get("branch") or not d or not Path(d).exists():
        return
    common = run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir"], check=False, capture_output=True).stdout.strip()
    own = run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-dir"], check=False, capture_output=True).stdout.strip()
    branch = run(["git", "-C", d, "branch", "--show-current"], check=False, capture_output=True).stdout.strip()
    repo = repo_of(Path(common).parent) if common else None
    if not (repo and branch and common != own):
        return
    chat["repo"], chat["branch"] = repo, branch
    save(chat, f"chat branch: {chat['name']} on {branch}", wait=True)


def cmd_move(args):
    if HOST != "mac":
        sys.exit("run moves from the Mac (it can reach the box; the box can't reach it)")
    git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
    chat = find(args.chat)
    if chat["host"] == args.to:
        sys.exit(f"{chat['name']} is already on {args.to}")
    try:
        if args.to == "mac":
            box_dir = json.loads(on_box("_release", chat["id"]))["dir"]
            git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
            chat = find(chat["id"])
            local = prepare_here(chat, "box")
            copy_transcript("box", box_dir, "mac", local, chat["id"])
            take_over(chat, local)
            print(f"moved {chat['name']} to the Mac: {local}")
        else:
            adopt_worktree_branch(chat)
            stop_elsewhere(chat)
            release_here(chat)
            box_dir = json.loads(on_box("_prepare", chat["id"], "mac"))["dir"]
            copy_transcript("mac", chat["dir"], "box", box_dir, chat["id"])
            on_box("_take", chat["id"], box_dir)
            # The box wrote the chat's new home to the state branch; take it here too, so the Mac stops listing it.
            git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
            print(f"moved {chat['name']} to the box: {box_dir}")
    except (SystemExit, subprocess.CalledProcessError) as err:
        # Put the chat back where it was, running, so a failed move loses nothing.
        if args.to == "mac":
            on_box("start", chat["id"])
        else:
            git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
            cmd_start(argparse.Namespace(chat=chat["id"]))
        sys.exit(f"move failed, chat left on {chat['host']}: {err}")


def cmd__release(args):
    git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
    chat = find(args.chat)
    release_here(chat)
    print(json.dumps({"dir": chat["dir"]}))


def cmd__prepare(args):
    git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
    print(json.dumps({"dir": str(prepare_here(find(args.chat), args.frm))}))


def cmd__take(args):
    git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
    take_over(find(args.chat), Path(args.dir))


def cmd_test_local(args):
    """Check a branch out on the Mac with the box's latest WIP, for manual
    testing; the chat (or dispatcher leg) working on it stays on the box.
    Takes a chat, or --branch for a leg that has no chat of its own."""
    if HOST != "mac":
        sys.exit("run this on the Mac")
    if args.branch:
        chat = {"branch": args.branch, "repo": "redo", "host": "box"}
        on_box("_snapshot_branch", args.branch)
    else:
        git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
        chat = find(args.chat)
        if not chat.get("branch"):
            sys.exit("this chat has no branch to check out")
        if chat["host"] == "box":
            on_box("_snapshot", chat["id"])
    directory = ensure_worktree(chat, restore_from=chat["host"])
    print(f"{directory}\nStart its stack with: wt start {chat['branch']} -d")


def cmd__snapshot_branch(args):
    """Snapshot whichever box worktree has this branch checked out."""
    out = run(["git", "-C", str(PRIMARY["redo"]), "worktree", "list", "--porcelain"], capture_output=True).stdout
    path = None
    for block in out.split("\n\n"):
        lines = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
        if lines.get("branch") == f"refs/heads/{args.branch}":
            path = lines.get("worktree")
    if not path:
        return
    queue = AGENT_HOME / "queue"
    queue.mkdir(parents=True, exist_ok=True)
    (queue / "snap-branch").write_text(path + "\n")
    run([str(Path(__file__).parent / "sync-worker")], check=False)


def cmd__snapshot(args):
    chat = find(args.chat)
    if chat.get("dir"):
        queue = AGENT_HOME / "queue"
        queue.mkdir(parents=True, exist_ok=True)
        (queue / f"snap-{chat['id']}").write_text(chat["dir"] + "\n")
    run([str(Path(__file__).parent / "sync-worker")], check=False)


def cmd_stack_start(args):
    chat = find(args.chat)
    if HOST != "mac" or not chat.get("branch"):
        sys.exit("stacks start on the Mac, for a chat with a branch")
    os.execvp(str(WT), [str(WT), "start", chat["branch"], "-d"])

def cmd_supervise(args):
    """Keep every running chat on this host alive; runs forever."""
    while True:
        git_state("pull", "-q", "--rebase", "--autostash", "origin", "state", check=False)
        for chat in all_chats():
            if chat["host"] != HOST or chat["status"] != "running":
                continue
            if tmux_alive(tmux_name(chat)):
                continue
            try:
                fresh = chat.get("branch") and not worktree_dir(chat).exists()
                launch(chat, resume=transcript(chat).exists(), restore_from=HOST if fresh else None)
                save(chat, f"chat relaunch: {chat['name']}")
                print(f"{now()} relaunched {chat['name']}", flush=True)
            except (subprocess.CalledProcessError, SystemExit) as err:
                print(f"{now()} relaunch failed for {chat['name']}: {err}", flush=True)
        time.sleep(args.interval if args.interval is not None else option("supervise_secs", 30))


def main():
    p = argparse.ArgumentParser(prog="chat")
    sub = p.add_subparsers(dest="cmd", required=True)

    n = sub.add_parser("new", help="start a chat")
    n.add_argument("name")
    n.add_argument("--kind", default="feature", choices=["orchestrator", "feature", "primary"])
    n.add_argument("--branch", help="run in this branch's worktree (created with wt)")
    n.add_argument("--base", help="new branch starts from origin/<base> instead of main")
    n.add_argument("--repo", choices=list(PRIMARY), help="default: the --dir's repo, else redo")
    n.add_argument("--dir", help="no branch: run here (default: the primary checkout)")
    n.add_argument("--parent", help="orchestrator chat id")
    n.add_argument("--feature", help="feature slug for grouping")
    n.add_argument("--model")
    n.add_argument("--prompt", help="first message")
    n.set_defaults(fn=cmd_new)

    fk = sub.add_parser("fork", help="start a new chat from a copy of this one's conversation")
    fk.add_argument("chat")
    fk.add_argument("--name")
    fk.set_defaults(fn=cmd_fork)

    ls = sub.add_parser("list")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--all", action="store_true")
    ls.set_defaults(fn=cmd_list)

    for name, fn in [("stop", cmd_stop), ("archive", cmd_archive), ("start", cmd_start), ("attach", cmd_attach)]:
        s = sub.add_parser(name)
        s.add_argument("chat", help="id prefix or name")
        s.set_defaults(fn=fn)

    se = sub.add_parser("send", help="type a message into a running chat")
    se.add_argument("chat")
    se.add_argument("text")
    se.set_defaults(fn=cmd_send)

    mv = sub.add_parser("move", help="move a chat between the box and the Mac (run on the Mac)")
    mv.add_argument("chat")
    mv.add_argument("--to", required=True, choices=["box", "mac"])
    mv.set_defaults(fn=cmd_move)

    tl = sub.add_parser("test-local", help="check the chat's branch out on the Mac with its WIP")
    tl.add_argument("chat", nargs="?")
    tl.add_argument("--branch", help="a dispatcher leg's branch instead of a chat")
    tl.set_defaults(fn=cmd_test_local)

    ss = sub.add_parser("stack-start", help="start the chat branch's local stack (wt start -d)")
    ss.add_argument("chat")
    ss.set_defaults(fn=cmd_stack_start)

    for name, fn in [("_release", cmd__release), ("_snapshot", cmd__snapshot)]:
        h = sub.add_parser(name)
        h.add_argument("chat")
        h.set_defaults(fn=fn)
    h = sub.add_parser("_snapshot_branch")
    h.add_argument("branch")
    h.set_defaults(fn=cmd__snapshot_branch)
    h = sub.add_parser("_prepare")
    h.add_argument("chat")
    h.add_argument("frm")
    h.set_defaults(fn=cmd__prepare)
    h = sub.add_parser("_take")
    h.add_argument("chat")
    h.add_argument("dir")
    h.set_defaults(fn=cmd__take)

    h = sub.add_parser("_commit")
    h.add_argument("message")
    h.set_defaults(fn=cmd__commit)
    h = sub.add_parser("_rc")
    h.add_argument("chat")
    h.set_defaults(fn=cmd__rc)

    sv = sub.add_parser("supervise")
    sv.add_argument("--interval", type=int, default=None)
    sv.set_defaults(fn=cmd_supervise)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
