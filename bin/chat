#!/usr/bin/env python3
"""Launch and track coding-agent chats (Claude Code under Remote Control, Codex).

Every chat is one interactive agent CLI process (`agents` below) in its own
tmux session, recorded in the registry on the agent-box `state` branch
(registry/chats/<session id>.json). `supervise` keeps every running chat on
this host alive, so chats survive crashes and workspace restarts.
"""

import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import abxcfg  # noqa: E402

HOME = Path.home()
HOST = abxcfg.host_id()
AGENT_HOME = HOME / ".agent-box"
STATE_DIR = AGENT_HOME / "state"
REGISTRY = STATE_DIR / "registry" / "chats"
PROJECTS = HOME / ".claude" / "projects"

# The app's `daemon` settings, as this machine's daemon last saved them (~/.agent-box/config.json);
# AGENT_BOX_OPTIONS (a JSON object) overrides them for one run.
option = abxcfg.option
fill = abxcfg.fill
label = abxcfg.label


def ssh_mux():
    """ssh options sharing one connection per machine for `ssh_mux_secs` (Coder's ssh takes seconds to
    connect, and a move makes dozens of calls)."""
    secs = option("ssh_mux_secs", 120)
    if not secs:
        return []
    return ["-o", "ControlMaster=auto", "-o", f"ControlPath={HOME}/.ssh/abx-%C", "-o", f"ControlPersist={secs}"]


def ssh(host, *command, stdin=False):
    remote_called()
    return ["ssh", *([] if stdin else ["-n"]), *ssh_mux(), ssh_to(host), *command]


def rsync():
    remote_called()
    return ["rsync", "-e", shlex.join(["ssh", *ssh_mux()])]

# How an agent's `trust` pre-accepts a folder: set `path` (keys; {dir} is the folder) to `value` in `file`.
TRUST = {"claude": {"file": "~/.claude.json", "path": ["projects", "{dir}", "hasTrustDialogAccepted"], "value": True}}

CLAUDE_SETTINGS = '{"showThinkingSummaries":true}'

# Each agent CLI a chat can run. The app's `daemon.agents` (config.json) overrides any key. A template is
# argv with {placeholders}; a nested list is dropped when a placeholder in it is empty. `session`:
# "assigned" (the chat id is the session id) or "discovered" (the CLI picks it; found in `sessions_dir`).
# transcripts_root/backup_dir: what sync-worker backs up, and where under the sessions branch.
# process_names/process_session_pattern: another process running a session (the pattern's group 1).
# Claude Code's stream-json mode, as the VS Code extension runs it: the daemon owns the process and talks
# JSON on its stdio (rust/daemon/src/sdk.rs). `_sdk_launch` fills these; {mode} is the permission mode.
SDK_FLAGS = ["--print", "--output-format", "stream-json", "--verbose", "--input-format", "stream-json",
             "--max-thinking-tokens=31999", "--permission-prompt-tool=stdio", "--setting-sources=user,project,local",
             "--include-partial-messages", "--replay-user-messages", "--settings", CLAUDE_SETTINGS,
             ["--model", "{model}"], ["--permission-mode", "{mode}"], ["--effort", "{effort}"]]

AGENTS = {
    "claude": {
        "bin": "claude", "session": "assigned", "trust": "claude", "remote_control": True, "stop_elsewhere": True,
        # transport "sdk": chats run in stream-json mode under the daemon (no tmux); "tui": the interactive CLI.
        "transport": "sdk",
        "sdk_new": ["{bin}", "--session-id", "{id}", *SDK_FLAGS],
        "sdk_resume": ["{bin}", "--resume", "{session}", *SDK_FLAGS],
        "sdk_fork": ["{bin}", "--resume", "{from}", "--fork-session", "--session-id", "{id}", *SDK_FLAGS],
        "rc_url_pattern": r"https://claude\.ai/code/session_[A-Za-z0-9]+",
        "transcripts_root": "~/.claude/projects", "backup_dir": "projects",
        "process_names": ["claude"], "process_session_pattern": r"--(?:resume|session-id)[ =]([0-9a-f]{8}-[0-9a-f-]{27})",
        "hooks_file": "~/.claude/settings.json", "hooks_installer": "claude-hooks", "provider": "anthropic",
        "hook_events": ["UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "PermissionRequest", "Stop",
                        "SubagentStop", "SessionStart", "SessionEnd"],
        # showThinkingSummaries: Claude Code logs thinking as empty blocks unless asked for summaries.
        "new": ["{bin}", "--session-id", "{id}", "--remote-control", "{name}", "--settings", CLAUDE_SETTINGS,
                ["--model", "{model}"], ["{prompt}"]],
        "resume": ["{bin}", "--resume", "{session}", "--remote-control", "{name}", "--settings", CLAUDE_SETTINGS,
                   ["--model", "{model}"]],
        "fork": ["{bin}", "--resume", "{from}", "--fork-session", "--session-id", "{id}", "--remote-control", "{name}",
                 "--settings", CLAUDE_SETTINGS, ["--model", "{model}"]],
    },
    "codex": {
        "bin": "codex", "session": "discovered", "sessions_dir": "~/.codex/sessions",
        "transcripts_root": "~/.codex/sessions", "backup_dir": "codex-sessions",
        "hooks_file": "~/.codex/hooks.json", "hooks_home_env": "CODEX_HOME", "provider": "openai",
        "hook_events": ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PermissionRequest", "Stop",
                        "SessionEnd"],
        "new": ["{bin}", "-c", "check_for_update_on_startup=false", "-c", 'projects={"{realdir}"={trust_level="trusted"}}',
                ["--model", "{model}"], ["{prompt}"]],
        "resume": ["{bin}", "resume", "{session}", "-c", "check_for_update_on_startup=false",
                   "-c", 'projects={"{realdir}"={trust_level="trusted"}}', ["--model", "{model}"]],
        "fork": ["{bin}", "fork", "{from}", "-c", "check_for_update_on_startup=false",
                 "-c", 'projects={"{realdir}"={trust_level="trusted"}}', ["--model", "{model}"]],
    },
}


def agents():
    out = {k: dict(v) for k, v in AGENTS.items()}
    for name, over in (option("agents", {}) or {}).items():
        out.setdefault(name, {}).update({k: v for k, v in (over or {}).items() if v is not None})
    return out


def agent_def(chat):
    return agents().get(chat.get("agent") or "claude", {})


def session_of(chat):
    """The agent's own id for the chat's conversation (Claude: the chat id), None until Codex has one."""
    return chat["id"] if agent_def(chat).get("session") == "assigned" else chat.get("session_id")


for key, value in zip(("GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL"), abxcfg.git_author()):
    os.environ.setdefault(key, value)
    os.environ.setdefault(key.replace("AUTHOR", "COMMITTER"), value)

repo_of = abxcfg.repo_of


def primary_of(repo):
    """A repo's primary checkout (`repos.REPO.primary`)."""
    path = abxcfg.primary(repo)
    if not path:
        sys.exit(f"unknown repo {repo!r} (known: {', '.join(abxcfg.repos())})")
    return path


def default_repo():
    return abxcfg.default_repo() or "redo"


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd, **kw):
    kw.setdefault("check", True)
    kw.setdefault("text", True)
    if not os.environ.get("ABX_TIMING"):
        return subprocess.run(cmd, **kw)
    # ABX_TIMING=1: how long each command took, on stderr (finding what makes a move slow).
    start = time.time()
    try:
        return subprocess.run(cmd, **kw)
    finally:
        print(f"[{time.time() - start:6.2f}s] {shlex.join(map(str, cmd))[:160]}", file=sys.stderr)


def git_state(*args, check=True):
    # A stalled connection to GitLab fails within seconds instead of holding a move (or anything) forever.
    env = {**os.environ, "GIT_SSH_COMMAND": os.environ.get("GIT_SSH_COMMAND") or
           "ssh -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3"}
    try:
        return run(["git", "-C", str(STATE_DIR), *args], capture_output=True, check=check, env=env,
                   timeout=option("state_git_timeout_secs", 60))
    except subprocess.TimeoutExpired as err:
        if check:
            raise SystemExit(f"git {' '.join(args)} in the state repo timed out")
        return subprocess.CompletedProcess(err.cmd, 124, "", "timed out")


class StateLock:
    def __enter__(self):
        AGENT_HOME.mkdir(parents=True, exist_ok=True)
        self.f = open(AGENT_HOME / "state.lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# When this process last pulled the state branch; a call to another machine (which may write it) makes
# the next pull_state really pull.
PULLED = {"at": 0.0}


def pull_state(force=False):
    """Bring in the other machines' state writes. Skipped when this process pulled within
    `state_pull_reuse_secs` and called no other machine since (each pull is a GitLab round trip)."""
    if not abxcfg.state_repo_url():
        return
    if not force and time.time() - PULLED["at"] < option("state_pull_reuse_secs", 20):
        return
    git_state("pull", "-q", "--rebase", "--autostash", "origin", abxcfg.state_branch(), check=False)
    unstick_state()
    PULLED["at"] = time.time()


def unstick_state():
    """A pull whose rebase or autostash doesn't apply cleanly leaves conflicted files, and every later pull
    and push fails on them: take the pulled copy of each, finish the rebase (or call off one that still
    can't go on), and say so in agent-box.log."""
    git_dir = STATE_DIR / ".git"
    rebasing = lambda: (git_dir / "rebase-merge").exists() or (git_dir / "rebase-apply").exists()
    taken, parked = [], False
    for _ in range(int(option("state_rebase_steps", 200))):
        stuck = git_state("diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        for path in stuck:
            if git_state("cat-file", "-e", f"HEAD:{path}", check=False).returncode == 0:
                git_state("checkout", "HEAD", "--", path, check=False)
            else:
                git_state("rm", "-q", "--cached", "--ignore-unmatch", path, check=False)
                (STATE_DIR / path).unlink(missing_ok=True)
        taken += stuck
        if not rebasing():
            break
        # Files changed since (this daemon keeps writing) would stop the rebase from going on.
        if not parked and git_state("diff", "--quiet", check=False).returncode != 0:
            parked = git_state("stash", "push", "-q", "--keep-index", "-m", "state: unstick", check=False).returncode == 0
        if git_state("-c", "core.editor=true", "rebase", "--continue", check=False).returncode != 0 \
                and not git_state("diff", "--name-only", "--diff-filter=U", check=False).stdout.strip():
            git_state("rebase", "--abort", check=False)
            move_log("called off a state rebase that couldn't go on; this machine's commits stay unpushed until the next pull", tag="state")
            break
    if parked:
        git_state("stash", "pop", "-q", check=False)
    if taken:
        move_log(f"took the pulled copy of {', '.join(sorted(set(taken)))}: this machine's change didn't apply on top (it's in `git stash list` or the state log)", tag="state")


def remote_called():
    PULLED["at"] = 0.0


def commit_state(message):
    """Commit and push the state branch (`state_push_tries` tries, `state_push_wait_secs` apart); a failed
    push retries next write."""
    unstick_state()
    git_state("add", "-A")
    if git_state("diff", "--cached", "--quiet", check=False).returncode != 0:
        git_state("commit", "-q", "-m", message)
    if not abxcfg.state_repo_url():
        return
    # Push first: a pull is only needed when another machine pushed since this one last pulled.
    for i in range(max(1, int(option("state_push_tries", 3)))):
        if i:
            pull_state(force=True)
        if git_state("push", "-q", "origin", f"HEAD:{abxcfg.state_branch()}", check=False).returncode == 0:
            return
        if i:
            time.sleep(option("state_push_wait_secs", 2))
    print("warning: state push failed; it will go out with the next write", file=sys.stderr)


def load(chat_id):
    path = REGISTRY / f"{chat_id}.json"
    return json.loads(path.read_text()) if path.exists() else None


def save(chat, message, wait=False, commit=True):
    """Write the registry entry now; the state branch commit and push happen in the background
    (they take seconds), unless wait. commit False: the caller commits several at once."""
    with StateLock():
        REGISTRY.mkdir(parents=True, exist_ok=True)
        chat["updated_at"] = now()
        (REGISTRY / f"{chat['id']}.json").write_text(json.dumps(chat, indent=2) + "\n")
        if wait and commit:
            commit_state(message)
    if commit and not wait:
        background("_commit", message)


def commit_now(message):
    with StateLock():
        commit_state(message)


def background(*args):
    subprocess.Popen([sys.executable, __file__, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def cmd__commit(args):
    with StateLock():
        commit_state(args.message)


def cmd__rc(args):
    """After `new` returns: wait for the Remote Control link and record it."""
    chat = load(args.chat)
    if chat and agent_def(chat).get("remote_control"):
        url = wait_for_rc_url(tmux_name(chat), pattern=agent_def(chat).get("rc_url_pattern"))
        if url:
            chat = load(args.chat) or chat
            chat["rc_url"] = url
            save(chat, f"chat link: {chat['name']}")


def all_chats():
    if not REGISTRY.exists():
        return []
    return [json.loads(p.read_text()) for p in sorted(REGISTRY.glob("*.json"))]


def find(prefix):
    matches = [c for c in all_chats() if c["id"].startswith(prefix) or c["name"] == prefix]
    if len(matches) != 1:
        sys.exit(f"{'no' if not matches else 'ambiguous'} chat matching {prefix!r}")
    return matches[0]


def tmux_name(chat):
    """`tmux_prefix` and the chat id's first `tmux_id_chars` characters (the daemon names them the same)."""
    return option("tmux_prefix", "chat-") + chat["id"][:int(option("tmux_id_chars", 8))]


def tmux_alive(name):
    return run(["tmux", "has-session", "-t", "=" + name], check=False, capture_output=True).returncode == 0


def project_slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def trust_folder(agent, path):
    """Pre-accept the agent's folder trust dialog (its `trust`: a TRUST name or {file, path, value}) so a
    headless start never blocks on it."""
    spec = agent.get("trust")
    spec = TRUST.get(spec) if isinstance(spec, str) else spec
    if not isinstance(spec, dict) or not spec.get("file") or not spec.get("path"):
        return
    file = Path(abxcfg.expand(spec["file"]))
    keys = [abxcfg.subst(k, {"dir": str(path)}) for k in spec["path"]]
    value = spec.get("value", True)
    with StateLock():
        cfg = json.loads(file.read_text()) if file.exists() else {}
        node = cfg
        for k in keys[:-1]:
            node = node.setdefault(k, {})
        if node.get(keys[-1]) == value:
            return
        node[keys[-1]] = value
        file.parent.mkdir(parents=True, exist_ok=True)
        tmp = file.with_suffix(file.suffix + ".agent-box")
        tmp.write_text(json.dumps(cfg, indent=2))
        tmp.replace(file)


def checked_out(primary, branch):
    """The worktree that already has `branch` checked out, if any (git allows only one)."""
    out = run(["git", "-C", str(primary), "worktree", "list", "--porcelain"], check=False, capture_output=True).stdout
    path = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = line[9:]
        elif line == f"branch refs/heads/{branch}" and path:
            return Path(path)
    return None


def worktree_dir(chat):
    return abxcfg.worktree_path(chat.get("repo") or default_repo(), chat["branch"])


def add_worktree(primary, wt_dir, branch, serial=None):
    """`git worktree add`, with git's own error when it fails. Given only origin's branch, git makes the
    local one and writes its upstream to the repo's config, and several doing that side by side fail on
    the config lock (exit 255, the branch made but untracked): so the branch is made first, holding
    `serial`. A failed one still tries again on its own."""
    git = lambda *a: run(["git", "-C", str(primary), *a], check=False, capture_output=True)
    with serial or contextlib.nullcontext():
        if git("rev-parse", "-q", "--verify", f"refs/heads/{branch}").returncode != 0 \
                and git("rev-parse", "-q", "--verify", f"refs/remotes/origin/{branch}").returncode == 0:
            git("branch", "-q", "--track", branch, f"origin/{branch}")
    cmd = ["git", "-C", str(primary), "worktree", "add", "-q", str(wt_dir), branch]
    for attempt in range(3):
        with (serial if attempt and serial else contextlib.nullcontext()):
            made = run(cmd, check=False, capture_output=True)
        if made.returncode == 0:
            return
        err = made.stderr.strip() or f"exit status {made.returncode}"
        move_log(f"git worktree add {wt_dir} (try {attempt + 1}) failed: {err}")
        if wt_dir.exists() and not any(wt_dir.iterdir()):
            wt_dir.rmdir()
        time.sleep(2)
    raise RuntimeError(f"git worktree add {wt_dir.name}: {err}")


def make_worktree(repo, branch, wt_dir, base=None, fetched=False, serial=None):
    """A worktree of `branch` at `wt_dir` (made from origin/<base or the default branch> when the branch is
    new), by the repo's worktree_tool or plain `git worktree add`. fetched: the caller fetched the branch
    and its base. serial: a lock held around the tool's part, when several are made at once (wt hands out
    slots); with an `adopt` command the checkout itself is plain git, outside it."""
    primary = primary_of(repo)
    # Just this branch (and the base a new one starts from), not the whole remote: a monorepo fetch takes seconds.
    if not fetched:
        fetch_branch(primary, branch)
    local = run(["git", "-C", str(primary), "rev-parse", "-q", "--verify", f"refs/heads/{branch}"],
                check=False, capture_output=True).returncode == 0
    remote = run(["git", "-C", str(primary), "rev-parse", "-q", "--verify", f"refs/remotes/origin/{branch}"],
                 check=False, capture_output=True).returncode == 0
    if not local and not remote:
        base = base or abxcfg.default_base(primary)
        if not fetched:
            fetch_branch(primary, base)
        run(["git", "-C", str(primary), "branch", "-q", "--no-track", branch, f"origin/{base}"])
    tool = abxcfg.worktree_tool(repo) or {}
    adopt = bool(tool.get("adopt"))
    if adopt or not tool.get("create"):
        wt_dir.parent.mkdir(parents=True, exist_ok=True)
        add_worktree(primary, wt_dir, branch, serial)
        if not adopt:
            return
    values = {"branch": branch, "path": str(wt_dir), "name": wt_dir.name}
    with serial or contextlib.nullcontext():
        made = run(abxcfg.tool_argv(repo, tool, "adopt" if adopt else "create", **values),
                   env=abxcfg.tool_env(repo, tool, **values), capture_output=True, check=False, cwd=str(primary))
    if not wt_dir.exists():
        sys.exit(f"{tool['bin']} didn't create {wt_dir}: {made.stderr.strip()}")
    if made.returncode != 0:
        # e.g. wt's "no free slots": the worktree exists but has no stack config; a chat doesn't need one.
        last = (made.stderr.strip().splitlines() or [""])[-1]
        note = abxcfg.subst(tool.get("partial_note") or "", {"path": str(wt_dir), "branch": branch})
        print(f"warning: {Path(tool['bin']).name}: {last}" + (f" ({note})" if note else ""), file=sys.stderr)


def fetch_branch(checkout, branch):
    run(["git", "-C", str(checkout), "fetch", "-q", "--no-write-fetch-head", "origin", f"+refs/heads/{branch}:refs/remotes/origin/{branch}"],
        check=False, capture_output=True)


def ensure_worktree(chat, restore_from=None, incoming=False):
    """Create the chat's worktree if it's missing; returns its directory.
    restore_from: also apply that host's latest WIP (the worktree must be clean); incoming: the WIP that
    host sent here for a move (send_wip), not its sessions branch."""
    if not chat.get("branch"):
        return Path(chat["dir"])
    repo = chat.get("repo") or default_repo()
    wt_dir = checked_out(primary_of(repo), chat["branch"]) or worktree_dir(chat)
    if wt_dir.exists():
        if restore_from:
            wip_restore(wt_dir, restore_from, incoming=incoming)
        return wt_dir
    make_worktree(repo, chat["branch"], wt_dir, chat.get("base"))
    if restore_from:
        wip_restore(wt_dir, restore_from, fresh=True, incoming=incoming)
    return wt_dir


def wip_restore(directory, host, fresh=False, incoming=False):
    # A worktree this machine handed off keeps the work it had then; stash that (recoverable, never
    # dropped) so the other machine's newer work can land.
    if not fresh and run(["git", "-C", str(directory), "status", "--porcelain"], check=False, capture_output=True).stdout.strip():
        run(["git", "-C", str(directory), "stash", "push", "-q", "-u", "-m", f"Turtwig: before restoring the {label(host)}'s work"], check=False)
        print(f"stashed {directory}'s local changes (git stash list) before restoring the {label(host)}'s work", file=sys.stderr)
    args = [str(Path(__file__).parent / "wip-restore")] + (["--fresh"] if fresh else []) + [str(directory), "--from", host]
    if incoming:
        args += ["--wip-dir", str(AGENT_HOME / "incoming" / host / "wip")]
    out = run(args, check=False, capture_output=True)
    text = (out.stdout + out.stderr).strip()
    if out.returncode != 0 and "no WIP from" not in text:
        sys.exit(f"WIP restore failed: {text}")
    if text:
        print(text, file=sys.stderr)


def agent_bin(name):
    # A host's `agent_bin_dirs` come first (on the Mac, super.engineering's `claude` wrapper is first on
    # PATH; Turtwig runs the CLI itself).
    for d in abxcfg.host().get("agent_bin_dirs") or []:
        real = Path(abxcfg.expand(d)) / name
        if real.exists():
            return str(real)
    return shutil.which(name) or str(HOME / ".local" / "bin" / name)


def session_pids(chat):
    """Processes of the chat's agent (its `process_names`, and their wrappers) running its session outside
    Turtwig: `process_session_pattern`'s group 1 is the session id."""
    agent = agent_def(chat)
    session = session_of(chat)
    names = agent.get("process_names") or []
    pattern = agent.get("process_session_pattern")
    if not (session and names and pattern):
        return []
    want = re.compile(pattern)
    out = run(["ps", "-axo", "pid=,args="], capture_output=True, check=False).stdout
    pids = []
    for line in out.splitlines():
        pid, _, args = line.strip().partition(" ")
        words = args.split()[:2]
        m = want.search(args)
        if any(w == n or w.endswith("/" + n) for w in words for n in names) and m and m.group(1) == session:
            pids.append(int(pid))
    return pids


def close_in_super_engineering(chat):
    """Close the foreign tool's (super.engineering's) tab running this chat, the way its UI would."""
    ft = abxcfg.foreign_tools()
    sc = Path(abxcfg.expand(ft["sc_bin"])) if ft and ft.get("sc_bin") else None
    if not sc or not sc.exists() or not chat.get("dir"):
        return
    env = {k: v for k, v in os.environ.items() if not k.startswith(tuple(ft.get("env_prefixes") or ()))}

    def call(*args):
        try:
            out = run([str(sc), *args], capture_output=True, check=False, env=env, timeout=30)
        except subprocess.TimeoutExpired:
            return {}
        try:
            return json.loads(out.stdout)
        except json.JSONDecodeError:
            return {}
    ws = call("workspace", "list", "--json")
    items = []
    for sec in ws.get("response", {}).get("workspaces", [{}])[0].get("sections", []):
        items += sec.get("items", [])
        for proj in sec.get("projects", []):
            items += proj.get("items", [])
    real = os.path.realpath(chat["dir"])
    for it in items:
        if os.path.realpath(it.get("path", "")) != real:
            continue
        selectors = []
        for tab in it.get("sessions", []):
            parts = tab.get("id", "").split(".")
            if len(parts) == 3 and parts[0][1:].isdigit() and parts[2][1:].isdigit():
                selectors += ["--to", f"view:{parts[0][1:]}/tab:{int(parts[2][1:]) + 1}"]
        if not selectors:
            return
        state = call("layout", "state", "--worktree", it["path"], "--output", "json", *selectors)
        for t in state.get("response", {}).get("targets", []):
            if chat["id"] in (t.get("session_id"), (t.get("conversation_id") or "").removeprefix("conv:claude:")):
                call("agent", "stop", "--to", "id:" + t["stable_target_id"], "--close", "--worktree", it["path"],
                     "--output", "json")


def stop_elsewhere(chat):
    """Stop whatever else runs this session (super.engineering, usually) before Turtwig resumes it, so
    two processes never share one session. Exits if it won't stop."""
    if not agent_def(chat).get("stop_elsewhere"):
        return
    # A process Turtwig just stopped takes a moment to exit.
    deadline = time.time() + option("stop_elsewhere_wait_secs", 5)
    while time.time() < deadline and session_pids(chat):
        time.sleep(0.5)
    if not session_pids(chat):
        return
    close_in_super_engineering(chat)
    for sig in (None, signal.SIGTERM):
        if sig:
            for pid in session_pids(chat):
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    pass
        deadline = time.time() + option("stop_elsewhere_kill_secs", 15)
        while time.time() < deadline and session_pids(chat):
            time.sleep(0.5)
        if not session_pids(chat):
            return
    sys.exit(f"another process still runs session {chat['id']}: {session_pids(chat)}")


def launch(chat, resume, restore_from=None, wait_rc=True, fork_from=None):
    """fork_from: the source chat's session id."""
    agent = agent_def(chat)
    directory = ensure_worktree(chat, restore_from)
    trust_folder(agent, directory)
    name = tmux_name(chat)
    if tmux_alive(name):
        return
    if agent.get("transport") == "sdk":
        # The daemon starts the process (`_sdk_launch` says how); the record just says the chat is an SDK one.
        chat["dir"] = str(directory)
        chat["transport"] = "sdk"
        return
    session = session_of(chat)
    template = agent["fork"] if fork_from else agent["resume"] if resume and session else agent["new"]
    if agent.get("session") == "discovered" and (fork_from or not (resume and session)):
        # A new session: bin/chat finds the CLI's id for it once its first message makes the rollout.
        chat.pop("session_id", None)
        chat.pop("transcript", None)
        chat["launched_at"] = time.time()
    cmd = fill(template, {"bin": agent_bin(agent.get("bin") or chat.get("agent") or "claude"), "id": chat["id"],
                          "session": session, "from": fork_from, "name": chat["name"], "model": chat.get("model"),
                          "prompt": None if resume else chat.get("prompt"), "dir": str(directory),
                          "realdir": os.path.realpath(str(directory))})
    cmd = [str(Path(__file__).parent / "agent-env")] + cmd
    run(["tmux", "new-session", "-d", "-s", name, "-x", str(option("chat_tmux_cols", 220)), "-y", str(option("chat_tmux_rows", 60)), "-c", str(directory),
         shlex.join(cmd)])
    chat["dir"] = str(directory)
    if wait_rc and agent.get("remote_control"):
        chat["rc_url"] = wait_for_rc_url(name, pattern=agent.get("rc_url_pattern")) or chat.get("rc_url")


def wait_for_rc_url(name, timeout=None, pattern=None):
    """The link Remote Control prints once the session connects (the agent's `rc_url_pattern`), from the
    pane's last `rc_scan_lines` lines."""
    deadline = time.time() + (timeout if timeout is not None else option("rc_url_wait_secs", 45))
    pattern = pattern or AGENTS["claude"]["rc_url_pattern"]
    while time.time() < deadline:
        pane = run(["tmux", "capture-pane", "-pt", name, "-S", f"-{int(option('rc_scan_lines', 200))}"],
                   check=False, capture_output=True).stdout
        m = re.findall(pattern, pane or "")
        if m:
            return m[-1]
        time.sleep(1)
    return None


def transcript(chat):
    """The chat's conversation file (None: a Codex chat with no session yet). An agent with a
    `transcript_path` template ({id} {session} {dir} {dir_slug}) keeps it there."""
    template = agent_def(chat).get("transcript_path")
    if template and not (chat.get("transcript") and os.path.exists(chat["transcript"])):
        session = session_of(chat) or chat["id"]
        values = {"id": chat["id"], "session": session, "dir": chat.get("dir") or "",
                  "dir_slug": project_slug(os.path.realpath(chat["dir"])) if chat.get("dir") else ""}
        return Path(abxcfg.expand(abxcfg.subst(template, values)))
    if agent_def(chat).get("session") == "discovered":
        # `transcript` is this machine's path; after a move the rollout is found again by its session.
        path = chat.get("transcript")
        if not (path and os.path.exists(path)) and session_of(chat):
            path = rollout_of(chat, session_of(chat)) or path
        return Path(path) if path else None
    return PROJECTS / project_slug(chat["dir"]) / f"{chat['id']}.jsonl" if chat.get("dir") else None


def sessions_dir(chat):
    return Path(os.path.expanduser(agent_def(chat).get("sessions_dir") or "~/.codex/sessions"))


def rollout_meta(path):
    """A rollout's session_meta payload (its first line)."""
    try:
        with open(path) as f:
            first = json.loads(f.readline())
    except (OSError, ValueError):
        return {}
    return first.get("payload") or {} if first.get("type") == "session_meta" else {}


def rollouts(root, since=None):
    """Rollout files under root (YYYY/MM/DD/rollout-*.jsonl), newest day first; since: days from then on."""
    first = datetime.date.fromtimestamp(since) - datetime.timedelta(days=1) if since else None
    for day in sorted(root.glob("[0-9]*/[0-9]*/[0-9]*"), reverse=True):
        try:
            if first and datetime.date(*map(int, day.parts[-3:])) < first:
                break
        except ValueError:
            continue
        yield from sorted(day.glob("rollout-*.jsonl"), reverse=True)


def rollout_of(chat, session):
    return next((str(p) for p in rollouts(sessions_dir(chat)) if p.name.endswith(f"-{session}.jsonl")), None)


def stamp(text):
    try:
        return datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return 0


def find_session(chat):
    """The rollout Codex started for this chat: the oldest one since its launch, in its folder, that's no
    subagent's and no other chat's (a fork's: forked from its source). (session id, path) or None."""
    since = chat.get("launched_at") or stamp(chat.get("created_at"))
    want = os.path.realpath(chat["dir"]) if chat.get("dir") else None
    claimed = {c.get("session_id") for c in all_chats() if c["id"] != chat["id"]}
    source = (load(chat["forked_from"]) or {}).get("session_id") if chat.get("forked_from") else None
    best = None
    for path in rollouts(sessions_dir(chat), since):
        if path.stat().st_mtime < since - 5:
            continue
        meta = rollout_meta(path)
        if (not meta.get("id") or meta["id"] in claimed or meta.get("thread_source") == "subagent"
                or isinstance(meta.get("source"), dict) or stamp(meta.get("timestamp")) < since - 5
                or os.path.realpath(meta.get("cwd") or "") != want or meta.get("forked_from_id") != source):
            continue
        if not best or stamp(meta.get("timestamp")) < best[0]:
            best = (stamp(meta.get("timestamp")), meta["id"], str(path))
    return best[1:] if best else None


def record_session(chat_id, wait=0):
    """Find and save a Codex chat's session, polling up to `wait` seconds; True once it's known."""
    deadline = time.time() + wait
    while True:
        chat = load(chat_id)
        if not chat or chat.get("session_id") or agent_def(chat).get("session") != "discovered":
            return bool(chat and chat.get("session_id"))
        found = find_session(chat)
        if found:
            chat["session_id"], chat["transcript"] = found
            save(chat, f"chat session: {chat['name']}")
            return True
        if time.time() >= deadline:
            return False
        time.sleep(option("session_poll_secs", 1))


def cmd__session(args):
    if args.background:
        background("_session", args.chat)
    else:
        record_session(args.chat, option("session_wait_secs", 180))


def agent_transcript_paths(chat):
    """Every file holding the chat's conversation, for any agent: Claude Code's session file and its
    subagents' folder; or Codex's rollout, the rollouts it was forked from (a fork's rollout holds only
    what came after), and its subagents' rollouts (sessions of their own)."""
    if agent_def(chat).get("session") != "discovered":
        main = transcript(chat)
        return [p for p in (main, main.with_suffix("") if main else None) if p and p.exists()]
    path = transcript(chat)
    if not path or not path.exists():
        return []
    out, meta = [path], rollout_meta(path)
    parent = meta.get("forked_from_id")
    while parent and len(out) < int(option("fork_chain_max", 50)):
        found = rollout_of(chat, parent)
        if not found:
            break
        out.append(Path(found))
        parent = rollout_meta(found).get("forked_from_id")
    for p in rollouts(sessions_dir(chat), stamp(meta.get("timestamp")) or None):
        source = rollout_meta(p).get("source") if p not in out else None
        spawn = source.get("subagent", {}).get("thread_spawn", {}) if isinstance(source, dict) else {}
        if spawn.get("parent_thread_id") == session_of(chat):
            out.append(p)
    return out


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "chat"


def chat_kinds():
    return list(option("chat_kinds", ["orchestrator", "feature", "primary"]))


def cmd_new(args):
    chat_id = str(uuid.uuid4())
    if args.kind not in chat_kinds():
        sys.exit(f"unknown kind {args.kind!r} (known: {', '.join(chat_kinds())})")
    if args.dir and not args.repo:
        args.repo = repo_of(args.dir)
    args.repo = args.repo or default_repo()
    if args.kind in option("branch_kinds", ["orchestrator"]) and not args.branch:
        # Like super.engineering, an orchestrator gets a blank worktree of its own (`orchestrator_branch`:
        # {slug} of its name, {id4} of its id); /ship-feature renames its branch when it takes it over.
        args.branch = abxcfg.subst(option("orchestrator_branch", "sc-{slug}-{id4}"),
                                   {"slug": slug(args.name), "id4": chat_id[:4], "id": chat_id})
    if args.branch:
        directory = None
    else:
        directory = Path(args.dir).expanduser().resolve() if args.dir else primary_of(args.repo)
    chat = {
        "id": chat_id,
        "name": args.name,
        "name_source": "auto" if args.auto_name else "creator",
        "kind": args.kind,
        "parent": args.parent,
        "feature": args.feature,
        "repo": args.repo,
        "branch": args.branch,
        "base": args.base,
        "dir": str(directory) if directory else None,
        "model": args.model,
        "prompt": args.prompt,
        "agent": args.agent or option("default_agent", "claude"),
        "host": HOST,
        "status": "running",
        "created_at": now(),
    }
    if chat["agent"] not in agents():
        sys.exit(f"unknown agent {chat['agent']!r} (known: {', '.join(agents())})")
    launch(chat, resume=False, wait_rc=False)
    if chat.get("transport") != "sdk":
        chat.pop("prompt", None)
    save(chat, f"chat new: {args.name}")
    after_launch(chat)
    print(f"{chat_id}  {args.name}  {chat['dir']}")


def cmd__sdk_launch(args):
    """For the daemon: ready the chat's folder and print how to run its SDK process as JSON (argv, cwd, env,
    model, mode, effort, and the first prompt, handed over once)."""
    chat = find(args.chat)
    agent = agent_def(chat)
    directory = ensure_worktree(chat, None)
    trust_folder(agent, directory)
    session = session_of(chat)
    t = transcript(chat)
    fork_from = None
    if chat.get("forked_from") and not (t and t.exists()):
        src = load(chat["forked_from"])
        fork_from = session_of(src) if src else None
    template = agent["sdk_fork"] if fork_from else agent["sdk_resume"] if t and t.exists() else agent["sdk_new"]
    mode = chat.get("mode") or agent.get("permission_mode") or option("permission_mode")
    cmd = fill(template, {"bin": agent_bin(agent.get("bin") or chat.get("agent") or "claude"), "id": chat["id"],
                          "session": session, "from": fork_from, "name": chat["name"], "model": chat.get("model"),
                          "mode": mode, "effort": chat.get("effort"), "dir": str(directory),
                          "realdir": os.path.realpath(str(directory))})
    cmd = [str(Path(__file__).parent / "agent-env")] + cmd
    prompt = chat.pop("prompt", None)
    chat["dir"] = str(directory)
    chat["transport"] = "sdk"
    chat["launched_at"] = time.time()
    save(chat, f"chat launch: {chat['name']}")
    print(json.dumps({"id": chat["id"], "argv": cmd, "cwd": str(directory), "env": {}, "prompt": prompt,
                      "model": chat.get("model"), "mode": mode, "effort": chat.get("effort"), "resume": bool(t and t.exists())}))


def cmd__set(args):
    """For the daemon: record fields on a chat (`--json '{"mode": "plan"}'`; null removes one)."""
    chat = find(args.chat)
    for k, v in json.loads(args.json).items():
        if v is None:
            chat.pop(k, None)
        else:
            chat[k] = v
    save(chat, f"chat set: {chat['name']}")


def after_launch(chat):
    """In the background: the Remote Control link, or a new Codex session's id."""
    agent = agent_def(chat)
    if agent.get("remote_control"):
        background("_rc", chat["id"])
    if agent.get("session") == "discovered" and not chat.get("session_id"):
        background("_session", chat["id"])


def cmd_fork(args):
    """A new chat that starts with a copy of this one's conversation, in the same folder."""
    src = find(args.chat)
    if src["host"] != HOST:
        sys.exit(f"{src['name']} lives on {src['host']}; fork it there")
    chat_id = str(uuid.uuid4())
    chat = {k: src.get(k) for k in ("kind", "parent", "feature", "repo", "branch", "base", "dir", "model", "agent")}
    chat.update({"id": chat_id, "name": args.name or f"{src['name']} (fork)", "host": HOST, "status": "running",
                 "name_source": "creator" if args.name else "auto", "created_at": now(), "forked_from": src["id"]})
    chat["kind"] = (option("fork_kinds", {"orchestrator": "feature"}) or {}).get(chat["kind"], chat["kind"])
    if not session_of(src):
        sys.exit(f"{src['name']} has no conversation to fork yet")
    launch(chat, resume=False, wait_rc=False, fork_from=session_of(src))
    save(chat, f"chat fork: {chat['name']}")
    after_launch(chat)
    print(f"{chat_id}  {chat['name']}  {chat['dir']}")


def cmd_list(args):
    chats = all_chats()
    if args.json:
        for c in chats:
            c["alive"] = c["host"] == HOST and tmux_alive(tmux_name(c))
            t = transcript(c)
            c["last_activity"] = (datetime.datetime.fromtimestamp(t.stat().st_mtime, datetime.timezone.utc)
                                  .strftime("%Y-%m-%dT%H:%M:%SZ") if t and t.exists() else None)
        print(json.dumps(chats, indent=2))
        return
    for c in chats:
        if c["status"] == "archived" and not args.all:
            continue
        alive = "up" if c["host"] == HOST and tmux_alive(tmux_name(c)) else "--"
        print(f"{c['id'][:8]}  {alive}  {c['host']:3}  {c['status']:8}  {c['kind']:12}  {c['name']}  [{c.get('branch') or c.get('dir')}]")


def set_status(chat, status):
    if status != "running" and tmux_alive(tmux_name(chat)):
        run(["tmux", "kill-session", "-t", tmux_name(chat)], check=False)
    chat["status"] = status
    save(chat, f"chat {status}: {chat['name']}")


def cmd_stop(args):
    set_status(find(args.chat), "stopped")


def auto_named(chat):
    """Whether the chat's name may follow its agent's own title (`auto_title`): it was never chosen, by you
    (a rename) or whoever made it (`name_source` user or creator). Chats from before name_source qualify
    with the placeholder name (`default_chat_name`) or a name brought from super.engineering. Orchestrators
    (`auto_title_keep`) keep theirs: their title drifts to whichever leg they're on."""
    keep = option("auto_title_keep", {"kinds": ["orchestrator"], "match": r"(?i)ship.feature|orchestrat"}) or {}
    if chat.get("kind") in (keep.get("kinds") or []) or (keep.get("match") and re.search(keep["match"], f"{chat.get('name', '')} {chat.get('dir') or ''}")):
        return False
    source = chat.get("name_source")
    if source:
        return source == "auto"
    return bool(chat.get("imported_from")) or chat.get("name") == option("default_chat_name", "New chat")


def cmd_rename(args):
    chat = find(args.chat)
    if args.auto and not (option("auto_title", True) and auto_named(chat)):
        return
    old, old_source = chat["name"], chat.get("name_source")
    chat["name"], chat["name_source"] = args.name, "auto" if args.auto else "user"
    if (old, old_source) != (args.name, chat["name_source"]):
        save(chat, f"chat {'title' if args.auto else 'rename'}: {old} -> {args.name}")


def cmd_archive(args):
    set_status(find(args.chat), "archived")


def cmd_start(args):
    chat = find(args.chat)
    if chat["host"] != HOST:
        sys.exit(f"{chat['name']} lives on {chat['host']}; move it here first")
    if not tmux_alive(tmux_name(chat)):
        stop_elsewhere(chat)
    launch(chat, resume=True, wait_rc=False)
    chat["status"] = "running"
    save(chat, f"chat start: {chat['name']}")
    after_launch(chat)


def cmd_attach(args):
    os.execvp("tmux", ["tmux", "attach", "-t", tmux_name(find(args.chat))])


def input_line(name, prompt=None):
    """The text in the agent's input box (None when the prompt isn't showing)."""
    prompt = prompt or option("prompt_char", "❯")
    pane = run(["tmux", "capture-pane", "-pt", name], check=False, capture_output=True).stdout or ""
    lines = [l for l in pane.splitlines() if l.strip().startswith(prompt)]
    return lines[-1].strip()[len(prompt):].strip() if lines else None


def cmd_send(args):
    """Type a message into a chat and submit it (a separate Enter, or the TUI treats the burst as a
    paste and doesn't submit). --wait first waits for an empty prompt (a chat that just started or
    resumed drops what's typed while it loads), and Enter is retried while the text still sits there."""
    chat = find(args.chat)
    name = tmux_name(chat)
    prompt = agent_def(chat).get("prompt_char")
    wait = args.wait
    if not tmux_alive(name):
        # A stopped or closed chat on this machine: resume it, then send once its prompt is up.
        if chat["host"] != HOST or not option("send_resumes", True):
            sys.exit(f"{chat['name']} isn't running here" + (f"; it's on the {label(chat['host'])}" if chat["host"] != HOST else ""))
        cmd_start(argparse.Namespace(chat=chat["id"]))
        wait = max(wait, option("send_resume_wait_secs", 90))
    if wait:
        deadline = time.time() + wait
        while time.time() < deadline and input_line(name, prompt) != "":
            time.sleep(1)
    run(["tmux", "send-keys", "-t", name, "-l", args.text])
    time.sleep(option("chat_send_pause_secs", 0.5))
    run(["tmux", "send-keys", "-t", name, "C-m"])
    # A slash command can open a menu that takes a moment to show (/artifacts, /model): a retried Enter
    # would land in it and pick its first entry.
    retries = 0 if args.text.startswith("/") else option("send_enter_tries", 4)
    for _ in range(retries if wait else 0):
        time.sleep(option("send_enter_wait_ms", 350) / 1000)
        line = input_line(name, prompt)
        if not line or not args.text.startswith(line[:20]):
            return
        run(["tmux", "send-keys", "-t", name, "C-m"])



def ssh_to(host):
    """The ssh name that reaches a host (`hosts.HOST.ssh`; the box: the app's ssh_host); exits when none."""
    target = abxcfg.ssh_of(host)
    if not target:
        sys.exit(f"the {label(HOST)} can't reach the {label(host)}: no ssh for it (set daemon.hosts.{host}.ssh)")
    return target


def remote_tool(host, rel):
    """A file of a host's agent-box checkout, for its shell."""
    return f"{abxcfg.remote_path(abxcfg.agent_box_dir(host))}/{rel}"


def endpoint(host, rel):
    """rsync's name for a path under a host's home."""
    return f"{HOME}/{rel}" if host == HOST else f"{ssh_to(host)}:{rel}"


def sh_on(host, script, **kw):
    """Run a shell snippet on a host (in its home)."""
    if host == HOST:
        return run(["bash", "-c", script], check=False, capture_output=True, cwd=str(HOME), **kw)
    return run(ssh(host, script, stdin=kw.get("input") is not None), check=False, capture_output=True, **kw)


def local_end(src, dst):
    if HOST not in (src, dst):
        sys.exit(f"the {label(HOST)} can only copy to or from itself, not {label(src)} -> {label(dst)}")


def snapshot_now():
    """Snapshot the queued worktrees' WIP now; the backup (transcripts, the push) follows in the background,
    since a move sends the WIP straight to the other machine."""
    worker = str(Path(__file__).parent / "sync-worker")
    run([worker, "--snapshot-only"], check=False)
    subprocess.Popen([worker], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def release_all(chats, dirs=()):
    """For a move: stop the chats here (one state push saying they're moving) and snapshot their WIP and
    dirs' (worktrees without chats) at once; returns {id: {dir, real}}."""
    for chat in chats:
        adopt_worktree_branch(chat)
        chat["status"] = "moving"
        save(chat, "", commit=False)
    for chat in chats:
        if tmux_alive(tmux_name(chat)):
            run(["tmux", "kill-session", "-t", tmux_name(chat)], check=False)
    for chat in chats:
        # Turtwig's own process first, so only another program's copy (super.engineering) is left to stop.
        stop_elsewhere(chat)
        if chat.get("branch") and chat.get("dir"):
            queue_snapshot(chat["dir"])
    for d in dirs:
        queue_snapshot(d)
    # The push saying they're moving (before the other machine writes them) goes out while the WIP saves.
    push = threading.Thread(target=commit_now, args=(f"chats moving: {', '.join(c['name'] for c in chats)}",))
    if chats:
        push.start()
    snapshot_now()
    if chats:
        push.join()
    folders = [c["dir"] for c in chats if c.get("branch") and c.get("dir")] + list(dirs)
    return {"chats": {c["id"]: {"dir": c.get("dir"), "real": os.path.realpath(c["dir"]) if c.get("dir") else None} for c in chats},
            "keys": sorted({k for k in map(wip_key, folders) if k})}


def wip_key(folder):
    """Where a worktree's WIP snapshot is filed (env.sh's wip_key): its origin's name, then its branch."""
    origin = run(["git", "-C", folder, "remote", "get-url", "origin"], check=False, capture_output=True).stdout.strip()
    branch = run(["git", "-C", folder, "symbolic-ref", "--quiet", "--short", "HEAD"], check=False, capture_output=True).stdout.strip()
    if not (origin and branch):
        return None
    return f"{os.path.basename(origin.removesuffix('.git'))}/{branch.replace('/', '~')}"


def take_over(chat, directory, commit=True):
    chat["host"] = HOST
    chat["dir"] = str(directory)
    chat["status"] = "running"
    # The Remote Control link takes seconds to show up; `_rc` records it once it does.
    launch(chat, resume=True, wait_rc=False)
    save(chat, f"chat moved to {HOST}: {chat['name']}", wait=True, commit=commit)
    background("_rc", chat["id"])


def prepare_here(chat, frm):
    if chat.get("branch"):
        return ensure_worktree(chat, restore_from=frm)
    return primary_of(chat.get("repo") or default_repo())


def send_wip(src, dst, keys=None):
    """src's WIP snapshots (only `keys`' when given) straight to dst's incoming/<src>/wip, so a move needn't
    wait for them to go through GitLab. Also makes incoming/<src>/claude there, for stage_transcript."""
    local_end(src, dst)
    inc = f".agent-box/incoming/{src}"
    sh_on(dst, f"mkdir -p {inc}/wip {inc}/claude")
    if src != HOST:
        sh_on(src, "mkdir -p .agent-box/sessions/wip")
    only = ["--include", "*/", *[x for k in keys for x in ("--include", f"{k}.json", "--include", f"{k}.bundle")],
            "--exclude", "*"] if keys is not None else []
    out = run([*rsync(), "-a", "--delete", *only, endpoint(src, ".agent-box/sessions/wip/"), endpoint(dst, f"{inc}/wip/")],
              check=False, capture_output=True)
    if out.returncode != 0:
        sys.exit(f"couldn't send the {label(src)}'s work to the {label(dst)}: {out.stderr.strip()}")


def stage_transcript(src, dst, chat_id, src_dir, src_real):
    """Copy a chat's transcript from src to dst's incoming/<src>/claude; `_receive` there files it under
    the folder it gets, so the copy needs no round trip to learn that folder first. Compressed, and
    against the copy the last move left there, so a long chat sends only what's new."""
    chat = load(chat_id)
    if chat and agent_def(chat).get("session") == "discovered":
        return copy_rollouts(src, dst, chat)
    for slug in dict.fromkeys([project_slug(src_real or src_dir), project_slug(src_dir)]):
        run([*rsync(), "-az", "--include", f"{chat_id}.jsonl", "--include", f"{chat_id}/***", "--exclude", "*",
             endpoint(src, f".claude/projects/{slug}/"), endpoint(dst, f".agent-box/incoming/{src}/claude/")],
            check=False, capture_output=True)


def place_transcript(chat_id, directory, frm):
    """File a staged transcript (stage_transcript) under the folder the chat now runs in."""
    chat = load(chat_id)
    if chat and agent_def(chat).get("session") == "discovered":
        return
    stage = AGENT_HOME / "incoming" / frm / "claude"
    main = stage / f"{chat_id}.jsonl"
    if not main.exists() or main.stat().st_size == 0:
        sys.exit(f"the conversation didn't arrive from the {label(frm)}")
    dest = PROJECTS / project_slug(os.path.realpath(str(directory)))
    dest.mkdir(parents=True, exist_ok=True)
    # Copies: the staged ones stay as the base the next move's rsync sends only changes against.
    shutil.copy2(main, dest / main.name)
    sub = stage / chat_id
    if sub.is_dir():
        shutil.copytree(sub, dest / chat_id, dirs_exist_ok=True)


def cmd__transcript_paths(args):
    print(json.dumps([str(p) for p in agent_transcript_paths(find(args.chat))]))


def copy_rollouts(src_host, dst_host, chat):
    """A Codex chat's rollouts (its own, the ones it forked from, its subagents') go to the same place
    under the other machine's home; the chat's own must arrive."""
    local_end(src_host, dst_host)
    paths = json.loads(on_host(src_host, "_transcript_paths", chat["id"]) or "[]")
    if not paths:
        sys.exit(f"no rollout for {chat['name']} on the {label(src_host)}")
    src_home = home_of(src_host)
    rels = [os.path.relpath(p, src_home) for p in paths if p.startswith(src_home + "/")]
    for rel in rels:
        sh_on(dst_host, f"mkdir -p {shlex.quote(os.path.dirname(rel) or '.')}")
        run([*rsync(), "-a", endpoint(src_host, rel), endpoint(dst_host, rel)], check=False, capture_output=True)
    main = rels[0] if rels else None
    if not (main and sh_on(dst_host, f"test -s {shlex.quote(main)}").returncode == 0):
        sys.exit(f"{chat['name']}'s rollout didn't copy to the {label(dst_host)}")
    # Its recorded rollout path belongs to the machine it left; the new one finds it by session id.
    chat.pop("transcript", None)
    save(chat, f"chat rollout copied: {chat['name']}", wait=True)


def adopt_worktree_branch(chat):
    """A chat brought in from super.engineering knows only its folder: when that's a worktree, take its
    repo and branch, so the box makes the same worktree (with the WIP) instead of using its main checkout."""
    d = chat.get("dir")
    if chat.get("branch") or not d or not Path(d).exists():
        return
    common = run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir"], check=False, capture_output=True).stdout.strip()
    own = run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-dir"], check=False, capture_output=True).stdout.strip()
    branch = run(["git", "-C", d, "branch", "--show-current"], check=False, capture_output=True).stdout.strip()
    repo = repo_of(Path(common).parent) if common else None
    if not (repo and branch and common != own):
        return
    chat["repo"], chat["branch"] = repo, branch
    save(chat, f"chat branch: {chat['name']} on {branch}", wait=True)


def sc_on(host, *args, cwd=None):
    """Run the sc shim on a machine (in cwd, for the commands that act on the caller's worktree)."""
    if host == HOST:
        shim = Path(__file__).resolve().parent.parent / "shim" / "sc"
        out = run(["python3", str(shim), *args, "--json"], cwd=cwd or str(HOME), capture_output=True, check=False)
    else:
        remote = (f"cd {shlex.quote(cwd)} && " if cwd else "") + f"python3 {remote_tool(host, 'shim/sc')} " + shlex.join([*args, "--json"])
        out = run(ssh(host, remote), capture_output=True, check=False)
    if out.returncode != 0:
        raise SystemExit(f"sc {' '.join(args)} on the {label(host)}: {(out.stderr or out.stdout).strip()}")
    try:
        return json.loads(out.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {}


def sc_store(host):
    try:
        data = json.loads((STATE_DIR / abxcfg.host(host)["sc_store"]).read_text())
    except (OSError, ValueError):
        data = {}
    data.setdefault("sections", [])
    data.setdefault("worktrees", {})
    return data


def on_host(host, *args):
    """Run this script's command on a machine; returns its stdout."""
    if host == HOST:
        return run([sys.executable, __file__, *args], capture_output=True).stdout
    timing = "ABX_TIMING=1 " if os.environ.get("ABX_TIMING") else ""
    out = run(ssh(host, timing + remote_tool(host, "bin/chat") + " " + shlex.join(args)), check=False, capture_output=True)
    if timing and out.stderr:
        print("\n".join(f"  {label(host)} {l}" for l in out.stderr.splitlines() if l.startswith("[")), file=sys.stderr)
    if out.returncode != 0:
        sys.exit(f"{label(host)}: {out.stderr.strip() or out.stdout.strip()}")
    return out.stdout


def cmd__paths(args):
    """{path: [real path or null when missing, branch (null for a main checkout), repo]} for folders here."""
    out = {}
    for p in args.paths:
        if not os.path.isdir(p):
            out[p] = [None, None, None]
            continue
        branch = run(["git", "-C", p, "branch", "--show-current"], check=False, capture_output=True).stdout.strip() or None
        common = run(["git", "-C", p, "rev-parse", "--path-format=absolute", "--git-common-dir"], check=False, capture_output=True).stdout.strip()
        repo = repo_of(Path(common).parent) if common else None
        if repo and os.path.realpath(str(primary_of(repo))) == os.path.realpath(p):
            branch = None  # a chat in the main checkout uses the other machine's main checkout, no WIP
        out[p] = [os.path.realpath(p), branch, repo]
    print(json.dumps(out))


def cmd__prepare_wt(args):
    """Make (or reuse) the worktree for a branch here with frm's latest WIP; prints its folder."""
    pull_state()
    if args.branch:
        directory = ensure_worktree({"branch": args.branch, "repo": args.repo}, restore_from=args.frm)
    else:
        directory = primary_of(args.repo)
    print(json.dumps({"dir": str(directory)}))


def queue_snapshot(directory):
    queue = AGENT_HOME / "queue"
    queue.mkdir(parents=True, exist_ok=True)
    (queue / f"snap-{hashlib.sha1(directory.encode()).hexdigest()[:10]}").write_text(directory + "\n")


def cmd__snapshot_dir(args):
    queue_snapshot(args.dir)
    snapshot_now()


def move_group(chat, scope):
    """What moves with this chat: (its section or None, [(source folder, branch, repo, [chats])]).
    scope "section": every worktree in the chat's section and every chat in them; "worktree": the chat's
    worktree and all its chats; "chat": the chat alone."""
    src = chat["host"]
    chats = [c for c in all_chats() if c["host"] == src and c["status"] != "archived" and c.get("dir")]
    store = sc_store(src)
    known = sorted({c["dir"] for c in chats} | set(store["worktrees"]))
    if src == HOST and scope != "chat":
        # Resolving every folder takes a git call or two each: here, only the ones that can move along.
        mine = os.path.realpath(chat.get("dir") or "")
        sid = store["worktrees"].get(mine, {}).get("section") if scope == "section" else None
        along = {p for p, m in store["worktrees"].items() if sid and m.get("section") == sid} | {mine}
        known = sorted(p for p in known if os.path.realpath(p) in along)
    info = json.loads(on_host(src, "_paths", *known) or "{}") if known else {}
    real = {p: v[0] for p, v in info.items()}
    here = real.get(chat.get("dir"))
    if scope == "chat" or not here:
        i = info.get(chat.get("dir")) or [None, chat.get("branch"), chat.get("repo")]
        return None, [(chat.get("dir"), chat.get("branch") or i[1], chat.get("repo") or i[2] or default_repo(), [chat])]
    sid = store["worktrees"].get(here, {}).get("section") if scope == "section" else None
    section = next((s for s in store["sections"] if s["section_id"] == sid), None)
    folders = [here]
    if section:
        members = [p for p, m in store["worktrees"].items() if m.get("section") == sid]
        members.sort(key=lambda p: store["worktrees"][p].get("order") if store["worktrees"][p].get("order") is not None else 1e9)
        folders = [real[p] for p in members if real.get(p)] or [here]
    groups = []
    for folder in dict.fromkeys(folders):
        mine = [c for c in chats if real.get(c["dir"]) == folder]
        path = next((p for p, r in real.items() if r == folder), folder)
        _, branch, repo = info.get(path, [None, None, None])
        branch = branch or next((c.get("branch") for c in mine if c.get("branch")), None)
        repo = repo or next((c.get("repo") for c in mine if c.get("repo")), None) or default_repo()
        groups.append((folder, branch, repo, mine))
    return section, groups


def move_batch(groups, src, dst, section=None, labels=None):
    """Move worktrees' chats (or, with none, their WIP) from src to dst all at once: one stop and snapshot
    on src, one copy of the WIP, and one call that makes every worktree on dst (into `section`, with
    `labels`) and starts the chats there. One end is this machine. Returns [(folder, new dir or None,
    error or None)] in the groups' order."""
    local_end(src, dst)
    chats = [c for *_, cs in groups for c in cs]
    status = {c["id"]: c["status"] for c in chats}
    chatless = [f for f, b, _, cs in groups if b and not cs]
    if src == HOST:
        released = release_all(chats, chatless)
    else:
        args = [c["id"] for c in chats] + [x for f in chatless for x in ("--dir", f)]
        released = json.loads(on_host(src, "_release", *args) or "{}")
    send_wip(src, dst, released.get("keys"))
    each(stage_transcript, [(src, dst, c["id"], c.get("dir"), (released.get("chats", {}).get(c["id"]) or {}).get("real")) for c in chats])
    spec = {"from": src, "section": section and {k: section.get(k) for k in ("section_id", "name", "collapsed")},
            "worktrees": [{"folder": f, "repo": r, "branch": b or "", "label": (labels or {}).get(f),
                           "chats": [{"id": c["id"], "stopped": status[c["id"]] == "stopped"} for c in cs]}
                          for f, b, r, cs in groups]}
    if dst == HOST:
        out = receive_all(spec)
    else:
        out = json.loads(on_host(dst, "_receive", json.dumps(spec)))
    return [(w["folder"], w.get("dir"), w.get("error")) for w in out["worktrees"]]


def each(fn, calls):
    """fn(*args) for every args in calls, side by side; returns when all have."""
    threads = [threading.Thread(target=fn, args=a) for a in calls]
    for t in threads:
        t.start()
    for t in threads:
        t.join()


def receive_all(spec):
    """A move's receiving end: the worktrees (into the section first, so each lands in it), each with the
    sender's WIP (send_wip), made side by side; then each chat's staged transcript filed under its folder
    (stage_transcript) and the chats running here, or stopped as they were. One state push for it all."""
    pull_state()
    frm, wts = spec["from"], spec["worktrees"]
    for w in wts:
        w["dir"] = str((checked_out(primary_of(w["repo"]), w["branch"]) or worktree_dir(w)) if w["branch"] else primary_of(w["repo"]))
    if spec.get("section"):
        place = {"section": spec["section"], "worktrees": [{"path": w["dir"], "label": w.get("label")} for w in wts if w["branch"]]}
        shim = Path(__file__).resolve().parent.parent / "shim" / "sc"
        run(["python3", str(shim), "section", "place", json.dumps(place), "--json"], capture_output=True, check=False,
            env={**os.environ, "SC_NO_COMMIT": "1"})
    making, bases = threading.Lock(), {}
    for w in wts:
        if w["branch"] and not Path(w["dir"]).exists():
            primary = primary_of(w["repo"])
            bases[primary] = abxcfg.default_base(primary)

    def prepare(w):
        try:
            if w["branch"]:
                exists = Path(w["dir"]).exists()
                if not exists:
                    fetch_branch(primary_of(w["repo"]), w["branch"])
                    make_worktree(w["repo"], w["branch"], Path(w["dir"]), fetched=True, serial=making)
                wip_restore(Path(w["dir"]), frm, fresh=not exists, incoming=True)
        except (SystemExit, Exception) as err:
            w["error"] = str(err).strip() or type(err).__name__
    each(fetch_branch, list(bases.items()))
    each(prepare, [(w,) for w in wts])
    for w in wts:
        for c in w["chats"] if not w.get("error") else []:
            try:
                place_transcript(c["id"], w["dir"], frm)
                chat = find(c["id"])
                take_over(chat, Path(w["dir"]), commit=False)
                if c.get("stopped"):
                    set_status(chat, "stopped")
            except (SystemExit, Exception) as err:
                w["error"] = str(err).strip() or type(err).__name__
        if w.get("error"):
            w.pop("dir", None)
    arrived = AGENT_HOME / "arrived"
    arrived.mkdir(parents=True, exist_ok=True)
    # Only a move's tidying, minutes later, reads them.
    for old in arrived.iterdir():
        if time.time() - old.stat().st_mtime > 86400:
            old.unlink(missing_ok=True)
    for w in wts:
        if w.get("dir"):
            (arrived / hashlib.sha1(os.path.realpath(w["dir"]).encode()).hexdigest()[:16]).write_text(f"{time.time()}\n")
    commit_now(f"moved to {HOST}: {', '.join(Path(w['folder']).name for w in wts if w.get('dir'))}")
    return {"worktrees": wts}


def cmd__receive(args):
    print(json.dumps(receive_all(json.loads(args.spec))))


def put_back(chats, src):
    """After a failed move: the chats run where they were."""
    for c in chats:
        try:
            if src != HOST:
                on_host(src, "start", c["id"])
            else:
                pull_state()
                cmd_start(argparse.Namespace(chat=c["id"]))
        except (SystemExit, subprocess.CalledProcessError) as err:
            print(f"couldn't restart {c['name']} on the {label(src)}: {err}", file=sys.stderr)


def home_of(host):
    if host == HOST:
        return str(HOME)
    if abxcfg.host(host).get("home"):
        return abxcfg.host(host)["home"]
    return run(ssh(host, "echo $HOME"), capture_output=True).stdout.strip().splitlines()[-1]


REWRITE = r"""
import json, os, sys
roots, pairs = json.loads(sys.stdin.read())
for root in roots:
    for d, _, names in os.walk(os.path.expanduser(root)):
        for n in names:
            p = os.path.join(d, n)
            try:
                if os.path.getsize(p) > 5_000_000:
                    continue
                text = open(p, encoding="utf-8").read()
            except (OSError, UnicodeDecodeError):
                continue
            new = text
            for a, b in pairs:
                new = new.replace(a, b)
            if new != text:
                open(p, "w", encoding="utf-8").write(new)
"""


def sync_files(src, dst, moved):
    """Copy the `move_sync_paths` folders (the factory skills' ledgers) to dst, newer files winning, and
    point the copies at dst's folders: each moved worktree's new path, then `path_aliases`, then dst's home
    for src's."""
    roots = [r for r in option("move_sync_paths", ["~/.local/state/redo/", "~/.factory/", "~/.config/redo/"]) if r]
    if not roots:
        return
    local_end(src, dst)
    homes = {src: home_of(src), dst: home_of(dst)}
    for root in roots:
        rel = root.removeprefix("~/").rstrip("/") + "/"
        if src == HOST and not (HOME / rel).exists():
            continue
        sh_on(dst, f"mkdir -p {shlex.quote(rel)}")
        run([*rsync(), "-a", "--update", endpoint(src, rel), endpoint(dst, rel)], check=False, capture_output=True)
    pairs = sorted(moved.items(), key=lambda kv: -len(kv[0]))
    pairs += [(a + "/", b + "/") for a, b in abxcfg.alias_pairs(src, dst, homes[src], homes[dst])]
    payload = json.dumps([roots, [list(p) for p in pairs if p[0] != p[1]]])
    if dst == HOST:
        run([sys.executable, "-c", REWRITE], input=payload, check=False)
    else:
        sh_on(dst, "python3 -c " + shlex.quote(REWRITE), input=payload)


SAVED_CHECK = r"""
. "$(dirname "$0")/env.sh"
top=$1
key=$(wip_key "$top") || exit 1
head=$(git -C "$top" rev-parse HEAD) || exit 1
idx=$(mktemp)
cp "$(git -C "$top" rev-parse --absolute-git-dir)/index" "$idx" 2> /dev/null || : > "$idx"
GIT_INDEX_FILE=$idx git -C "$top" add -A 2> /dev/null
tree=$(GIT_INDEX_FILE=$idx git -C "$top" write-tree)
rm -f "$idx"
[ "$(jq -r '.head + " " + .tree' "$AGENT_SESSIONS_DIR/wip/$key.json" 2> /dev/null)" = "$head $tree" ]
"""


def saved_remotely(path):
    """Whether everything in the worktree (unpushed commits, uncommitted and untracked files) is in the
    WIP snapshot this machine made last, the one a move sent and the other machine restored."""
    return run(["bash", "-c", SAVED_CHECK, str(Path(__file__).resolve()), path], check=False, capture_output=True).returncode == 0


def cmd__drop_worktree(args):
    """Take a worktree a move left behind off this machine: remove (the folder goes, wt frees its slot;
    the branch and its commits stay) or delete (also its bazel cache and local branch). Main checkouts
    and folders a chat still uses here are left alone."""
    pull_state()
    path = os.path.realpath(args.dir)
    common = run(["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir"], check=False, capture_output=True).stdout.strip()
    repo = repo_of(Path(common).parent) if common else None
    if not repo or os.path.realpath(str(primary_of(repo))) == path:
        print(f"kept {path}: not a worktree of a known repo")
        return
    if any(c["host"] == HOST and c["status"] != "archived" and c.get("dir") and os.path.realpath(c["dir"]) == path for c in all_chats()):
        print(f"kept {path}: a chat here still uses it")
        return
    if not saved_remotely(path):
        print(f"kept {path}: it has work that isn't in the snapshot the other machine got")
        return
    try:
        came = float((AGENT_HOME / "arrived" / hashlib.sha1(path.encode()).hexdigest()[:16]).read_text())
    except (OSError, ValueError):
        came = 0
    if args.since and came > args.since:
        print(f"kept {path}: a later move brought it back")
        return
    branch = run(["git", "-C", path, "branch", "--show-current"], check=False, capture_output=True).stdout.strip()
    primary = str(primary_of(repo))
    tool = abxcfg.worktree_tool(repo)
    values = {"path": path, "branch": branch, "force": "--force"}
    env = abxcfg.tool_env(repo, tool, **values) if tool else None
    listing = abxcfg.tool_argv(repo, tool, "list", **values) if tool else None
    listed = listing and path in run(listing, check=False, capture_output=True, env=env).stdout
    argv = tool and abxcfg.tool_argv(repo, tool, "delete" if args.mode == "delete" else "remove", **values)
    if listed and argv:
        out = run(argv, check=False, capture_output=True, env=env)
    else:
        out = run(["git", "-C", primary, "worktree", "remove", "--force", path], check=False, capture_output=True)
    if out.returncode != 0 or os.path.exists(path):
        sys.exit(f"couldn't remove {path}: {(out.stderr or out.stdout).strip()}")
    if args.mode == "delete" and branch:
        run(["git", "-C", primary, "branch", "-q", "-D", branch], check=False, capture_output=True)
    print(f"{'deleted' if args.mode == 'delete' else 'removed'} {path}{f' and branch {branch}' if args.mode == 'delete' and branch else ''}")


def leave_behind(src, folders):
    """What happens to the worktrees a finished move left on src (move_leftovers): keep, hide (from the
    sidebar; the project menu shows them again), remove or delete (see cmd__drop_worktree)."""
    mode = option("move_leftovers", "hide")
    pull_state()
    in_use = {c["dir"] for c in all_chats() if c["host"] == src and c["status"] != "archived" and c.get("dir")}
    for folder in folders:
        if mode == "hide" and (folder in in_use or os.path.realpath(folder) in {os.path.realpath(d) for d in in_use}):
            continue
        try:
            if mode == "hide":
                run([str(Path(__file__).parent / "abx"), "do", json.dumps({"do": "state.set", "key": f"hidden:{folder}", "value": True})],
                    check=False, capture_output=True, timeout=option("abx_call_secs", 15))
            elif mode in ("remove", "delete"):
                print(on_host(src, "_drop_worktree", folder, mode).strip())
        except (SystemExit, subprocess.CalledProcessError, subprocess.TimeoutExpired) as err:
            print(f"left {folder} on the {label(src)}: {err}", file=sys.stderr)


def move_log(text, tag="chat move"):
    with open(AGENT_HOME / "log" / "agent-box.log", "a") as log:
        for line in str(text).strip().splitlines():
            log.write(f"{datetime.datetime.now(datetime.timezone.utc):%Y-%m-%dT%H:%M:%SZ} [{tag}] {line}\n")


def cmd__leave_behind(args):
    out = subprocess.run([sys.executable, __file__, "_leave_behind_now", args.src, *args.folders], capture_output=True, text=True)
    move_log(out.stdout + out.stderr)


def is_orchestrator(chat):
    """kind in move_note_kinds, or a name or folder matching move_note_match (chats brought in from
    super.engineering are all kind "feature")."""
    pattern = option("move_note_match", r"(?i)ship.feature|orchestrat")
    return chat.get("kind") in option("move_note_kinds", ["orchestrator"]) or bool(
        pattern and re.search(pattern, f"{chat.get('name', '')} {chat.get('dir', '')}"))


def note_moved(chats, src, dst, section, moved, running):
    """Tell the moved orchestrators (move_note_kinds) that were running (ids in `running`) what changed,
    so they pick up where they were."""
    text = option("move_note", "")
    if not text:
        return
    paths = "; ".join(f"{a} -> {b}" for a, b in moved.items() if a != b) or "unchanged"
    text = text.replace("{from}", label(src)).replace("{to}", label(dst)).replace("{section}", section["name"] if section else "").replace("{paths}", paths)
    for c in chats:
        if is_orchestrator(c) and c["id"] in running:
            try:
                on_host(dst, "send", c["id"], text, "--wait", str(option("move_note_wait_secs", 90)))
            except (SystemExit, subprocess.CalledProcessError) as err:
                print(f"couldn't tell {c['name']} about the move: {err}", file=sys.stderr)


def cmd_move(args):
    pull_state()
    chat = find(args.chat)
    src, dst = chat["host"], args.to
    if dst not in abxcfg.hosts():
        sys.exit(f"unknown host {dst!r} (known: {', '.join(abxcfg.hosts())})")
    if src == dst:
        sys.exit(f"{chat['name']} is already on the {label(dst)}")
    if not abxcfg.state_repo_url():
        sys.exit(f"can't move {chat['name']}: {abxcfg.NO_BACKUP}")
    if HOST not in (src, dst):
        # Neither end is here: the source runs it (it reaches the destination or says it can't).
        print(on_host(src, "move", chat["id"], "--to", dst, *(["--scope", args.scope] if args.scope else []),
                      *(["--dry-run"] if args.dry_run else [])), end="")
        return
    ssh_to(dst if src == HOST else src)
    scope = args.scope or option("move_together", "section")
    section, groups = move_group(chat, scope)
    if args.dry_run:
        print(json.dumps({"section": section and section["name"], "from": src, "to": dst, "worktrees": [
            {"folder": f, "branch": b, "repo": r, "chats": [c["name"] for c in cs]} for f, b, r, cs in groups]}, indent=2))
        return
    labels = {f: sc_store(src)["worktrees"].get(f, {}).get("label") for f, *_ in groups}
    every = [c for *_, cs in groups for c in cs]
    started = time.time()
    # Tells the app each row switches machines as its worktree lands, instead of showing on both.
    app_do([{"do": "state.set", "key": "moving", "value": {"to": dst, "branches": [b for _, b, *_ in groups if b], "at": started}}])
    try:
        finish_move(chat, src, dst, section, groups, labels, every, started)
    finally:
        app_do([{"do": "state.set", "key": "moving", "value": None}])


def finish_move(chat, src, dst, section, groups, labels, every, started):
    # Before the move, which marks each chat "moving" as it stops it.
    running = {c["id"] for *_, cs in groups for c in cs if c["status"] == "running"}
    try:
        results = move_batch(groups, src, dst, section, labels)
    except (SystemExit, Exception) as err:
        move_log(f"moving to the {label(dst)} failed: {err}")
        put_back(every, src)
        sys.exit(f"move failed, left on the {label(src)} ({one_line(err)}; agent-box.log)")
    moved = {f: d for f, d, e in results if d}
    failed = [(f, e) for f, d, e in results if not d]
    if failed:
        for f, e in failed:
            move_log(f"moving {f} to the {label(dst)} failed: {e}")
        by_folder = {f: (b, r, cs) for f, b, r, cs in groups}
        put_back([c for f, _ in failed for c in by_folder[f][2]], src)
        # What already moved goes back, so a section never ends up split across machines.
        stuck = []
        if moved:
            pull_state(force=True)
            back = [(d, by_folder[f][0], by_folder[f][1], [find(c["id"]) for c in by_folder[f][2]]) for f, d in moved.items()]
            try:
                stuck = [d for d, nd, e in move_batch(back, dst, src) if not nd]
            except (SystemExit, Exception) as err:
                move_log(f"couldn't move back to the {label(src)}: {err}")
                stuck = list(moved.values())
            if section and any(x["section_id"] == section["section_id"] for x in sc_store(dst)["sections"]):
                sc_on(dst, "section", "delete", section["section_id"])
            if option("move_leftovers", "hide") != "keep":
                background("_leave_behind", dst, *[d for d in moved.values() if d not in stuck])
        f, e = failed[0]
        why = f"{by_folder[f][0] or f}: {one_line(e)}"
        if stuck:
            sys.exit(f"move failed ({why}) and {len(stuck)} worktree(s) couldn't come back, so they're still on the {label(dst)} (agent-box.log)")
        sys.exit(f"move failed, left on the {label(src)} ({why}; agent-box.log)")
    leftovers = [f for f, b, *_ in groups if b and f]
    # Straight away, so the rows switch machines in the sidebar rather than show on both for a while: the
    # moved folders (an earlier move may have hidden them) shown, what's left on src hidden.
    set_hidden(list(moved.values()), False)
    if option("move_leftovers", "hide") != "keep":
        set_hidden(leftovers, True)
    # The chats already run on dst; the rest needn't hold the move up (agent-box.log has the outcome).
    background("_after_move", json.dumps({"at": started, "src": src, "dst": dst, "section": section, "moved": moved, "running": sorted(running),
                                          "chats": [c["id"] for c in every], "leftovers": leftovers}))
    what = f"section {section['name']}" if section else chat["name"]
    print(f"moved {what} to the {label(dst)}: {len(every)} chat(s), {len(groups)} worktree(s)")
    for a, b in moved.items():
        print(f"  {a} -> {b}")


def one_line(err):
    text = str(err).strip()
    return text.splitlines()[0] if text else type(err).__name__


def after_move(spec):
    """A finished move's tidying, in order: take the section off src, copy the factory ledgers, tell the
    orchestrators, then remove or delete what it left on src (move_leftovers; cmd_move hid it already)."""
    src, dst, section, moved = spec["src"], spec["dst"], spec["section"], spec["moved"]
    pull_state()
    chats = [c for c in (load(i) for i in spec["chats"]) if c]
    mode = option("move_leftovers", "hide")
    if section and not option("move_keep_section", False):
        sc_on(src, "section", "delete", section["section_id"])
    if section or any(is_orchestrator(c) for c in chats):
        sync_files(src, dst, moved)
    note_moved(chats, src, dst, section, moved, set(spec["running"]))
    if mode in ("remove", "delete"):
        for folder in spec["leftovers"]:
            try:
                out = on_host(src, "_drop_worktree", folder, mode, "--since", str(spec["at"])).strip()
            except (SystemExit, subprocess.CalledProcessError) as err:
                out = f"kept {folder}: {err}"
            print(out)
            # Kept: shown again; gone: nothing left to hide, and a later move may bring it back.
            set_hidden([folder], False)


def set_hidden(folders, hidden):
    """Hide folders in the app's sidebar (state hidden:PATH), or show them again, in one call."""
    app_do([{"do": "state.set", "key": f"hidden:{f}", "value": hidden or None} for f in folders])


def app_do(actions):
    """Run actions in the app on this machine, if it's running."""
    if not actions:
        return
    try:
        run([str(Path(__file__).parent / "abx"), "do", json.dumps(actions)], check=False, capture_output=True,
            timeout=option("abx_call_secs", 15))
    except subprocess.TimeoutExpired:
        print(f"the app didn't take {json.dumps(actions)[:200]}", file=sys.stderr)


def cmd__after_move(args):
    out = subprocess.run([sys.executable, __file__, "_after_move_now", args.spec], capture_output=True, text=True)
    move_log(out.stdout + out.stderr)


def cmd__release(args):
    """Stop chats here for a move and snapshot their WIP (and each --dir's, for worktrees without chats) in
    one go; prints {id: {dir, real}}."""
    pull_state()
    print(json.dumps(release_all([find(c) for c in args.chats], args.dir or [])))


def cmd__prepare(args):
    pull_state()
    print(json.dumps({"dir": str(prepare_here(find(args.chat), args.frm))}))


def cmd__take(args):
    pull_state()
    take_over(find(args.chat), Path(args.dir))


def cmd_test_local(args):
    """Check a branch out here with another machine's latest WIP, for manual testing; the chat (or
    dispatcher leg) working on it stays where it is. Takes a chat, or --branch for a leg that has no chat
    of its own (its WIP from --from, default the other machine)."""
    if args.branch:
        frm = args.frm or abxcfg.remote_host()
        if not frm:
            sys.exit("no other machine to take the WIP from (--from HOST)")
        chat = {"branch": args.branch, "repo": args.repo or default_repo(), "host": frm}
        on_host(frm, "_snapshot_branch", args.branch)
    else:
        pull_state()
        chat = find(args.chat)
        if not chat.get("branch"):
            sys.exit("this chat has no branch to check out")
        if chat["host"] != HOST:
            on_host(chat["host"], "_snapshot", chat["id"])
    directory = ensure_worktree(chat, restore_from=chat["host"] if chat["host"] != HOST else None)
    print(directory)
    start = stack_argv(chat)
    if start:
        print(f"Start its stack with: {shlex.join(start)}")


def stack_argv(chat):
    """The repo's worktree_tool `start` for the chat's branch, or None."""
    repo = chat.get("repo") or default_repo()
    tool = abxcfg.worktree_tool(repo)
    if not tool or not chat.get("branch"):
        return None
    return abxcfg.tool_argv(repo, tool, "start", branch=chat["branch"], path=str(worktree_dir(chat)))


def cmd__snapshot_branch(args):
    """Snapshot whichever worktree here has this branch checked out."""
    path = None
    for repo in abxcfg.repos():
        checkout = abxcfg.primary(repo)
        if not checkout or not checkout.exists():
            continue
        out = run(["git", "-C", str(checkout), "worktree", "list", "--porcelain"], capture_output=True, check=False).stdout
        for block in out.split("\n\n"):
            lines = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
            if lines.get("branch") == f"refs/heads/{args.branch}":
                path = lines.get("worktree")
    if not path:
        return
    queue = AGENT_HOME / "queue"
    queue.mkdir(parents=True, exist_ok=True)
    (queue / "snap-branch").write_text(path + "\n")
    run([str(Path(__file__).parent / "sync-worker")], check=False)


def cmd__snapshot(args):
    chat = find(args.chat)
    if chat.get("dir"):
        queue = AGENT_HOME / "queue"
        queue.mkdir(parents=True, exist_ok=True)
        (queue / f"snap-{chat['id']}").write_text(chat["dir"] + "\n")
    run([str(Path(__file__).parent / "sync-worker")], check=False)


def cmd_stack_start(args):
    chat = find(args.chat)
    if not abxcfg.host().get("stacks"):
        sys.exit(f"stacks don't run on the {label(HOST)} (daemon.hosts.{HOST}.stacks)")
    argv = stack_argv(chat)
    if not argv:
        sys.exit("this chat has no branch, or its repo's worktree_tool has no `start`")
    tool = abxcfg.worktree_tool(chat.get("repo") or default_repo())
    os.execvpe(argv[0], argv, abxcfg.tool_env(chat.get("repo") or default_repo(), tool, branch=chat["branch"]))


def backup_roots():
    """(agent transcripts_root, backup_dir) for each agent whose transcripts sync-worker backs up."""
    out = {}
    for name, a in agents().items():
        root, dest = a.get("transcripts_root"), a.get("backup_dir")
        if root and dest and a.get("backup", True):
            out.setdefault(abxcfg.expand(root).rstrip("/"), dest)
    return list(out.items())


def cmd__agent(args):
    """The agent's definition, its hooks_file resolved (under $<hooks_home_env> when that's set)."""
    a = dict(agents().get(args.name) or {})
    if a.get("hooks_file"):
        home = os.environ.get(a.get("hooks_home_env") or "")
        a["hooks_file"] = os.path.join(home, os.path.basename(a["hooks_file"])) if home else abxcfg.expand(a["hooks_file"])
    print(json.dumps(a))


def cmd__backup_roots(args):
    for root, dest in backup_roots():
        print(f"{root}\t{dest}")


def cmd__backup_paths(args):
    """root, backup_dir, path under root: the transcripts of the chats that live here (running or moving)."""
    roots = backup_roots()
    for chat in all_chats():
        if chat.get("host", "box") != HOST or chat.get("status") not in ("running", "moving"):
            continue
        for p in agent_transcript_paths(chat):
            for root, dest in roots:
                if str(p).startswith(root + "/"):
                    print(f"{root}\t{dest}\t{os.path.relpath(p, root)}")
                    break


def cmd__wip_list(args):
    """Every host's WIP snapshots on its sessions branch (for one worktree with --path), as JSON."""
    sessions = AGENT_HOME / "sessions"
    want = wip_key(args.path) if args.path else None
    if args.path and not want:
        sys.exit(f"not on a branch with an origin: {args.path}")
    out = []
    for hid in abxcfg.hosts():
        branch = abxcfg.host(hid)["sessions_branch"]
        ref = f"refs/abx/{branch}"
        if run(["git", "-C", str(sessions), "fetch", "-q", "origin", f"+refs/heads/{branch}:{ref}"],
               check=False, capture_output=True).returncode != 0:
            continue
        names = run(["git", "-C", str(sessions), "ls-tree", "-r", "--name-only", ref, "--", "wip/"],
                    check=False, capture_output=True).stdout.split()
        for name in (n for n in names if n.endswith(".json")):
            try:
                meta = json.loads(run(["git", "-C", str(sessions), "show", f"{ref}:{name}"], capture_output=True).stdout)
            except (subprocess.CalledProcessError, ValueError):
                continue
            key = name[len("wip/"):-len(".json")]
            if want and key != want:
                continue
            out.append({**meta, "host": meta.get("host") or hid, "key": key})
    print(json.dumps(out, indent=2))


def wip_key(path):
    """A worktree's WIP key, as env.sh's wip_key: <origin's repo name>/<branch, / as ~>."""
    git = lambda *a: run(["git", "-C", str(path), *a], check=False, capture_output=True).stdout.strip()  # noqa: E731
    branch, origin = git("symbolic-ref", "--quiet", "--short", "HEAD"), git("remote", "get-url", "origin")
    if not branch or not origin:
        return None
    return f"{os.path.basename(origin.removesuffix('.git'))}/{branch.replace('/', '~')}"


def cmd_supervise(args):
    """Keep every running chat on this host alive; runs forever."""
    while True:
        pull_state()
        for chat in all_chats():
            if chat["host"] != HOST or chat["status"] != "running":
                continue
            if agent_def(chat).get("transport") == "sdk" and not tmux_alive(tmux_name(chat)):
                continue  # the daemon keeps SDK chats' processes
            if tmux_alive(tmux_name(chat)):
                if session_of(chat) is None:
                    record_session(chat["id"])
                continue
            try:
                fresh = chat.get("branch") and not worktree_dir(chat).exists()
                t = transcript(chat)
                launch(chat, resume=bool(t and t.exists()), restore_from=HOST if fresh else None)
                save(chat, f"chat relaunch: {chat['name']}")
                print(f"{now()} relaunched {chat['name']}", flush=True)
            except (subprocess.CalledProcessError, SystemExit) as err:
                print(f"{now()} relaunch failed for {chat['name']}: {err}", flush=True)
        time.sleep(args.interval if args.interval is not None else option("supervise_secs", 30))


def main():
    p = argparse.ArgumentParser(prog="chat")
    sub = p.add_subparsers(dest="cmd", required=True)

    n = sub.add_parser("new", help="start a chat")
    n.add_argument("name")
    n.add_argument("--auto-name", action="store_true", help="name is a placeholder: follow the agent's own title")
    n.add_argument("--kind", default="feature", help=f"one of option chat_kinds ({', '.join(chat_kinds())})")
    n.add_argument("--branch", help="run in this branch's worktree (made by the repo's worktree_tool)")
    n.add_argument("--base", help="new branch starts from origin/<base> instead of the default branch")
    n.add_argument("--repo", choices=list(abxcfg.repos()), help="default: the --dir's repo, else option default_repo")
    n.add_argument("--dir", help="no branch: run here (default: the primary checkout)")
    n.add_argument("--parent", help="orchestrator chat id")
    n.add_argument("--feature", help="feature slug for grouping")
    n.add_argument("--model")
    n.add_argument("--agent", help="agent CLI: claude (default: option default_agent), codex, or one in `agents`")
    n.add_argument("--prompt", help="first message")
    n.set_defaults(fn=cmd_new)

    fk = sub.add_parser("fork", help="start a new chat from a copy of this one's conversation")
    fk.add_argument("chat")
    fk.add_argument("--name")
    fk.set_defaults(fn=cmd_fork)

    ls = sub.add_parser("list")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--all", action="store_true")
    ls.set_defaults(fn=cmd_list)

    for name, fn in [("stop", cmd_stop), ("archive", cmd_archive), ("start", cmd_start), ("attach", cmd_attach)]:
        s = sub.add_parser(name)
        s.add_argument("chat", help="id prefix or name")
        s.set_defaults(fn=fn)

    rn = sub.add_parser("rename", help="rename a chat")
    rn.add_argument("chat")
    rn.add_argument("name")
    rn.add_argument("--auto", action="store_true", help="the agent's own title: only for a chat whose name was never chosen")
    rn.set_defaults(fn=cmd_rename)

    se = sub.add_parser("send", help="type a message into a running chat")
    se.add_argument("chat")
    se.add_argument("text")
    se.add_argument("--wait", type=float, default=0, help="first wait up to this many seconds for an empty prompt")
    se.set_defaults(fn=cmd_send)

    mv = sub.add_parser("move", help="move a chat, with its worktree or whole section, to another machine "
                                     "(run where one end can reach the other over ssh)")
    mv.add_argument("chat")
    mv.add_argument("--to", required=True, help=f"a host id ({', '.join(abxcfg.hosts())})")
    mv.add_argument("--scope", choices=["section", "worktree", "chat"], help="what moves with it (default: option move_together)")
    mv.add_argument("--dry-run", action="store_true", help="print what would move")
    mv.set_defaults(fn=cmd_move)

    tl = sub.add_parser("test-local", help="check the chat's branch out here with its WIP")
    tl.add_argument("chat", nargs="?")
    tl.add_argument("--branch", help="a dispatcher leg's branch instead of a chat")
    tl.add_argument("--repo", help="the --branch's repo (default: option default_repo)")
    tl.add_argument("--from", dest="frm", help="the host with the --branch's WIP (default: the other machine)")
    tl.set_defaults(fn=cmd_test_local)

    ss = sub.add_parser("stack-start", help="start the chat branch's local stack (its worktree_tool `start`)")
    ss.add_argument("chat")
    ss.set_defaults(fn=cmd_stack_start)

    h = sub.add_parser("_snapshot")
    h.add_argument("chat")
    h.set_defaults(fn=cmd__snapshot)
    h = sub.add_parser("_release")
    h.add_argument("chats", nargs="*")
    h.add_argument("--dir", action="append")
    h.set_defaults(fn=cmd__release)
    for name, fn in [("_leave_behind", cmd__leave_behind), ("_leave_behind_now", lambda a: leave_behind(a.src, a.folders))]:
        h = sub.add_parser(name)
        h.add_argument("src")
        h.add_argument("folders", nargs="+")
        h.set_defaults(fn=fn)
    for name, fn in [("_after_move", cmd__after_move), ("_after_move_now", lambda a: after_move(json.loads(a.spec)))]:
        h = sub.add_parser(name)
        h.add_argument("spec")
        h.set_defaults(fn=fn)
    h = sub.add_parser("_receive")
    h.add_argument("spec", help="JSON: {from, section?, worktrees: [{folder, repo, branch, label?, chats: [{id, stopped}]}]}")
    h.set_defaults(fn=cmd__receive)
    h = sub.add_parser("_snapshot_branch")
    h.add_argument("branch")
    h.set_defaults(fn=cmd__snapshot_branch)
    h = sub.add_parser("_prepare")
    h.add_argument("chat")
    h.add_argument("frm")
    h.set_defaults(fn=cmd__prepare)
    h = sub.add_parser("_transcript_paths")
    h.add_argument("chat")
    h.set_defaults(fn=cmd__transcript_paths)
    h = sub.add_parser("_drop_worktree")
    h.add_argument("dir")
    h.add_argument("mode", choices=["remove", "delete"])
    h.add_argument("--since", type=float, help="keep it if a move brought it here after this time")
    h.set_defaults(fn=cmd__drop_worktree)
    h = sub.add_parser("_paths")
    h.add_argument("paths", nargs="*")
    h.set_defaults(fn=cmd__paths)
    h = sub.add_parser("_prepare_wt")
    h.add_argument("repo")
    h.add_argument("branch")
    h.add_argument("frm")
    h.set_defaults(fn=cmd__prepare_wt)
    h = sub.add_parser("_snapshot_dir")
    h.add_argument("dir")
    h.set_defaults(fn=cmd__snapshot_dir)
    h = sub.add_parser("_agent", help="an agent's merged definition, as JSON")
    h.add_argument("name")
    h.set_defaults(fn=cmd__agent)
    for name, fn in [("_backup_roots", cmd__backup_roots), ("_backup_paths", cmd__backup_paths)]:
        sub.add_parser(name).set_defaults(fn=fn)
    h = sub.add_parser("_wip_list")
    h.add_argument("--path")
    h.set_defaults(fn=cmd__wip_list)
    h = sub.add_parser("_take")
    h.add_argument("chat")
    h.add_argument("dir")
    h.set_defaults(fn=cmd__take)

    h = sub.add_parser("_commit")
    h.add_argument("message")
    h.set_defaults(fn=cmd__commit)
    h = sub.add_parser("_rc")
    h.add_argument("chat")
    h.set_defaults(fn=cmd__rc)
    h = sub.add_parser("_session", help="record a Codex chat's session id once its rollout exists")
    h.add_argument("chat")
    h.add_argument("--background", action="store_true")
    h.set_defaults(fn=cmd__session)
    h = sub.add_parser("_sdk_launch", help="for the daemon: how to run the chat's SDK process, as JSON")
    h.add_argument("chat")
    h.set_defaults(fn=cmd__sdk_launch)
    h = sub.add_parser("_set", help="for the daemon: record fields on a chat")
    h.add_argument("chat")
    h.add_argument("--json", required=True)
    h.set_defaults(fn=cmd__set)

    sv = sub.add_parser("supervise")
    sv.add_argument("--interval", type=int, default=None)
    sv.set_defaults(fn=cmd_supervise)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
