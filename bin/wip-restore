#!/usr/bin/env bash
# wip-restore [--fresh] <worktree> [--from HOST | HOST]: put another host's latest WIP for
# this branch into a clean worktree: its unpushed commits, plus its
# uncommitted changes left uncommitted. HOST defaults to the other machine
# (when there is just one).
# --fresh: the worktree was just created, so move its branch to the WIP's
# head even when that isn't a fast-forward.
# --wip-dir DIR: read the WIP from DIR (what a move sent here) instead of
# HOST's sessions branch.
set -euo pipefail
. "$(dirname "$0")/env.sh"

fresh=0 from= dir= wip_dir=
while [ $# -gt 0 ]; do
  case "$1" in
    --fresh) fresh=1; shift ;;
    --wip-dir) wip_dir=${2:-}; shift 2 ;;
    --from) from=${2:-}; shift 2 ;;
    *) if [ -z "$dir" ]; then dir=$1; else from=$1; fi; shift ;;
  esac
done
[ -n "$dir" ] || { echo "usage: wip-restore [--fresh] <worktree> [--from HOST]" >&2; exit 2; }
top=$(git -C "$dir" rev-parse --show-toplevel)
if [ -z "$from" ]; then
  others=$(cfg hosts | jq -r --arg me "$AGENT_HOST" 'keys_unsorted[] | select(. != $me)' 2> /dev/null)
  if [ -z "$others" ]; then
    others=$([ "$AGENT_HOST" = box ] && echo mac || echo box)
  fi
  [ "$(printf '%s\n' "$others" | wc -l)" -eq 1 ] || { echo "more than one other host ($(echo $others)); pass --from HOST" >&2; exit 2; }
  from=$others
fi
from_branch=$(cfg host "$from" | jq -r '.sessions_branch // empty' 2> /dev/null)
from_branch=${from_branch:-sessions/$from}
fetch_tries=$(opt wip_fetch_tries); fetch_tries=${fetch_tries:-3}
key=$(wip_key "$top") || { echo "not on a branch with an origin: $top" >&2; exit 1; }

if [ -n "$(git -C "$top" status --porcelain)" ]; then
  echo "worktree has local changes; commit or stash them first: $top" >&2
  exit 1
fi

bundle=$(mktemp)
trap 'rm -f "$bundle"' EXIT
if [ -n "$wip_dir" ]; then
  if ! meta=$(cat "$wip_dir/$key.json" 2> /dev/null); then
    echo "no WIP from $from for $key" >&2
    exit 1
  fi
  cat "$wip_dir/$key.bundle" > "$bundle"
else
  ensure_branch_clone "$AGENT_SESSIONS_DIR" "$SESSIONS_BRANCH"
  git -C "$AGENT_SESSIONS_DIR" fetch -q origin "$from_branch"
  if ! meta=$(git -C "$AGENT_SESSIONS_DIR" show "FETCH_HEAD:wip/$key.json" 2> /dev/null); then
    echo "no WIP from $from for $key" >&2
    exit 1
  fi
  git -C "$AGENT_SESSIONS_DIR" show "FETCH_HEAD:wip/$key.bundle" > "$bundle"
fi

head=$(jq -r .head <<< "$meta")
snap=$(jq -r .snap <<< "$meta")
# The bundle holds what isn't on origin; fetch from origin only when this
# checkout lacks a commit it builds on: the branch and its base first, then
# everything. Other sessions fetch in the same repo and hold ref locks, so
# the full fetch retries.
if ! git -C "$top" fetch -q "$bundle" refs/agent-box/wip 2> /dev/null; then
  branch=$(jq -r .branch <<< "$meta")
  base=$(git -C "$top" symbolic-ref -q --short refs/remotes/origin/HEAD 2> /dev/null | sed 's|^origin/||')
  for b in "$branch" ${base:-main}; do
    git -C "$top" fetch -q origin "+refs/heads/$b:refs/remotes/origin/$b" 2> /dev/null || true
  done
  if ! git -C "$top" fetch -q "$bundle" refs/agent-box/wip 2> /dev/null; then
    for i in $(seq 1 "$fetch_tries"); do
      git -C "$top" fetch -q origin 2> /dev/null && break
      sleep $((i * 3))
    done
    git -C "$top" fetch -q "$bundle" refs/agent-box/wip
  fi
fi

if [ "$(git -C "$top" rev-parse HEAD)" != "$head" ]; then
  # Only refuse when this branch has commits that exist nowhere else: not on
  # origin and not in the WIP. Anything else is safe to move.
  if [ "$fresh" = 0 ] && [ -n "$(git -C "$top" rev-list HEAD --not --remotes=origin "$head" | head -1)" ]; then
    echo "this branch has local commits the $from WIP doesn't; not overwriting them" >&2
    exit 1
  fi
  git -C "$top" reset -q --keep "$head"
fi
git -C "$top" restore --source="$snap" --worktree -- .

echo "restored $key from $from (saved $(jq -r .at <<< "$meta"))"
git -C "$top" status --short | head -20
