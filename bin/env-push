#!/usr/bin/env bash
# Run on the Mac: give the box TJ's personal Claude setup (skills, global
# CLAUDE.md, the redo project's auto memory), and bring back memory the box
# wrote. Files only flow toward the newer copy, so neither side loses edits.
set -euo pipefail
host=${AGENT_BOX_SSH:-coder.tj-agents}
mac_memory="$HOME/.claude/projects/-Users-tj-dev-redo/memory/"
box_memory=".claude/projects/-home-coder-project/memory/"

ssh -n "$host" 'mkdir -p ~/.agents/skills ~/.claude/projects/-home-coder-project/memory
  if [ -d ~/.claude/skills ] && [ ! -L ~/.claude/skills ]; then
    cp -a ~/.claude/skills/. ~/.agents/skills/ && rm -rf ~/.claude/skills
  fi
  [ -L ~/.claude/skills ] || ln -s ../.agents/skills ~/.claude/skills' 2> /dev/null

rsync -au --exclude .git --exclude __pycache__ "$HOME/.agents/skills/" "$host:.agents/skills/"
rsync -au "$HOME/.claude/CLAUDE.md" "$host:.claude/CLAUDE.md"
rsync -au "$mac_memory" "$host:$box_memory"
rsync -au "$host:$box_memory" "$mac_memory"
# The Mac's dispatcher state, read-only for the dashboard. Kept apart from
# the box's own ~/.local/state/redo, where box dispatchers write.
ssh -n "$host" 'mkdir -p ~/.agent-box/mac-state' 2> /dev/null
rsync -a --delete "$HOME/.local/state/redo/ship-feature" "$HOME/.local/state/redo/handoffs" \
  "$HOME/.local/state/redo/designs" "$host:.agent-box/mac-state/"
# Config the factory scripts read (Cursor environments, type-check agents).
ssh -n "$host" 'mkdir -p ~/.config/redo' 2> /dev/null
rsync -au "$HOME/.config/redo/cursor-environments.json" "$HOME/.config/redo/cursor-typecheck-agents.json" \
  "$host:.config/redo/"
# super.engineering's sidebar (worktrees, sections, labels, statuses) for the
# dashboard, until every feature runs on the box.
if command -v sc > /dev/null; then
  "$(dirname "$0")/sc-snapshot" > "$HOME/.agent-box/mac-sidebar.json.tmp" 2> /dev/null \
    && mv "$HOME/.agent-box/mac-sidebar.json.tmp" "$HOME/.agent-box/mac-sidebar.json" \
    && rsync -a "$HOME/.agent-box/mac-sidebar.json" "$host:.agent-box/mac-state/sidebar.json"
fi
echo "env pushed to $host"
