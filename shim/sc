#!/usr/bin/env python3
"""`sc` for the agent box: the subset of super.engineering's CLI the factory
skills use (worktrees, sidebar sections and labels, discussion tabs), backed
by git worktrees, `wt`, and the agent-box state repo instead of the Mac app.

Sections and labels live in ~/.agent-box/state/<this host's sc_store> (sc.json on the
box, sc-mac.json on the Mac); the dashboard shows them. A discussion tab becomes a
Remote Control chat (bin/chat). Repos, their worktree folders and tools come from the
app's `daemon` settings (bin/abxcfg.py).
"""

import fcntl
import hashlib
import json
import os
import subprocess
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "bin"))
import abxcfg  # noqa: E402

HOME = Path.home()
STATE_DIR = HOME / ".agent-box" / "state"
STORE = STATE_DIR / abxcfg.host()["sc_store"]
CHAT = Path(__file__).resolve().parent.parent / "bin" / "chat"
REPOS = {k: p for k in abxcfg.repos() if (p := abxcfg.primary(k))}
WORKSPACE = "box"
# Worktrees a.box (its worktree folders) or a foreign tool (super.engineering) made; any other is "external".
_FOREIGN = [Path(abxcfg.expand(b)) for b in (abxcfg.foreign_tools() or {}).get("managed_bases") or []]
MANAGED_BASES = {repo: [abxcfg.worktrees_base(repo)] + _FOREIGN for repo in REPOS}
BUILT_IN = [
    {"section_id": "pinned", "name": "Pinned", "kind": "manual", "rules": [], "priority": None,
     "collapsed": False, "built_in": True},
    {"section_id": "__projects__", "name": "Projects", "kind": "projects", "rules": [], "priority": None,
     "collapsed": False, "built_in": True},
]


def die(msg, code=1):
    print(json.dumps({"kind": "error", "error": msg}) if "--json" in sys.argv else msg, file=sys.stderr)
    sys.exit(code)


def git(*args, cwd=None, check=False):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        die(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r


def real(p):
    return os.path.realpath(str(p))


class Store:
    """sc.json under an exclusive lock; committed to the state branch on save."""

    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.lock = open(HOME / ".agent-box" / "sc.lock", "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.data = json.loads(STORE.read_text()) if STORE.exists() else {}
        self.data.setdefault("sections", [])
        self.data.setdefault("worktrees", {})
        self.dirty = False
        return self

    def wt(self, path):
        return self.data["worktrees"].setdefault(real(path), {})

    def save(self, message):
        self.dirty = True
        self.message = message

    def __exit__(self, *exc):
        if self.dirty and not exc[0]:
            STORE.write_text(json.dumps(self.data, indent=2) + "\n")
            branch = abxcfg.state_branch()
            git("add", STORE.name, cwd=STATE_DIR)
        # SC_NO_COMMIT: the caller (a move) commits it with its own state writes.
        if self.dirty and not exc[0] and not os.environ.get("SC_NO_COMMIT"):
            git("commit", "-q", "-m", f"sc: {self.message}", cwd=STATE_DIR)
            git("pull", "-q", "--rebase", "--autostash", "origin", branch, cwd=STATE_DIR)
            git("push", "-q", "origin", f"HEAD:{branch}", cwd=STATE_DIR)
        fcntl.flock(self.lock, fcntl.LOCK_UN)


def item_id(path, primary):
    return f"primary:{real(path)}" if primary else "wt:" + hashlib.sha1(real(path).encode()).hexdigest()[:12]


def worktrees(repo):
    """[(path, branch, is_primary)] from `git worktree list` of the repo's checkout."""
    checkout = REPOS[repo]
    if not checkout.exists():
        return []
    out = git("worktree", "list", "--porcelain", cwd=checkout).stdout
    result, path, branch = [], None, None
    for line in out.splitlines() + [""]:
        if line.startswith("worktree "):
            path = line[9:]
        elif line.startswith("branch "):
            branch = line[7:].removeprefix("refs/heads/")
        elif not line and path:
            result.append((path, branch, real(path) == real(checkout)))
            path, branch = None, None
    return result


def items(store):
    out = []
    for repo in REPOS:
        for path, branch, primary in worktrees(repo):
            meta = store.data["worktrees"].get(real(path), {})
            out.append({
                "id": item_id(path, primary), "project_id": repo, "project_name": REPOS[repo].name,
                "worktree": "main" if primary else Path(path).name,
                "title": meta.get("label") or branch or Path(path).name,
                "path": path, "branch": branch, "is_primary": primary, "selected": False, "visible": True,
                "agent_status": "idle", "attention": None, "pr": None, "local": {},
                "section": meta.get("section"),
                "order": meta.get("order"),
                "target_branch": meta.get("target_branch"),
                "external": not primary and not any(real(path).startswith(real(b) + os.sep) for b in MANAGED_BASES[repo]),
            })
    rank = {name: i for i, name in enumerate(store.data.get("project_order", []))}
    repo_rank = {repo: rank.get(repo, len(rank) + i) for i, repo in enumerate(REPOS)}
    out.sort(key=lambda it: (repo_rank[it["project_id"]] if not it["section"] else 0,
                             it["order"] if it["order"] is not None else (-1 if it["is_primary"] else 1e9),
                             it["title"]))
    return out


def find_item(store, ident):
    for it in items(store):
        if ident in (it["id"], it["path"], real(it["path"])):
            return it
    die(f"no worktree {ident!r}")


def caller_worktree():
    path = os.environ.get("SUPER_ENGINEERING_WORKTREE_PATH") or os.getcwd()
    top = git("rev-parse", "--show-toplevel", cwd=path).stdout.strip()
    if not top:
        die(f"not inside a worktree: {path}")
    return top


def out(kind, response):
    print(json.dumps({"kind": kind, "response": response}))


def flag(args, name, default=None):
    if name in args:
        i = args.index(name)
        return args[i + 1] if i + 1 < len(args) else default
    return default


def workspace_list(args):
    with Store() as s:
        its = items(s)
        secs = [{"id": "__projects__", "kind": "projects", "name": None,
                 "items": [i for i in its if not i["section"]]}]
        for sec in s.data["sections"]:
            secs.append({"id": sec["section_id"], "kind": "worktrees", "name": sec["name"],
                         "items": [i for i in its if i["section"] == sec["section_id"]]})
    out("workspaces", {"workspaces": [{"id": WORKSPACE, "title": "a.box", "selected": True, "sections": secs}]})


def section_cmd(args):
    sub = args[0] if args else ""
    with Store() as s:
        secs = s.data["sections"]
        by = lambda key: next((x for x in secs if key in (x["section_id"], x["name"])), None)  # noqa: E731
        if sub == "list":
            print(json.dumps({"kind": "sections", "sections": BUILT_IN + secs}))
        elif sub == "create":
            name = args[1]
            if by(name):
                die(f"section {name!r} exists")
            sec = {"section_id": str(uuid.uuid4()), "name": name, "kind": "manual", "rules": [],
                   "priority": None, "collapsed": False, "built_in": False}
            secs.append(sec)
            s.save(f"section create {name}")
            out("section", sec)
        elif sub == "edit":
            sec = by(args[1]) or die(f"no section {args[1]!r}")
            if "--manual" in args:
                sec["kind"] = "manual"
            if flag(args, "--name"):
                sec["name"] = flag(args, "--name")
            if flag(args, "--collapsed") is not None:
                sec["collapsed"] = flag(args, "--collapsed").lower() in ("1", "true", "yes", "on")
            s.save(f"section edit {sec['name']}")
            out("section", sec)
        elif sub == "move":
            sec = by(args[1]) or die(f"no section {args[1]!r}")
            secs.remove(sec)
            secs.insert(max(0, min(int(flag(args, "--index", len(secs))), len(secs))), sec)
            s.save(f"section move {sec['name']}")
            out("section", sec)
        elif sub == "delete":
            sec = by(args[1]) or die(f"no section {args[1]!r}")
            secs.remove(sec)
            for meta in s.data["worktrees"].values():
                if meta.get("section") == sec["section_id"]:
                    meta.pop("section")
            s.save(f"section delete {sec['name']}")
            out("section_deleted", {"section_id": sec["section_id"]})
        elif sub == "place":
            # For a move: the section (made with the same id when this machine has none by its name) holding
            # these worktrees first, in order, with their labels.
            spec = json.loads(args[1])
            want = spec["section"]
            sec = by(want["section_id"]) or by(want["name"])
            created = sec is None
            if created:
                sec = {"section_id": want["section_id"], "name": want["name"], "kind": "manual", "rules": [],
                       "priority": None, "collapsed": bool(want.get("collapsed")), "built_in": False}
                secs.append(sec)
            placed = [real(w["path"]) for w in spec["worktrees"]]
            rest = sorted((p for p, m in s.data["worktrees"].items() if m.get("section") == sec["section_id"] and p not in placed),
                          key=lambda p: s.data["worktrees"][p].get("order") if s.data["worktrees"][p].get("order") is not None else 1e9)
            for n, path in enumerate(placed + rest):
                s.wt(path).update(section=sec["section_id"], order=n)
            for w in spec["worktrees"]:
                if w.get("label"):
                    s.wt(w["path"])["label"] = w["label"]
            s.save(f"section place {sec['name']}")
            out("section_placed", {"section_id": sec["section_id"], "created": created})
        elif sub in ("assign", "unassign"):
            path = caller_worktree()
            if sub == "assign":
                sec = by(args[1]) or die(f"no section {args[1]!r}")
                s.wt(path)["section"] = sec["section_id"]
            else:
                s.wt(path).pop("section", None)
            s.save(f"section {sub} {Path(path).name}")
            out("section_assignment", {"path": path, "section": s.wt(path).get("section")})
        else:
            die(f"sc section {sub}: not supported on the agent box")


def worktree_cmd(args):
    sub = args[0] if args else ""
    if sub == "create":
        return worktree_create(args[1:])
    with Store() as s:
        if sub == "status":
            path = caller_worktree()
            branch = git("branch", "--show-current", cwd=path).stdout.strip()
            stat = git("diff", "--shortstat", "HEAD", cwd=path).stdout
            changed = int(stat.split()[0]) if stat.strip() else 0
            target = s.data["worktrees"].get(real(path), {}).get("target_branch") or abxcfg.default_base(path)
            out("worktree_status", {"branch": branch, "target_branch": target,
                                    "files_changed": changed, "insertions": 0, "deletions": 0})
        elif sub == "rename-branch":
            path = caller_worktree()
            git("branch", "-m", args[1], cwd=path, check=True)
            out("worktree_branch", {"branch": args[1]})
        elif sub == "set-target-branch":
            path = caller_worktree() if len(args) < 3 else find_item(s, args[2])["path"]
            s.wt(path)["target_branch"] = args[1]
            s.save(f"target {Path(path).name} -> {args[1]}")
            out("worktree_target_branch", {"target_branch": args[1]})
        elif sub == "set-label":
            it = find_item(s, args[1])
            s.wt(it["path"])["label"] = args[2]
            s.save(f"label {it['worktree']}: {args[2]}")
            out("worktree_label", {"id": it["id"], "label": args[2]})
        elif sub == "move":
            it = find_item(s, args[1])
            target = flag(args, "--section")
            target = None if target in (None, "none", "") else target
            if target and not any(x["section_id"] == target for x in s.data["sections"]):
                die(f"no section {target!r}")
            group = [x for x in items(s) if x["section"] == target and x["path"] != it["path"]
                     and (target or x["project_id"] == it["project_id"])]
            before = flag(args, "--before")
            ix = next((i for i, x in enumerate(group) if before and before in (x["id"], x["path"])), None)
            if ix is None:
                ix = max(0, min(int(flag(args, "--index", len(group))), len(group)))
            group.insert(ix, it)
            for n, x in enumerate(group):
                s.wt(x["path"])["order"] = n
            if target:
                s.wt(it["path"])["section"] = target
            else:
                s.wt(it["path"]).pop("section", None)
            s.save(f"move {it['worktree']}")
            out("worktree_moved", {"id": it["id"], "section": target, "index": ix})
        elif sub == "delete":
            it = find_item(s, args[1])
            if it["is_primary"]:
                die("refusing to delete a primary checkout")
            if git("status", "--porcelain", cwd=it["path"]).stdout.strip() and "--force" not in args:
                die(f"{it['path']} has uncommitted changes")
            tool = abxcfg.worktree_tool(it["project_id"])
            values = {"path": it["path"], "branch": it["branch"] or "", "force": "--force" if "--force" in args else ""}
            argv = tool and it["branch"] and abxcfg.tool_argv(it["project_id"], tool, "remove", **values)
            if argv:
                r = subprocess.run(argv, capture_output=True, text=True, cwd=REPOS[it["project_id"]],
                                   env=abxcfg.tool_env(it["project_id"], tool, **values))
            else:
                r = subprocess.run(["git", "worktree", "remove", it["path"]] + (["--force"] if "--force" in args else []),
                                   cwd=REPOS[it["project_id"]], capture_output=True, text=True)
            if r.returncode:
                die(r.stderr.strip() or "delete failed")
            s.data["worktrees"].pop(real(it["path"]), None)
            s.save(f"delete {it['worktree']}")
            out("worktree_deleted", {"id": it["id"], "path": it["path"]})
        else:
            die(f"sc worktree {sub}: not supported on the agent box")


def worktree_create(args):
    repo = flag(args, "--project") or abxcfg.default_repo()
    if repo not in REPOS:
        repo = abxcfg.repo_for_folder(repo)
    if repo not in REPOS:
        die(f"unknown project {repo!r} (projects here: {', '.join(REPOS)})")
    if "--prompt" in args or "--stdin" in args or "--from-file" in args:
        die("sc worktree create --prompt isn't supported on the agent box; use `chat new --branch`")
    name = flag(args, "--worktree-name") or abxcfg.subst(abxcfg.option("worktree_name", "sc-{hex6}"),
                                                         {"hex6": uuid.uuid4().hex[:6], "repo": repo})
    branch = flag(args, "--existing-branch") or flag(args, "--branch") or name
    checkout = REPOS[repo]
    git("fetch", "-q", "origin", cwd=checkout)
    path = abxcfg.worktree_path(repo, branch, name)
    tool = abxcfg.worktree_tool(repo)
    exists = git("rev-parse", "-q", "--verify", f"refs/heads/{branch}", cwd=checkout).returncode == 0
    on_origin = git("rev-parse", "-q", "--verify", f"refs/remotes/origin/{branch}", cwd=checkout).returncode == 0
    base = flag(args, "--base") or abxcfg.default_base(checkout)
    if tool and tool.get("create"):
        if not exists and not on_origin and flag(args, "--base"):
            git("branch", "-q", "--no-track", branch, f"origin/{base}", cwd=checkout, check=True)
        values = {"branch": branch, "path": str(path), "name": name}
        r = subprocess.run(abxcfg.tool_argv(repo, tool, "create", **values), capture_output=True, text=True,
                           cwd=checkout, env=abxcfg.tool_env(repo, tool, **values))
        if not path.exists():
            die(r.stderr.strip() or f"{tool['bin']} failed")
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        cmd = ["worktree", "add", str(path)]
        cmd += [branch] if exists or on_origin else ["-b", branch, f"origin/{base}"]
        git(*cmd, cwd=checkout, check=True)
    resp = {"id": item_id(path, False), "path": str(path), "branch": branch, "worktree": path.name,
            "project_id": repo, "workspace_id": WORKSPACE}
    print(json.dumps({"kind": "worktree_created", "response": resp, **resp}))


def project_cmd(args):
    sub = args[0] if args else ""
    if sub != "move" or len(args) < 2 or args[1] not in REPOS:
        die(f"usage: sc project move {'|'.join(REPOS)} --index N")
    with Store() as s:
        order = [r for r in s.data.get("project_order", []) if r in REPOS]
        order += [r for r in REPOS if r not in order]
        order.remove(args[1])
        order.insert(max(0, min(int(flag(args, "--index", len(order))), len(order))), args[1])
        s.data["project_order"] = order
        s.save(f"project move {args[1]}")
        out("project_order", {"order": order})


def layout_cmd(args):
    sub = args[0] if args else ""
    if sub == "capabilities":
        out("layout_capabilities", {"kind": "layout_capabilities", "team_runs": False,
                                    "layout_orchestration": {"run": ["tabs"]},
                                    "providers": [{"key": "claude", "available": True}]})
    elif sub == "run" and len(args) > 1 and args[1] == "tabs":
        label = flag(args, "--label") or "discussion"
        prompt = flag(args, "--prompt") or flag(args, "--initial-message")
        if flag(args, "--from-file"):
            prompt = Path(flag(args, "--from-file")).read_text()
        cmd = [str(CHAT), "new", label, "--kind", "primary", "--dir", flag(args, "--worktree") or caller_worktree()]
        if prompt:
            cmd += ["--prompt", prompt]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode:
            die(r.stderr.strip() or "chat new failed")
        out("layout_run", {"ok": True, "label": label, "chat": r.stdout.split()[0] if r.stdout else None})
    else:
        die(f"sc layout {sub}: not supported on the agent box (only `run tabs` and `capabilities`)")


INSTRUCTIONS = """On the agent box, `sc` is a compatibility shim over git worktrees, each repo's
worktree tool, and the agent-box registry; there is no super.engineering app here. Supported:
  sc workspace list --json
  sc section list|create NAME --manual|edit SECTION [--manual] [--name N] [--collapsed true|false]
             |assign SECTION|unassign|delete SECTION [--json]
  sc worktree create --workspace box --project {repos} [--worktree-name N]
                     [--branch B | --existing-branch B] [--base B] [--background] --json
  sc worktree status|rename-branch NEW|set-target-branch B [ITEM_ID] [--json]   (act on the caller's
                     worktree; SUPER_ENGINEERING_WORKTREE_PATH overrides, as in the app)
  sc worktree set-label ITEM_ID LABEL|delete ITEM_ID [--force] [--json]
  sc worktree move ITEM_ID [--section SECTION|none] [--before ITEM_ID | --index N] [--json]
  sc section move SECTION --index N [--json]
  sc project move {repos} --index N [--json]
  sc layout run tabs --label L [--prompt TEXT] [--worktree PATH]   (starts a Remote Control chat you
                     see on the dashboard and phone)
  sc layout capabilities --output json
Everything else (`sc chat`, `sc agent`, other layout commands, reviews, browser) is unavailable.
Worktrees are made with each repo's worktree_tool (redo: `wt --no-start`), or `git worktree add`.""".replace(
    "{repos}", "|".join(REPOS))


def main():
    args = sys.argv[1:]
    if not args:
        die(INSTRUCTIONS, 2)
    cmd, rest = args[0], args[1:]
    if cmd == "instructions":
        print(INSTRUCTIONS)
    elif cmd == "workspace" and rest[:1] == ["list"]:
        workspace_list(rest)
    elif cmd == "section":
        section_cmd(rest)
    elif cmd == "worktree":
        worktree_cmd(rest)
    elif cmd == "project":
        project_cmd(rest)
    elif cmd == "layout":
        layout_cmd(rest)
    else:
        die(f"sc {cmd}: not supported on the agent box. {INSTRUCTIONS}")


if __name__ == "__main__":
    main()
