// Built-in defaults: super.engineering's layout, written in the same settings language you use.
// Override any part in your settings file; SETTINGS.md (next to it) documents every key.
{
  "connection": {
    "ssh_host": "coder.tj-agents",
    "daemon": "~/agent-box/rust/target/release/agent-boxd",
    "retry_seconds": 3,
    // Extra ssh arguments for the box connection.
    "ssh_options": ["-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"],
    // How often skills, CLAUDE.md, memory and hooks are copied to the box (bin/env-push); 0 turns it off.
    "env_push_seconds": 60
  },

  // This Mac: its worktrees, sections, and chats (super.engineering's, in place), through a local
  // agent-boxd. Chats here run on the Mac; the sidebar marks them with the mac host icon.
  "local": {
    "enabled": true,
    "daemon": "~/dev/agent-box/rust/target/release/agent-boxd"
  },

  "theme": {
    // Named shadows for `shadow` styles, beside the built-in sm/md/lg/xl: {color, x, y, blur, spread, inset} or a list.
    "shadows": {},
    // Right-click menu checkbox icons.
    "menu_check_icon": "square-check",
    "menu_uncheck_icon": "square",
    "animations": true,
    "font_ui": ".SystemUIFont",
    "font_mono": "Menlo",
    "window": "#212122",
    "card": "#1e1e1f",
    "line": "#323235",
    "text": "#f5f5f7",
    "text_muted": "#898a8e",
    "text_faint": "#6c6c70",
    "age": "#a8a8ad",
    "accent": "#488efc",
    "hover": "#28282b",
    "selection": "#272c35",
    "selection_border": "#485262",
    "pill": "#262626",
    "pill_hover": "#2e2e2e",
    "user_bubble": "#2c2c2e",
    "code_bg": "#171717",
    "composer": "#212121",
    "waiting_bg": "#2a2212",
    "claude": "#d97757",
    "tab_border": "#3b4350",
    "tab_bg": "#22262e",
    "diff_add": "#3fb950",
    "diff_del": "#e5534b",
    "diff_add_bg": "#1b2e21",
    "diff_del_bg": "#351d22",
    "diff_hunk_bg": "#21252c",
    "diff_file_bg": "#29292b",
    "warning": "#f0a43a",
    "danger": "#d8566c",
    "merged": "#8b5cf6",
    "success": "#3fb950",
    "drag_preview": { "padding": [5, 10], "radius": 8, "background": "#2b2f38", "border": 1, "border_color": "#488efc", "color": "#f5f5f7", "font_size": 13, "shadow": "lg", "opacity": 0.95 }
  },

  // The logo: `logo` nodes, the Dock icon while the app runs, and the bundle icon (see SETTINGS.md, Logo).
  // art: SVG markup, or an .svg or image (png/jpg/webp) path. ink: an SVG's currentColor, and with
  // tint, the color an image is redrawn in (its transparency kept). tile: the rounded square behind it.
  "logo": {
    "art": "logo.png",
    "ink": "#111111",
    "tint": true,
    "tile": "#ffffff",
    "corner": 0.225,
    "padding": 0,
    "dock": { "margin": 0.098 }
  },

  // How things move. move: nodes glide to new positions after a change (give a node an `id` so it
  // glides even when moved to a different parent). enter: how nodes that appear after a change come
  // in. style: colors and sizes ease. Set "enabled": false to turn all motion off.
  "motion": {
    "enabled": true,
    // easing: "spring" | "ease_out" | "ease_out_quart" | "linear"; spring shape {c1, c3}.
    "move": { "duration": 320, "easing": "spring", "spring": { "c1": 1.2, "c3": 2.2 } },
    "enter": { "from": { "opacity": 0, "y": 8 }, "duration": 260, "easing": "ease_out_quart" },
    "style": { "duration": 180, "easing": "ease_out" },
    // Spinners: an icon name (null: the built-in loader) and one turn's length; `spin` icons turn at spin_period_ms.
    "spinner": { "icon": null, "period_ms": 800 },
    "spin_period_ms": 900,
    // How often spinners and pulsing lines redraw (each redraw repaints the window). 0 holds them still.
    "animation_fps": 30
  },

  "state": {
    "designer_open": false,
    "designer_width": 420,
    "sidebar_open": true,
    "terminal_open": true,
    "sidebar_width": 339,
    "terminal_height": 300,
    "bottom_tab": "terminal",
    "diff_base": "uncommitted",
    // Sidebar rows: "worktrees" (one row per worktree; its chats are tabs) or "chats" (each worktree's
    // chats listed under its row too).
    "sidebar_rows": "worktrees",
    // Projects: "merged" lists each repo once with every machine's worktrees (each marked with its
    // machine); "by_host" gives each machine its own copy of the project.
    "sidebar_projects": "merged",
    // Worktree order in each project and section: "manual" (as you drag them) or "recent" (newest
    // activity first). Dragging a worktree while sorted by recent switches to manual, with a notice.
    "sidebar_order": "manual",
    // Where the worktree's changes show: "bottom" (a tab beside the terminals) or "right" (a panel).
    "changes_place": "bottom",
    "changes_width": 560
  },

  "views": {
    "main": {
      "type": "row",
      "style": { "width": "full", "height": "full", "position": "relative" },
      "children": [
        { "type": "Sidebar", "id": "sidebar", "if": ".state.sidebar_open" },
        { "type": "MainArea", "id": "main-area", "style": { "grow": 1 } },
        { "type": "ChangesPanel", "id": "changes-panel", "if": ".state.changes_place == \"right\" and .selected.worktree" },
        { "type": "DesignerPanel", "id": "designer", "if": ".state.designer_open" },
        { "type": "Confirm", "id": "confirm" }
      ]
    }
  },

  "components": {
    "Sidebar": {
      "about": "The left column: projects, sections, worktree rows, footer buttons. Resizable (state.sidebar_width).",
      "type": "stack",
      "style": { "width": "{{ .state.sidebar_width }}", "height": "full", "shrink": 0, "background": "@window" },
      "animate": { "from": { "opacity": 0, "x": -16 }, "duration": 180 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "id": "sidebar-header",
              "type": "row",
              "style": { "height": 44, "shrink": 0, "padding": [0, 0, 0, 88], "align": "center" },
              "children": [
                { "type": "IconButton", "id": "sidebar-toggle", "props": { "icon": "panel-left", "tooltip": "Hide sidebar  ⌘\\", "do": { "do": "state.toggle", "key": "sidebar_open" } } },
                { "type": "DesignerButton", "id": "designer-button" },
                { "id": "sidebar-drag", "type": "spacer", "style": { "height": "full" }, "on": { "mouse_down": "window.move", "double_click": "window.zoom" } }
              ]
            },
            {
              "id": "sidebar-list",
              "type": "scroll",
              "props": { "virtual": true },
              "style": { "grow": 1, "min_height": 0, "padding": [0, 6, 10, 6] },
              "children": [
                {
                  "id": "brand",
                  "type": "row",
                  "style": { "height": 34, "padding": [4, 8, 0, 6], "gap": 8, "align": "center" },
                  "children": [
                    { "id": "brand-logo", "type": "logo", "props": { "size": 24 } },
                    { "id": "brand-name", "type": "text", "props": { "text": "a.box" }, "style": { "font_size": 15, "font_weight": "semibold" } }
                  ]
                },
                {
                  "id": "projects-label",
                  "type": "SectionLabel",
                  "props": { "text": "Projects", "collapsed": "{{ .state[\"collapsed:projects\"] // false }}" },
                  "style": { "cursor": "pointer", "radius": 6 },
                  "tooltip": "{{ if .state[\"collapsed:projects\"] then \"Show\" else \"Hide\" end }} projects",
                  "on": { "click": { "do": "state.toggle", "key": "collapsed:projects" } },
                  "menu": [
                    { "label": "Sort by recent activity", "checked": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
                    { "label": "Sort manually", "checked": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
                    { "separator": true },
                    { "label": "{{ if .state[\"collapsed:projects\"] then \"Show\" else \"Hide\" end }} projects", "do": { "do": "state.toggle", "key": "collapsed:projects" } }
                  ]
                },
                {
                  "if": ".state[\"collapsed:projects\"] | not",
                  "for": ".app.drag as $d | .projects | map(select((($d.kind == \"project\" and $d.value == .repo) | not)))", "as": "p", "key": ".p.name",
                  "id": "project-card",
                  "type": "column",
                  "children": [
                    {
                      "id": "project-row",
                      "type": "row",
                      "style": {
                        "position": "relative", "height": 37, "padding": [0, 8], "gap": 8, "align": "center", "radius": 8, "border": 1,
                        "border_color": "{{ if (.app.drop.key == (\"proj:\" + .p.repo) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"proj:\" + .p.repo) then \"@accent\" else \"transparent\" end }}",
                        "background": "{{ if (.app.drop.key == (\"proj:\" + .p.repo) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"proj:\" + .p.repo) then \"#488efc1a\" else \"transparent\" end }}",
                        "cursor": "pointer"
                      },
                      "drag": { "kind": "project", "value": "{{ .p.repo }}", "label": "{{ .p.name }}" },
                      "tooltip": "{{ if .state[\"collapsed:proj:\" + .p.repo] then \"Show\" else \"Hide\" end }} {{ .p.name }}'s worktrees",
                      "drop_key": "proj:{{ .p.repo }}",
                      "drop_zones": { "worktree": "inside", "project": "edges" },
                      "menu": [
                        { "label": "Rename Project", "icon": "pencil", "do": { "do": "prompt", "title": "Rename project", "value": "{{ .p.name }}", "then": { "do": "state.set", "key": "project_name:{{ .p.repo }}", "value": "{{ .input }}" } } },
                        { "label": "Project settings", "icon": "settings", "do": { "do": "project.settings", "repo": "{{ .p.repo }}" } },
                        { "if": ".p.primary_path", "label": "View on GitLab", "icon": "gitlab", "do": { "do": "project.open_remote", "path": "{{ .p.primary_path }}" } },
                        { "separator": true },
                        { "label": "Show external worktrees", "checked": ".p.show_external", "do": { "do": "state.toggle", "key": "hide_external:{{ .p.repo }}" } },
                        { "label": "Show primary worktree", "checked": ".p.show_primary", "do": { "do": "state.toggle", "key": "hide_primary:{{ .p.repo }}" } },
                        { "if": ".p.hidden_count > 0", "label": "Show {{ .p.hidden_count }} hidden worktree{{ if .p.hidden_count == 1 then \"\" else \"s\" end }}", "icon": "eye", "do": { "do": "project.unhide", "repo": "{{ .p.repo }}" } },
                        { "label": "New worktree from…", "icon": "git-branch", "shortcut": "⌘⇧N", "do": { "do": "worktree.new", "repo": "{{ .p.repo }}", "host": "{{ .p.primary_host // .p.host }}" } },
                        { "separator": true },
                        { "label": "Remove Project", "icon": "trash", "danger": true, "do": { "do": "confirm", "title": "Remove {{ .p.name }} from the sidebar?", "text": "Its worktrees and chats stay on disk. Bring it back from the command palette (Restore removed projects).", "confirm": "Remove", "then": { "do": "state.set", "key": "removed_project:{{ .p.repo }}", "value": true } } }
                      ],
                      "on": {
                        "click": { "do": "state.toggle", "key": "collapsed:proj:{{ .p.repo }}" },
                        "drop_item": [
                          {
                            "accept": "worktree",
                            "valid": ".dragged as $d | [.worktrees[] | select(.path == $d)][0] as $w | $w.repo == .p.repo and $w.section != null",
                            "do": { "do": "worktree.move", "section": null }
                          },
                          {
                            "accept": "project",
                            "valid": ".dragged as $d | .p.repo as $t | [.projects[].repo] as $r | ($r | index($t)) as $ti | ($r | index($d)) as $di | $d != $t and ((.zone == \"before\" and $di != $ti - 1) or (.zone == \"after\" and $di != $ti + 1))",
                            "do": { "do": "project.move", "target": "{{ .p.repo }}" }
                          }
                        ]
                      },
                      "children": [
                        { "type": "DropLine", "props": { "key": "proj:{{ .p.repo }}" } },
                        { "type": "Badge", "props": { "letter": "{{ .p.letter }}", "hue": "{{ .p.hue }}", "size": 22 } },
                        { "id": "project-name", "type": "text", "props": { "text": "{{ .p.name }}" }, "style": { "font_size": 14, "truncate": true, "min_width": 0, "shrink": 1 } },
                        { "type": "icon", "props": { "name": "{{ if .state[\"collapsed:proj:\" + .p.repo] then \"chevron-right\" else \"chevron-down\" end }}", "size": 12, "color": "@text_faint" } },
                        { "type": "spacer" },
                        { "for": ".p.hosts", "as": "h", "id": "project-host", "type": "HostIcon", "props": { "host": "{{ .h }}", "size": 12 } },
                        { "id": "project-new-chat", "type": "IconButton", "props": { "icon": "plus", "size": 22, "tooltip": "New chat in {{ .p.name }}", "do": { "do": "chat.new", "dir": "{{ ([.p.items[] | select(.is_primary)][0] // .p.items[0]).path }}" } } }
                      ]
                    },
                    {
                      "if": ".state[\"collapsed:proj:\" + .p.repo] | not",
                      "for": ".app.drag as $d | .p.items | map(select((($d.kind == \"worktree\" and $d.value == .path) | not)))", "as": "w", "key": ".w.path",
                      "id": "project-worktrees",
                      "type": "column",
                      "children": [
                        { "id": "wt-row", "type": "WorktreeRow", "props": { "w": "{{ .w }}", "in_section": false } },
                        { "id": "wt-chats", "type": "WorktreeChats", "props": { "w": "{{ .w }}", "indent": 40 } }
                      ]
                    }
                  ]
                },
                {
                  "for": ".app.drag as $d | .sections | map(select((($d.kind == \"section\" and $d.value == .id) | not)))", "as": "s", "key": ".s.id",
                  "id": "section-card",
                  "type": "column",
                  "children": [
                    {
                      "id": "section-label",
                      "type": "SectionLabel",
                      "props": {
                        "text": "{{ .s.name }}",
                        "drop_key": "sec:{{ .s.id }}",
                        "collapsed": "{{ (\"collapsed:\" + .s.id) as $k | if .state | has($k) then .state[$k] else .s.collapsed end }}"
                      },
                      "style": {
                        "position": "relative", "cursor": "pointer", "radius": 6,
                        "background": "{{ if (.app.drop.key == (\"sec:\" + .s.id) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"sec:\" + .s.id) then \"#488efc1a\" else \"transparent\" end }}",
                        "color": "{{ if (.app.drop.key == (\"sec:\" + .s.id) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"sec:\" + .s.id) then \"@accent\" else \"@text_muted\" end }}"
                      },
                      "drag": { "kind": "section", "value": "{{ .s.id }}", "label": "{{ .s.name }}" },
                      "drop_key": "sec:{{ .s.id }}",
                      "drop_zones": { "worktree": "inside", "section": "edges" },
                      "on": {
                        "click": { "do": "state.toggle", "key": "collapsed:{{ .s.id }}", "default": "{{ .s.collapsed }}" },
                        "drop_item": [
                          {
                            "accept": "worktree",
                            "valid": ".s.items[0].path != .dragged",
                            "do": { "do": "worktree.move", "section": "{{ .s.id }}", "before": "{{ .s.items[0].path // \"\" }}" }
                          },
                          {
                            "accept": "section",
                            "valid": ".dragged as $d | .s.id as $t | [.sections[].id] as $r | ($r | index($t)) as $ti | ($r | index($d)) as $di | $d != $t and ((.zone == \"before\" and $di != $ti - 1) or (.zone == \"after\" and $di != $ti + 1))",
                            "do": { "do": "section.move", "target": "{{ .s.id }}" }
                          }
                        ]
                      },
                      "menu": [
                        { "label": "Rename…", "do": { "do": "section.rename", "id": "{{ .s.id }}" } },
                        { "separator": true },
                        { "label": "Sort by recent activity", "checked": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
                        { "label": "Sort manually", "checked": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
                        { "separator": true },
                        { "label": "Delete section", "do": { "do": "section.delete", "id": "{{ .s.id }}" } }
                      ]
                    },
                    {
                      "if": "(\"collapsed:\" + .s.id) as $k | if .state | has($k) then .state[$k] else .s.collapsed end | not",
                      "for": ".app.drag as $d | .s.items | map(select((($d.kind == \"worktree\" and $d.value == .path) | not)))",
                      "as": "w", "key": ".w.path",
                      "id": "section-worktrees",
                      "type": "column",
                      "children": [
                        {
                          "id": "wt-row",
                          "type": "WorktreeRow",
                          "props": {
                            "w": "{{ .w }}", "in_section": true,
                            "child": "{{ (.w.chats | any(.kind == \"orchestrator\") | not) and (.s.items | any(.chats | any(.kind == \"orchestrator\"))) }}"
                          }
                        },
                        { "id": "wt-chats", "type": "WorktreeChats", "props": { "w": "{{ .w }}", "indent": "{{ if (.w.chats | any(.kind == \"orchestrator\") | not) and (.s.items | any(.chats | any(.kind == \"orchestrator\"))) then 44 else 32 end }}" } }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "row",
              "style": { "height": 46, "shrink": 0, "padding": [0, 18], "gap": 4, "align": "center" },
              "children": [
                { "id": "footer-settings", "type": "IconButton", "props": { "icon": "settings", "tooltip": "Settings  ⌘,", "do": "settings.open" } },
                { "id": "footer-new-section", "type": "IconButton", "props": { "icon": "folder-plus", "tooltip": "New section", "do": "section.new" } },
                { "id": "footer-new-chat", "type": "IconButton", "props": { "icon": "plus", "tooltip": "New chat  ⌘N", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } } },
                { "type": "spacer" },
                {
                  "if": ".app.settings_error or (.app.errors | length > 0)",
                  "type": "text", "props": { "text": "settings error" },
                  "style": { "font_size": 11, "color": "@danger", "cursor": "pointer" },
                  "tooltip": "{{ [.app.settings_error // empty] + .app.errors | join(\"\\n\") }}",
                  "on": { "click": "settings.open" }
                },
                {
                  "type": "box",
                  "style": { "width": 7, "height": 7, "radius": 4, "background": "{{ if .app.connected then \"@success\" else \"@warning\" end }}" },
                  "tooltip": "{{ .app.status }}"
                }
              ]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "sidebar_width", "axis": "x", "min": 220, "max": 700 },
          "style": { "position": "absolute", "top": 0, "right": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "DesignerButton": {
      "about": "The painter's palette: opens the designer, a chat with an agent that redesigns this app live.",
      "type": "box",
      "style": {
        "width": 26, "height": 26, "shrink": 0, "radius": 6, "align": "center", "justify": "center", "cursor": "pointer",
        "background": "{{ if .state.designer_open then \"@selection\" else \"transparent\" end }}",
        "hover": { "background": "@hover" }, "active": { "opacity": 0.7 }
      },
      "tooltip": "Redesign the app with an agent  ⌘⇧D",
      "on": { "click": { "do": "state.toggle", "key": "designer_open" } },
      "children": [
        { "type": "icon", "props": { "name": "palette", "size": 15, "color": "{{ if .state.designer_open then \"@accent\" else \"@text_muted\" end }}", "spin": "{{ .designer.working }}" } }
      ]
    },

    "DesignerPanel": {
      "about": "The designer chat on the right: ask for any change and watch it happen. Resizable (state.designer_width).",
      "type": "stack",
      "style": { "width": "{{ .state.designer_width }}", "height": "full", "shrink": 0, "padding": [0, 14, 14, 0] },
      "animate": { "from": { "opacity": 0, "x": 28 }, "duration": 220 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "type": "row",
              "style": { "height": 44, "shrink": 0, "gap": 8, "align": "center", "padding": [0, 4] },
              "on": { "mouse_down": "window.move", "double_click": "window.zoom" },
              "children": [
                { "type": "icon", "props": { "name": "palette", "size": 15, "color": "@accent" } },
                { "type": "text", "props": { "text": "Designer" }, "style": { "font_size": 13, "font_weight": "semibold" } },
                { "if": ".designer.working", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
                { "type": "spacer" },
                { "type": "IconButton", "props": { "icon": "undo-2", "tooltip": "Undo the last change", "do": "settings.undo" } },
                { "type": "IconButton", "props": { "icon": "square-pen", "tooltip": "New designer conversation", "do": "designer.reset" } },
                { "type": "IconButton", "props": { "icon": "x", "tooltip": "Close", "do": { "do": "state.set", "key": "designer_open", "value": false } } }
              ]
            },
            {
              "type": "column",
              "style": { "grow": 1, "min_height": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
              "children": [
                {
                  "type": "transcript",
                  "props": { "chat": "designer", "empty": "Ask for any change and watch it happen: move the terminal beside the chat, show worktrees as cards, add a button that…" },
                  "style": { "grow": 1, "min_height": 0, "padding": [0, 4] }
                },
                {
                  "if": ".designer.working",
                  "id": "designer-progress",
                  "type": "row",
                  "style": { "gap": 8, "align": "center", "padding": [0, 16, 6, 16], "font_size": 12.5, "color": "@text_muted" },
                  "children": [
                    { "type": "spinner", "props": { "size": "xsmall", "color": "@accent" } },
                    { "type": "text", "props": { "text": "{{ if .designer.activity == \"\" then \"Working\" else .designer.activity end }}…" }, "style": { "truncate": true } }
                  ]
                },
                {
                  "type": "box",
                  "style": { "shrink": 0, "padding": [4, 12, 12, 12] },
                  "children": [
                    {
                      "style": { "radius": 10, "border": 1, "border_color": "@line", "background": "@composer", "padding": [6, 8, 6, 6], "gap": 6, "align": "center" },
                      "type": "row",
                      "children": [
                        { "type": "composer", "props": { "chat": "designer" }, "style": { "grow": 1, "min_width": 0 } },
                        {
                          "id": "designer-send",
                          "type": "box",
                          "tooltip": "Send  ↩   (⇧↩ new line)",
                          "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@accent", "cursor": "pointer", "opacity": "{{ if .designer.working then 0.4 else 1 end }}", "hover": { "opacity": 0.85 } },
                          "on": { "click": { "do": "composer.send", "chat": "designer" } },
                          "children": [{ "type": "icon", "props": { "name": "arrow-up", "size": 15, "color": "#ffffff" } }]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "designer_width", "axis": "x", "invert": true, "min": 300, "max": 900 },
          "style": { "position": "absolute", "top": 0, "left": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "WorktreeRow": {
      "about": "One worktree in the sidebar. props: w (a worktree), in_section (bool: sections show the project badge and emoji), child (bool: a worker under the section's orchestrator, drawn indented with a tree line).",
      "type": "row",
      "style": {
        "height": "{{ if .props.w.drop_gap then 66 else 33 end }}",
        "padding": "{{ (if .props.w.drop_gap then 33 else 0 end) as $top | (if .props.child then [0, 12, 0, 30] elif .props.in_section then [0, 12, 0, 8] else [0, 12, 0, 27] end) | .[0] = $top }}",
        "gap": 8, "align": "center", "radius": 8, "border": 1, "cursor": "pointer",
        "border_color": "{{ if .props.w.selected then \"@selection_border\" else \"transparent\" end }}",
        "background": "{{ if .props.w.selected then \"@selection\" else \"transparent\" end }}",
        "hover": "{{ if .props.w.selected then {} else {\"background\": \"@hover\"} end }}",
        "position": "relative"
      },
      "on": {
        "click": { "do": "select", "worktree": "{{ .props.w.path }}" },
        "double_click": { "do": "worktree.label", "path": "{{ .props.w.path }}" },
        "drop_item": {
          "accept": "worktree",
          "valid": ".dragged as $d | .props.w as $t | .zone as $z | (if $t.section then [.sections[] | select(.id == $t.section.id) | .items[].path] else [.projects[] | select(.repo == $t.repo) | .items[].path] end) as $list | ($list | index($t.path)) as $ti | ($list | index($d)) as $di | $d != $t.path and ($t.section != null or ([.worktrees[] | select(.path == $d)][0].repo == $t.repo)) and ($di == null or ($z == \"before\" and $di != $ti - 1) or ($z == \"after\" and $di != $ti + 1))",
          "do": [
            {
              "do": "if", "cond": "{{ .state.sidebar_order == \"recent\" }}",
              "then": [
                { "do": "state.set", "key": "sidebar_order", "value": "manual" },
                { "do": "notify", "text": "Sidebar switched to manual order so your arrangement sticks. Right-click Projects to sort by recent activity again." }
              ]
            },
            { "do": "worktree.move", "section": "{{ .props.w.section.id }}", "target": "{{ .props.w.path }}" }
          ]
        }
      },
      "drag": { "kind": "worktree", "value": "{{ .props.w.path }}", "label": "{{ .props.w.title }}" },
      "drop_key": "wt:{{ .props.w.path }}",
      "drop_zones": "edges",
      "tooltip": "{{ .props.w.branch // \"\" }}",
      "menu": [
        { "label": "Rename feature label…", "do": { "do": "worktree.label", "path": "{{ .props.w.path }}" } },
        { "label": "Rename current branch", "do": { "do": "worktree.rename_branch", "path": "{{ .props.w.path }}" } },
        { "label": "Hide worktree", "do": { "do": "state.set", "key": "hidden:{{ .props.w.path }}", "value": true } },
        { "separator": true },
        {
          "label": "New section",
          "items": [
            { "label": "With this worktree…", "do": { "do": "section.new", "assign": "{{ .props.w.path }}" } },
            { "label": "Empty…", "do": "section.new" }
          ]
        },
        { "separator": true },
        { "label": "Copy path", "shortcut": "⌘⇧C", "do": { "do": "clipboard.copy", "text": "{{ .props.w.path }}" } },
        { "if": ".props.w.host == \"mac\"", "label": "Open in Finder", "do": { "do": "shell", "run": "open \"$P\"", "env": { "P": "{{ .props.w.path }}" } } },
        { "if": ".props.w.host == \"mac\"", "label": "Open in Terminal", "do": { "do": "shell", "run": "open -a Terminal \"$P\"", "env": { "P": "{{ .props.w.path }}" } } },
        {
          "if": ".props.w.host != \"mac\"", "label": "Open in Terminal",
          "do": {
            "do": "shell",
            "run": "osascript -e 'on run argv' -e 'tell application \"Terminal\" to do script \"ssh -t \" & item 1 of argv & \" \" & quoted form of (\"cd \" & quoted form of (item 2 of argv) & \" && exec $SHELL -l\")' -e 'tell application \"Terminal\" to activate' -e 'end run' \"$H\" \"$P\"",
            "env": { "P": "{{ .props.w.path }}", "H": "{{ .app.ssh_host }}" }
          }
        },
        { "if": ".props.w.is_primary | not", "separator": true },
        { "if": ".props.w.is_primary | not", "label": "Delete worktree", "danger": true, "do": { "do": "confirm", "title": "Delete {{ .props.w.title }}?", "text": "Removes the worktree folder, with any uncommitted changes in it. The branch stays.", "confirm": "Delete", "then": { "do": "worktree.delete", "path": "{{ .props.w.path }}" } } },
        { "separator": true },
        { "label": "{{ if .props.w.pinned then \"Unpin\" else \"Pin\" end }} worktree", "do": { "do": "state.toggle", "key": "pinned:{{ .props.w.path }}" } },
        {
          "label": "Move to section",
          "items": [
            { "for": ".props.w.section.id as $cur | [.sections[] | select(.id != $cur)]", "as": "s", "label": "{{ .s.name }}", "do": { "do": "section.assign", "path": "{{ .props.w.path }}", "section": "{{ .s.id }}" } }
          ]
        },
        { "if": ".props.w.section", "label": "Remove from section", "do": { "do": "section.assign", "path": "{{ .props.w.path }}", "section": null } }
      ],
      "children": [
        { "if": ".props.w.drop_room | not", "type": "DropLine", "props": { "key": "wt:{{ .props.w.path }}" } },
        {
          "if": ".props.w.drop_gap",
          "id": "wt-drop-slot",
          "type": "row",
          "motion": false,
          "style": {
            "position": "absolute", "top": 3, "left": 4, "right": 4, "height": 27, "radius": 7, "border": 1, "padding": [0, 10],
            "align": "center", "gap": 6, "font_size": 12.5,
            "border_color": "{{ if .app.drag.into then \"@accent\" else \"@line\" end }}",
            "background": "{{ if .app.drag.into then \"#488efc1a\" else \"#ffffff08\" end }}",
            "color": "@accent"
          },
          "children": [
            { "if": ".app.drag.into", "type": "icon", "props": { "name": "folder-input", "size": 12, "color": "@accent" } },
            { "if": ".app.drag.into", "type": "text", "props": { "text": "Move to {{ .app.drag.into }}" }, "style": { "truncate": true, "min_width": 0 } }
          ]
        },
        { "if": ".props.child", "type": "icon", "props": { "name": "corner-down-right", "size": 12, "color": "@text_faint" }, "style": { "margin": [0, -2, 0, -14] } },
        { "if": ".props.w.chats | any(.kind == \"orchestrator\")", "type": "icon", "props": { "name": "workflow", "size": 14, "color": "@accent" }, "tooltip": "Orchestrator" },
        { "if": ".props.in_section and (.props.w.chats | any(.kind == \"orchestrator\") | not)", "type": "Badge", "props": { "letter": "{{ .props.w.letter }}", "hue": "{{ .props.w.hue }}", "size": 16 } },
        { "if": ".props.in_section and .props.w.emoji", "type": "text", "props": { "text": "{{ .props.w.emoji }}" }, "style": { "width": 16, "shrink": 0, "font_size": 14 } },
        {
          "type": "row",
          "style": { "grow": 1, "min_width": 0, "gap": 6, "align": "center" },
          "children": [
            { "type": "text", "props": { "text": "{{ if .props.in_section then .props.w.label else .props.w.title end }}" }, "style": { "truncate": true, "font_size": 14 } },
            { "if": ".props.w.is_primary", "type": "icon", "props": { "name": "star-fill", "size": 11, "color": "@text_muted" } },
            { "if": ".props.w.pinned", "type": "icon", "props": { "name": "pin", "size": 11, "color": "@text_muted" }, "tooltip": "Pinned" },
            { "id": "wt-host", "type": "HostIcon", "props": { "host": "{{ .props.w.host }}", "size": 11 } },
            { "for": ".props.w.host as $h | [.props.w.chats[] | select(.open) | .host] | unique | map(select(. != $h))", "as": "h", "type": "HostIcon", "props": { "host": "{{ .h }}", "size": 11 } }
          ]
        },
        { "type": "StatusIcon", "props": { "status": "{{ .props.w.status }}" } },
        { "type": "text", "props": { "text": "{{ .props.w.age_text }}" }, "style": { "min_width": 22, "text_align": "right", "font_size": 12.5, "color": "@age" } }
      ]
    },

    "DropLine": {
      "about": "The insertion line shown above or below a drop target while dragging. props: key (the target's drop_key). Its parent needs position: relative.",
      "type": "box",
      "motion": false,
      "if": ".app.drop.key == .props.key and (.app.drop.zone == \"before\" or .app.drop.zone == \"after\")",
      "style": {
        "position": "absolute", "left": 6, "right": 6, "height": 2, "radius": 1, "background": "@accent",
        "top": "{{ if .app.drop.zone == \"before\" then -3 else null end }}",
        "bottom": "{{ if .app.drop.zone == \"after\" then -3 else null end }}"
      }
    },

    "StatusIcon": {
      "about": "A small icon for a worktree status. props: status (working | waiting | merged | failing | pending | dirty | behind | idle).",
      "type": "box",
      "style": { "width": 14, "align": "center", "justify": "center" },
      "children": [
        { "if": ".props.status == \"working\"", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
        { "if": ".props.status == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 12, "color": "@warning" }, "tooltip": "Waiting for you" },
        { "if": ".props.status == \"merged\"", "type": "icon", "props": { "name": "circle-check", "size": 12, "color": "@merged" }, "tooltip": "Merged" },
        { "if": ".props.status == \"failing\"", "type": "icon", "props": { "name": "circle-x", "size": 12, "color": "@danger" }, "tooltip": "Checks failing" },
        { "if": ".props.status == \"pending\"", "type": "icon", "props": { "name": "loader", "size": 12, "color": "@warning" }, "tooltip": "Checks running" },
        { "if": ".props.status == \"dirty\"", "type": "icon", "props": { "name": "arrow-up", "size": 12, "color": "@age" }, "tooltip": "Unpushed work" },
        { "if": ".props.status == \"behind\"", "type": "icon", "props": { "name": "arrow-down", "size": 12, "color": "@age" }, "tooltip": "Behind its base" }
      ]
    },

    "SectionLabel": {
      "about": "A small grey heading. props: text, collapsed (bool: shows a chevron), drop_key (shows drop lines for reordering).",
      "type": "row",
      "style": { "height": 34, "padding": [12, 8, 0, 8], "gap": 5, "align": "center", "font_size": 13, "color": "@text_muted" },
      "children": [
        { "if": ".props.drop_key", "type": "DropLine", "props": { "key": "{{ .props.drop_key }}" } },
        { "type": "text", "props": { "text": "{{ .props.text }}" } },
        { "if": ".props.collapsed", "type": "icon", "props": { "name": "chevron-right", "size": 12 } }
      ]
    },

    "Badge": {
      "about": "A rounded letter tile tinted by hue. props: letter, hue (0-360), size.",
      "type": "box",
      "style": {
        "width": "{{ .props.size // 16 }}", "height": "{{ .props.size // 16 }}", "shrink": 0,
        "radius": "{{ if (.props.size // 16) > 18 then 5 else 4 end }}", "align": "center", "justify": "center",
        "background": "hsl({{ .props.hue // 210 }}, 24, 26)", "color": "hsl({{ .props.hue // 210 }}, 25, 76)",
        "font_size": "{{ if (.props.size // 16) > 18 then 13 else 9.5 end }}"
      },
      "children": [{ "type": "text", "props": { "text": "{{ .props.letter }}" } }]
    },

    "IconButton": {
      "about": "A square icon button. props: icon (Lucide name), do (action), tooltip, size (default 26).",
      "type": "box",
      "style": {
        "width": "{{ .props.size // 26 }}", "height": "{{ .props.size // 26 }}", "shrink": 0, "radius": 6,
        "align": "center", "justify": "center", "cursor": "pointer", "hover": { "background": "@hover" }, "active": { "opacity": 0.7 }
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": "{{ .props.do }}" },
      "children": [{ "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 15, "color": "@text_muted" } }]
    },

    "Pill": {
      "about": "A rounded button with text and an optional icon. props: text, icon, do, tooltip, mono (bool).",
      "type": "row",
      "style": {
        "height": 26, "padding": [0, 10], "gap": 6, "align": "center", "radius": 13, "border": 1, "border_color": "@line",
        "background": "@pill", "hover": { "background": "@pill_hover" }, "active": { "opacity": 0.75 },
        "font_size": 12.5, "cursor": "pointer", "font_family": "{{ if .props.mono then \"@font_mono\" else \"@font_ui\" end }}"
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": "{{ .props.do }}" },
      "children": [
        { "if": ".props.icon", "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 13 } },
        { "if": ".props.text", "type": "text", "props": { "text": "{{ .props.text }}" } }
      ]
    },

    "MainArea": {
      "about": "The right side: toolbar, chat card, branch bar, terminal card.",
      "type": "column",
      "style": { "height": "full", "min_width": 0, "padding": [0, 14, 14, 0] },
      "children": [
        { "type": "Toolbar", "id": "toolbar" },
        { "type": "ChatCard", "id": "chat-card", "style": { "grow": 1, "min_height": 160 } },
        { "type": "BranchBar", "id": "branch-bar" },
        { "if": ".state.terminal_open", "type": "TerminalCard", "id": "terminal-card" }
      ]
    },

    "Toolbar": {
      "about": "The title bar: sidebar toggle (when hidden), worktree and chat, status, IDE and MR buttons. Drag it to move the window.",
      "type": "row",
      "style": { "height": 44, "shrink": 0, "gap": 8, "align": "center", "padding": [0, 0, 0, "{{ if .state.sidebar_open then 23 else 88 end }}"] },
      "children": [
        { "if": ".state.sidebar_open | not", "type": "IconButton", "id": "sidebar-toggle", "props": { "icon": "panel-left", "size": 24, "tooltip": "Show sidebar  ⌘\\", "do": { "do": "state.toggle", "key": "sidebar_open" } } },
        { "if": ".state.sidebar_open | not", "type": "DesignerButton", "id": "designer-button", "style": { "margin": [0, 8, 0, 0] } },
        {
          "id": "nav-buttons",
          "type": "row",
          "style": { "gap": 0, "align": "center", "margin": [0, 4, 0, -6] },
          "children": [
            { "type": "box", "style": { "opacity": "{{ if .app.nav.back then 1 else 0.35 end }}" }, "children": [{ "type": "IconButton", "id": "nav-back", "props": { "icon": "chevron-left", "size": 24, "tooltip": "Back  ⌘[", "do": "nav.back" } }] },
            { "type": "box", "style": { "opacity": "{{ if .app.nav.forward then 1 else 0.35 end }}" }, "children": [{ "type": "IconButton", "id": "nav-forward", "props": { "icon": "chevron-right", "size": 24, "tooltip": "Forward  ⌘]", "do": "nav.forward" } }] }
          ]
        },
        { "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "background": "{{ if .selected.chat.alive then \"@success\" else \"@text_faint\" end }}" } },
        {
          "if": ".selected.worktree",
          "type": "row",
          "style": { "gap": 8, "align": "center" },
          "children": [
            { "type": "Badge", "props": { "letter": "{{ .selected.worktree.letter }}", "hue": "{{ .selected.worktree.hue }}", "size": 16 } },
            { "type": "text", "props": { "text": "{{ .selected.worktree.title }}" }, "style": { "font_size": 13 } },
            { "if": ".selected.chat", "type": "icon", "props": { "name": "chevron-right", "size": 12, "color": "@text_faint" } },
            { "if": ".selected.chat", "type": "text", "props": { "text": "{{ .selected.chat.name }}" }, "style": { "font_size": 12, "color": "@age" } },
            { "if": ".selected.worktree.uncommitted > 0", "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "background": "@warning" }, "tooltip": "Uncommitted changes" }
          ]
        },
        { "id": "toolbar-drag", "type": "spacer", "style": { "height": "full" }, "on": { "mouse_down": "window.move", "double_click": "window.zoom" } },
        {
          "id": "history",
          "type": "box",
          "style": { "position": "relative" },
          "children": [
            { "type": "IconButton", "id": "history-button", "props": { "icon": "clock", "size": 26, "tooltip": "History: past and closed chats on every machine", "do": [{ "do": "state.toggle", "key": "history_open" }, "history.load"] } },
            {
              "if": ".state.history_open",
              "type": "box",
              "layer": "top",
              "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
              "on": { "click": { "do": "state.set", "key": "history_open", "value": false } }
            },
            {
              "if": ".state.history_open",
              "id": "history-panel",
              "type": "column",
              "layer": "top",
              "style": {
                "position": "absolute", "top": 32, "right": -6, "width": 460, "max_height": 560, "padding": 8, "gap": 6,
                "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
              },
              "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
              "children": [
                {
                  "type": "row",
                  "style": { "gap": 8, "align": "center", "padding": [2, 4] },
                  "children": [
                    { "type": "icon", "props": { "name": "search", "size": 14, "color": "@text_faint" } },
                    { "id": "history-search", "type": "input", "props": { "state": "history_query", "placeholder": "Search chats by name or folder", "autofocus": true, "appearance": false }, "style": { "grow": 1 } },
                    { "if": ".app.history_loading", "type": "spinner", "props": { "size": "xsmall" } }
                  ]
                },
                { "type": "divider" },
                {
                  "type": "scroll",
                  "style": { "max_height": 480, "gap": 1 },
                  "children": [
                    { "if": "(.history | length) == 0 and (.app.history_loading | not)", "type": "text", "props": { "text": "No past chats yet." }, "style": { "padding": 10, "font_size": 13, "color": "@text_faint" } },
                    {
                      "for": "(.state.history_query // \"\" | ascii_downcase) as $q | [.history[] | select($q == \"\" or ((.name // \"\") | ascii_downcase | contains($q)) or ((.folder // \"\") | ascii_downcase | contains($q)))] | .[:150]",
                      "as": "h", "key": ".h.host + .h.id",
                      "type": "row",
                      "style": { "height": 40, "padding": [0, 8], "gap": 10, "align": "center", "radius": 8, "cursor": "pointer", "hover": { "background": "@hover" } },
                      "tooltip": "{{ .h.dir // \"\" }}",
                      "on": { "click": [{ "do": "chat.open", "chat": "{{ .h.id }}", "host": "{{ .h.host }}" }, { "do": "state.set", "key": "history_open", "value": false }] },
                      "children": [
                        { "type": "HostIcon", "props": { "host": "{{ .h.host }}", "size": 13 } },
                        {
                          "type": "column",
                          "style": { "grow": 1, "min_width": 0 },
                          "children": [
                            { "type": "text", "props": { "text": "{{ .h.name }}" }, "style": { "font_size": 13, "truncate": true } },
                            { "type": "text", "props": { "text": "{{ .h.folder }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "truncate": true } }
                          ]
                        },
                        { "if": ".h.closed | not", "type": "text", "props": { "text": "open" }, "style": { "font_size": 11, "color": "@accent" } },
                        { "type": "text", "props": { "text": "{{ .h.age_text }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "shrink": 0 } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "status-pill", "type": "Pill", "props": { "text": "{{ if .app.connected then \"a.box\" else .app.status end }}", "mono": true, "tooltip": "{{ .app.status }}", "do": "palette.open" } },
        { "if": ".selected.worktree", "type": "Pill", "props": { "icon": "square-terminal", "tooltip": "Open in Cursor", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"cursor://file\" + .selected.worktree.path else \"cursor://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } } },
        { "if": ".selected.worktree", "type": "Pill", "props": { "icon": "code", "tooltip": "Open in VS Code", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"vscode://file\" + .selected.worktree.path else \"vscode://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } } },
        { "if": ".selected.worktree.mr", "type": "Pill", "props": { "text": "!{{ .selected.worktree.mr.number }}", "icon": "git-pull-request", "tooltip": "Open the merge request", "do": { "do": "open", "url": "{{ .selected.worktree.mr.url }}" } } }
      ]
    },

    "Card": {
      "about": "A rounded panel.",
      "type": "column",
      "style": { "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" }
    },

    "ChatCard": {
      "about": "Chat tabs, the transcript, a waiting card when the agent needs you, and the composer. Drop files on the transcript or composer to attach them.",
      "type": "column",
      "style": { "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
      "children": [
        { "type": "ChatTabs" },
        {
          "type": "column",
          "style": { "grow": 1, "min_height": 0 },
          "children": [
            {
              "id": "transcript",
              "type": "transcript",
              "props": { "empty": "{{ if .selected.worktree then \"No chat in this worktree yet. Press + above to start one.\" else \"Select a worktree\" end }}" },
              "style": { "grow": 1, "min_height": 0 }
            },
            {
              "if": ".selected.chat.status == \"running_elsewhere\"",
              "id": "elsewhere-banner",
              "type": "row",
              "style": { "gap": 10, "padding": [8, 14], "margin": [0, 28, 8, 28], "align": "center", "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "font_size": 13, "width": "full", "max_width": 860, "self": "center" },
              "children": [
                { "type": "icon", "props": { "name": "eye", "size": 14, "color": "@text_muted" } },
                { "type": "text", "props": { "text": "Running in super.engineering. You're watching; send a message or take it over to continue here." }, "style": { "grow": 1, "color": "@text_muted" } },
                { "type": "Pill", "id": "elsewhere-take-over", "props": { "text": "Take it over", "icon": "arrow-down-to-line", "do": { "do": "chat.take_over", "chat": "{{ .selected.chat.id }}" } } }
              ]
            },
            { "id": "waiting", "type": "waiting", "style": { "padding": [0, 28, 10, 28], "width": "full", "max_width": 916, "self": "center" } },
            {
              "if": ".selected.chat",
              "id": "composer-box",
              "type": "box",
              "style": { "shrink": 0, "padding": [4, 20, 14, 20], "width": "full", "max_width": 900, "self": "center", "position": "relative" },
              "children": [
                { "type": "Completions", "props": { "chat": "{{ .selected.chat.id }}" } },
                { "type": "Queued", "props": { "c": "{{ .selected.chat }}" } },
                {
                  "if": ".selected.chat.kind == \"subagent\"",
                  "id": "subagent-note",
                  "type": "row",
                  "style": { "padding": [8, 12], "gap": 8, "align": "center", "radius": 10, "border": 1, "border_color": "@line", "font_size": 13, "color": "@text_muted" },
                  "children": [
                    { "type": "icon", "props": { "name": "bot", "size": 14 } },
                    { "type": "text", "props": { "text": "A subagent's conversation, shown as it runs. Reply in its parent chat." } }
                  ]
                },
                {
                  "if": ".selected.chat.kind != \"subagent\"",
                  "id": "composer-frame",
                  "type": "row",
                  "style": { "radius": 10, "border": 1, "border_color": "@line", "background": "@composer", "padding": [6, 8, 6, 6], "gap": 6, "align": "end" },
                  "children": [
                    { "type": "composer", "style": { "grow": 1, "min_width": 0 } },
                    {
                      "if": ".selected.chat.state == \"working\"",
                      "id": "composer-stop",
                      "type": "box",
                      "tooltip": "Stop the agent (Esc in the chat)",
                      "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@text", "cursor": "pointer", "hover": { "opacity": 0.85 } },
                      "on": { "click": { "do": "chat.interrupt", "chat": "{{ .selected.chat.id }}" } },
                      "children": [{ "type": "box", "style": { "width": 10, "height": 10, "radius": 2, "background": "@composer" } }]
                    },
                    {
                      "if": ".selected.chat.state != \"working\"",
                      "id": "composer-send",
                      "type": "box",
                      "tooltip": "Send  ↩   (⇧↩ new line)",
                      "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@accent", "cursor": "pointer", "hover": { "opacity": 0.85 } },
                      "on": { "click": { "do": "composer.send", "chat": "{{ .selected.chat.id }}" } },
                      "children": [{ "type": "icon", "props": { "name": "arrow-up", "size": 15, "color": "#ffffff" } }]
                    }
                  ]
                },
                {
                  "if": "(.selected.background | length) > 0",
                  "id": "background-work",
                  "type": "row",
                  "style": { "padding": [8, 2, 0, 2], "gap": 6, "wrap": true, "align": "center" },
                  "children": [
                    {
                      "for": ".selected.background", "as": "b", "key": ".b.tool_id", "id": "background-chip",
                      "type": "row",
                      "style": {
                        "height": 26, "padding": [0, 10], "gap": 6, "align": "center", "radius": 13, "border": 1, "border_color": "@line",
                        "font_size": 12.5, "color": "@text_muted", "cursor": "pointer", "max_width": 320, "hover": { "color": "@text", "background": "@hover" }
                      },
                      "tooltip": "{{ if .b.kind == \"shell\" then \"Running in the background. Click to follow its output in a terminal tab.\" else \"A subagent at work. Click to open its conversation in a tab.\" end }}",
                      "on": {
                        "click": {
                          "do": "if", "cond": "{{ .b.kind == \"shell\" }}",
                          "then": { "do": "shell.open", "task": "{{ .b.task_id }}", "output": "{{ .b.output }}", "label": "{{ .b.label }}" },
                          "else": { "do": "subagent.open", "chat": "{{ .b.chat }}", "agent": "{{ .b.agent }}", "label": "{{ .b.label }}" }
                        }
                      },
                      "children": [
                        { "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
                        { "type": "icon", "props": { "name": "{{ if .b.kind == \"shell\" then \"square-terminal\" else \"bot\" end }}", "size": 12 } },
                        { "type": "text", "props": { "text": "{{ .b.label }}" }, "style": { "truncate": true, "min_width": 0 } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    "ChatTabs": {
      "about": "Tabs for the selected worktree's open chats (a chat is open while its Claude process runs; closing a tab stops it), a placeholder while a new chat starts, + for a new chat, and the worktree's closed chats under the clock. Drag tabs to reorder them.",
      "type": "row",
      "style": { "height": 32, "shrink": 0, "padding": [0, 0, 0, 6], "align": "stretch" },
      "children": [
        {
          "id": "chat-tabs-scroll",
          "type": "scroll",
          "props": { "axis": "x", "handle": "chat_tabs" },
          "style": { "direction": "row", "align": "stretch", "basis": "auto", "shrink": 1, "min_width": 0 },
          "children": [
            {
              "for": ".app.drag as $d | .selected.chats | map(select(.open and (($d.kind == \"chat\" and $d.value == .id) | not)))", "as": "c", "key": ".c.id", "id": "chat-tab",
              "type": "row",
              "style": {
                "position": "relative", "gap": 6, "padding": [0, 4, 0, 10], "align": "center", "font_size": 13, "cursor": "pointer", "shrink": 0,
                "color": "{{ if .c.active then \"@text\" else \"@age\" end }}", "hover": { "color": "@text" }
              },
              "on": {
                "click": { "do": "select", "chat": "{{ .c.id }}" },
                "drop_item": { "accept": "chat", "valid": ".dragged != .c.id", "do": { "do": "tab.move", "target": "{{ .c.id }}" } }
              },
              "drag": { "kind": "chat", "value": "{{ .c.id }}", "label": "{{ .c.name }}" },
              "drop_key": "tab:{{ .c.id }}",
              "drop_zones": "edges_x",
              "tooltip": "{{ .hosts[.c.host].label // .c.host }} · {{ .c.state }}",
              "menu": [
                { "label": "Move to {{ if .c.host == \"box\" then \"the Mac\" else \"the cloud\" end }}", "do": { "do": "chat.move", "chat": "{{ .c.id }}", "to": "{{ if .c.host == \"box\" then \"mac\" else \"box\" end }}" } },
                { "if": ".c.alive | not", "label": "Start", "do": { "do": "chat.start", "chat": "{{ .c.id }}" } },
                { "label": "Fork chat", "do": { "do": "chat.fork", "chat": "{{ .c.id }}" } },
                { "separator": true },
                { "label": "Close tab", "do": { "do": "if", "cond": "{{ .c.state == \"working\" or .c.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .c.name }}”?", "text": "It's still working. Closing the tab stops its Claude process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .c.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .c.id }}" } } },
                { "label": "Archive", "do": { "do": "chat.archive", "chat": "{{ .c.id }}" } }
              ],
              "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
              "children": [
                { "type": "DropLineX", "props": { "key": "tab:{{ .c.id }}" } },
                { "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 12 } },
                { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "max_width": 240, "truncate": true } },
                { "if": ".c.state == \"working\"", "type": "spinner", "props": { "size": "xsmall" } },
                { "if": ".c.state == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 12, "color": "@warning" } },
                {
                  "id": "chat-tab-close",
                  "type": "box",
                  "style": { "width": 18, "height": 18, "radius": 4, "align": "center", "justify": "center", "opacity": "{{ if .c.active then 0.9 else 0.45 end }}", "hover": { "background": "@hover", "opacity": 1 } },
                  "tooltip": "Close tab (stops the chat)",
                  "on": { "click": { "do": "if", "cond": "{{ .c.state == \"working\" or .c.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .c.name }}”?", "text": "It's still working. Closing the tab stops its Claude process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .c.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .c.id }}" } } },
                  "children": [{ "type": "icon", "props": { "name": "x", "size": 11, "color": "@text_muted" } }]
                },
                { "if": ".c.active", "type": "box", "style": { "position": "absolute", "left": 0, "right": 0, "bottom": 0, "height": 2, "background": "@accent" } }
              ]
            }
          ]
        },
        {
          "if": ".app.starting != null and .app.starting == .selected.worktree.path",
          "id": "chat-tab-starting",
          "type": "row",
          "style": { "gap": 7, "padding": [0, 12], "align": "center", "font_size": 13, "color": "@text_muted" },
          "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
          "children": [{ "type": "spinner", "props": { "size": "xsmall" } }, { "type": "text", "props": { "text": "Starting…" } }]
        },
        {
          "if": ".selected.worktree",
          "id": "chat-tab-new",
          "type": "row",
          "style": { "padding": [0, 10], "gap": 4, "align": "center", "shrink": 0, "color": "@text_muted", "cursor": "pointer", "hover": { "color": "@text" } },
          "tooltip": "New chat here  ⌘N",
          "on": { "click": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
          "children": [{ "type": "icon", "props": { "name": "plus", "size": 13 } }]
        },
        { "type": "spacer" },
        { "if": ".selected.chats | any(.open | not)", "id": "chat-tab-divider", "type": "divider", "props": { "axis": "y" }, "style": { "height": 14, "self": "center", "margin": [0, 4] } },
        {
          "if": ".selected.chats | any(.open | not)",
          "id": "chat-history",
          "type": "row",
          "style": { "position": "relative", "padding": [0, 4], "align": "center", "shrink": 0 },
          "children": [
            { "type": "IconButton", "id": "chat-history-button", "props": { "icon": "archive-restore", "size": 24, "tooltip": "Closed chats in this worktree", "do": { "do": "state.toggle", "key": "chat_history_open" } } },
            {
              "if": ".state.chat_history_open",
              "type": "box",
              "layer": "top",
              "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
              "on": { "click": { "do": "state.set", "key": "chat_history_open", "value": false } }
            },
            {
              "if": ".state.chat_history_open",
              "id": "chat-history-list",
              "type": "scroll",
              "layer": "top",
              "style": {
                "position": "absolute", "top": 30, "right": 0, "width": 320, "max_height": 380, "padding": 6, "gap": 2,
                "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
              },
              "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
              "children": [
                { "type": "text", "props": { "text": "Closed chats" }, "style": { "padding": [4, 8, 6, 8], "font_size": 12, "color": "@text_faint" } },
                {
                  "for": ".selected.chats | map(select(.open | not)) | sort_by(.last_activity // \"\") | reverse", "as": "c", "key": ".c.id",
                  "type": "row",
                  "style": { "height": 32, "padding": [0, 8], "gap": 8, "align": "center", "radius": 6, "cursor": "pointer", "font_size": 13, "hover": { "background": "@hover" } },
                  "tooltip": "Reopen (resumes it on {{ .hosts[.c.host].label // .c.host }})",
                  "on": { "click": [{ "do": "chat.open", "chat": "{{ .c.id }}" }, { "do": "state.set", "key": "chat_history_open", "value": false }] },
                  "children": [
                    { "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 12 } },
                    { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "grow": 1, "truncate": true } },
                    { "type": "text", "props": { "text": "{{ .c.age_text }}" }, "style": { "font_size": 12, "color": "@text_faint", "shrink": 0 } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    "WorktreeChats": {
      "about": "Only when state.sidebar_rows is \"chats\": a worktree's chats under its sidebar row, open ones first, then newest; the first `chat.sidebar_chats` (5) unless expanded. Clicking one opens it (resuming its process). props: w (a worktree), indent (left padding).",
      "if": ".state.sidebar_rows == \"chats\" and (.props.w.chats | length) > 0",
      "type": "column",
      "style": { "padding": [0, 0, 2, 0] },
      "children": [
        {
          "for": ".state as $s | .props.w.path as $p | (.props.w.chats | sort_by([(if .open then 1 else 0 end), (.last_activity // 0)]) | reverse) as $all | if $s[\"chats_more:\" + $p] then $all else $all[:5] end",
          "as": "c", "key": ".c.id", "id": "wt-chat",
          "type": "row",
          "style": {
            "height": 26, "padding": "{{ [0, 10, 0, (.props.indent // 40)] }}", "gap": 7, "align": "center", "radius": 6, "font_size": 12.5, "cursor": "pointer",
            "color": "{{ if .c.active then \"@text\" elif .c.open then \"@text_muted\" else \"@text_faint\" end }}",
            "background": "{{ if .c.active then \"@hover\" else \"transparent\" end }}",
            "hover": { "background": "@hover", "color": "@text" }
          },
          "tooltip": "{{ .c.name }} · {{ .hosts[.c.host].label // .c.host }} · {{ if .c.open then .c.state else \"closed (click to resume)\" end }}",
          "on": { "click": { "do": "chat.open", "chat": "{{ .c.id }}" } },
          "children": [
            { "if": ".c.state == \"working\"", "type": "spinner", "props": { "size": "xsmall" } },
            { "if": ".c.state == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 11, "color": "@warning" } },
            { "if": ".c.state != \"working\" and .c.state != \"waiting\"", "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "margin": [0, 2], "background": "{{ if .c.open then \"@accent\" else \"@line\" end }}" } },
            { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "grow": 1, "truncate": true } },
            { "if": ".c.host != .props.w.host", "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 11 } },
            { "type": "text", "props": { "text": "{{ .c.age_text }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "shrink": 0 } }
          ]
        },
        {
          "if": "(.props.w.chats | length) > 5",
          "id": "wt-chats-more",
          "type": "row",
          "style": { "height": 24, "padding": "{{ [0, 10, 0, ((.props.indent // 40) + 13)] }}", "align": "center", "font_size": 12, "color": "@text_faint", "cursor": "pointer", "radius": 6, "hover": { "color": "@text" } },
          "on": { "click": { "do": "state.set", "key": "chats_more:{{ .props.w.path }}", "value": "{{ .state[\"chats_more:\" + .props.w.path] | not }}" } },
          "children": [{ "type": "text", "props": { "text": "{{ if .state[\"chats_more:\" + .props.w.path] then \"Show fewer\" else \"Show \\((.props.w.chats | length) - 5) more\" end }}" } }]
        }
      ]
    },

    "Completions": {
      "about": "The list the composer shows while you type a trigger word (\"/\" for commands and skills): up/down to move, Tab or Enter to fill it in, Esc to close. props: chat.",
      "if": ".app.completion and .app.completion.chat == .props.chat",
      "type": "column",
      "layer": "top",
      "style": {
        "position": "absolute", "left": 20, "right": 20, "bottom": "full", "max_height": 340, "padding": 5, "gap": 1,
        "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
      },
      "children": [
        {
          "for": ".app.completion.selected as $sel | .app.completion.items | to_entries | map(.value + {index: .key, selected: (.key == $sel)})",
          "as": "e", "key": ".e.name",
          "type": "row",
          "style": {
            "height": 30, "padding": [0, 10], "gap": 10, "align": "center", "radius": 6, "cursor": "pointer", "font_size": 13,
            "background": "{{ if .e.selected then \"@selection\" else \"transparent\" end }}", "hover": { "background": "@hover" }
          },
          "on": { "click": { "do": "completion.accept", "index": "{{ .e.index }}" } },
          "children": [
            { "type": "icon", "props": { "name": "{{ if .e.kind == \"skill\" then \"sparkles\" else \"square-slash\" end }}", "size": 13, "color": "@text_faint" } },
            { "type": "text", "props": { "text": "{{ .app.completion.trigger }}{{ .e.name }}" }, "style": { "shrink": 0, "font_family": "@font_mono", "font_size": 12.5 } },
            { "type": "text", "props": { "text": "{{ .e.description }}" }, "style": { "grow": 1, "min_width": 0, "truncate": true, "color": "@text_faint", "font_size": 12 } },
            {
              "type": "text",
              "props": { "text": "{{ if .e.source == \"project\" then \"repo\" elif .e.source == \"personal\" then \"personal\" else \"built-in\" end }}" },
              "tooltip": "{{ if .e.source == \"project\" then \"From this repository (.claude or .agents in the worktree)\" elif .e.source == \"personal\" then \"Yours (~/.claude, ~/.agents)\" else \"Claude Code command\" end }}",
              "style": {
                "shrink": 0, "padding": [1, 7], "radius": 9, "font_size": 11, "border": 1,
                "border_color": "{{ if .e.source == \"project\" then \"@accent\" elif .e.source == \"personal\" then \"@success\" else \"@line\" end }}",
                "color": "{{ if .e.source == \"project\" then \"@accent\" elif .e.source == \"personal\" then \"@success\" else \"@text_faint\" end }}"
              }
            }
          ]
        }
      ]
    },

    "Queued": {
      "about": "Messages waiting to send (state chat.queue): each goes out when the agent finishes its turn. Click one to edit it in the composer. props: c (a chat).",
      "if": "(.props.c.queued | length) > 0",
      "type": "column",
      "style": { "gap": 4, "padding": [0, 4, 8, 4] },
      "children": [
        { "type": "text", "props": { "text": "Queued · sends when the agent finishes" }, "style": { "font_size": 11.5, "color": "@text_faint", "padding": [0, 4] } },
        {
          "for": ".props.c.queued | to_entries", "as": "q", "key": ".q.key",
          "id": "queued-message",
          "type": "row",
          "style": { "gap": 8, "padding": [6, 6, 6, 10], "align": "center", "radius": 8, "border": 1, "border_color": "@line", "background": "@user_bubble", "font_size": 13 },
          "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
          "children": [
            { "type": "icon", "props": { "name": "clock", "size": 12, "color": "@text_faint" } },
            {
              "type": "text", "props": { "text": "{{ .q.value }}" },
              "style": { "grow": 1, "min_width": 0, "truncate": true, "cursor": "pointer" },
              "tooltip": "Edit (back into the message box)",
              "on": { "click": { "do": "queue.edit", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } }
            },
            { "type": "IconButton", "props": { "icon": "pencil", "size": 22, "tooltip": "Edit", "do": { "do": "queue.edit", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } },
            { "type": "IconButton", "props": { "icon": "send", "size": 22, "tooltip": "Send now", "do": { "do": "queue.send_now", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } },
            { "type": "IconButton", "props": { "icon": "x", "size": 22, "tooltip": "Remove", "do": { "do": "queue.remove", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } }
          ]
        }
      ]
    },

    "HostIcon": {
      "about": "Where something runs: the icon for props.host from `hosts`, with its label as the tooltip. props: host (box | mac), size (12).",
      "type": "box",
      "style": { "shrink": 0, "align": "center", "justify": "center" },
      "tooltip": "{{ .hosts[.props.host].label // .props.host }}",
      "children": [{ "type": "icon", "props": { "name": "{{ .hosts[.props.host].icon // \"circle\" }}", "size": "{{ .props.size // 12 }}", "color": "{{ .hosts[.props.host].color // \"@text_muted\" }}" } }]
    },

    "Confirm": {
      "about": "The dialog the `confirm` action opens (.app.confirm: title, text, confirm, cancel). Esc cancels.",
      "if": ".app.confirm",
      "type": "box",
      "layer": "top",
      "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "align": "center", "justify": "center" },
      "children": [
        { "type": "box", "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "background": "#00000066" }, "on": { "click": "confirm.cancel" } },
        {
          "id": "confirm-card",
          "type": "column",
          "occlude": true,
          "style": { "width": 420, "padding": [18, 20, 16, 20], "gap": 10, "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg" },
          "animate": { "from": { "opacity": 0, "y": 8 }, "duration": 140 },
          "children": [
            { "type": "text", "props": { "text": "{{ .app.confirm.title // \"Are you sure?\" }}" }, "style": { "font_size": 15, "font_weight": "semibold" } },
            { "if": ".app.confirm.text", "type": "text", "props": { "text": "{{ .app.confirm.text }}" }, "style": { "font_size": 13, "color": "@text_muted", "line_height": 1.5 } },
            {
              "type": "row",
              "style": { "gap": 8, "justify": "end", "margin": [6, 0, 0, 0] },
              "children": [
                { "type": "Pill", "id": "confirm-cancel", "props": { "text": "{{ .app.confirm.cancel // \"Cancel\" }}", "do": "confirm.cancel" } },
                {
                  "id": "confirm-accept",
                  "type": "row",
                  "style": { "height": 26, "padding": [0, 12], "align": "center", "radius": 13, "background": "@danger", "color": "#ffffff", "font_size": 12.5, "cursor": "pointer", "hover": { "opacity": 0.9 } },
                  "on": { "click": "confirm.accept" },
                  "children": [{ "type": "text", "props": { "text": "{{ .app.confirm.confirm // \"OK\" }}" } }]
                }
              ]
            }
          ]
        }
      ]
    },

    "DropLineX": {
      "about": "The vertical insertion line at the left or right edge of a drop target in a row (tabs). props: key (the target's drop_key). Its parent needs position: relative.",
      "type": "box",
      "motion": false,
      "if": ".app.drop.key == .props.key and (.app.drop.zone == \"before\" or .app.drop.zone == \"after\")",
      "style": {
        "position": "absolute", "top": 8, "bottom": 8, "width": 2, "radius": 1, "background": "@accent",
        "left": "{{ if .app.drop.zone == \"before\" then -1 else null end }}",
        "right": "{{ if .app.drop.zone == \"after\" then -1 else null end }}"
      }
    },

    "BranchBar": {
      "about": "Branch, uncommitted changes, and actions. Drag it up or down to resize the terminal (state.terminal_height).",
      "type": "resize_handle",
      "props": { "state": "terminal_height", "axis": "y", "invert": true, "min": 100, "max": 1200 },
      "style": { "height": 54, "shrink": 0, "direction": "row", "gap": 10, "padding": [0, 16], "align": "center" },
      "children": [
        {
          "if": ".selected.worktree",
          "type": "row",
          "style": { "grow": 1, "gap": 10, "align": "center" },
          "children": [
            { "type": "icon", "props": { "name": "git-branch", "size": 13, "color": "@age" } },
            {
              "id": "branch-input",
              "type": "input",
              "tooltip": "Click to rename the branch; Enter saves",
              "props": { "value": "{{ .selected.worktree.branch // \"\" }}", "placeholder": "detached", "appearance": false },
              "on": { "submit": { "do": "worktree.rename_branch", "path": "{{ .selected.worktree.path }}", "branch": "{{ .input }}" } },
              "style": { "grow": 1, "min_width": 0, "max_width": 460, "font_size": 13, "radius": 6, "padding": [2, 6], "margin": [0, 0, 0, -6], "cursor": "text", "hover": { "background": "@hover" } }
            },
            { "type": "spacer" },
            {
              "if": ".selected.diff.files > 0",
              "id": "changes-pill",
              "type": "Pill",
              "props": {
                "icon": "file-diff",
                "text": "{{ .selected.diff.files }} file{{ if .selected.diff.files == 1 then \"\" else \"s\" end }} +{{ .selected.diff.added }} −{{ .selected.diff.removed }}",
                "tooltip": "Show the changes ({{ .selected.diff.base_label }})",
                "do": [{ "do": "state.set", "key": "terminal_open", "value": true }, { "do": "state.set", "key": "bottom_tab", "value": "changes" }]
              }
            },
            {
              "if": ".selected.worktree.uncommitted > 0",
              "type": "text",
              "props": { "text": "{{ .selected.worktree.uncommitted }} uncommitted change{{ if .selected.worktree.uncommitted == 1 then \"\" else \"s\" end }}" },
              "style": { "font_size": 12.5, "color": "@warning" }
            },
            { "if": ".selected.worktree.uncommitted > 0 and .selected.chat", "type": "Pill", "props": { "text": "Commit and push", "icon": "git-commit-horizontal", "do": { "do": "chat.send", "text": "Commit and push your changes." } } },
            { "if": "(.selected.worktree.is_primary | not) and .selected.worktree.branch and .selected.worktree.host == \"box\"", "type": "Pill", "props": { "text": "Test on Mac", "icon": "laptop", "tooltip": "Check this branch out on the Mac with the box's latest work", "do": { "do": "worktree.test_local", "branch": "{{ .selected.worktree.branch }}" } } },
            {
              "if": ".selected.chat and .selected.chat.kind != \"subagent\" and (.selected.worktree.host == \"box\" or .selected.chat.host == \"mac\")",
              "id": "move-chat",
              "type": "Pill",
              "props": {
                "text": "Move chat to {{ if .selected.chat.host == \"box\" then \"Mac\" else \"the cloud\" end }}",
                "icon": "{{ if .selected.chat.host == \"box\" then \"laptop\" else \"cloud\" end }}",
                "tooltip": "{{ if .selected.chat.host == \"box\" then \"Continue this chat on the Mac, with the worktree's latest work\" else \"Continue this chat on the box: it gets the same branch with your uncommitted and unpushed work, and keeps running when the laptop sleeps\" end }}",
                "do": {
                  "do": "confirm",
                  "title": "Move “{{ .selected.chat.name }}” to {{ if .selected.chat.host == \"box\" then \"the Mac\" else \"the cloud\" end }}?",
                  "text": "Its Claude process stops here{{ if .selected.chat.status == \"running_elsewhere\" then \", including in super.engineering,\" else \"\" end }} and the conversation continues there in a minute, on the same branch with this worktree's uncommitted and unpushed work.",
                  "confirm": "Move it",
                  "then": { "do": "chat.move", "chat": "{{ .selected.chat.id }}", "to": "{{ if .selected.chat.host == \"box\" then \"mac\" else \"box\" end }}" }
                }
              }
            },
            { "type": "IconButton", "props": { "icon": "{{ if .state.terminal_open then \"panel-bottom-close\" else \"panel-bottom-open\" end }}", "tooltip": "Terminal  ⌘J", "do": { "do": "state.toggle", "key": "terminal_open" } } }
          ]
        }
      ]
    },

    "TerminalCard": {
      "about": "The bottom card: the Changes tab (unless changes are in the right panel), then the terminal tabs (state.bottom_tab). Height: state.terminal_height.",
      "type": "column",
      "style": { "height": "{{ .state.terminal_height }}", "shrink": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
      "animate": { "from": { "opacity": 0, "y": 10 }, "duration": 160 },
      "children": [
        {
          "type": "row",
          "style": { "height": 46, "shrink": 0, "padding": [0, 18], "gap": 6, "align": "center" },
          "children": [
            {
              "if": ".state.changes_place != \"right\"",
              "type": "BottomTab", "id": "tab-changes",
              "props": { "tab": "changes", "icon": "file-diff", "text": "Changes{{ if .selected.diff.files > 0 then \" \" + (.selected.diff.files | tostring) else \"\" end }}" }
            },
            { "if": ".state.changes_place != \"right\"", "id": "bottom-tabs-divider", "type": "divider", "props": { "axis": "y" }, "style": { "height": 14, "self": "center", "margin": [0, 4] } },
            {
              "for": ".selected.terminals", "as": "t", "key": ".t.id", "id": "tab-terminal",
              "type": "row",
              "style": {
                "height": 26, "padding": "{{ if (.selected.terminals | length) > 1 then [0, 6, 0, 11] else [0, 11] end }}", "gap": 6, "align": "center", "radius": 13, "border": 1, "font_size": 13, "cursor": "pointer", "shrink": 0,
                "border_color": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@tab_border\" else \"transparent\" end }}",
                "background": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@tab_bg\" else \"transparent\" end }}",
                "color": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@text\" else \"@age\" end }}",
                "hover": { "color": "@text" }
              },
              "on": { "click": { "do": "terminal.select", "id": "{{ .t.id }}" } },
              "children": [
                { "type": "icon", "props": { "name": "{{ if .t.command then \"scroll-text\" else \"square-terminal\" end }}", "size": 13 } },
                { "type": "text", "props": { "text": "{{ .t.label }}" }, "style": { "truncate": true, "max_width": 220 } },
                {
                  "if": "(.selected.terminals | length) > 1",
                  "type": "box",
                  "style": { "width": 18, "height": 18, "radius": 9, "align": "center", "justify": "center", "color": "@text_faint", "hover": { "background": "@hover", "color": "@text" } },
                  "tooltip": "Close this terminal",
                  "on": { "click": { "do": "terminal.close", "id": "{{ .t.id }}" } },
                  "children": [{ "type": "icon", "props": { "name": "x", "size": 11 } }]
                }
              ]
            },
            { "id": "terminal-new", "type": "IconButton", "props": { "icon": "plus", "size": 24, "tooltip": "New terminal  ⌃⇧T", "do": "terminal.new" } },
            { "type": "spacer" },
            {
              "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\")",
              "type": "row",
              "style": { "gap": 6, "align": "center" },
              "children": [
                { "type": "DiffTools" },
                {
                  "type": "IconButton", "id": "changes-to-right",
                  "props": { "icon": "panel-right", "tooltip": "Open changes in a right panel", "do": [{ "do": "state.set", "key": "changes_place", "value": "right" }, { "do": "state.set", "key": "bottom_tab", "value": "terminal" }] }
                }
              ]
            }
          ]
        },
        { "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not", "id": "terminal-view", "type": "terminal", "style": { "grow": 1, "min_height": 0 } },
        { "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\")", "id": "bottom-diff", "type": "diff", "style": { "grow": 1, "min_height": 0, "border_top": 1, "border_color": "@line" } }
      ]
    },

    "DiffTools": {
      "about": "The diff's controls: what to compare against, collapse/expand every file, refresh.",
      "type": "row",
      "style": { "gap": 6, "align": "center" },
      "children": [
        { "if": ".selected.diff.loading", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
        { "type": "Segment", "props": { "key": "diff_base", "value": "uncommitted", "text": "Uncommitted", "tooltip": "Changes not yet committed" } },
        { "type": "Segment", "props": { "key": "diff_base", "value": "branch", "text": "Whole branch", "tooltip": "Everything on this branch since it left main, committed or not" } },
        { "type": "IconButton", "props": { "icon": "chevrons-down-up", "tooltip": "Collapse all files", "do": "diff.collapse_all" } },
        { "type": "IconButton", "props": { "icon": "chevrons-up-down", "tooltip": "Expand all files", "do": "diff.expand_all" } },
        { "type": "IconButton", "props": { "icon": "refresh-cw", "tooltip": "Refresh", "do": "diff.refresh" } }
      ]
    },

    "ChangesPanel": {
      "about": "The worktree's changes in a panel right of the chat (state.changes_place \"right\"). Resizable (state.changes_width).",
      "type": "stack",
      "style": { "width": "{{ .state.changes_width }}", "height": "full", "shrink": 0, "padding": [0, 14, 14, 0] },
      "animate": { "from": { "opacity": 0, "x": 28 }, "duration": 220 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "type": "row",
              "style": { "height": 44, "shrink": 0, "gap": 6, "align": "center", "padding": [0, 4] },
              "on": { "mouse_down": "window.move", "double_click": "window.zoom" },
              "children": [
                { "type": "icon", "props": { "name": "file-diff", "size": 14, "color": "@age" } },
                { "type": "text", "props": { "text": "Changes{{ if .selected.diff.files > 0 then \" \" + (.selected.diff.files | tostring) else \"\" end }}" }, "style": { "font_size": 13, "font_weight": "semibold" } },
                { "type": "spacer" },
                { "type": "DiffTools" },
                {
                  "type": "IconButton", "id": "changes-to-bottom",
                  "props": { "icon": "panel-bottom", "tooltip": "Move changes back to the bottom panel", "do": [{ "do": "state.set", "key": "changes_place", "value": "bottom" }, { "do": "state.set", "key": "bottom_tab", "value": "changes" }, { "do": "state.set", "key": "terminal_open", "value": true }] }
                },
                { "type": "IconButton", "props": { "icon": "x", "tooltip": "Close", "do": { "do": "state.set", "key": "changes_place", "value": "bottom" } } }
              ]
            },
            {
              "type": "column",
              "style": { "grow": 1, "min_height": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
              "children": [{ "id": "panel-diff", "type": "diff", "style": { "grow": 1, "min_height": 0 } }]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "changes_width", "axis": "x", "invert": true, "min": 320, "max": 1400 },
          "style": { "position": "absolute", "top": 0, "left": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "BottomTab": {
      "about": "A tab in the bottom card. props: tab (the state.bottom_tab value it selects), text, icon.",
      "type": "row",
      "style": {
        "height": 26, "padding": [0, 11], "gap": 6, "align": "center", "radius": 13, "border": 1, "font_size": 13, "cursor": "pointer",
        "border_color": "{{ if .state.bottom_tab == .props.tab then \"@tab_border\" else \"transparent\" end }}",
        "background": "{{ if .state.bottom_tab == .props.tab then \"@tab_bg\" else \"transparent\" end }}",
        "color": "{{ if .state.bottom_tab == .props.tab then \"@text\" else \"@age\" end }}",
        "hover": { "color": "@text" }
      },
      "on": { "click": { "do": "state.set", "key": "bottom_tab", "value": "{{ .props.tab }}" } },
      "children": [
        { "if": ".props.icon", "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 13 } },
        { "type": "text", "props": { "text": "{{ .props.text }}" } }
      ]
    },

    "Segment": {
      "about": "One option of a segmented control bound to a state key. props: key, value, text, tooltip.",
      "type": "row",
      "style": {
        "height": 24, "padding": [0, 9], "align": "center", "radius": 6, "font_size": 12, "cursor": "pointer",
        "background": "{{ if .state[.props.key] == .props.value then \"@selection\" else \"transparent\" end }}",
        "color": "{{ if .state[.props.key] == .props.value then \"@text\" else \"@age\" end }}",
        "hover": { "color": "@text" }
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": { "do": "state.set", "key": "{{ .props.key }}", "value": "{{ .props.value }}" } },
      "children": [{ "type": "text", "props": { "text": "{{ .props.text }}" } }]
    }
  },

  // What happens when chats change while you're elsewhere. Each event: {"if": jq, "do": action}; the chat is .chat.
  "events": {
    "chat.waiting": {
      "if": ".app.focused | not",
      "do": [
        { "do": "notify.system", "chat": "{{ .chat.id }}", "title": "{{ .chat.name }} needs you", "text": "{{ .chat.waiting_on.message // \"It's waiting for an answer.\" }}", "sound": false },
        "dock.bounce"
      ]
    },
    "chat.finished": {
      "if": ".app.focused | not",
      "do": { "do": "notify.system", "chat": "{{ .chat.id }}", "title": "{{ .chat.name }} finished", "text": "{{ .chat.last_message // \"Ready for your next message.\" }}", "sound": false }
    },
    "designer.finished": {
      "if": ".app.focused | not",
      "do": { "do": "notify.system", "chat": "designer", "title": "The designer finished", "text": "Your changes are in.", "sound": false }
    }
  },

  // The designer (the palette button's agent that edits these settings). It runs without a terminal, so
  // it can't ask for permissions: add_dirs are the folders it may read besides this one (uploads hold
  // the images you paste or drop into it).
  "designer": {
    // The designer's instructions (null: the built-in ones) and the claude it runs.
    "prompt": null,
    "claude": "~/.local/bin/claude",
    "add_dirs": ["~/.agent-box/uploads", "~/Desktop", "~/Downloads"],
    "tools": ["Read", "Edit", "Write", "Glob", "Grep"],
    "permission_mode": "acceptEdits"
  },

  // Where chats and worktrees run. Tabs, worktree rows, and the closed-chats list show the host's icon.
  "hosts": {
    "box": { "label": "On the box (tj-agents)", "icon": "cloud", "color": "@text_faint" },
    "mac": { "label": "On this Mac", "icon": "laptop", "color": "@success" }
  },

  // Sounds when things happen, focused or not ("when": "unfocused" to only play in the background).
  // A name is a macOS sound (Basso Blow Bottle Frog Funk Glass Hero Morse Ping Pop Purr Sosumi
  // Submarine Tink) or an audio file path; null silences one. chat.question: a turn that ends asking you.
  "sounds": {
    "enabled": true,
    "volume": 1,
    "when": "always",
    "chat.finished": "Glass",
    "chat.question": "Ping",
    "chat.waiting": "Funk",
    "chat.stopped": null,
    "designer.finished": "Glass"
  },

  // The Dock icon's badge: how many chats are waiting on you.
  "dock": { "badge": "{{ [.chats[] | select(.state == \"waiting\")] | length }}" },

  "keys": [
    // `not_in`: leave the key to the focused "terminal", "composer", or other "input" (cmd-k clears a terminal).
    { "key": "cmd-k", "do": "palette.open", "not_in": ["terminal"] },
    { "key": "cmd-shift-p", "do": "palette.open" },
    { "key": "cmd-\\", "do": { "do": "state.toggle", "key": "sidebar_open" } },
    { "key": "cmd-j", "do": { "do": "state.toggle", "key": "terminal_open" } },
    { "key": "cmd-,", "do": "settings.open" },
    { "key": "cmd-shift-d", "do": { "do": "state.toggle", "key": "designer_open" } },
    { "key": "cmd-n", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
    { "key": "ctrl-shift-t", "if": ".selected.worktree", "do": "terminal.new" },
    { "key": "cmd-shift-c", "if": ".selected.worktree", "do": { "do": "clipboard.copy", "text": "{{ .selected.worktree.path }}" } },
    { "key": "cmd-shift-n", "if": ".selected.worktree", "do": { "do": "worktree.new", "repo": "{{ .selected.worktree.repo }}", "host": "{{ .selected.worktree.host }}" } },
    // Back and forward through where you've been (the mouse's side buttons and trackpad swipes do too).
    { "key": "cmd-[", "do": "nav.back" },
    { "key": "cmd-]", "do": "nav.forward" },
    { "key": "cmd-alt-]", "do": { "do": "select", "offset": 1 } },
    { "key": "cmd-alt-[", "do": { "do": "select", "offset": -1 } },
    { "key": "cmd-q", "do": "app.quit" },
    { "key": "escape", "if": ".app.confirm", "do": "confirm.cancel" },
    { "key": "cmd-w", "if": ".selected.chat", "do": { "do": "if", "cond": "{{ .selected.chat.state == \"working\" or .selected.chat.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .selected.chat.name }}”?", "text": "It's still working. Closing the tab stops its Claude process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .selected.chat.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .selected.chat.id }}" } } }
  ],

  "commands": [
    { "label": "Redesign the app (open the designer)", "do": { "do": "state.set", "key": "designer_open", "value": true } },
    { "label": "Undo the last design change", "do": "settings.undo" },
    { "label": "New chat here", "if": ".selected.worktree", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
    { "label": "New orchestrator chat in redo", "do": { "do": "chat.new", "repo": "redo", "kind": "orchestrator" } },
    { "label": "New feature chat in redo…", "do": { "do": "prompt", "title": "Branch name", "then": { "do": "chat.new", "repo": "redo", "kind": "feature", "branch": "{{ .input }}" } } },
    { "label": "New section…", "do": "section.new" },
    { "label": "Sidebar: sort by recent activity", "if": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
    { "label": "Sidebar: sort manually", "if": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
    { "label": "Restore removed projects", "if": ".app.removed_projects | length > 0", "do": "project.restore" },
    { "label": "Sidebar: list chats under worktrees", "if": ".state.sidebar_rows != \"chats\"", "do": { "do": "state.set", "key": "sidebar_rows", "value": "chats" } },
    { "label": "Sidebar: worktrees only", "if": ".state.sidebar_rows == \"chats\"", "do": { "do": "state.set", "key": "sidebar_rows", "value": "worktrees" } },
    { "label": "Toggle sidebar", "do": { "do": "state.toggle", "key": "sidebar_open" } },
    { "label": "Toggle terminal", "do": { "do": "state.toggle", "key": "terminal_open" } },
    { "label": "Open in Cursor", "if": ".selected.worktree", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"cursor://file\" + .selected.worktree.path else \"cursor://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } },
    { "label": "Open in VS Code", "if": ".selected.worktree", "do": { "do": "open", "url": "vscode://vscode-remote/ssh-remote+{{ .app.ssh_host }}{{ .selected.worktree.path }}" } },
    { "label": "Open merge request", "if": ".selected.worktree.mr", "do": { "do": "open", "url": "{{ .selected.worktree.mr.url }}" } },
    { "label": "Commit and push", "if": ".selected.chat", "do": { "do": "chat.send", "text": "Commit and push your changes." } },
    { "label": "Test this branch on the Mac", "if": ".selected.worktree.branch and (.selected.worktree.is_primary | not)", "do": { "do": "worktree.test_local", "branch": "{{ .selected.worktree.branch }}" } },
    { "label": "Move chat to the Mac", "if": ".selected.chat.host == \"box\"", "do": { "do": "chat.move", "to": "mac" } },
    { "label": "Move chat to the cloud (the box)", "if": ".selected.chat.host == \"mac\"", "do": { "do": "chat.move", "to": "box" } },
    { "label": "Stop chat", "if": ".selected.chat.alive", "do": "chat.stop" },
    { "label": "Start chat", "if": ".selected.chat and (.selected.chat.alive | not)", "do": "chat.start" },
    { "label": "Archive chat", "if": ".selected.chat", "do": "chat.archive" },
    { "label": "Expand all steps", "if": ".selected.chat", "do": "steps.expand_all" },
    { "label": "Collapse all steps", "if": ".selected.chat", "do": "steps.collapse_all" },
    { "label": "Settings", "do": "settings.open" },
    { "label": "Settings reference", "do": "settings.docs" },
    { "label": "Reload settings", "do": "settings.reload" },
    { "label": "Quit", "do": "app.quit" }
  ],

  "chat": {
    // ---- Transcript text and look ----
    // Lines Claude Code writes that aren't conversation: meta and wrappers show as notices when true;
    // compaction / agent_messages: "step" | "message" | "hidden"; task_notifications: "notice" | "message" | "hidden".
    "show": { "meta": false, "sidechain": false, "wrappers": false, "compaction": "step", "agent_messages": "step", "task_notifications": "notice", "errors": true },
    // The "Thinking…"/"Working…" row while the agent works.
    "pending": { "show": true },
    // Tool step summaries are cut to this many characters.
    "summary_chars": 140,
    "labels": {
      "steps": "{n} step{s}{failed}", "steps_failed": ", {n} failed", "earlier_steps": "{n} earlier step{s}",
      "thinking": "Thinking", "thought": "Thought", "pending_thinking": "Thinking", "pending_working": "Working",
      "activity_thinking": "Thinking", "activity_writing": "Writing", "more_lines": "… {n} more lines",
      "compacted": "Compacted the conversation", "compacted_auto": "Compacted the conversation automatically",
      "message_from": "Message from {from}", "message_from_summary": "Message from {from}: {summary}",
      "skill_subject": "the {skill} skill", "background_finished": "A background task finished", "another_session": "another session"
    },
    // Per tool name (or "*"): { "doing", "done", "failed", "icon", "activity" }; any field overrides the built-in table.
    "tools": {},
    "tool_names": { "strip": "mcp__", "separator": " · " },
    "step_line": {
      "icon_size": 14, "chevron_size": 12, "pulse_ms": 1400, "pulse_min": 0.35, "pulse_max": 1,
      "icons": { "pending": "brain", "thinking": "brain", "fold": "list-checks", "open": "chevron-down", "closed": "chevron-right" }
    },
    "step_detail": {
      "removed": "@diff_del", "removed_background": "@diff_del_bg", "added": "@diff_add", "added_background": "@diff_add_bg",
      "error": "@danger", "removed_prefix": "- ", "added_prefix": "+ ", "command_prefix": "$ ", "json_fallback": true,
      "tab_width": 4, "padding_x": 8, "padding_bottom": 12
    },
    "attachments": {
      "size": 64, "image_width_factor": 2.5, "image_extensions": ["png", "jpg", "jpeg", "gif", "webp"], "strip_prefix": true,
      "file_icon": "file", "name_size": 10, "uploading_overlay": "#00000073", "failed_border": "@danger",
      "remove": { "size": 18, "icon_size": 11, "icon": "x", "top": 3, "right": 3, "background": "#000000a6", "color": "#ffffff" }
    },
    // ---- Chips over the transcript ----
    "jump_icon": "arrow-down", "jump_icon_size": 13, "jump_bottom": 14,
    // The "Loading earlier messages…" chip (its look falls back to `jump`), and how close to the top loads more.
    "loading_chip_top": 10, "load_earlier_within": 0,
    "drop_overlay_icon": "paperclip",
    // ---- The message box ----
    "composer_lines": { "min": 1, "max": 10 }, "composer_gap": 6, "composer_radius": 6,
    "suggestion_hint": "   ⇥ Tab",
    // Keys besides Tab that take Claude's suggestion into an empty message box.
    "suggestion_keys": [],
    "cmd_enter_sends": true,
    // The completion list's keys (the arrows, Enter, Tab, and Esc work too).
    "completion_keys": { "next": ["ctrl-n"], "prev": ["ctrl-p"], "accept": [], "close": [] },
    "completion_limit": 12, "completion_cache_secs": 20,
    // ---- Waiting chats ----
    // Choices when a waiting chat gives none (a permission prompt); every question shows when there are several.
    "waiting_options": ["Yes", "Yes, don't ask again", "No"], "waiting_all_questions": true,
    // ---- Behavior ----
    // What makes a chat show as a tab (besides opening it yourself): alive, working, waiting, running_elsewhere.
    "open_when": ["alive", "working", "waiting", "running_elsewhere"],
    // A reply "asks" (the chat.question sound) when it ends with one of these.
    "asks_endings": ["?"],
    // A chat shows as working this long after you send, until its hook says so.
    "working_after_send_secs": 10,
    // Wait at least this long between queued messages to one chat.
    "queue_resend_secs": 8,
    // Closing a Mac chat's tab: "archive" (ends it in super.engineering too) or "stop".
    "close_on_mac": "archive",
    // A new chat's kind: with no folder, and in a folder without a branch.
    "new_kind": "orchestrator", "new_kind_in_folder": "primary",
    "last_message_chars": 280,
    "enter_sends": true,
    "placeholder": "Message the agent…",
    "designer_placeholder": "Describe a change to the app…",
    // Trace-style transcript (after shadcn's Trace): user turns as bubbles, replies as text, steps as quiet lines.
    "fold_steps_after": 5,
    "step_detail_lines": 40,
    // How many of a chat's newest transcript entries to load when it opens (long chats run to 40,000+).
    "transcript_tail": 600,
    // How many more older entries to load each time you scroll to the top of a long chat.
    "transcript_page": 600,
    // Typing one of these at the start of a word opens a list of matches under the composer.
    // Messages sent while the agent is working wait here and go out one per turn as it finishes.
    "queue": true,
    // Before continuing a chat super.engineering still runs ({name}: the chat). confirm: false skips the question.
    "takeover": { "confirm": true },
    // Typing with nothing focused goes to the selected chat's message box.
    "type_to_focus": true,
    // Claude Code's suggested next prompt shows in the empty message box; Tab fills it in (doesn't send).
    "suggestions": true,
    // Copy and Fork under each message while you hover it.
    "message_actions": true,
    // Select and copy message text with the mouse.
    "selectable": true,
    // How replies' Markdown looks. Style objects take the usual style keys (padding, radius, font_size,
    // font_family, background, overflow_x...). Tables scroll sideways instead of squeezing.
    "markdown": {
      // theme: "dark" | "light" | "auto" (follows window.appearance); highlight: a code theme, or null for the theme's.
      "theme": "dark", "highlight": null,
      // Show <placeholders> as text instead of hiding them as HTML.
      "show_angle_brackets": true,
      "paragraph_gap": 0.75,
      "heading_sizes": [20, 17, 15, 14, 13, 13],
      "code_block": { "radius": 8, "padding": [10, 12], "font_family": "@font_mono", "font_size": 12.5 },
      "table": { "overflow_x": "scroll" },
      "table_head": {},
      "table_cell": { "padding": [6, 10] }
    },
    "completion_triggers": ["/"],
    // What "/" offers: these commands, then the skills and commands in skill_dirs ({worktree}: the chat's
    // worktree; box worktrees read this Mac's checkout of the same repo).
    "slash_commands": [
      { "name": "clear", "description": "Start a fresh conversation" },
      { "name": "compact", "description": "Summarize the conversation to free up context" },
      { "name": "model", "description": "Switch the model" },
      { "name": "loop", "description": "Run a prompt on a schedule or self-paced" },
      { "name": "review", "description": "Review the current changes" },
      { "name": "context", "description": "Show what's using the context window" },
      { "name": "cost", "description": "Show this session's cost and usage" },
      { "name": "resume", "description": "Resume an earlier conversation" },
      { "name": "init", "description": "Write a CLAUDE.md for this repo" }
    ],
    "skill_dirs": ["{worktree}/.claude/skills", "{worktree}/.claude/commands", "{worktree}/.agents/skills", "~/.claude/skills", "~/.claude/commands", "~/.agents/skills"],
    // Selecting a worktree opens its live chat, if any: "open" (default) shows no chat when none is
    // running; "recent" shows the newest chat even when it isn't.
    "open_on_select": "open",
    // Code in expanded steps: long lines scroll sideways with a horizontal swipe, or with shift + scroll
    // (shift), which holds the transcript still. shift_holds_transcript: shift + scroll elsewhere in the
    // transcript doesn't scroll it either. scrollbar: hover | always | scrolling | never.
    // Shown over a chat while files are dragged onto it, naming the chat they'll attach to.
    "drop_overlay": { "radius": 12, "border": 2, "border_color": "@accent", "background": "#488efc1f", "gap": 8, "font_size": 14, "color": "@text" },
    // The message box while files are dragged over it.
    "composer_drop": { "border_color": "@accent", "background": "#488efc26" },
    "code_scroll": { "shift": true, "speed": 1, "shift_holds_transcript": true, "scrollbar": "hover" },
    "list": { "gap": 22, "padding": [20, 28], "width": "full", "max_width": 780, "self": "center" },
    // New messages: "at_bottom" keeps you at the newest while you're there (scroll up and it stays put),
    // "always" jumps to each one, "never" doesn't move. Scrolled up, a chip offers to jump down (false hides it).
    "follow": "at_bottom",
    "jump": { "padding": [5, 12], "radius": 14, "background": "@pill", "border": 1, "border_color": "@line", "font_size": 12.5, "color": "@text", "hover": { "background": "@pill_hover" }, "shadow": "md" },
    "jump_labels": { "new": "New messages", "latest": "Jump to latest" },
    "user": { "max_width": "80%", "padding": [8, 14], "radius": 16, "background": "@user_bubble", "font_size": 14, "line_height": 1.5, "gap": 6 },
    "assistant": { "font_size": 14, "line_height": 1.6 },
    "trace": { "gap": 8 },
    "trace_line": { "gap": 8, "align": "center", "font_size": 13.5, "color": "@text_muted", "hover": { "color": "@text" } },
    "trace_content": { "margin": [8, 0, 4, 7], "border_left": 1, "border_color": "@line", "padding": [0, 4, 0, 16], "color": "@text_muted", "font_size": 13, "line_height": 1.55, "gap": 6 },
    "step_code": { "font_family": "@font_mono", "font_size": 12, "radius": 6, "background": "@code_bg", "padding": [6, 0], "overflow": "hidden", "color": "@age" },
    "image": { "max_width": 360, "max_height": 240, "radius": 10, "margin": [6, 0, 0, 0] },
    "file": { "margin": [6, 0, 0, 0], "padding": [4, 8], "radius": 6, "background": "@pill", "font_size": 12.5, "color": "@age" },
    "notice": { "font_size": 12.5, "color": "@danger" },
    "empty": { "color": "@text_muted", "width": "full", "padding": [0, 32], "text_align": "center", "line_height": 1.5 },
    "waiting": { "padding": 12, "radius": 10, "border": 1, "border_color": "@warning", "background": "@waiting_bg", "font_size": 13 },
    "waiting_option": { "height": 26, "padding": [0, 10], "radius": 13, "border": 1, "border_color": "@line", "background": "@pill", "hover": { "background": "@pill_hover" }, "font_size": 12.5, "align": "center" }
  },

  "diff": {
    "row_height": 20, "gutter_width": 44, "sign_width": 14, "note_font_size": 12,
    "header": { "font_family": ".SystemUIFont", "font_size": 12.5 },
    "max_lines_per_file": 4000, "refresh_ms": 2000,
    // Each a color or @token.
    "colors": { "add_bg": "@diff_add_bg", "del_bg": "@diff_del_bg", "add": "@diff_add", "del": "@diff_del", "muted": "@text_faint", "hunk_bg": "@diff_hunk_bg", "file_bg": "@diff_file_bg", "hover": "@hover" },
    // The line link for Mac worktrees (open_url is for box ones); both take {host} {machine} {path} {line}.
    "open_url_local": "cursor://file{path}:{line}",
    "font_size": 12,
    "open_url": "cursor://vscode-remote/ssh-remote+{host}{path}:{line}",
    "file_list": { "width": 260, "shrink": 0, "height": "full", "border_right": 1, "border_color": "@line", "padding": [6, 0] },
    "file_row": { "padding": [4, 12], "gap": 6, "font_size": 12.5 },
    "empty": { "color": "@text_muted" }
  },

  "terminal": {
    // The 16 ANSI colors, normal then bright.
    "palette": ["#1e1e1f", "#e5534b", "#3fb950", "#d29922", "#488efc", "#bc8cff", "#39c5cf", "#d6d6d8",
                "#6e7681", "#ff7b72", "#56d364", "#e3b341", "#79c0ff", "#d2a8ff", "#56d4dd", "#ffffff"],
    // shape: block | bar | underline | hollow | app; optional "color".
    "cursor": { "shape": "block", "focused_alpha": 0.75, "unfocused_alpha": 0.3 },
    "size": { "cols": 100, "rows": 30 },
    "scrollback": 10000,
    // The wheel: "auto" (to the program when it asks for the mouse; in a tmux shell, tmux's own history,
    // without tmux's mouse mode so drags still select here; else this view's scrollback), "tmux", "local",
    // "app", or "off". Typing while scrolled back returns to the prompt.
    "wheel": "auto", "wheel_lines": 1,
    // Drag to select (double-click a word, triple-click a line); copy_key copies it.
    "select": true, "selection": "#3a425299", "copy_key": "cmd-c",
    "font_family": "Menlo",
    "font_size": 13,
    "line_height": 1.25,
    "padding": [14, 6],
    "foreground": "#f5f5f7",
    "background": "#1e1e1f",
    // Mac-style editing: each combo sends this text to the shell (readline/zsh codes). Use opt or alt,
    // cmd, ctrl, shift. {"paste": true} pastes the clipboard; null hands the combo back to the app.
    "keys": {
      "cmd-backspace": "\u0015",
      "alt-backspace": "\u001b\u007f",
      "cmd-delete": "\u000b",
      "alt-delete": "\u001bd",
      "cmd-left": "\u0001",
      "cmd-right": "\u0005",
      "alt-left": "\u001bb",
      "alt-right": "\u001bf",
      "shift-enter": "\u001b\r",
      "cmd-v": { "paste": true },
      "cmd-k": "\u000c"
    }
  },

  // A picture behind the whole window: a file (absolute, ~/, or in the settings folder) or URL; fit
  // cover | contain | fill | scale_down | none; dim lays a color over it. Panels need see-through colors
  // in `theme` (e.g. "#2e2218cc") for it to show.
  "background": { "image": null, "fit": "cover", "opacity": 1, "dim": null },

  // The window: title, starting size, the traffic lights' position, and the component kit's look
  // ("dark" | "light" | "system"; the app's own colors are `theme`). Read at launch.
  "window": { "title": "a.box", "width": 1500, "height": 940, "traffic_lights": { "x": 20, "y": 15 }, "appearance": "dark" },

  // Words the app shows that aren't in the layout above. {name} parts are filled in.
  "strings": {
    "app_name": "a.box", "connected": "Connected", "reconnecting": "Reconnecting to {host}… ({why})",
    "starting_chat": "Starting a chat…", "start_failed": "Couldn't start the chat: {error}", "making_worktree": "Making a worktree for {branch}…",
    "working": "Working…", "done": "Done", "failed": "Failed", "copied": "Copied", "nothing_to_undo": "Nothing to undo", "no_window": "No window to capture",
    "sending_after_upload": "Sending when the upload finishes", "stop_elsewhere": "This chat is running in super.engineering: stop it there, or take it over first",
    "rename_branch_failed": "Couldn't rename the branch: {error}", "new_worktree_failed": "Couldn't make the worktree: {error}", "no_remote": "This project has no origin remote",
    "no_chat": "No chat here yet.", "new_chat_name": "New chat", "terminal_n": "Terminal {n}", "background_shell": "Background shell", "subagent": "Subagent",
    "waiting": "The agent is waiting for you", "waiting_cancel": "Cancel", "drop_to_attach": "Drop to attach to {chat}", "drag_move_to": "Move to {name}",
    "the_designer": "the designer", "this_chat": "this chat", "a_file": "a file", "n_files": "{n} files",
    "attaching": "Attaching {what} to {chat}", "attach_failed": "Couldn't attach: {error}", "upload_failed": "Upload failed: {error}",
    "dialog_save": "Save", "dialog_name": "Name", "settings_title": "Settings", "new_section_title": "New section",
    "menu_settings": "Settings…", "menu_palette": "Command Palette", "menu_quit": "Quit {app}",
    "settings_intro": "Everything about the app is here. Your file is merged over the built-in defaults; set a key to null to remove a default. Reference for you and agents: {docs}",
    "diff.select_worktree": "Select a worktree", "diff.no_changes": "No changes", "diff.loading": "Loading changes…", "diff.binary": "Binary file",
    "diff.more_lines": "{n} more lines; open the file to see them"
  },

  // How ages read in the sidebar and lists.
  "format": { "age": { "now": "now", "m": "{n}m", "h": "{n}h", "d": "{n}d", "w": "{n}w" } },

  // In-window notifications: shown at all, hidden after a few seconds, and how many recent ones `.app.notifications` keeps.
  "notifications": { "show": true, "autohide": true, "keep": 20 },

  // The command palette.
  "palette": { "placeholder": "Type a command or a worktree…", "worktrees": true, "worktree_label": "Go to {title}" },

  "settings_editor": { "width": 760 },

  // The macOS menu bar: `app` items join the a.box menu; each of `menus` is a menu of its own.
  // Items are {label, do} or {separator: true}.
  "menu_bar": { "app": [], "menus": [] },

  "sidebar": {
    // Which status a worktree shows when several apply (idle when none).
    "status_order": ["working", "waiting", "merged", "failing", "pending", "dirty", "behind"],
    // A section's orchestrator first, its workers after.
    "orchestrators_first": true,
    // Whose worktrees come first in a project shared by both machines.
    "host_order": ["mac", "box"]
  },

  // Back and forward: how many visits to remember.
  "nav": { "max": 200 },

  // The History list: how many past chats to fetch from each machine.
  "history": { "limit": 300 },

  // The mouse's extra buttons: an action each (back and forward default to nav.back / nav.forward).
  "mouse": { "back": "nav.back", "forward": "nav.forward", "middle": null },

  // Dragging: where a row's before/after split is, and how much of it means "inside".
  "drag": { "edge": 0.5, "inside_band": 0.25 },

  // inspect.json, activity.log and perf, for agents.
  "inspect": {
    "interval_ms": 500, "activity_lines": 400, "activity_chars": 600, "perf_window_secs": 2,
    "hook_events": 50, "transcript_items": 20, "transcript_chars": 2000, "terminal_lines": 40
  },

  "scripts_options": { "context_cache_ms": 250, "min_timer_ms": 16 },
  "settings_options": { "reload_debounce_ms": 80 },

  // Each machine's daemon and scripts (sent to it on connect and when settings change; kept in
  // ~/.agent-box/config.json there for bin/chat and sync-worker).
  "daemon": {
    "tool_text_max": 20000,              // cut tool output at this many characters (0: never)
    "tool_text_cut_note": "\n… (cut here; the full output is in the transcript file)",
    "drop_tool_images": true,            // drop image bytes from tool results
    "drop_tool_use_result": true,        // drop the toolUseResult copy from entries
    "events_poll_ms": 250, "events_batch": 500,
    "model_poll_ms": 2000, "model_debounce_ms": 250,
    "transcripts_poll_ms": 300,
    "warm_index_chats": 60,              // newest chats line-indexed at startup
    "transcript_page": 600, "history_limit": 200,
    "send_paste_wait_ms": 150, "send_enter_tries": 4, "send_enter_wait_ms": 350,
    "prompt_char": "❯",                  // Claude's input prompt ("" skips Enter retries)
    "escape_marks_idle": true,           // stop (Esc) marks the chat idle
    "connect_tries": 50, "connect_wait_ms": 200,
    "git_ttl_secs": 90, "git_at_once": 2, "mr_ttl_secs": 90,
    "hook_states": {},                   // {hook event: state, or null to ignore}, over the built-in map
    "waiting_notification_types": ["permission_prompt", "elicitation_dialog"],
    "idle_notification_prefix": "Claude is waiting for your input",
    "waiting_pattern": "(?i)Enter to select|Esc to cancel|Do you want to proceed|❯ 1\\. Yes",
    "waiting_pane_lines": 25,
    "suggestion_prompt": "❯\u00a0", "suggestion_rule": "──", "suggestion_placeholder_prefix": "Try \"",
    "diff_max_bytes": 3000000, "diff_max_untracked": 200, "diff_include_untracked": true, "diff_default_base": "origin/main",
    "terminal_mouse": false,             // tmux mouse mode on terminal shells (wheel scrolls tmux history)
    "terminal_history_limit": null,
    "chat_tmux_cols": 220, "chat_tmux_rows": 60, "rc_url_wait_secs": 45, "chat_send_pause_secs": 0.5, "supervise_secs": 30,
    "sync_transcript_max_mb": 95, "sync_bundle_warn_mb": 50, "sync_lock_wait_secs": 600
  }
}
