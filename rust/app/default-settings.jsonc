// Built-in defaults: super.engineering's layout, written in the same settings language you use.
// Override any part in your settings file; SETTINGS.md (next to it) documents every key.
{
  // The box: another machine (a Coder workspace) whose chats keep running while this Mac sleeps. It's
  // used once app.default_host is "box"; setup fills in ssh_host (its name in ~/.ssh/config).
  "connection": {
    "ssh_host": "",
    "daemon": "~/agent-box/rust/target/release/agent-boxd",
    "retry_seconds": 3,
    // Extra ssh arguments for the box connection.
    "ssh_options": ["-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"],
    // How often skills, CLAUDE.md, memory and hooks are copied to the box (bin/env-push); 0 turns it off.
    "env_push_seconds": 60,
    // The copy's command (null: env-push in app.bin_dir; {bin} is that folder).
    "env_push_command": null,
    // How often a dropped connection's process is checked for, to end it (ms).
    "watch_ms": 500
  },

  // This Mac: its worktrees, sections, and chats (super.engineering's, in place), through a local
  // agent-boxd. Chats here run on the Mac; the sidebar marks them with the mac host icon.
  "local": {
    "enabled": true,
    "daemon": "~/dev/agent-box/rust/target/release/agent-boxd"
  },

  "theme": {
    // Named shadows for `shadow` styles, beside the built-in sm/md/lg/xl: {color, x, y, blur, spread, inset} or a list.
    "shadows": {},
    // Right-click menu checkbox icons.
    "menu_check_icon": "square-check",
    "menu_uncheck_icon": "square",
    "animations": true,
    "font_ui": ".SystemUIFont",
    "font_mono": "Menlo",
    "window": "#212122",
    "card": "#1e1e1f",
    "line": "#323235",
    "text": "#f5f5f7",
    "text_muted": "#898a8e",
    "text_faint": "#6c6c70",
    "age": "#a8a8ad",
    "accent": "#488efc",
    "hover": "#28282b",
    "selection": "#272c35",
    "selection_border": "#485262",
    "pill": "#262626",
    "pill_hover": "#2e2e2e",
    "user_bubble": "#2c2c2e",
    "code_bg": "#171717",
    "composer": "#212121",
    "waiting_bg": "#2a2212",
    "claude": "#d97757",
    "tab_border": "#3b4350",
    "tab_bg": "#22262e",
    "diff_add": "#3fb950",
    "diff_del": "#e5534b",
    "diff_add_bg": "#1b2e21",
    "diff_del_bg": "#351d22",
    "diff_hunk_bg": "#21252c",
    "diff_file_bg": "#29292b",
    "warning": "#f0a43a",
    "danger": "#d8566c",
    "merged": "#8b5cf6",
    "success": "#3fb950",
    // The second line of the drag preview ("Move to …").
    "drag_preview_note": { "font_size": 11.5, "color": "@accent" },
    // Font files to load (absolute, ~/, or in the settings folder); use them by family name in font_family.
    "fonts": [],
    // Style objects over tooltips (background, color, padding, radius, font_size...) and the button of a
    // `select` node; `menu`: {min_width, max_height, scrollable} for menus. tooltip_delay_ms: wait before
    // a tooltip shows (unset: the built-in delay).
    "tooltip": {},
    "menu": {},
    "select": { "direction": "row", "align": "center", "gap": 6, "padding": [4, 10], "radius": 6, "border": 1, "border_color": "@line", "background": "@pill", "font_size": 12.5, "hover": { "background": "@pill_hover" } },
    "drag_preview": { "padding": [5, 10], "radius": 8, "background": "#2b2f38", "border": 1, "border_color": "#488efc", "color": "#f5f5f7", "font_size": 13, "shadow": "lg", "opacity": 0.95 }
  },

  // The logo: `logo` nodes, the Dock icon while the app runs, and the bundle icon (see SETTINGS.md, Logo).
  // art: SVG markup, or an .svg or image (png/jpg/webp) path. ink: an SVG's currentColor, and with
  // tint, the color an image is redrawn in (its transparency kept). tile: the rounded square behind it.
  "logo": {
    "art": "logo.png",
    "ink": "#111111",
    "tint": true,
    "tile": "#ffffff",
    "corner": 0.225,
    "padding": 0,
    "dock": { "margin": 0.098 }
  },

  // How things move. move: nodes glide to new positions after a change (give a node an `id` so it
  // glides even when moved to a different parent). enter: how nodes that appear after a change come
  // in. style: colors and sizes ease. Set "enabled": false to turn all motion off.
  "motion": {
    "enabled": true,
    // easing: "spring" | "ease_out" | "ease_out_quart" | "linear"; spring shape {c1, c3}.
    "move": { "duration": 320, "easing": "spring", "spring": { "c1": 1.2, "c3": 2.2 } },
    "enter": { "from": { "opacity": 0, "y": 8 }, "duration": 260, "easing": "ease_out_quart" },
    "style": { "duration": 180, "easing": "ease_out" },
    // Spinners: an icon name (null: the built-in loader) and one turn's length; `spin` icons turn at spin_period_ms.
    "spinner": { "icon": null, "period_ms": 800 },
    "spin_period_ms": 900,
    // How often spinners and pulsing lines redraw (each redraw repaints the window). 0 holds them still.
    "animation_fps": 30
  },

  "state": {
    "designer_open": false,
    "designer_width": 420,
    "sidebar_open": true,
    "terminal_open": true,
    "sidebar_width": 339,
    "terminal_height": 300,
    "bottom_tab": "terminal",
    "diff_base": "uncommitted",
    // Sidebar rows: "worktrees" (one row per worktree; its chats are tabs) or "chats" (each worktree's
    // chats listed under its row too).
    "sidebar_rows": "worktrees",
    // Projects: "merged" lists each repo once with every machine's worktrees (each marked with its
    // machine); "by_host" gives each machine its own copy of the project.
    "sidebar_projects": "merged",
    // Worktree order in each project and section: "manual" (as you drag them) or "recent" (newest
    // activity first). Dragging a worktree while sorted by recent switches to manual, with a notice.
    "sidebar_order": "manual",
    // Where the worktree's changes show: "bottom" (a tab beside the terminals) or "right" (a panel).
    "changes_place": "bottom",
    "changes_width": 560
  },

  "views": {
    "main": {
      "type": "row",
      "style": { "width": "full", "height": "full", "position": "relative" },
      "children": [
        { "type": "Sidebar", "id": "sidebar", "if": ".state.sidebar_open" },
        { "type": "MainArea", "id": "main-area", "style": { "grow": 1 } },
        { "type": "ChangesPanel", "id": "changes-panel", "if": ".state.changes_place == \"right\" and .selected.worktree" },
        { "type": "DesignerPanel", "id": "designer", "if": ".state.designer_open" },
        { "type": "Confirm", "id": "confirm" },
        { "type": "Setup", "id": "setup" }
      ]
    }
  },

  "components": {
    "Sidebar": {
      "about": "The left column: projects, sections, worktree rows, footer buttons. Resizable (state.sidebar_width).",
      "type": "stack",
      "style": { "width": "{{ .state.sidebar_width }}", "height": "full", "shrink": 0, "background": "@window" },
      "animate": { "from": { "opacity": 0, "x": -16 }, "duration": 180 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "id": "sidebar-header",
              "type": "row",
              "style": { "height": 44, "shrink": 0, "padding": [0, 0, 0, 88], "align": "center" },
              "children": [
                { "type": "IconButton", "id": "sidebar-toggle", "props": { "icon": "panel-left", "tooltip": "Hide sidebar  ⌘\\", "do": { "do": "state.toggle", "key": "sidebar_open" } } },
                { "type": "DesignerButton", "id": "designer-button" },
                { "id": "sidebar-drag", "type": "spacer", "style": { "height": "full" }, "on": { "mouse_down": "window.move", "double_click": "window.zoom" } }
              ]
            },
            {
              "id": "sidebar-list",
              "type": "scroll",
              "props": { "virtual": true },
              "style": { "grow": 1, "min_height": 0, "padding": [0, 6, 10, 6] },
              "children": [
                {
                  "id": "brand",
                  "type": "row",
                  "style": { "height": 34, "padding": [4, 8, 0, 6], "gap": 8, "align": "center" },
                  "children": [
                    { "id": "brand-logo", "type": "logo", "props": { "size": 24 } },
                    { "id": "brand-name", "type": "text", "props": { "text": "a.box" }, "style": { "font_size": 15, "font_weight": "semibold" } }
                  ]
                },
                {
                  "id": "projects-label",
                  "type": "SectionLabel",
                  "props": { "text": "Projects", "collapsed": "{{ .state[\"collapsed:projects\"] // false }}" },
                  "style": { "cursor": "pointer", "radius": 6 },
                  "tooltip": "{{ if .state[\"collapsed:projects\"] then \"Show\" else \"Hide\" end }} projects",
                  "on": { "click": { "do": "state.toggle", "key": "collapsed:projects" } },
                  "menu": [
                    { "label": "Sort by recent activity", "checked": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
                    { "label": "Sort manually", "checked": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
                    { "separator": true },
                    { "label": "{{ if .state[\"collapsed:projects\"] then \"Show\" else \"Hide\" end }} projects", "do": { "do": "state.toggle", "key": "collapsed:projects" } }
                  ]
                },
                {
                  "if": ".state[\"collapsed:projects\"] | not",
                  "for": ".app.drag as $d | .projects | map(select((($d.kind == \"project\" and $d.value == .repo) | not)))", "as": "p", "key": ".p.name",
                  "id": "project-drop",
                  "type": "column",
                  "drop_key": "projcard:{{ .p.repo }}",
                  "drop_zones": { "project": "edges" },
                  "on": { "drop_item": { "accept": "project", "do": { "do": "project.move", "target": "{{ .p.repo }}" } } },
                  "children": [
                    { "if": ".p.drop_gap", "type": "DropSlot" },
                    {
                      "id": "project-card",
                      "type": "column",
                      "children": [
                        {
                          "id": "project-row",
                          "type": "row",
                          "style": {
                            "position": "relative", "height": 37, "padding": [0, 8], "gap": 8, "align": "center", "radius": 8, "border": 1,
                            "border_color": "{{ if (.app.drop.key == (\"proj:\" + .p.repo) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"proj:\" + .p.repo) then \"@accent\" else \"transparent\" end }}",
                            "background": "{{ if (.app.drop.key == (\"proj:\" + .p.repo) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"proj:\" + .p.repo) then \"#488efc1a\" else \"transparent\" end }}",
                            "cursor": "pointer"
                          },
                          "drag": { "kind": "project", "value": "{{ .p.repo }}", "label": "{{ .p.name }}" },
                          "tooltip": "{{ if .state[\"collapsed:proj:\" + .p.repo] then \"Show\" else \"Hide\" end }} {{ .p.name }}'s worktrees",
                          "drop_key": "proj:{{ .p.repo }}",
                          "drop_zones": { "worktree": "inside" },
                          "menu": [
                            { "label": "Rename Project", "icon": "pencil", "do": { "do": "prompt", "title": "Rename project", "value": "{{ .p.name }}", "then": { "do": "state.set", "key": "project_name:{{ .p.repo }}", "value": "{{ .input }}" } } },
                            { "label": "Project settings", "icon": "settings", "do": { "do": "project.settings", "repo": "{{ .p.repo }}" } },
                            { "if": ".p.primary_path", "label": "View on GitLab", "icon": "gitlab", "do": { "do": "project.open_remote", "path": "{{ .p.primary_path }}" } },
                            { "separator": true },
                            { "label": "Show external worktrees", "checked": ".p.show_external", "do": { "do": "state.toggle", "key": "hide_external:{{ .p.repo }}" } },
                            { "label": "Show primary worktree", "checked": ".p.show_primary", "do": { "do": "state.toggle", "key": "hide_primary:{{ .p.repo }}" } },
                            { "if": ".p.hidden_count > 0", "label": "Show {{ .p.hidden_count }} hidden worktree{{ if .p.hidden_count == 1 then \"\" else \"s\" end }}", "icon": "eye", "do": { "do": "project.unhide", "repo": "{{ .p.repo }}" } },
                            { "label": "New worktree from…", "icon": "git-branch", "shortcut": "⌘⇧N", "do": { "do": "worktree.new", "repo": "{{ .p.repo }}", "host": "{{ .p.primary_host // .p.host }}" } },
                            { "separator": true },
                            { "label": "Remove Project", "icon": "trash", "danger": true, "do": { "do": "confirm", "title": "Remove {{ .p.name }} from the sidebar?", "text": "Its worktrees and chats stay on disk. Bring it back from the command palette (Restore removed projects).", "confirm": "Remove", "then": { "do": "state.set", "key": "removed_project:{{ .p.repo }}", "value": true } } }
                          ],
                          "on": {
                            "click": { "do": "state.toggle", "key": "collapsed:proj:{{ .p.repo }}" },
                            "drop_item": [
                              {
                                "accept": "worktree",
                                "valid": ".dragged as $d | [.worktrees[] | select(.path == $d)][0] as $w | $w.repo == .p.repo and $w.section != null",
                                "do": { "do": "worktree.move", "section": null }
                              }
                            ]
                          },
                          "children": [
                            { "type": "DropLine", "props": { "key": "proj:{{ .p.repo }}" } },
                            { "type": "Badge", "props": { "letter": "{{ .p.letter }}", "hue": "{{ .p.hue }}", "size": 22 } },
                            { "id": "project-name", "type": "text", "props": { "text": "{{ .p.name }}" }, "style": { "font_size": 14, "truncate": true, "min_width": 0, "shrink": 1 } },
                            { "type": "icon", "props": { "name": "{{ if .state[\"collapsed:proj:\" + .p.repo] then \"chevron-right\" else \"chevron-down\" end }}", "size": 12, "color": "@text_faint" } },
                            { "type": "spacer" },
                            { "for": ".p.hosts", "as": "h", "id": "project-host", "type": "HostIcon", "props": { "host": "{{ .h }}", "size": 12 } },
                            { "id": "project-new-chat", "type": "IconButton", "props": { "icon": "plus", "size": 22, "tooltip": "New chat in {{ .p.name }}", "do": { "do": "chat.new", "dir": "{{ ([.p.items[] | select(.is_primary)][0] // .p.items[0]).path }}" } } }
                          ]
                        },
                        {
                          "if": ".state[\"collapsed:proj:\" + .p.repo] | not",
                          "for": ".app.drag as $d | .p.items | map(select((($d.kind == \"worktree\" and $d.value == .path) | not)))", "as": "w", "key": ".w.path",
                          "id": "project-worktrees",
                          "type": "column",
                          "children": [
                            { "id": "wt-row", "type": "WorktreeRow", "props": { "w": "{{ .w }}", "in_section": false } },
                            { "id": "wt-chats", "type": "WorktreeChats", "props": { "w": "{{ .w }}", "indent": 40 } }
                          ]
                        }
                      ]
                    },
                    { "if": ".p.drop_gap_end", "type": "DropSlot" }
                  ]
                },
                {
                  "for": ".app.drag as $d | .sections | map(select((($d.kind == \"section\" and $d.value == .id) | not)))", "as": "s", "key": ".s.id",
                  "id": "section-drop",
                  "type": "column",
                  "drop_key": "seccard:{{ .s.id }}",
                  "drop_zones": { "section": "edges" },
                  "on": { "drop_item": { "accept": "section", "do": { "do": "section.move", "target": "{{ .s.id }}" } } },
                  "children": [
                    { "if": ".s.drop_gap", "type": "DropSlot" },
                    {
                      "id": "section-card",
                      "type": "column",
                      "children": [
                        {
                          "id": "section-label",
                          "type": "SectionLabel",
                          "props": {
                            "text": "{{ .s.name }}",
                            "drop_key": "sec:{{ .s.id }}",
                            "collapsed": "{{ (\"collapsed:\" + .s.id) as $k | if .state | has($k) then .state[$k] else .s.collapsed end }}"
                          },
                          "style": {
                            "position": "relative", "cursor": "pointer", "radius": 6,
                            "background": "{{ if (.app.drop.key == (\"sec:\" + .s.id) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"sec:\" + .s.id) then \"#488efc1a\" else \"transparent\" end }}",
                            "color": "{{ if (.app.drop.key == (\"sec:\" + .s.id) and .app.drop.zone == \"inside\") or .app.drag.into_key == (\"sec:\" + .s.id) then \"@accent\" else \"@text_muted\" end }}"
                          },
                          "drag": { "kind": "section", "value": "{{ .s.id }}", "label": "{{ .s.name }}" },
                          "drop_key": "sec:{{ .s.id }}",
                          "drop_zones": { "worktree": "inside" },
                          "on": {
                            "click": { "do": "state.toggle", "key": "collapsed:{{ .s.id }}", "default": "{{ .s.collapsed }}" },
                            "drop_item": [
                              {
                                "accept": "worktree",
                                "valid": ".s.items[0].path != .dragged",
                                "do": { "do": "worktree.move", "section": "{{ .s.id }}", "before": "{{ .s.items[0].path // \"\" }}" }
                              }
                            ]
                          },
                          "menu": [
                            { "label": "Rename…", "do": { "do": "section.rename", "id": "{{ .s.id }}" } },
                            { "separator": true },
                            { "label": "Sort by recent activity", "checked": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
                            { "label": "Sort manually", "checked": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
                            { "separator": true },
                            { "label": "Delete section", "do": { "do": "section.delete", "id": "{{ .s.id }}" } }
                          ]
                        },
                        {
                          "if": "(\"collapsed:\" + .s.id) as $k | if .state | has($k) then .state[$k] else .s.collapsed end | not",
                          "for": ".app.drag as $d | .s.items | map(select((($d.kind == \"worktree\" and $d.value == .path) | not)))",
                          "as": "w", "key": ".w.path",
                          "id": "section-worktrees",
                          "type": "column",
                          "children": [
                            {
                              "id": "wt-row",
                              "type": "WorktreeRow",
                              "props": {
                                "w": "{{ .w }}", "in_section": true,
                                "child": "{{ (.w.chats | any(.kind == \"orchestrator\") | not) and (.s.items | any(.chats | any(.kind == \"orchestrator\"))) }}"
                              }
                            },
                            { "id": "wt-chats", "type": "WorktreeChats", "props": { "w": "{{ .w }}", "indent": "{{ if (.w.chats | any(.kind == \"orchestrator\") | not) and (.s.items | any(.chats | any(.kind == \"orchestrator\"))) then 44 else 32 end }}" } }
                          ]
                        }
                      ]
                    },
                    { "if": ".s.drop_gap_end", "type": "DropSlot" }
                  ]
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "row",
              "style": { "height": 46, "shrink": 0, "padding": [0, 18], "gap": 4, "align": "center" },
              "children": [
                { "id": "footer-settings", "type": "IconButton", "props": { "icon": "settings", "tooltip": "Settings  ⌘,", "do": "settings.open" } },
                { "id": "footer-new-section", "type": "IconButton", "props": { "icon": "folder-plus", "tooltip": "New section", "do": "section.new" } },
                { "id": "footer-new-chat", "type": "IconButton", "props": { "icon": "plus", "tooltip": "New chat  ⌘N", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } } },
                { "type": "spacer" },
                {
                  "if": ".app.settings_error or (.app.errors | length > 0)",
                  "type": "text", "props": { "text": "settings error" },
                  "style": { "font_size": 11, "color": "@danger", "cursor": "pointer" },
                  "tooltip": "{{ [.app.settings_error // empty] + .app.errors | join(\"\\n\") }}",
                  "on": { "click": "settings.open" }
                },
                {
                  "type": "box",
                  "style": { "width": 7, "height": 7, "radius": 4, "background": "{{ if .app.connected then \"@success\" else \"@warning\" end }}" },
                  "tooltip": "{{ .app.status }}"
                }
              ]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "sidebar_width", "axis": "x", "min": 220, "max": 700 },
          "style": { "position": "absolute", "top": 0, "right": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "DesignerButton": {
      "about": "The painter's palette: opens the designer, a chat with an agent that redesigns this app live.",
      "type": "box",
      "style": {
        "width": 26, "height": 26, "shrink": 0, "radius": 6, "align": "center", "justify": "center", "cursor": "pointer",
        "background": "{{ if .state.designer_open then \"@selection\" else \"transparent\" end }}",
        "hover": { "background": "@hover" }, "active": { "opacity": 0.7 }
      },
      "tooltip": "Redesign the app with an agent  ⌘⇧D",
      "on": { "click": { "do": "state.toggle", "key": "designer_open" } },
      "children": [
        { "type": "icon", "props": { "name": "palette", "size": 15, "color": "{{ if .state.designer_open then \"@accent\" else \"@text_muted\" end }}", "spin": "{{ .designer.working }}" } }
      ]
    },

    "DesignerPanel": {
      "about": "The designer chat on the right: ask for any change and watch it happen. Resizable (state.designer_width).",
      "type": "stack",
      "style": { "width": "{{ .state.designer_width }}", "height": "full", "shrink": 0, "padding": [0, 14, 14, 0] },
      "animate": { "from": { "opacity": 0, "x": 28 }, "duration": 220 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "id": "designer-header",
              "type": "row",
              "style": { "height": 44, "shrink": 0, "gap": 8, "align": "center", "padding": [0, 4] },
              "on": { "mouse_down": "window.move", "double_click": "window.zoom" },
              "children": [
                { "type": "icon", "props": { "name": "palette", "size": 15, "color": "@accent" } },
                { "type": "text", "props": { "text": "Designer" }, "style": { "font_size": 13, "font_weight": "semibold" } },
                { "if": ".designer.working", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
                { "type": "spacer" },
                { "type": "IconButton", "props": { "icon": "undo-2", "tooltip": "Undo the last change", "do": "settings.undo" } },
                {
                  "id": "designer-history",
                  "type": "box",
                  "style": { "position": "relative" },
                  "children": [
                    { "type": "IconButton", "id": "designer-history-button", "props": { "icon": "rotate-ccw-clock", "tooltip": "Earlier designer conversations", "do": [{ "do": "state.toggle", "key": "designer_history_open" }, "designer.history"] } },
                    { "type": "IconButton", "if": ".state.designer_history_open", "id": "designer-history-button-above", "layer": "above", "motion": false, "style": { "position": "absolute", "top": 0, "left": 0 }, "props": { "icon": "rotate-ccw-clock", "tooltip": "Earlier designer conversations", "do": [{ "do": "state.toggle", "key": "designer_history_open" }, "designer.history"] } },
                    {
                      "if": ".state.designer_history_open and (.app.dragging | not)",
                      "type": "box", "layer": "top",
                      "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
                      "on": { "click": { "do": "state.set", "key": "designer_history_open", "value": false } }
                    },
                    {
                      "if": ".state.designer_history_open",
                      "id": "designer-history-list",
                      "type": "scroll", "layer": "top",
                      "style": { "position": "absolute", "top": 30, "right": -40, "width": 340, "max_height": 420, "padding": 6, "gap": 2, "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg" },
                      "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
                      "children": [
                        { "type": "text", "props": { "text": "Designer conversations" }, "style": { "padding": [4, 8, 6, 8], "font_size": 12, "color": "@text_faint" } },
                        { "if": "(.designer.sessions | length) == 0", "type": "text", "props": { "text": "No earlier conversations yet." }, "style": { "padding": [4, 8], "font_size": 13, "color": "@text_faint" } },
                        {
                          "for": ".designer.sessions", "as": "d", "key": ".d.id",
                          "type": "row",
                          "style": {
                            "padding": [6, 8], "gap": 8, "align": "center", "radius": 6, "cursor": "pointer", "font_size": 13,
                            "background": "{{ if .d.current then \"@selection\" else \"transparent\" end }}", "hover": { "background": "@hover" }
                          },
                          "tooltip": "{{ if .d.current then \"Showing now\" elif .designer.working then \"Wait for the designer to finish first\" else \"Continue this conversation\" end }}",
                          "on": { "click": [{ "do": "designer.open", "id": "{{ .d.id }}" }, { "do": "state.set", "key": "designer_history_open", "value": false }] },
                          "children": [
                            {
                              "type": "column", "style": { "grow": 1, "min_width": 0, "gap": 2 },
                              "children": [
                                { "type": "text", "props": { "text": "{{ .d.title }}" }, "style": { "truncate": true } },
                                { "type": "text", "props": { "text": "{{ .d.messages }} message{{ if .d.messages == 1 then \"\" else \"s\" end }} · began with “{{ .d.first }}”" }, "style": { "truncate": true, "font_size": 11.5, "color": "@text_faint" } }
                              ]
                            },
                            { "type": "text", "props": { "text": "{{ .d.age_text }}" }, "style": { "font_size": 12, "color": "@text_faint", "shrink": 0, "self": "start" } }
                          ]
                        }
                      ]
                    }
                  ]
                },
                { "type": "IconButton", "props": { "icon": "square-pen", "tooltip": "New designer conversation", "do": "designer.reset" } },
                { "type": "IconButton", "props": { "icon": "x", "tooltip": "Close", "do": { "do": "state.set", "key": "designer_open", "value": false } } }
              ]
            },
            {
              "type": "column",
              "style": { "grow": 1, "min_height": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden", "position": "relative" },
              "children": [
                {
                  "type": "transcript",
                  "props": { "chat": "designer", "empty": "Ask for any change and watch it happen: move the terminal beside the chat, show worktrees as cards, add a button that…" },
                  "style": { "grow": 1, "min_height": 0, "padding": [0, 4] }
                },
                {
                  "if": ".designer.working",
                  "id": "designer-progress",
                  "type": "row",
                  "style": { "gap": 8, "align": "center", "padding": [0, 16, 6, 16], "font_size": 12.5, "color": "@text_muted" },
                  "children": [
                    { "type": "spinner", "props": { "size": "xsmall", "color": "@accent" } },
                    { "type": "text", "props": { "text": "{{ if .designer.activity == \"\" then \"Working\" else .designer.activity end }}…" }, "style": { "truncate": true } }
                  ]
                },
                {
                  "type": "box",
                  "style": { "shrink": 0, "padding": [4, 12, 12, 12] },
                  "children": [
                    {
                      "style": { "radius": 10, "border": 1, "border_color": "@line", "background": "@composer", "padding": [6, 8, 6, 6], "gap": 6, "align": "center" },
                      "type": "row",
                      "children": [
                        { "type": "composer", "props": { "chat": "designer" }, "style": { "grow": 1, "min_width": 0 } },
                        {
                          "id": "designer-send",
                          "type": "box",
                          "tooltip": "Send  ↩   (⇧↩ new line)",
                          "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@accent", "cursor": "pointer", "opacity": "{{ if .designer.working then 0.4 else 1 end }}", "hover": { "opacity": 0.85 } },
                          "on": { "click": { "do": "composer.send", "chat": "designer" } },
                          "children": [{ "type": "icon", "props": { "name": "arrow-up", "size": 15, "color": "#ffffff" } }]
                        }
                      ]
                    }
                  ]
                },
                { "type": "DropOverlay", "props": { "chat": "designer", "name": "the designer" } }
              ]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "designer_width", "axis": "x", "invert": true, "min": 300, "max": 900 },
          "style": { "position": "absolute", "top": 0, "left": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "WorktreeRow": {
      "about": "One worktree in the sidebar. props: w (a worktree), in_section (bool: sections show the project badge and emoji), child (bool: a worker under the section's orchestrator, drawn indented with a tree line).",
      "type": "row",
      "style": {
        "height": "{{ if .props.w.drop_gap then 66 else 33 end }}",
        "padding": "{{ (if .props.w.drop_gap then 33 else 0 end) as $top | (if .props.child then [0, 12, 0, 30] elif .props.in_section then [0, 12, 0, 8] else [0, 12, 0, 27] end) | .[0] = $top }}",
        "gap": 8, "align": "center", "radius": 8, "border": 1, "cursor": "pointer",
        "border_color": "{{ if .props.w.selected then \"@selection_border\" else \"transparent\" end }}",
        "background": "{{ if .props.w.selected then \"@selection\" else \"transparent\" end }}",
        "hover": "{{ if .props.w.selected then {} else {\"background\": \"@hover\"} end }}",
        "position": "relative"
      },
      "on": {
        "click": { "do": "select", "worktree": "{{ .props.w.path }}" },
        "double_click": { "do": "worktree.label", "path": "{{ .props.w.path }}" },
        "drop_item": {
          "accept": "worktree",
          "valid": ".dragged as $d | .props.w as $t | .zone as $z | (if $t.section then [.sections[] | select(.id == $t.section.id) | .items[].path] else [.projects[] | select(.repo == $t.repo) | .items[].path] end) as $list | ($list | index($t.path)) as $ti | ($list | index($d)) as $di | $d != $t.path and ($t.section != null or ([.worktrees[] | select(.path == $d)][0].repo == $t.repo)) and ($di == null or ($z == \"before\" and $di != $ti - 1) or ($z == \"after\" and $di != $ti + 1))",
          "do": [
            {
              "do": "if", "cond": "{{ .state.sidebar_order == \"recent\" }}",
              "then": [
                { "do": "state.set", "key": "sidebar_order", "value": "manual" },
                { "do": "notify", "text": "Sidebar switched to manual order so your arrangement sticks. Right-click Projects to sort by recent activity again." }
              ]
            },
            { "do": "worktree.move", "section": "{{ .props.w.section.id }}", "target": "{{ .props.w.path }}" }
          ]
        }
      },
      "drag": { "kind": "worktree", "value": "{{ .props.w.path }}", "label": "{{ .props.w.title }}" },
      "drop_key": "wt:{{ .props.w.path }}",
      "drop_zones": "edges",
      "tooltip": "{{ .props.w.branch // \"\" }}",
      "menu": [
        { "label": "Rename feature label…", "do": { "do": "worktree.label", "path": "{{ .props.w.path }}" } },
        { "label": "Rename current branch", "do": { "do": "worktree.rename_branch", "path": "{{ .props.w.path }}" } },
        { "label": "Hide worktree", "do": { "do": "state.set", "key": "hidden:{{ .props.w.path }}", "value": true } },
        { "separator": true },
        {
          "label": "New section",
          "items": [
            { "label": "With this worktree…", "do": { "do": "section.new", "assign": "{{ .props.w.path }}" } },
            { "label": "Empty…", "do": "section.new" }
          ]
        },
        { "separator": true },
        { "label": "Copy path", "shortcut": "⌘⇧C", "do": { "do": "clipboard.copy", "text": "{{ .props.w.path }}" } },
        { "if": ".props.w.host == \"mac\"", "label": "Open in Finder", "do": { "do": "shell", "run": "open \"$P\"", "env": { "P": "{{ .props.w.path }}" } } },
        { "if": ".props.w.host == \"mac\"", "label": "Open in Terminal", "do": { "do": "shell", "run": "open -a Terminal \"$P\"", "env": { "P": "{{ .props.w.path }}" } } },
        {
          "if": ".props.w.host != \"mac\"", "label": "Open in Terminal",
          "do": {
            "do": "shell",
            "run": "osascript -e 'on run argv' -e 'tell application \"Terminal\" to do script \"ssh -t \" & item 1 of argv & \" \" & quoted form of (\"cd \" & quoted form of (item 2 of argv) & \" && exec $SHELL -l\")' -e 'tell application \"Terminal\" to activate' -e 'end run' \"$H\" \"$P\"",
            "env": { "P": "{{ .props.w.path }}", "H": "{{ .app.ssh_host }}" }
          }
        },
        { "if": ".props.w.is_primary | not", "separator": true },
        { "if": ".props.w.is_primary | not", "label": "Delete worktree", "danger": true, "do": { "do": "confirm", "title": "Delete {{ .props.w.title }}?", "text": "Removes the worktree folder, with any uncommitted changes in it. The branch stays.", "confirm": "Delete", "then": { "do": "worktree.delete", "path": "{{ .props.w.path }}" } } },
        { "separator": true },
        { "label": "{{ if .props.w.pinned then \"Unpin\" else \"Pin\" end }} worktree", "do": { "do": "state.toggle", "key": "pinned:{{ .props.w.path }}" } },
        {
          "label": "Move to section",
          "items": [
            { "for": ".props.w.section.id as $cur | [.sections[] | select(.id != $cur)]", "as": "s", "label": "{{ .s.name }}", "do": { "do": "section.assign", "path": "{{ .props.w.path }}", "section": "{{ .s.id }}" } }
          ]
        },
        { "if": ".props.w.section", "label": "Remove from section", "do": { "do": "section.assign", "path": "{{ .props.w.path }}", "section": null } }
      ],
      "children": [
        { "if": ".props.w.drop_room | not", "type": "DropLine", "props": { "key": "wt:{{ .props.w.path }}" } },
        {
          "if": ".props.w.drop_gap",
          "id": "wt-drop-slot",
          "type": "row",
          "motion": false,
          "style": {
            "position": "absolute", "top": 3, "left": 4, "right": 4, "height": 27, "radius": 7, "border": 1, "padding": [0, 10],
            "align": "center", "gap": 6, "font_size": 12.5,
            "border_color": "{{ if .app.drag.into then \"@accent\" else \"@line\" end }}",
            "background": "{{ if .app.drag.into then \"#488efc1a\" else \"#ffffff08\" end }}",
            "color": "@accent"
          },
          "children": [
            { "if": ".app.drag.into", "type": "icon", "props": { "name": "folder-input", "size": 12, "color": "@accent" } },
            { "if": ".app.drag.into", "type": "text", "props": { "text": "Move to {{ .app.drag.into }}" }, "style": { "truncate": true, "min_width": 0 } }
          ]
        },
        { "if": ".props.child", "type": "icon", "props": { "name": "corner-down-right", "size": 12, "color": "@text_faint" }, "style": { "margin": [0, -2, 0, -14] } },
        { "if": ".props.w.chats | any(.kind == \"orchestrator\")", "type": "icon", "props": { "name": "workflow", "size": 14, "color": "@accent" }, "tooltip": "Orchestrator" },
        { "if": ".props.in_section and (.props.w.chats | any(.kind == \"orchestrator\") | not)", "type": "Badge", "props": { "letter": "{{ .props.w.letter }}", "hue": "{{ .props.w.hue }}", "size": 16 } },
        { "if": ".props.in_section and .props.w.emoji", "type": "text", "props": { "text": "{{ .props.w.emoji }}" }, "style": { "width": 16, "shrink": 0, "font_size": 14 } },
        {
          "type": "row",
          "style": { "grow": 1, "min_width": 0, "gap": 6, "align": "center" },
          "children": [
            { "type": "text", "props": { "text": "{{ if .props.in_section then .props.w.label else .props.w.title end }}" }, "style": { "truncate": true, "font_size": 14 } },
            { "if": ".props.w.is_primary", "type": "icon", "props": { "name": "star-fill", "size": 11, "color": "@text_muted" } },
            { "if": ".props.w.pinned", "type": "icon", "props": { "name": "pin", "size": 11, "color": "@text_muted" }, "tooltip": "Pinned" },
            { "id": "wt-host", "type": "HostIcon", "props": { "host": "{{ .props.w.host }}", "size": 11 } },
            { "for": ".props.w.host as $h | [.props.w.chats[] | select(.open) | .host] | unique | map(select(. != $h))", "as": "h", "type": "HostIcon", "props": { "host": "{{ .h }}", "size": 11 } }
          ]
        },
        { "type": "StatusIcon", "props": { "status": "{{ .props.w.status }}" } },
        { "type": "text", "props": { "text": "{{ .props.w.age_text }}" }, "style": { "min_width": 22, "text_align": "right", "font_size": 12.5, "color": "@age" } }
      ]
    },

    "DropLine": {
      "about": "The insertion line shown above or below a drop target while dragging. props: key (the target's drop_key). Its parent needs position: relative.",
      "type": "box",
      "motion": false,
      "if": ".app.drop.key == .props.key and (.app.drop.zone == \"before\" or .app.drop.zone == \"after\")",
      "style": {
        "position": "absolute", "left": 6, "right": 6, "height": 2, "radius": 1, "background": "@accent",
        "top": "{{ if .app.drop.zone == \"before\" then -3 else null end }}",
        "bottom": "{{ if .app.drop.zone == \"after\" then -3 else null end }}"
      }
    },

    "StatusIcon": {
      "about": "A small icon for a worktree status. props: status (working | waiting | merged | failing | pending | dirty | behind | idle).",
      "type": "box",
      "style": { "width": 14, "align": "center", "justify": "center" },
      "children": [
        { "if": ".props.status == \"working\"", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
        { "if": ".props.status == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 12, "color": "@warning" }, "tooltip": "Waiting for you" },
        { "if": ".props.status == \"merged\"", "type": "icon", "props": { "name": "circle-check", "size": 12, "color": "@merged" }, "tooltip": "Merged" },
        { "if": ".props.status == \"failing\"", "type": "icon", "props": { "name": "circle-x", "size": 12, "color": "@danger" }, "tooltip": "Checks failing" },
        { "if": ".props.status == \"pending\"", "type": "icon", "props": { "name": "loader", "size": 12, "color": "@warning" }, "tooltip": "Checks running" },
        { "if": ".props.status == \"dirty\"", "type": "icon", "props": { "name": "arrow-up", "size": 12, "color": "@age" }, "tooltip": "Unpushed work" },
        { "if": ".props.status == \"behind\"", "type": "icon", "props": { "name": "arrow-down", "size": 12, "color": "@age" }, "tooltip": "Behind its base" }
      ]
    },

    "DropOverlay": {
      "about": "While files are dragged over the window: one drop target covering a whole chat (its messages and its message box), naming where they'll go. Put it last in a position: relative container. props: chat (id, or designer), name.",
      "if": ".app.dragging and (.app.drag | not) and .props.chat != null and .props.chat != \"\"",
      "type": "column",
      "motion": false,
      "style": {
        "position": "absolute", "top": 8, "left": 8, "right": 8, "bottom": 8, "align": "center", "justify": "center", "gap": 8,
        "radius": 12, "border": 2, "border_color": "@accent", "background": "#488efc1f", "font_size": 14, "color": "@text",
        "opacity": 0, "drag_over": { "opacity": 1 }
      },
      "on": { "drop": { "do": "chat.attach", "chat": "{{ .props.chat }}" } },
      "children": [
        { "type": "icon", "props": { "name": "paperclip", "size": 22, "color": "@accent" } },
        { "type": "text", "props": { "text": "Drop to attach to {{ .props.name }}" } }
      ]
    },

    "DropSlot": {
      "about": "The room a dragged section or project opens where it would land (sections and projects get drop_gap / drop_gap_end while one is dragged over them).",
      "type": "box",
      "motion": false,
      "style": { "height": 34, "margin": [0, 0, 8, 0], "radius": 6, "border": 1, "border_color": "@accent", "background": "#488efc1a" }
    },

    "SectionLabel": {
      "about": "A small grey heading. props: text, collapsed (bool: shows a chevron), drop_key (shows drop lines for reordering).",
      "type": "row",
      "style": { "height": 34, "padding": [12, 8, 0, 8], "gap": 5, "align": "center", "font_size": 13, "color": "@text_muted" },
      "children": [
        { "if": ".props.drop_key", "type": "DropLine", "props": { "key": "{{ .props.drop_key }}" } },
        { "type": "text", "props": { "text": "{{ .props.text }}" } },
        { "if": ".props.collapsed", "type": "icon", "props": { "name": "chevron-right", "size": 12 } }
      ]
    },

    "Badge": {
      "about": "A rounded letter tile tinted by hue. props: letter, hue (0-360), size.",
      "type": "box",
      "style": {
        "width": "{{ .props.size // 16 }}", "height": "{{ .props.size // 16 }}", "shrink": 0,
        "radius": "{{ if (.props.size // 16) > 18 then 5 else 4 end }}", "align": "center", "justify": "center",
        "background": "hsl({{ .props.hue // 210 }}, 24, 26)", "color": "hsl({{ .props.hue // 210 }}, 25, 76)",
        "font_size": "{{ if (.props.size // 16) > 18 then 13 else 9.5 end }}"
      },
      "children": [{ "type": "text", "props": { "text": "{{ .props.letter }}" } }]
    },

    "IconButton": {
      "about": "A square icon button. props: icon (Lucide name), do (action), tooltip, size (default 26), icon_size (15), icon_color (@text_muted).",
      "type": "box",
      "style": {
        "width": "{{ .props.size // 26 }}", "height": "{{ .props.size // 26 }}", "shrink": 0, "radius": 6,
        "align": "center", "justify": "center", "cursor": "pointer", "hover": { "background": "@hover" }, "active": { "opacity": 0.7 }
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": "{{ .props.do }}" },
      "children": [{ "type": "icon", "props": { "name": "{{ .props.icon }}", "size": "{{ .props.icon_size // 15 }}", "color": "{{ .props.icon_color // \"@text_muted\" }}" } }]
    },

    "Pill": {
      "about": "A rounded button with text and an optional icon. props: text, icon, do, tooltip, mono (bool).",
      "type": "row",
      "style": {
        "height": 26, "padding": [0, 10], "gap": 6, "align": "center", "radius": 13, "border": 1, "border_color": "@line",
        "background": "@pill", "hover": { "background": "@pill_hover" }, "active": { "opacity": 0.75 },
        "font_size": 12.5, "cursor": "pointer", "font_family": "{{ if .props.mono then \"@font_mono\" else \"@font_ui\" end }}"
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": "{{ .props.do }}" },
      "children": [
        { "if": ".props.icon", "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 13 } },
        { "if": ".props.text", "type": "text", "props": { "text": "{{ .props.text }}" } }
      ]
    },

    "MainArea": {
      "about": "The right side: toolbar, chat card, branch bar, terminal card.",
      "type": "column",
      "style": { "height": "full", "min_width": 0, "padding": [0, 14, 14, 0] },
      "children": [
        { "type": "Toolbar", "id": "toolbar" },
        { "type": "ChatCard", "id": "chat-card", "style": { "grow": 1, "min_height": 160 } },
        { "type": "BranchBar", "id": "branch-bar" },
        { "if": ".state.terminal_open", "type": "TerminalCard", "id": "terminal-card" }
      ]
    },

    "Toolbar": {
      "about": "The title bar: sidebar toggle (when hidden), worktree and chat, status, IDE and MR buttons. Drag it to move the window.",
      "type": "row",
      "style": { "height": 44, "shrink": 0, "gap": 8, "align": "center", "padding": [0, 0, 0, "{{ if .state.sidebar_open then 23 else 88 end }}"] },
      "children": [
        { "if": ".state.sidebar_open | not", "type": "IconButton", "id": "sidebar-toggle", "props": { "icon": "panel-left", "size": 24, "tooltip": "Show sidebar  ⌘\\", "do": { "do": "state.toggle", "key": "sidebar_open" } } },
        { "if": ".state.sidebar_open | not", "type": "DesignerButton", "id": "designer-button", "style": { "margin": [0, 8, 0, 0] } },
        {
          "id": "nav-buttons",
          "type": "row",
          "style": { "gap": 0, "align": "center", "margin": [0, 4, 0, -6] },
          "children": [
            { "type": "box", "style": { "opacity": "{{ if .app.nav.back then 1 else 0.35 end }}" }, "children": [{ "type": "IconButton", "id": "nav-back", "props": { "icon": "chevron-left", "size": 24, "tooltip": "Back  ⌘[", "do": "nav.back" } }] },
            { "type": "box", "style": { "opacity": "{{ if .app.nav.forward then 1 else 0.35 end }}" }, "children": [{ "type": "IconButton", "id": "nav-forward", "props": { "icon": "chevron-right", "size": 24, "tooltip": "Forward  ⌘]", "do": "nav.forward" } }] }
          ]
        },
        { "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "background": "{{ if .selected.chat.alive then \"@success\" else \"@text_faint\" end }}" } },
        {
          "if": ".selected.worktree",
          "type": "row",
          "style": { "gap": 8, "align": "center" },
          "children": [
            { "type": "Badge", "props": { "letter": "{{ .selected.worktree.letter }}", "hue": "{{ .selected.worktree.hue }}", "size": 16 } },
            { "type": "text", "props": { "text": "{{ .selected.worktree.title }}" }, "style": { "font_size": 13 } },
            { "if": ".selected.chat", "type": "icon", "props": { "name": "chevron-right", "size": 12, "color": "@text_faint" } },
            { "if": ".selected.chat", "type": "text", "props": { "text": "{{ .selected.chat.name }}" }, "style": { "font_size": 12, "color": "@age" } },
            { "if": ".selected.worktree.uncommitted > 0", "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "background": "@warning" }, "tooltip": "Uncommitted changes" }
          ]
        },
        { "id": "toolbar-drag", "type": "spacer", "style": { "height": "full" }, "on": { "mouse_down": "window.move", "double_click": "window.zoom" } },
        { "type": "CostButton", "id": "usage-cost" },
        { "type": "PlanButton", "id": "usage-plan" },
        {
          "id": "history",
          "type": "box",
          "style": { "position": "relative" },
          "children": [
            { "type": "IconButton", "id": "history-button", "props": { "icon": "clock", "size": 26, "tooltip": "History: past and closed chats on every machine", "do": [{ "do": "state.toggle", "key": "history_open" }, "history.load"] } },
            { "type": "IconButton", "if": ".state.history_open", "id": "history-button-above", "layer": "above", "motion": false, "style": { "position": "absolute", "top": 0, "left": 0 }, "props": { "icon": "clock", "size": 26, "tooltip": "History: past and closed chats on every machine", "do": [{ "do": "state.toggle", "key": "history_open" }, "history.load"] } },
            {
              "if": ".state.history_open and (.app.dragging | not)",
              "type": "box",
              "layer": "top",
              "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
              "on": { "click": { "do": "state.set", "key": "history_open", "value": false } }
            },
            {
              "if": ".state.history_open",
              "id": "history-panel",
              "type": "column",
              "layer": "top",
              "style": {
                "position": "absolute", "top": 32, "right": -6, "width": 460, "max_height": 560, "padding": 8, "gap": 6,
                "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
              },
              "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
              "children": [
                {
                  "type": "row",
                  "style": { "gap": 8, "align": "center", "padding": [2, 4] },
                  "children": [
                    { "type": "icon", "props": { "name": "search", "size": 14, "color": "@text_faint" } },
                    { "id": "history-search", "type": "input", "props": { "state": "history_query", "placeholder": "Search chats by name or folder", "autofocus": true, "appearance": false }, "style": { "grow": 1 } },
                    { "if": ".app.history_loading", "type": "spinner", "props": { "size": "xsmall" } }
                  ]
                },
                { "type": "divider" },
                {
                  "type": "scroll",
                  "style": { "max_height": 480, "gap": 1 },
                  "children": [
                    { "if": "(.history | length) == 0 and (.app.history_loading | not)", "type": "text", "props": { "text": "No past chats yet." }, "style": { "padding": 10, "font_size": 13, "color": "@text_faint" } },
                    {
                      "for": "(.state.history_query // \"\" | ascii_downcase) as $q | [.history[] | select($q == \"\" or ((.name // \"\") | ascii_downcase | contains($q)) or ((.folder // \"\") | ascii_downcase | contains($q)))] | .[:150]",
                      "as": "h", "key": ".h.host + .h.id",
                      "type": "row",
                      "style": { "height": 40, "padding": [0, 8], "gap": 10, "align": "center", "radius": 8, "cursor": "pointer", "hover": { "background": "@hover" } },
                      "tooltip": "{{ .h.dir // \"\" }}",
                      "on": { "click": [{ "do": "chat.open", "chat": "{{ .h.id }}", "host": "{{ .h.host }}" }, { "do": "state.set", "key": "history_open", "value": false }] },
                      "children": [
                        { "type": "HostIcon", "props": { "host": "{{ .h.host }}", "size": 13 } },
                        {
                          "type": "column",
                          "style": { "grow": 1, "min_width": 0 },
                          "children": [
                            { "type": "text", "props": { "text": "{{ .h.name }}" }, "style": { "font_size": 13, "truncate": true } },
                            { "type": "text", "props": { "text": "{{ .h.folder }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "truncate": true } }
                          ]
                        },
                        { "if": ".h.closed | not", "type": "text", "props": { "text": "open" }, "style": { "font_size": 11, "color": "@accent" } },
                        { "type": "text", "props": { "text": "{{ .h.age_text }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "shrink": 0 } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "status-pill", "type": "Pill", "props": { "text": "{{ if .app.connected then \"a.box\" else .app.status end }}", "mono": true, "tooltip": "{{ .app.status }}", "do": "palette.open" } },
        { "if": ".selected.worktree", "type": "Pill", "props": { "icon": "square-terminal", "tooltip": "Open in Cursor", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"cursor://file\" + .selected.worktree.path else \"cursor://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } } },
        { "if": ".selected.worktree", "type": "Pill", "props": { "icon": "code", "tooltip": "Open in VS Code", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"vscode://file\" + .selected.worktree.path else \"vscode://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } } },
        { "if": ".selected.worktree.mr", "type": "Pill", "props": { "text": "!{{ .selected.worktree.mr.number }}", "icon": "git-pull-request", "tooltip": "Open the merge request", "do": { "do": "open", "url": "{{ .selected.worktree.mr.url }}" } } }
      ]
    },

    "Card": {
      "about": "A rounded panel.",
      "type": "column",
      "style": { "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" }
    },

    "ChatCard": {
      "about": "Chat tabs, the transcript, a waiting card when the agent needs you, and the composer. Drop files on the transcript or composer to attach them.",
      "type": "column",
      "style": { "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
      "children": [
        { "type": "ChatTabs" },
        {
          "type": "column",
          "style": { "grow": 1, "min_height": 0, "position": "relative" },
          "children": [
            {
              "id": "transcript",
              "type": "transcript",
              "props": { "empty": "{{ if .selected.worktree then \"No chat in this worktree yet. Press + above to start one.\" else \"Select a worktree\" end }}" },
              "style": { "grow": 1, "min_height": 0 }
            },
            {
              "if": ".selected.chat.status == \"running_elsewhere\"",
              "id": "elsewhere-banner",
              "type": "row",
              "style": { "gap": 10, "padding": [8, 14], "margin": [0, 28, 8, 28], "align": "center", "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "font_size": 13, "width": "full", "max_width": 860, "self": "center" },
              "children": [
                { "type": "icon", "props": { "name": "eye", "size": 14, "color": "@text_muted" } },
                { "type": "text", "props": { "text": "Running in super.engineering. You're watching; send a message or take it over to continue here." }, "style": { "grow": 1, "color": "@text_muted" } },
                { "type": "Pill", "id": "elsewhere-take-over", "props": { "text": "Take it over", "icon": "arrow-down-to-line", "do": { "do": "chat.take_over", "chat": "{{ .selected.chat.id }}" } } }
              ]
            },
            { "id": "waiting", "type": "waiting", "style": { "padding": [0, 28, 10, 28], "width": "full", "max_width": 916, "self": "center" } },
            {
              "if": ".selected.chat",
              "id": "composer-box",
              "type": "box",
              "style": { "shrink": 0, "padding": [4, 20, 14, 20], "width": "full", "max_width": 900, "self": "center", "position": "relative" },
              "children": [
                { "type": "Completions", "props": { "chat": "{{ .selected.chat.id }}" } },
                { "type": "Queued", "props": { "c": "{{ .selected.chat }}" } },
                {
                  "if": ".selected.chat.kind == \"subagent\"",
                  "id": "subagent-note",
                  "type": "row",
                  "style": { "padding": [8, 12], "gap": 8, "align": "center", "radius": 10, "border": 1, "border_color": "@line", "font_size": 13, "color": "@text_muted" },
                  "children": [
                    { "type": "icon", "props": { "name": "bot", "size": 14 } },
                    { "type": "text", "props": { "text": "A subagent's conversation, shown as it runs. Reply in its parent chat." } }
                  ]
                },
                {
                  "if": ".selected.chat.kind != \"subagent\"",
                  "id": "composer-frame",
                  "type": "row",
                  "style": { "radius": 10, "border": 1, "border_color": "@line", "background": "@composer", "padding": [6, 8, 6, 6], "gap": 6, "align": "end" },
                  "children": [
                    { "type": "composer", "style": { "grow": 1, "min_width": 0 } },
                    {
                      "if": ".selected.chat.state == \"working\"",
                      "id": "composer-stop",
                      "type": "box",
                      "tooltip": "Stop the agent (Esc in the chat)",
                      "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@text", "cursor": "pointer", "hover": { "opacity": 0.85 } },
                      "on": { "click": { "do": "chat.interrupt", "chat": "{{ .selected.chat.id }}" } },
                      "children": [{ "type": "box", "style": { "width": 10, "height": 10, "radius": 2, "background": "@composer" } }]
                    },
                    {
                      "if": ".selected.chat.state != \"working\"",
                      "id": "composer-send",
                      "type": "box",
                      "tooltip": "Send  ↩   (⇧↩ new line)",
                      "style": { "width": 28, "height": 28, "shrink": 0, "radius": 14, "align": "center", "justify": "center", "background": "@accent", "cursor": "pointer", "hover": { "opacity": 0.85 } },
                      "on": { "click": { "do": "composer.send", "chat": "{{ .selected.chat.id }}" } },
                      "children": [{ "type": "icon", "props": { "name": "arrow-up", "size": 15, "color": "#ffffff" } }]
                    }
                  ]
                },
                {
                  "if": "(.selected.background | length) > 0",
                  "id": "background-work",
                  "type": "row",
                  "style": { "padding": [8, 2, 0, 2], "gap": 6, "wrap": true, "align": "center" },
                  "children": [
                    {
                      "for": ".selected.background", "as": "b", "key": ".b.tool_id", "id": "background-chip",
                      "type": "row",
                      "style": {
                        "height": 26, "padding": [0, 10], "gap": 6, "align": "center", "radius": 13, "border": 1, "border_color": "@line",
                        "font_size": 12.5, "color": "@text_muted", "cursor": "pointer", "max_width": 320, "hover": { "color": "@text", "background": "@hover" }
                      },
                      "tooltip": "{{ if .b.kind == \"shell\" then \"Running in the background. Click to follow its output in a terminal tab.\" else \"A subagent at work. Click to open its conversation in a tab.\" end }}",
                      "on": {
                        "click": {
                          "do": "if", "cond": "{{ .b.kind == \"shell\" }}",
                          "then": { "do": "shell.open", "task": "{{ .b.task_id }}", "output": "{{ .b.output }}", "label": "{{ .b.label }}" },
                          "else": { "do": "subagent.open", "chat": "{{ .b.chat }}", "agent": "{{ .b.agent }}", "label": "{{ .b.label }}" }
                        }
                      },
                      "children": [
                        { "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
                        { "type": "icon", "props": { "name": "{{ if .b.kind == \"shell\" then \"square-terminal\" else \"bot\" end }}", "size": 12 } },
                        { "type": "text", "props": { "text": "{{ .b.label }}" }, "style": { "truncate": true, "min_width": 0 } }
                      ]
                    }
                  ]
                }
              ]
            },
            { "type": "DropOverlay", "props": { "chat": "{{ .selected.chat.id }}", "name": "“{{ .selected.chat.name }}”" } }
          ]
        }
      ]
    },

    "ChatTabs": {
      "about": "Tabs for the selected worktree's open chats (a chat is open while its agent's process runs; closing a tab stops it), a placeholder while a new chat starts, + for a new chat, and the worktree's closed chats under the clock. Drag tabs to reorder them.",
      "type": "row",
      "style": { "height": 32, "shrink": 0, "padding": [0, 0, 0, 6], "align": "stretch" },
      "children": [
        {
          "id": "chat-tabs-scroll",
          "type": "scroll",
          "props": { "axis": "x", "handle": "chat_tabs" },
          "style": { "direction": "row", "align": "stretch", "basis": "auto", "shrink": 1, "min_width": 0 },
          "children": [
            {
              "for": ".app.drag as $d | .selected.chats | map(select(.open and (($d.kind == \"chat\" and $d.value == .id) | not)))", "as": "c", "key": ".c.id", "id": "chat-tab",
              "type": "row",
              "style": {
                "position": "relative", "gap": 6, "padding": [0, 4, 0, 10], "align": "center", "font_size": 13, "cursor": "pointer", "shrink": 0,
                "color": "{{ if .c.active then \"@text\" else \"@age\" end }}", "hover": { "color": "@text" }
              },
              "on": {
                "click": { "do": "select", "chat": "{{ .c.id }}" },
                "drop_item": { "accept": "chat", "valid": ".dragged != .c.id", "do": { "do": "tab.move", "target": "{{ .c.id }}" } }
              },
              "drag": { "kind": "chat", "value": "{{ .c.id }}", "label": "{{ .c.name }}" },
              "drop_key": "tab:{{ .c.id }}",
              "drop_zones": "edges_x",
              "tooltip": "{{ .agents[.c.agent].name // .c.agent }} · {{ .hosts[.c.host].label // .c.host }} · {{ .c.state }}",
              "menu": [
                { "label": "Move {{ if .selected.move.scope == \"section\" then \"section\" elif .selected.move.scope == \"worktree\" then \"worktree\" else \"chat\" end }} to {{ if .c.host == \"box\" then \"the Mac\" else \"the cloud\" end }}", "do": { "do": "chat.move", "chat": "{{ .c.id }}", "to": "{{ if .c.host == \"box\" then \"mac\" else \"box\" end }}" } },
                { "if": ".selected.move.scope != \"chat\"", "label": "Move only this chat to {{ if .c.host == \"box\" then \"the Mac\" else \"the cloud\" end }}", "do": { "do": "chat.move", "chat": "{{ .c.id }}", "scope": "chat", "to": "{{ if .c.host == \"box\" then \"mac\" else \"box\" end }}" } },
                { "if": ".c.alive | not", "label": "Start", "do": { "do": "chat.start", "chat": "{{ .c.id }}" } },
                { "label": "Fork chat", "do": { "do": "chat.fork", "chat": "{{ .c.id }}" } },
                { "separator": true },
                { "label": "Close tab", "do": { "do": "if", "cond": "{{ .c.state == \"working\" or .c.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .c.name }}”?", "text": "It's still working. Closing the tab stops its {{ .agents[.c.agent].name // \"agent\" }} process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .c.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .c.id }}" } } },
                { "label": "Archive", "do": { "do": "chat.archive", "chat": "{{ .c.id }}" } }
              ],
              "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
              "children": [
                { "type": "DropLineX", "props": { "key": "tab:{{ .c.id }}" } },
                { "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 12 } },
                { "type": "AgentIcon", "props": { "agent": "{{ .c.agent }}", "size": 12 } },
                { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "max_width": 240, "truncate": true } },
                { "if": ".c.state == \"working\"", "type": "spinner", "props": { "size": "xsmall" } },
                { "if": ".c.state == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 12, "color": "@warning" } },
                {
                  "id": "chat-tab-close",
                  "type": "box",
                  "style": { "width": 18, "height": 18, "radius": 4, "align": "center", "justify": "center", "opacity": "{{ if .c.active then 0.9 else 0.45 end }}", "hover": { "background": "@hover", "opacity": 1 } },
                  "tooltip": "Close tab (stops the chat)",
                  "on": { "click": { "do": "if", "cond": "{{ .c.state == \"working\" or .c.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .c.name }}”?", "text": "It's still working. Closing the tab stops its {{ .agents[.c.agent].name // \"agent\" }} process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .c.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .c.id }}" } } },
                  "children": [{ "type": "icon", "props": { "name": "x", "size": 11, "color": "@text_muted" } }]
                },
                { "if": ".c.active", "type": "box", "style": { "position": "absolute", "left": 0, "right": 0, "bottom": 0, "height": 2, "background": "@accent" } }
              ]
            }
          ]
        },
        {
          "if": ".app.starting != null and .app.starting == .selected.worktree.path",
          "id": "chat-tab-starting",
          "type": "row",
          "style": { "gap": 7, "padding": [0, 12], "align": "center", "font_size": 13, "color": "@text_muted" },
          "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
          "children": [{ "type": "spinner", "props": { "size": "xsmall" } }, { "type": "text", "props": { "text": "Starting…" } }]
        },
        {
          "if": ".selected.worktree",
          "id": "chat-tab-new",
          "type": "row",
          "style": { "padding": [0, 10], "gap": 4, "align": "center", "shrink": 0, "color": "@text_muted", "cursor": "pointer", "hover": { "color": "@text" } },
          "tooltip": "New chat here  ⌘N (right-click: pick the agent)",
          "on": { "click": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
          "menu": [
            { "label": "New Claude chat", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}", "agent": "claude" } },
            { "label": "New Codex chat", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}", "agent": "codex" } }
          ],
          "children": [{ "type": "icon", "props": { "name": "plus", "size": 13 } }]
        },
        { "type": "spacer" },
        { "if": ".selected.chats | any(.open | not)", "id": "chat-tab-divider", "type": "divider", "props": { "axis": "y" }, "style": { "height": 14, "self": "center", "margin": [0, 4] } },
        {
          "if": ".selected.chats | any(.open | not)",
          "id": "chat-history",
          "type": "row",
          "style": { "position": "relative", "padding": [0, 4], "align": "center", "shrink": 0 },
          "children": [
            { "type": "IconButton", "id": "chat-history-button", "props": { "icon": "archive-restore", "size": 24, "tooltip": "Closed chats in this worktree", "do": { "do": "state.toggle", "key": "chat_history_open" } } },
            { "type": "IconButton", "if": ".state.chat_history_open", "id": "chat-history-button-above", "layer": "above", "motion": false, "style": { "position": "absolute", "top": 0, "left": 4 }, "props": { "icon": "archive-restore", "size": 24, "tooltip": "Closed chats in this worktree", "do": { "do": "state.toggle", "key": "chat_history_open" } } },
            {
              "if": ".state.chat_history_open and (.app.dragging | not)",
              "type": "box",
              "layer": "top",
              "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
              "on": { "click": { "do": "state.set", "key": "chat_history_open", "value": false } }
            },
            {
              "if": ".state.chat_history_open",
              "id": "chat-history-list",
              "type": "scroll",
              "layer": "top",
              "style": {
                "position": "absolute", "top": 30, "right": 0, "width": 320, "max_height": 380, "padding": 6, "gap": 2,
                "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
              },
              "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
              "children": [
                { "type": "text", "props": { "text": "Closed chats" }, "style": { "padding": [4, 8, 6, 8], "font_size": 12, "color": "@text_faint" } },
                {
                  "for": ".selected.chats | map(select(.open | not)) | sort_by(.last_activity // \"\") | reverse", "as": "c", "key": ".c.id",
                  "type": "row",
                  "style": { "height": 32, "padding": [0, 8], "gap": 8, "align": "center", "radius": 6, "cursor": "pointer", "font_size": 13, "hover": { "background": "@hover" } },
                  "tooltip": "Reopen (resumes it on {{ .hosts[.c.host].label // .c.host }})",
                  "on": { "click": [{ "do": "chat.open", "chat": "{{ .c.id }}" }, { "do": "state.set", "key": "chat_history_open", "value": false }] },
                  "children": [
                    { "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 12 } },
                    { "type": "AgentIcon", "props": { "agent": "{{ .c.agent }}", "size": 12 } },
                    { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "grow": 1, "truncate": true } },
                    { "type": "text", "props": { "text": "{{ .c.age_text }}" }, "style": { "font_size": 12, "color": "@text_faint", "shrink": 0 } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    "WorktreeChats": {
      "about": "Only when state.sidebar_rows is \"chats\": a worktree's chats under its sidebar row, open ones first, then newest; the first `chat.sidebar_chats` (5) unless expanded. Clicking one opens it (resuming its process). props: w (a worktree), indent (left padding).",
      "if": ".state.sidebar_rows == \"chats\" and (.props.w.chats | length) > 0",
      "type": "column",
      "style": { "padding": [0, 0, 2, 0] },
      "children": [
        {
          "for": ".state as $s | .props.w.path as $p | (.props.w.chats | sort_by([(if .open then 1 else 0 end), (.last_activity // 0)]) | reverse) as $all | if $s[\"chats_more:\" + $p] then $all else $all[:5] end",
          "as": "c", "key": ".c.id", "id": "wt-chat",
          "type": "row",
          "style": {
            "height": 26, "padding": "{{ [0, 10, 0, (.props.indent // 40)] }}", "gap": 7, "align": "center", "radius": 6, "font_size": 12.5, "cursor": "pointer",
            "color": "{{ if .c.active then \"@text\" elif .c.open then \"@text_muted\" else \"@text_faint\" end }}",
            "background": "{{ if .c.active then \"@hover\" else \"transparent\" end }}",
            "hover": { "background": "@hover", "color": "@text" }
          },
          "tooltip": "{{ .c.name }} · {{ .hosts[.c.host].label // .c.host }} · {{ if .c.open then .c.state else \"closed (click to resume)\" end }}",
          "on": { "click": { "do": "chat.open", "chat": "{{ .c.id }}" } },
          "children": [
            { "if": ".c.state == \"working\"", "type": "spinner", "props": { "size": "xsmall" } },
            { "if": ".c.state == \"waiting\"", "type": "icon", "props": { "name": "bell", "size": 11, "color": "@warning" } },
            { "if": ".c.state != \"working\" and .c.state != \"waiting\"", "type": "box", "style": { "width": 6, "height": 6, "radius": 3, "margin": [0, 2], "background": "{{ if .c.open then \"@accent\" else \"@line\" end }}" } },
            { "type": "text", "props": { "text": "{{ .c.name }}" }, "style": { "grow": 1, "truncate": true } },
            { "type": "AgentIcon", "props": { "agent": "{{ .c.agent }}", "size": 11 } },
            { "if": ".c.host != .props.w.host", "type": "HostIcon", "props": { "host": "{{ .c.host }}", "size": 11 } },
            { "type": "text", "props": { "text": "{{ .c.age_text }}" }, "style": { "font_size": 11.5, "color": "@text_faint", "shrink": 0 } }
          ]
        },
        {
          "if": "(.props.w.chats | length) > 5",
          "id": "wt-chats-more",
          "type": "row",
          "style": { "height": 24, "padding": "{{ [0, 10, 0, ((.props.indent // 40) + 13)] }}", "align": "center", "font_size": 12, "color": "@text_faint", "cursor": "pointer", "radius": 6, "hover": { "color": "@text" } },
          "on": { "click": { "do": "state.set", "key": "chats_more:{{ .props.w.path }}", "value": "{{ .state[\"chats_more:\" + .props.w.path] | not }}" } },
          "children": [{ "type": "text", "props": { "text": "{{ if .state[\"chats_more:\" + .props.w.path] then \"Show fewer\" else \"Show \\((.props.w.chats | length) - 5) more\" end }}" } }]
        }
      ]
    },

    "Completions": {
      "about": "The list the composer shows while you type a trigger word (\"/\" for commands and skills): up/down to move, Tab or Enter to fill it in, Esc to close. props: chat.",
      "if": ".app.completion and .app.completion.chat == .props.chat",
      "type": "column",
      "layer": "top",
      "style": {
        "position": "absolute", "left": 20, "right": 20, "bottom": "full", "max_height": 340, "padding": 5, "gap": 1,
        "radius": 10, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg"
      },
      "children": [
        {
          "for": ".app.completion.selected as $sel | .app.completion.items | to_entries | map(.value + {index: .key, selected: (.key == $sel)})",
          "as": "e", "key": ".e.name",
          "type": "row",
          "style": {
            "height": 30, "padding": [0, 10], "gap": 10, "align": "center", "radius": 6, "cursor": "pointer", "font_size": 13,
            "background": "{{ if .e.selected then \"@selection\" else \"transparent\" end }}", "hover": { "background": "@hover" }
          },
          "on": { "click": { "do": "completion.accept", "index": "{{ .e.index }}" } },
          "children": [
            { "type": "icon", "props": { "name": "{{ if .e.kind == \"skill\" then \"sparkles\" else \"square-slash\" end }}", "size": 13, "color": "@text_faint" } },
            { "type": "text", "props": { "text": "{{ .app.completion.trigger }}{{ .e.name }}" }, "style": { "shrink": 0, "font_family": "@font_mono", "font_size": 12.5 } },
            { "type": "text", "props": { "text": "{{ .e.description }}" }, "style": { "grow": 1, "min_width": 0, "truncate": true, "color": "@text_faint", "font_size": 12 } },
            {
              "type": "text",
              "props": { "text": "{{ if .e.source == \"project\" then \"repo\" elif .e.source == \"personal\" then \"personal\" else \"built-in\" end }}" },
              "tooltip": "{{ if .e.source == \"project\" then \"From this repository (.claude or .agents in the worktree)\" elif .e.source == \"personal\" then \"Yours (~/.claude, ~/.agents)\" else \"Claude Code command\" end }}",
              "style": {
                "shrink": 0, "padding": [1, 7], "radius": 9, "font_size": 11, "border": 1,
                "border_color": "{{ if .e.source == \"project\" then \"@accent\" elif .e.source == \"personal\" then \"@success\" else \"@line\" end }}",
                "color": "{{ if .e.source == \"project\" then \"@accent\" elif .e.source == \"personal\" then \"@success\" else \"@text_faint\" end }}"
              }
            }
          ]
        }
      ]
    },

    "Queued": {
      "about": "Messages waiting to send (state chat.queue): each goes out when the agent finishes its turn. Click one to edit it in the composer. props: c (a chat).",
      "if": "(.props.c.queued | length) > 0",
      "type": "column",
      "style": { "gap": 4, "padding": [0, 4, 8, 4] },
      "children": [
        { "type": "text", "props": { "text": "Queued · sends when the agent finishes" }, "style": { "font_size": 11.5, "color": "@text_faint", "padding": [0, 4] } },
        {
          "for": ".props.c.queued | to_entries", "as": "q", "key": ".q.key",
          "id": "queued-message",
          "type": "row",
          "style": { "gap": 8, "padding": [6, 6, 6, 10], "align": "center", "radius": 8, "border": 1, "border_color": "@line", "background": "@user_bubble", "font_size": 13 },
          "animate": { "from": { "opacity": 0, "y": 4 }, "duration": 140 },
          "children": [
            { "type": "icon", "props": { "name": "clock", "size": 12, "color": "@text_faint" } },
            {
              "type": "text", "props": { "text": "{{ .q.value }}" },
              "style": { "grow": 1, "min_width": 0, "truncate": true, "cursor": "pointer" },
              "tooltip": "Edit (back into the message box)",
              "on": { "click": { "do": "queue.edit", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } }
            },
            { "type": "IconButton", "props": { "icon": "pencil", "size": 22, "tooltip": "Edit", "do": { "do": "queue.edit", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } },
            { "type": "IconButton", "props": { "icon": "send", "size": 22, "tooltip": "Send now", "do": { "do": "queue.send_now", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } },
            { "type": "IconButton", "props": { "icon": "x", "size": 22, "tooltip": "Remove", "do": { "do": "queue.remove", "chat": "{{ .props.c.id }}", "index": "{{ .q.key }}" } } }
          ]
        }
      ]
    },

    "AgentIcon": {
      "about": "Which agent CLI a chat runs: `agents[props.agent].icon` when that agent sets `tab_icon`, with its name as the tooltip. props: agent, size (12).",
      "if": ".agents[.props.agent].tab_icon == true",
      "type": "box",
      "style": { "shrink": 0, "align": "center", "justify": "center" },
      "tooltip": "{{ .agents[.props.agent].name // .props.agent }}",
      "children": [{ "type": "icon", "props": { "name": "{{ .agents[.props.agent].icon // \"bot\" }}", "size": "{{ .props.size // 12 }}", "color": "{{ .agents[.props.agent].color // \"@text_muted\" }}" } }]
    },

    "HostIcon": {
      "about": "Where something runs: the icon for props.host from `hosts`, with its label as the tooltip. props: host (box | mac), size (12).",
      "type": "box",
      "style": { "shrink": 0, "align": "center", "justify": "center" },
      "tooltip": "{{ .hosts[.props.host].label // .props.host }}",
      "children": [{ "type": "icon", "props": { "name": "{{ .hosts[.props.host].icon // \"circle\" }}", "size": "{{ .props.size // 12 }}", "color": "{{ .hosts[.props.host].color // \"@text_muted\" }}" } }]
    },

    "Confirm": {
      "about": "The dialog the `confirm` action opens (.app.confirm: title, text, confirm, cancel). Esc cancels.",
      "if": ".app.confirm",
      "type": "box",
      "layer": "top",
      "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "align": "center", "justify": "center" },
      "children": [
        { "type": "box", "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "background": "#00000066" }, "on": { "click": "confirm.cancel" } },
        {
          "id": "confirm-card",
          "type": "column",
          "occlude": true,
          "style": { "width": 420, "padding": [18, 20, 16, 20], "gap": 10, "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg" },
          "animate": { "from": { "opacity": 0, "y": 8 }, "duration": 140 },
          "children": [
            { "type": "text", "props": { "text": "{{ .app.confirm.title // \"Are you sure?\" }}" }, "style": { "font_size": 15, "font_weight": "semibold" } },
            { "if": ".app.confirm.text", "type": "text", "props": { "text": "{{ .app.confirm.text }}" }, "style": { "font_size": 13, "color": "@text_muted", "line_height": 1.5 } },
            {
              "type": "row",
              "style": { "gap": 8, "justify": "end", "margin": [6, 0, 0, 0] },
              "children": [
                { "type": "Pill", "id": "confirm-cancel", "props": { "text": "{{ .app.confirm.cancel // \"Cancel\" }}", "do": "confirm.cancel" } },
                {
                  "id": "confirm-accept",
                  "type": "row",
                  "style": { "height": 26, "padding": [0, 12], "align": "center", "radius": 13, "background": "@danger", "color": "#ffffff", "font_size": 12.5, "cursor": "pointer", "hover": { "opacity": 0.9 } },
                  "on": { "click": "confirm.accept" },
                  "children": [{ "type": "text", "props": { "text": "{{ .app.confirm.confirm // \"OK\" }}" } }]
                }
              ]
            }
          ]
        }
      ]
    },

    "Setup": {
      "about": "The setup guide a fresh install opens with (state.setup_step: welcome, agents, box, backup, finish, tour; done or null hides it). Its checks and steps run bin/setup; its texts and tour stops are in settings `setup`. The palette's \"Set up a.box\" reopens it.",
      "if": ".state.setup_step and .state.setup_step != \"done\"",
      "type": "box",
      "layer": "top",
      "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0 },
      "children": [
        { "if": ".state.setup_step == \"tour\"", "type": "SetupTour", "id": "setup-tour" },
        {
          "if": ".state.setup_step != \"tour\"",
          "type": "box",
          "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "align": "center", "justify": "center", "background": "#0000008c" },
          "occlude": true,
          "children": [
            {
              "id": "setup-card",
              "type": "column",
              "occlude": true,
              "style": { "width": 560, "max_height": "{{ .app.window.height - 60 }}", "padding": [22, 26, 20, 26], "gap": 16, "radius": 14, "border": 1, "border_color": "@line", "background": "@card", "shadow": "xl" },
              "animate": { "from": { "opacity": 0, "y": 10 }, "duration": 200 },
              "children": [
                {
                  "type": "row",
                  "style": { "align": "center", "gap": 10 },
                  "children": [
                    { "type": "logo", "props": { "size": 22 } },
                    { "type": "text", "props": { "text": "Set up a.box" }, "style": { "font_size": 12.5, "color": "@text_muted", "grow": 1 } },
                    {
                      "if": ".state.setup_step != \"welcome\"",
                      "type": "row",
                      "style": { "gap": 6, "align": "center" },
                      "children": [
                        {
                          "for": "[\"agents\", \"box\", \"backup\", \"finish\"] | to_entries",
                          "as": "d",
                          "key": ".d.value",
                          "type": "box",
                          "style": {
                            "height": 7, "radius": 4,
                            "width": "{{ if .d.value == .state.setup_step then 18 else 7 end }}",
                            "background": "{{ if .d.key <= (if .state.setup_step == \"agents\" then 0 elif .state.setup_step == \"box\" then 1 elif .state.setup_step == \"backup\" then 2 else 3 end) then \"@accent\" else \"@line\" end }}"
                          },
                          "transition": { "width": 200 }
                        }
                      ]
                    }
                  ]
                },

                { "if": ".state.setup_step == \"welcome\"", "type": "SetupWelcome", "id": "setup-welcome" },
                { "if": ".state.setup_step == \"agents\"", "type": "SetupAgents", "id": "setup-agents" },
                { "if": ".state.setup_step == \"box\"", "type": "SetupBox", "id": "setup-box" },
                { "if": ".state.setup_step == \"backup\"", "type": "SetupBackup", "id": "setup-backup" },
                { "if": ".state.setup_step == \"finish\"", "type": "SetupFinish", "id": "setup-finish" }
              ]
            }
          ]
        }
      ]
    },

    "SetupButton": {
      "about": "A setup guide button. props: text, do, primary (accent fill), icon, busy (a spinner instead of the icon), disabled.",
      "type": "row",
      "style": {
        "height": 30, "padding": [0, 14], "gap": 6, "align": "center", "radius": 15, "font_size": 13, "shrink": 0,
        "cursor": "{{ if .props.disabled then \"default\" else \"pointer\" end }}",
        "opacity": "{{ if .props.disabled then 0.45 else 1 end }}",
        "border": "{{ if .props.primary then 0 else 1 end }}", "border_color": "@line",
        "background": "{{ if .props.primary then \"@accent\" else \"@pill\" end }}",
        "color": "{{ if .props.primary then \"#ffffff\" else \"@text\" end }}",
        "hover": { "opacity": "{{ if .props.disabled then 0.45 else 0.88 end }}" }, "active": { "opacity": 0.75 }
      },
      "on": { "click": "{{ if .props.disabled or .props.busy then null else .props.do end }}" },
      "children": [
        { "if": ".props.busy", "type": "spinner", "props": { "size": "xsmall", "color": "{{ if .props.primary then \"#ffffff\" else \"@accent\" end }}" } },
        { "if": ".props.icon and (.props.busy | not)", "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 14 } },
        { "type": "text", "props": { "text": "{{ .props.text }}" } }
      ]
    },

    "SetupStepText": {
      "about": "A setup step's heading and explanation. props: title, text.",
      "type": "column",
      "style": { "gap": 6 },
      "children": [
        { "type": "text", "props": { "text": "{{ .props.title }}" }, "style": { "font_size": 20, "font_weight": "semibold" } },
        { "type": "text", "props": { "text": "{{ .props.text }}" }, "style": { "font_size": 13.5, "color": "@text_muted", "line_height": 1.55 } }
      ]
    },

    "SetupFooter": {
      "about": "A setup step's buttons: Back (props.back: the step before), a quiet skip (props.skip, props.skip_do), and props.next / props.next_do.",
      "type": "row",
      "style": { "align": "center", "gap": 8, "margin": [4, 0, 0, 0] },
      "children": [
        { "if": ".props.back", "type": "SetupButton", "props": { "text": "Back", "do": { "do": "state.set", "key": "setup_step", "value": "{{ .props.back }}" } } },
        { "type": "box", "style": { "grow": 1 } },
        {
          "if": ".props.skip",
          "type": "text",
          "props": { "text": "{{ .props.skip }}" },
          "style": { "font_size": 12.5, "color": "@text_faint", "cursor": "pointer", "padding": [0, 6], "hover": { "color": "@text" } },
          "on": { "click": "{{ .props.skip_do }}" }
        },
        { "if": ".props.next", "type": "SetupButton", "props": { "text": "{{ .props.next }}", "do": "{{ .props.next_do }}", "primary": true, "busy": "{{ .props.busy }}", "disabled": "{{ .props.disabled }}" } }
      ]
    },

    "SetupStatus": {
      "about": "A check's line: props.state ok | missing | busy | warn, props.text.",
      "type": "row",
      "style": { "gap": 8, "align": "center", "font_size": 12.5 },
      "children": [
        { "if": ".props.state == \"busy\"", "type": "spinner", "props": { "size": "xsmall", "color": "@accent" } },
        {
          "if": ".props.state != \"busy\"",
          "type": "icon",
          "props": {
            "name": "{{ if .props.state == \"ok\" then \"circle-check\" elif .props.state == \"warn\" then \"triangle-alert\" else \"circle-dashed\" end }}", "size": 15,
            "color": "{{ if .props.state == \"ok\" then \"@success\" elif .props.state == \"warn\" then \"@warning\" else \"@text_faint\" end }}"
          }
        },
        { "type": "text", "props": { "text": "{{ .props.text }}" }, "style": { "color": "{{ if .props.state == \"warn\" then \"@warning\" else \"@text_muted\" end }}", "shrink": 1, "min_width": 0 } }
      ]
    },

    "SetupWelcome": {
      "type": "column",
      "style": { "gap": 16 },
      "children": [
        { "type": "SetupStepText", "props": { "title": "{{ .settings.setup.welcome.title }}", "text": "{{ .settings.setup.welcome.text }}" } },
        {
          "type": "column",
          "style": { "gap": 10, "padding": [4, 0] },
          "children": [
            {
              "for": ".settings.setup.welcome.points",
              "as": "p",
              "type": "row",
              "style": { "gap": 10, "align": "start" },
              "children": [
                { "type": "icon", "props": { "name": "{{ .p.icon }}", "size": 16, "color": "@accent" }, "style": { "margin": [2, 0, 0, 0] } },
                {
                  "type": "column",
                  "style": { "gap": 1, "shrink": 1, "min_width": 0 },
                  "children": [
                    { "if": ".p.title", "type": "text", "props": { "text": "{{ .p.title }}" }, "style": { "font_size": 13, "font_weight": "semibold" } },
                    { "type": "text", "props": { "text": "{{ .p.text }}" }, "style": { "font_size": 12.5, "color": "{{ if .p.title then \"@text_muted\" else \"@text\" end }}", "line_height": 1.45 } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "SetupFooter",
          "props": {
            "skip": "Not now", "skip_do": { "do": "state.set", "key": "setup_step", "value": "done" },
            "next": "Get started", "next_do": [{ "do": "state.set", "key": "setup_step", "value": "agents" }, { "do": "emit", "event": "setup.check" }]
          }
        }
      ]
    },

    "SetupAgents": {
      "type": "column",
      "style": { "gap": 14 },
      "children": [
        { "type": "SetupStepText", "props": { "title": "Your agents", "text": "a.box runs agents you already have. Claude Code is the one you need; the rest make later steps easier." } },
        {
          "type": "column",
          "style": { "gap": 2, "radius": 10, "border": 1, "border_color": "@line", "padding": 4 },
          "children": [
            {
              "for": ".settings.setup.tools",
              "as": "t",
              "key": ".t.key",
              "type": "row",
              "style": { "gap": 12, "align": "center", "padding": [9, 10], "radius": 7, "hover": { "background": "@hover" } },
              "children": [
                {
                  "type": "SetupStatus",
                  "props": {
                    "state": "{{ if .state.setup_busy == \"check\" then \"busy\" elif .state.setup_facts[.t.key].installed and .state.setup_facts[.t.key].signed_in then \"ok\" elif .t.required then \"warn\" else \"missing\" end }}",
                    "text": ""
                  }
                },
                {
                  "type": "column",
                  "style": { "grow": 1, "min_width": 0, "gap": 2 },
                  "children": [
                    {
                      "type": "row",
                      "style": { "gap": 6, "align": "center" },
                      "children": [
                        { "type": "text", "props": { "text": "{{ .t.name }}" }, "style": { "font_size": 13.5, "font_weight": "medium" } },
                        { "if": ".t.required | not", "type": "text", "props": { "text": "optional" }, "style": { "font_size": 11.5, "color": "@text_faint" } }
                      ]
                    },
                    { "type": "text", "props": { "text": "{{ .t.about }}" }, "style": { "font_size": 12, "color": "@text_muted" } }
                  ]
                },
                {
                  "if": ".state.setup_facts and .state.setup_busy != \"check\" and (.state.setup_facts[.t.key].installed | not)",
                  "type": "Pill",
                  "props": { "text": "Install", "icon": "download", "tooltip": "{{ .t.install }}", "do": { "do": "emit", "event": "setup.terminal", "payload": { "run": "{{ .t.install }}" } } }
                },
                {
                  "if": ".state.setup_facts[.t.key].installed and (.state.setup_facts[.t.key].signed_in | not) and .state.setup_busy != \"check\"",
                  "type": "Pill",
                  "props": { "text": "Sign in", "icon": "key-round", "tooltip": "{{ .t.sign_in }}", "do": { "do": "emit", "event": "setup.terminal", "payload": { "run": "{{ .t.sign_in }}" } } }
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "style": { "gap": 8, "align": "center" },
          "children": [
            { "type": "text", "props": { "text": "Installs and sign-ins open in Terminal. Come back here when they're done." }, "style": { "font_size": 12, "color": "@text_faint", "grow": 1, "shrink": 1, "min_width": 0 } },
            { "type": "Pill", "props": { "text": "Check again", "icon": "refresh-cw", "do": { "do": "emit", "event": "setup.check" } } }
          ]
        },
        {
          "type": "SetupFooter",
          "props": { "back": "welcome", "next": "Continue", "next_do": { "do": "state.set", "key": "setup_step", "value": "box" } }
        }
      ]
    },

    "SetupBox": {
      "type": "column",
      "style": { "gap": 14 },
      "children": [
        { "type": "SetupStepText", "props": { "title": "A box in the cloud", "text": "Chats can also run on a Coder workspace, so they keep working while your Mac sleeps or travels, and you can move a chat between the two at any time. Skip this to keep everything on this Mac; you can add a box later." } },
        {
          "if": ".settings.app.default_host != .settings.app.local_host and (.settings.connection.ssh_host // \"\") != \"\"",
          "type": "SetupStatus",
          "props": { "state": "ok", "text": "Using {{ .settings.connection.ssh_host }}. Connect another below to change it." }
        },
        {
          "type": "column",
          "style": { "gap": 8 },
          "children": [
            { "type": "text", "props": { "text": "Its ssh name" }, "style": { "font_size": 12, "color": "@text_muted" } },
            {
              "type": "row",
              "style": { "gap": 8, "align": "center" },
              "children": [
                {
                  "id": "setup-ssh",
                  "type": "input",
                  "props": { "state": "setup_ssh", "placeholder": "coder.my-workspace" },
                  "style": { "grow": 1 },
                  "on": { "submit": { "do": "emit", "event": "setup.box_check" } }
                },
                { "type": "SetupButton", "props": { "text": "Connect", "icon": "plug", "busy": "{{ .state.setup_busy == \"box\" }}", "disabled": "{{ (.state.setup_ssh // \"\") == \"\" }}", "do": { "do": "emit", "event": "setup.box_check" } } }
              ]
            },
            {
              "if": "(.state.setup_facts.coder.workspaces // []) | length > 0",
              "type": "row",
              "style": { "gap": 6, "wrap": true, "align": "center" },
              "children": [
                { "type": "text", "props": { "text": "Your workspaces:" }, "style": { "font_size": 12, "color": "@text_faint" } },
                {
                  "for": ".state.setup_facts.coder.workspaces",
                  "as": "w",
                  "type": "Pill",
                  "props": { "text": "{{ .w }}", "mono": true, "do": [{ "do": "state.set", "key": "setup_ssh", "value": "{{ .w }}" }, { "do": "emit", "event": "setup.box_check" }] }
                }
              ]
            },
            {
              "if": ".state.setup_facts and (.state.setup_facts.coder.installed | not)",
              "type": "text",
              "props": { "text": "With Coder's CLI signed in (coder login, then coder config-ssh), your workspaces show up here." },
              "style": { "font_size": 12, "color": "@text_faint" }
            }
          ]
        },
        {
          "if": ".state.setup_box and .state.setup_busy != \"box\"",
          "type": "column",
          "style": { "gap": 10, "padding": [12, 14], "radius": 10, "background": "@window" },
          "children": [
            {
              "type": "SetupStatus",
              "props": {
                "state": "{{ if .state.setup_busy == \"box_install\" then \"busy\" elif .state.setup_box.ok and .state.setup_box.installed then \"ok\" elif .state.setup_box.ok then \"missing\" else \"warn\" end }}",
                "text": "{{ if .state.setup_busy == \"box_install\" then \"Installing a.box on \\(.state.setup_box.host). The first build takes a few minutes…\" elif .state.setup_box.ok and .state.setup_box.installed then \"\\(.state.setup_box.host) is ready.\" elif .state.setup_box.ok then \"Reached \\(.state.setup_box.host). a.box isn't installed there yet.\" else \"Couldn't reach \\(.state.setup_box.host): \\(.state.setup_box.error)\" end }}"
              }
            },
            {
              "if": ".state.setup_box.ok and (.state.setup_box.installed | not)",
              "type": "row",
              "children": [{ "type": "SetupButton", "props": { "text": "Install a.box there", "icon": "download", "busy": "{{ .state.setup_busy == \"box_install\" }}", "do": { "do": "emit", "event": "setup.box_install" } } }]
            }
          ]
        },
        {
          "type": "SetupFooter",
          "props": {
            "back": "agents",
            "skip": "Just this Mac",
            "skip_do": [{ "do": "settings.set", "key": "app.default_host", "value": "{{ .settings.app.local_host }}" }, { "do": "state.set", "key": "setup_step", "value": "backup" }],
            "next": "{{ if .state.setup_box.ok and .state.setup_box.installed then \"Use \\(.state.setup_box.host)\" else \"Continue\" end }}",
            "disabled": "{{ (.state.setup_box.ok and .state.setup_box.installed) or ((.settings.connection.ssh_host // \"\") != \"\" and .settings.app.default_host != .settings.app.local_host) | not }}",
            "next_do": [
              {
                "do": "if",
                "cond": "{{ .state.setup_box.ok and .state.setup_box.installed }}",
                "then": { "do": "settings.set", "values": { "connection.ssh_host": "{{ .state.setup_box.host }}", "app.default_host": "box", "hosts.box.label": "On the box ({{ .state.setup_box.host }})" } }
              },
              { "do": "state.set", "key": "setup_step", "value": "backup" }
            ]
          }
        }
      ]
    },

    "SetupBackup": {
      "type": "column",
      "style": { "gap": 14 },
      "children": [
        { "type": "SetupStepText", "props": { "title": "Backups", "text": "a.box keeps your chats, settings and uncommitted work in a private git repo of your own. That's what lets a chat move between machines, and what brings everything back on a new one. It holds every transcript, so it must be private: never a repo other people can read." } },
        {
          "if": "(.settings.daemon.state_repo_url // \"\") != \"\"",
          "type": "SetupStatus",
          "props": { "state": "ok", "text": "Backing up to {{ .settings.daemon.state_repo_url }}" }
        },
        {
          "if": "(.settings.daemon.state_repo_url // \"\") == \"\"",
          "type": "column",
          "style": { "gap": 12 },
          "children": [
            {
              "type": "row",
              "style": { "gap": 10, "align": "center" },
              "children": [
                {
                  "type": "SetupButton",
                  "props": {
                    "text": "Make a private GitLab repo for me", "icon": "lock", "primary": true,
                    "busy": "{{ .state.setup_busy == \"backup\" }}",
                    "disabled": "{{ .state.setup_facts.glab.signed_in | not }}",
                    "do": { "do": "emit", "event": "setup.backup_create" }
                  }
                },
                {
                  "if": ".state.setup_facts and (.state.setup_facts.glab.signed_in | not)",
                  "type": "text",
                  "props": { "text": "Needs the GitLab CLI, signed in (the Agents step)." },
                  "style": { "font_size": 12, "color": "@text_faint", "shrink": 1 }
                }
              ]
            },
            {
              "type": "row",
              "style": { "gap": 8, "align": "center" },
              "children": [
                { "id": "setup-backup-url", "type": "input", "props": { "state": "setup_backup_url", "placeholder": "Or one you made: git@gitlab.com:you/agent-box-state.git" }, "style": { "grow": 1 }, "on": { "submit": { "do": "emit", "event": "setup.backup_use" } } },
                { "type": "SetupButton", "props": { "text": "Use it", "busy": "{{ .state.setup_busy == \"backup_check\" }}", "disabled": "{{ (.state.setup_backup_url // \"\") == \"\" }}", "do": { "do": "emit", "event": "setup.backup_use" } } }
              ]
            },
            { "if": ".state.setup_backup_error", "type": "SetupStatus", "props": { "state": "warn", "text": "{{ .state.setup_backup_error }}" } }
          ]
        },
        {
          "type": "SetupFooter",
          "props": {
            "back": "box",
            "skip": "{{ if (.settings.daemon.state_repo_url // \"\") == \"\" then \"Not now\" else null end }}",
            "skip_do": [{ "do": "state.set", "key": "setup_step", "value": "finish" }, { "do": "emit", "event": "setup.finish" }],
            "next": "Continue",
            "disabled": "{{ (.settings.daemon.state_repo_url // \"\") == \"\" }}",
            "next_do": [{ "do": "state.set", "key": "setup_step", "value": "finish" }, { "do": "emit", "event": "setup.finish" }]
          }
        }
      ]
    },

    "SetupFinish": {
      "type": "column",
      "style": { "gap": 14 },
      "children": [
        { "type": "SetupStepText", "props": { "title": "{{ if .state.setup_busy == \"finish\" then \"Almost there\" else \"You're set\" end }}", "text": "a.box adds its hooks to Claude Code and Codex, so it can see when a chat is working, done, or waiting on you." } },
        {
          "type": "SetupStatus",
          "props": {
            "state": "{{ if .state.setup_busy == \"finish\" then \"busy\" elif .state.setup_finish.ok then \"ok\" else \"warn\" end }}",
            "text": "{{ if .state.setup_busy == \"finish\" then \"Installing hooks…\" elif .state.setup_finish.ok then \"Hooks installed.\" else \"Setup hit a problem: \\(.state.setup_finish.error // \"unknown\"). Try again, or run bin/boot --force.\" end }}"
          }
        },
        { "if": ".state.setup_busy != \"finish\" and (.state.setup_finish.ok | not)", "type": "row", "children": [{ "type": "Pill", "props": { "text": "Try again", "icon": "refresh-cw", "do": { "do": "emit", "event": "setup.finish" } } }] },
        {
          "type": "SetupFooter",
          "props": {
            "back": "backup",
            "skip": "Skip the tour", "skip_do": { "do": "state.set", "key": "setup_step", "value": "done" },
            "next": "Take the tour", "busy": "{{ .state.setup_busy == \"finish\" }}",
            "next_do": [{ "do": "state.set", "key": "setup_tour", "value": 0 }, { "do": "state.set", "key": "setup_step", "value": "tour" }]
          }
        }
      ]
    },

    "SetupTour": {
      "about": "The tour: each stop (settings setup.tour: {id, title, text}) dims the window around the node with that id (.app.layout) and explains it; a stop without an id is a card in the middle.",
      "type": "box",
      "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0 },
      "children": [
        {
          "for": ". as $c | [{stop: .settings.setup.tour[.state.setup_tour // 0], n: (.state.setup_tour // 0), count: (.settings.setup.tour | length)} | . + {t: ($c.app.layout[.stop.id // \"\"] // {x: 0, y: 0, w: 0, h: 0})}]",
          "as": "s",
          "type": "box",
          "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0 },
          "occlude": true,
          "children": [
            { "if": ".s.t.w == 0", "type": "box", "style": { "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0, "background": "#0000008c" } },
            { "if": ".s.t.w > 0", "type": "box", "style": { "position": "absolute", "left": 0, "right": 0, "top": 0, "height": "{{ [.s.t.y - 6, 0] | max }}", "background": "#0000008c" } },
            { "if": ".s.t.w > 0", "type": "box", "style": { "position": "absolute", "left": 0, "right": 0, "bottom": 0, "top": "{{ .s.t.y + .s.t.h + 6 }}", "background": "#0000008c" } },
            { "if": ".s.t.w > 0", "type": "box", "style": { "position": "absolute", "left": 0, "top": "{{ [.s.t.y - 6, 0] | max }}", "height": "{{ .s.t.h + 12 }}", "width": "{{ [.s.t.x - 6, 0] | max }}", "background": "#0000008c" } },
            { "if": ".s.t.w > 0", "type": "box", "style": { "position": "absolute", "right": 0, "top": "{{ [.s.t.y - 6, 0] | max }}", "height": "{{ .s.t.h + 12 }}", "left": "{{ .s.t.x + .s.t.w + 6 }}", "background": "#0000008c" } },
            {
              "if": ".s.t.w > 0",
              "id": "setup-tour-ring",
              "type": "box",
              "style": { "position": "absolute", "left": "{{ .s.t.x - 6 }}", "top": "{{ .s.t.y - 6 }}", "width": "{{ .s.t.w + 12 }}", "height": "{{ .s.t.h + 12 }}", "radius": 10, "border": 2, "border_color": "@accent" }
            },
            {
              "id": "setup-tour-card",
              "type": "column",
              "style": {
                "position": "absolute", "width": 320, "padding": [16, 18, 14, 18], "gap": 8, "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "xl",
                "left": "{{ if .s.t.w == 0 then (.app.window.width - 320) / 2 elif .s.t.x + .s.t.w + 360 < .app.window.width then .s.t.x + .s.t.w + 22 else [.s.t.x - 342, 16] | max end }}",
                "top": "{{ if .s.t.w == 0 then (.app.window.height - 200) / 2 else [[.s.t.y, .app.window.height - 230] | min, 16] | max end }}"
              },
              "children": [
                { "type": "text", "props": { "text": "{{ .s.stop.title }}" }, "style": { "font_size": 15, "font_weight": "semibold" } },
                { "type": "text", "props": { "text": "{{ .s.stop.text }}" }, "style": { "font_size": 13, "color": "@text_muted", "line_height": 1.55 } },
                {
                  "type": "row",
                  "style": { "align": "center", "gap": 8, "margin": [6, 0, 0, 0] },
                  "children": [
                    { "type": "text", "props": { "text": "{{ .s.n + 1 }} of {{ .s.count }}" }, "style": { "font_size": 12, "color": "@text_faint", "grow": 1 } },
                    { "if": ".s.n > 0", "type": "SetupButton", "props": { "text": "Back", "do": { "do": "state.set", "key": "setup_tour", "value": "{{ .s.n - 1 }}" } } },
                    {
                      "type": "SetupButton",
                      "props": {
                        "primary": true,
                        "text": "{{ if .s.n + 1 < .s.count then \"Next\" else \"Done\" end }}",
                        "do": "{{ if .s.n + 1 < .s.count then {do: \"state.set\", key: \"setup_tour\", value: (.s.n + 1)} else {do: \"state.set\", key: \"setup_step\", value: \"done\"} end }}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    "DropLineX": {
      "about": "The vertical insertion line at the left or right edge of a drop target in a row (tabs). props: key (the target's drop_key). Its parent needs position: relative.",
      "type": "box",
      "motion": false,
      "if": ".app.drop.key == .props.key and (.app.drop.zone == \"before\" or .app.drop.zone == \"after\")",
      "style": {
        "position": "absolute", "top": 8, "bottom": 8, "width": 2, "radius": 1, "background": "@accent",
        "left": "{{ if .app.drop.zone == \"before\" then -1 else null end }}",
        "right": "{{ if .app.drop.zone == \"after\" then -1 else null end }}"
      }
    },

    "BranchBar": {
      "about": "Branch, uncommitted changes, and actions. Drag it up or down to resize the terminal (state.terminal_height).",
      "type": "resize_handle",
      "props": { "state": "terminal_height", "axis": "y", "invert": true, "min": 100, "max": 1200 },
      "style": { "height": 54, "shrink": 0, "direction": "row", "gap": 10, "padding": [0, 16], "align": "center" },
      "children": [
        {
          "if": ".selected.worktree",
          "type": "row",
          "style": { "grow": 1, "gap": 10, "align": "center" },
          "children": [
            { "type": "icon", "props": { "name": "git-branch", "size": 13, "color": "@age" } },
            {
              "id": "branch-input",
              "type": "input",
              "tooltip": "Click to rename the branch; Enter saves",
              "props": { "value": "{{ .selected.worktree.branch // \"\" }}", "placeholder": "detached", "appearance": false },
              "on": { "submit": { "do": "worktree.rename_branch", "path": "{{ .selected.worktree.path }}", "branch": "{{ .input }}" } },
              "style": { "grow": 1, "min_width": 0, "max_width": 460, "font_size": 13, "radius": 6, "padding": [2, 6], "margin": [0, 0, 0, -6], "cursor": "text", "hover": { "background": "@hover" } }
            },
            { "type": "spacer" },
            {
              "if": ".selected.diff.files > 0",
              "id": "changes-pill",
              "type": "Pill",
              "props": {
                "icon": "file-diff",
                "text": "{{ .selected.diff.files }} file{{ if .selected.diff.files == 1 then \"\" else \"s\" end }} +{{ .selected.diff.added }} −{{ .selected.diff.removed }}",
                "tooltip": "Show the changes ({{ .selected.diff.base_label }})",
                "do": [{ "do": "state.set", "key": "terminal_open", "value": true }, { "do": "state.set", "key": "bottom_tab", "value": "changes" }]
              }
            },
            {
              "if": ".selected.worktree.uncommitted > 0",
              "type": "text",
              "props": { "text": "{{ .selected.worktree.uncommitted }} uncommitted change{{ if .selected.worktree.uncommitted == 1 then \"\" else \"s\" end }}" },
              "style": { "font_size": 12.5, "color": "@warning" }
            },
            { "if": ".selected.worktree.uncommitted > 0 and .selected.chat", "type": "Pill", "props": { "text": "Commit and push", "icon": "git-commit-horizontal", "do": { "do": "chat.send", "text": "Commit and push your changes." } } },
            { "if": "(.selected.worktree.is_primary | not) and .selected.worktree.branch and .selected.worktree.host == \"box\"", "type": "Pill", "props": { "text": "Test on Mac", "icon": "laptop", "tooltip": "Check this branch out on the Mac with the box's latest work", "do": { "do": "worktree.test_local", "branch": "{{ .selected.worktree.branch }}" } } },
            {
              "if": ".selected.chat and .selected.chat.kind != \"subagent\" and (.selected.worktree.host == \"box\" or .selected.chat.host == \"mac\")",
              "id": "move-chat",
              "type": "Pill",
              "props": {
                "text": "Move {{ if .selected.move.scope == \"section\" then \"section\" elif .selected.move.chats > 1 then (.selected.move.chats | tostring) + \" chats\" else \"chat\" end }} to {{ if .selected.chat.host == \"box\" then \"Mac\" else \"the cloud\" end }}",
                "icon": "{{ if .selected.chat.host == \"box\" then \"laptop\" else \"cloud\" end }}",
                "tooltip": "{{ (if .selected.chat.host == \"box\" then \"Continue on the Mac\" else \"Continue on the box, which keeps running when the laptop sleeps\" end) + (if .selected.move.scope == \"section\" then \": the whole \" + .selected.move.section + \" section moves (\" + (.selected.move.worktrees | tostring) + \" worktrees, \" + (.selected.move.chats | tostring) + \" chats) with each worktree's uncommitted and unpushed work\" elif .selected.move.chats > 1 then \": this worktree's \" + (.selected.move.chats | tostring) + \" chats move with its uncommitted and unpushed work\" else \": same branch, with the worktree's uncommitted and unpushed work\" end) }}",
                "do": {
                  "do": "confirm",
                  "title": "Move {{ if .selected.move.scope == \"section\" then \"the section “\" + .selected.move.section + \"”\" else \"“\" + .selected.chat.name + \"”\" end }} to {{ if .selected.chat.host == \"box\" then \"the Mac\" else \"the cloud\" end }}?",
                  "text": "{{ if .selected.move.scope == \"section\" then \"All \" + (.selected.move.worktrees | tostring) + \" worktrees and \" + (.selected.move.chats | tostring) + \" chats in it move together: \" else \"\" end }}their agent processes stop here{{ if .selected.chat.status == \"running_elsewhere\" then \", including in super.engineering,\" else \"\" end }} and continue there in a minute or so, on the same branches with the uncommitted and unpushed work.{{ if .selected.move.scope == \"section\" then \" The factory ledgers go along, and the orchestrator is told the new paths.\" else \"\" end }}",
                  "confirm": "Move",
                  "then": { "do": "chat.move", "chat": "{{ .selected.chat.id }}", "to": "{{ if .selected.chat.host == \"box\" then \"mac\" else \"box\" end }}" }
                }
              }
            },
            { "type": "IconButton", "props": { "icon": "{{ if .state.terminal_open then \"panel-bottom-close\" else \"panel-bottom-open\" end }}", "tooltip": "Terminal  ⌘J", "do": { "do": "state.toggle", "key": "terminal_open" } } }
          ]
        }
      ]
    },

    "TerminalCard": {
      "about": "The bottom card: the Changes tab (unless changes are in the right panel), then the terminal tabs (state.bottom_tab). Height: state.terminal_height.",
      "type": "column",
      "style": { "height": "{{ .state.terminal_height }}", "shrink": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
      "animate": { "from": { "opacity": 0, "y": 10 }, "duration": 160 },
      "children": [
        {
          "type": "row",
          "style": { "height": 46, "shrink": 0, "padding": [0, 18], "gap": 6, "align": "center" },
          "children": [
            {
              "if": ".state.changes_place != \"right\"",
              "type": "BottomTab", "id": "tab-changes",
              "props": { "tab": "changes", "icon": "file-diff", "text": "Changes{{ if .selected.diff.files > 0 then \" \" + (.selected.diff.files | tostring) else \"\" end }}" }
            },
            { "if": ".state.changes_place != \"right\"", "id": "bottom-tabs-divider", "type": "divider", "props": { "axis": "y" }, "style": { "height": 14, "self": "center", "margin": [0, 4] } },
            {
              "for": ".selected.terminals", "as": "t", "key": ".t.id", "id": "tab-terminal",
              "type": "row",
              "style": {
                "height": 26, "padding": "{{ if (.selected.terminals | length) > 1 then [0, 6, 0, 11] else [0, 11] end }}", "gap": 6, "align": "center", "radius": 13, "border": 1, "font_size": 13, "cursor": "pointer", "shrink": 0,
                "border_color": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@tab_border\" else \"transparent\" end }}",
                "background": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@tab_bg\" else \"transparent\" end }}",
                "color": "{{ if ((.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not) and .t.active then \"@text\" else \"@age\" end }}",
                "hover": { "color": "@text" }
              },
              "on": { "click": { "do": "terminal.select", "id": "{{ .t.id }}" } },
              "children": [
                { "type": "icon", "props": { "name": "{{ if .t.command then \"scroll-text\" else \"square-terminal\" end }}", "size": 13 } },
                { "type": "text", "props": { "text": "{{ .t.label }}" }, "style": { "truncate": true, "max_width": 220 } },
                {
                  "if": "(.selected.terminals | length) > 1",
                  "type": "box",
                  "style": { "width": 18, "height": 18, "radius": 9, "align": "center", "justify": "center", "color": "@text_faint", "hover": { "background": "@hover", "color": "@text" } },
                  "tooltip": "Close this terminal",
                  "on": { "click": { "do": "terminal.close", "id": "{{ .t.id }}" } },
                  "children": [{ "type": "icon", "props": { "name": "x", "size": 11 } }]
                }
              ]
            },
            { "id": "terminal-new", "type": "IconButton", "props": { "icon": "plus", "size": 24, "tooltip": "New terminal  ⌃⇧T", "do": "terminal.new" } },
            { "type": "spacer" },
            {
              "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\")",
              "type": "row",
              "style": { "gap": 6, "align": "center" },
              "children": [
                { "type": "DiffTools" },
                {
                  "type": "IconButton", "id": "changes-to-right",
                  "props": { "icon": "panel-right", "tooltip": "Open changes in a right panel", "do": [{ "do": "state.set", "key": "changes_place", "value": "right" }, { "do": "state.set", "key": "bottom_tab", "value": "terminal" }] }
                }
              ]
            }
          ]
        },
        { "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\") | not", "id": "terminal-view", "type": "terminal", "style": { "grow": 1, "min_height": 0 } },
        { "if": "(.state.bottom_tab == \"changes\" and .state.changes_place != \"right\")", "id": "bottom-diff", "type": "diff", "style": { "grow": 1, "min_height": 0, "border_top": 1, "border_color": "@line" } }
      ]
    },

    "CostButton": {
      "about": "What the current worktree's conversations cost (API-equivalent, at models.dev rates), with a breakdown: this chat, the worktree, its tabs, and every conversation by time. `.usage` holds the numbers.",
      "type": "box",
      "style": { "position": "relative" },
      "children": [
        {
          "id": "usage-cost-pill",
          "type": "row",
         
          "style": { "height": 26, "padding": [0, 10], "radius": 13, "border": 1, "border_color": "@line", "align": "center", "font_size": 12.5, "font_family": "@font_mono", "cursor": "pointer", "hover": { "background": "@hover" } },
          "tooltip": "What this worktree's chats cost",
          "on": { "click": [{ "do": "state.toggle", "key": "usage_cost_open" }, { "do": "state.set", "key": "usage_plan_open", "value": false }] },
          "children": [{ "type": "text", "props": { "text": "{{ .usage.worktree_text }}" } }]
        },
        {
          "if": ".state.usage_cost_open", "id": "usage-cost-pill-above", "layer": "above", "motion": false,
          "type": "row",
         
          "style": { "position": "absolute", "top": 0, "left": 0, "height": 26, "padding": [0, 10], "radius": 13, "border": 1, "border_color": "@line", "align": "center", "font_size": 12.5, "font_family": "@font_mono", "cursor": "pointer", "hover": { "background": "@hover" } },
          "tooltip": "What this worktree's chats cost",
          "on": { "click": [{ "do": "state.toggle", "key": "usage_cost_open" }, { "do": "state.set", "key": "usage_plan_open", "value": false }] },
          "children": [{ "type": "text", "props": { "text": "{{ .usage.worktree_text }}" } }]
        },
        {
          "if": ".state.usage_cost_open and (.app.dragging | not)",
          "type": "box", "layer": "top",
          "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
          "on": { "click": { "do": "state.set", "key": "usage_cost_open", "value": false } }
        },
        {
          "if": ".state.usage_cost_open",
          "id": "usage-cost-panel",
          "type": "column", "layer": "top",
          "style": { "position": "absolute", "top": 32, "right": -6, "width": 340, "padding": [12, 14], "gap": 6, "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg", "font_size": 13 },
          "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
          "children": [
            { "type": "text", "props": { "text": "Conversation cost" }, "style": { "font_size": 14, "font_weight": "semibold", "padding": [0, 0, 4, 0] } },
            { "type": "UsageRow", "props": { "label": "Active conversation", "value": "{{ .usage.chat_text }}" } },
            { "type": "UsageRow", "props": { "label": "Current worktree", "value": "{{ .usage.worktree_text }}", "strong": true } },
            { "if": "(.usage.tabs | length) > 0", "type": "divider", "style": { "margin": [4, 0] } },
            { "if": "(.usage.tabs | length) > 0", "type": "text", "props": { "text": "Tabs in this worktree" }, "style": { "font_size": 12, "color": "@text_faint" } },
            { "for": ".usage.tabs", "as": "t", "key": ".t.id", "type": "UsageRow", "props": { "label": "{{ .t.name }}", "value": "{{ .t.cost_text }}", "strong": "{{ .t.id == .selected.chat.id }}" } },
            { "type": "divider", "style": { "margin": [4, 0] } },
            { "type": "text", "props": { "text": "All conversations" }, "style": { "font_size": 12, "color": "@text_faint" } },
            { "type": "UsageRow", "props": { "label": "Last 7 days", "value": "{{ .usage.last_7_text }}", "strong": true } },
            { "type": "UsageRow", "props": { "label": "Last 30 days", "value": "{{ .usage.last_30_text }}", "strong": true } },
            { "type": "UsageRow", "props": { "label": "Last 90 days", "value": "{{ .usage.last_90_text }}", "strong": true } },
            { "type": "UsageRow", "props": { "label": "Lifetime", "value": "{{ .usage.lifetime_text }}", "strong": true } },
            { "if": "(.usage.providers | length) > 1", "type": "divider", "style": { "margin": [4, 0] } },
            { "if": "(.usage.providers | length) > 1", "type": "text", "props": { "text": "By provider, last 30 days" }, "style": { "font_size": 12, "color": "@text_faint" } },
            {
              "if": "(.usage.providers | length) > 1", "for": ".usage.providers", "as": "p", "key": ".p.id",
              "type": "row", "style": { "height": 24, "gap": 8, "align": "center" },
              "children": [
                { "type": "icon", "props": { "name": "{{ .p.icon // \"circle\" }}", "size": 13, "color": "{{ .p.color // \"@text_muted\" }}" } },
                { "type": "text", "props": { "text": "{{ .p.name }}" }, "style": { "grow": 1, "min_width": 0, "truncate": true, "color": "@text_muted" } },
                { "type": "text", "props": { "text": "{{ .p.last_30_text }}" }, "style": { "font_family": "@font_mono" } }
              ]
            },
            { "if": ".usage.unpriced_tokens > 0", "type": "text", "props": { "text": "{{ .usage.unpriced_tokens }} tokens unpriced ({{ .usage.unpriced_models | join(\", \") }})" }, "style": { "font_size": 11.5, "color": "@text_faint", "padding": [4, 0, 0, 0] } },
            { "type": "text", "props": { "text": "Rates: models.dev{{ if .usage.rates_updated then \", updated \" + .usage.rates_updated else \"\" end }}{{ if .usage.loading then \" · counting…\" else \"\" end }}" }, "style": { "font_size": 11.5, "color": "@text_faint" } },
            { "type": "text", "props": { "text": "API-equivalent cost of every agent conversation ({{ [.usage.providers[].name] | join(\", \") }}) on both machines, not a bill: plan usage is valued at the same rates." }, "style": { "font_size": 11.5, "color": "@text_faint" } }
          ]
        }
      ]
    },

    "UsageRow": {
      "about": "A label and an amount on one line. props: label, value, strong (bool).",
      "type": "row",
      "style": { "height": 24, "gap": 10, "align": "center" },
      "children": [
        { "type": "text", "props": { "text": "{{ .props.label }}" }, "style": { "grow": 1, "min_width": 0, "truncate": true, "color": "{{ if .props.strong then \"@text\" else \"@text_muted\" end }}" } },
        { "type": "text", "props": { "text": "{{ .props.value }}" }, "style": { "font_family": "@font_mono", "font_weight": "{{ if .props.strong then \"semibold\" else \"normal\" end }}" } }
      ]
    },

    "PlanButton": {
      "about": "How much of each provider's plan is left (`.usage.plans`: Claude Code's usage endpoint, Codex's own rate limits). The gauge shows `.usage.plan.meter` (mode: state usage_meter, else settings usage.meter; providers: usage.meter_providers).",
      "type": "box",
      "style": { "position": "relative" },
      "children": [
        {
          "type": "IconButton", "id": "usage-plan-button",
          "props": {
            "icon_size": 18, "icon_color": "{{ {\"danger\": \"@danger\", \"warning\": \"@warning\", \"ok\": \"@success\"}[.usage.plan.meter.level] // \"@text_muted\" }}",
            "icon": "{{ .usage.plan.meter.icon // \"circle-gauge\" }}", "size": 26,
            "tooltip": "{{ if .usage.plan.meter then .usage.plan.meter.provider_name + \" \" + .usage.plan.meter.name + \": \" + ((.usage.plan.meter.left | floor) | tostring) + \"% left\" else \"Plan usage\" end }}",
            "do": [{ "do": "state.toggle", "key": "usage_plan_open" }, { "do": "state.set", "key": "usage_cost_open", "value": false }]
          }
        },
        {
          "type": "IconButton", "if": ".state.usage_plan_open", "id": "usage-plan-button-above", "layer": "above", "motion": false, "style": { "position": "absolute", "top": 0, "left": 0 },
          "props": {
            "icon_size": 18, "icon_color": "{{ {\"danger\": \"@danger\", \"warning\": \"@warning\", \"ok\": \"@success\"}[.usage.plan.meter.level] // \"@text_muted\" }}",
            "icon": "{{ .usage.plan.meter.icon // \"circle-gauge\" }}", "size": 26,
            "tooltip": "{{ if .usage.plan.meter then .usage.plan.meter.provider_name + \" \" + .usage.plan.meter.name + \": \" + ((.usage.plan.meter.left | floor) | tostring) + \"% left\" else \"Plan usage\" end }}",
            "do": [{ "do": "state.toggle", "key": "usage_plan_open" }, { "do": "state.set", "key": "usage_cost_open", "value": false }]
          }
        },
        {
          "if": ".state.usage_plan_open and (.app.dragging | not)",
          "type": "box", "layer": "top",
          "style": { "position": "absolute", "left": -4000, "top": -4000, "width": 9000, "height": 9000 },
          "on": { "click": { "do": "state.set", "key": "usage_plan_open", "value": false } }
        },
        {
          "if": ".state.usage_plan_open",
          "id": "usage-plan-panel",
          "type": "column", "layer": "top",
          "style": { "position": "absolute", "top": 32, "right": -6, "width": 320, "padding": [12, 14], "gap": 10, "radius": 12, "border": 1, "border_color": "@line", "background": "@card", "shadow": "lg", "font_size": 13 },
          "animate": { "from": { "opacity": 0, "y": -4 }, "duration": 120 },
          "children": [
            { "if": "(.usage.plans | length) == 0", "type": "text", "props": { "text": "No plan usage yet: Refresh asks Claude Code; Codex reports its limits as its chats run." }, "style": { "color": "@text_faint" } },
            {
              "for": ".usage.plans", "as": "pl", "key": ".pl.provider",
              "type": "column", "style": { "gap": 10 },
              "children": [
                {
                  "type": "row", "style": { "gap": 8, "align": "center" },
                  "children": [
                    { "type": "icon", "props": { "name": "{{ .pl.icon // \"circle-gauge\" }}", "size": 15, "color": "{{ .pl.color // \"@text_muted\" }}" } },
                    { "type": "text", "props": { "text": "{{ .pl.name }}" }, "style": { "font_size": 14, "font_weight": "semibold", "grow": 1 } },
                    { "if": "(.usage.plans | length) > 1", "type": "text", "props": { "text": "{{ .pl.updated_text // \"\" }}" }, "style": { "font_size": 11.5, "color": "@text_faint" } }
                  ]
                },
                {
                  "for": ".pl.limits", "as": "l", "key": ".l.name",
                    "type": "column", "style": { "gap": 5 },
                    "children": [
                      {
                        "type": "row", "style": { "gap": 8, "align": "center" },
                        "children": [
                          { "type": "text", "props": { "text": "{{ .l.name }}" }, "style": { "grow": 1 } },
                          { "type": "text", "props": { "text": "{{ .l.left | floor }}% left" }, "style": { "color": "{{ {\"danger\": \"@danger\", \"warning\": \"@warning\", \"ok\": \"@success\"}[.l.level] // \"@text_muted\" }}" } },
                          { "if": ".l.resets_in", "type": "text", "props": { "text": "Resets in {{ .l.resets_in }}" }, "style": { "color": "@text_faint", "font_size": 12 } }
                        ]
                      },
                      {
                        "type": "box", "style": { "height": 6, "radius": 3, "background": "@hover" },
                        "children": [{ "type": "box", "style": { "height": 6, "radius": 3, "width": "{{ (.l.left | floor | tostring) + \"%\" }}", "background": "{{ {\"danger\": \"@danger\", \"warning\": \"@warning\", \"ok\": \"@success\"}[.l.level] // \"@text_muted\" }}" } }]
                      }
                    ]
                  }
              ]
            },
            { "type": "divider" },
            { "type": "text", "props": { "text": "Toolbar meter" }, "style": { "font_size": 12, "color": "@text_faint" } },
            {
              "id": "usage-meter-options", "type": "column", "style": { "gap": 2, "margin": [-4, -6, 0, -6], "min_width": 0 },
              "children": [
                { "type": "MeterOption", "props": { "mode": "smart", "text": "Smart", "about": "Whichever window is closest to running out." } },
                { "type": "MeterOption", "props": { "mode": "session", "text": "Prefer session", "about": "Always the shortest window, such as the 5-hour cycle." } },
                { "type": "MeterOption", "props": { "mode": "weekly", "text": "Prefer weekly", "about": "Always the longest window, such as the week." } }
              ]
            },
            { "type": "divider" },
            {
              "type": "row", "style": { "gap": 8, "align": "center", "font_size": 12, "color": "@text_faint" },
              "children": [
                { "type": "text", "props": { "text": "Updated {{ .usage.plan.updated_text // \"never\" }}" }, "style": { "grow": 1 } },
                { "type": "Pill", "id": "usage-refresh", "props": { "text": "Refresh", "do": "usage.refresh" } }
              ]
            }
          ]
        }
      ]
    },

    "DiffTools": {
      "about": "The diff's controls: what to compare against, collapse/expand every file, refresh.",
      "type": "row",
      "style": { "gap": 6, "align": "center" },
      "children": [
        { "if": ".selected.diff.loading", "type": "spinner", "props": { "size": "xsmall", "color": "@age" } },
        { "type": "Segment", "props": { "key": "diff_base", "value": "uncommitted", "text": "Uncommitted", "tooltip": "Changes not yet committed" } },
        { "type": "Segment", "props": { "key": "diff_base", "value": "branch", "text": "Whole branch", "tooltip": "Everything on this branch since it left main, committed or not" } },
        { "type": "IconButton", "props": { "icon": "chevrons-down-up", "tooltip": "Collapse all files", "do": "diff.collapse_all" } },
        { "type": "IconButton", "props": { "icon": "chevrons-up-down", "tooltip": "Expand all files", "do": "diff.expand_all" } },
        { "type": "IconButton", "props": { "icon": "refresh-cw", "tooltip": "Refresh", "do": "diff.refresh" } }
      ]
    },

    "ChangesPanel": {
      "about": "The worktree's changes in a panel right of the chat (state.changes_place \"right\"). Resizable (state.changes_width).",
      "type": "stack",
      "style": { "width": "{{ .state.changes_width }}", "height": "full", "shrink": 0, "padding": [0, 14, 14, 0] },
      "animate": { "from": { "opacity": 0, "x": 28 }, "duration": 220 },
      "children": [
        {
          "type": "column",
          "style": { "width": "full", "height": "full" },
          "children": [
            {
              "id": "changes-panel-header",
              "type": "row",
              "style": { "height": 44, "shrink": 0, "gap": 6, "align": "center", "padding": [0, 4] },
              "on": { "mouse_down": "window.move", "double_click": "window.zoom" },
              "children": [
                { "type": "icon", "props": { "name": "file-diff", "size": 14, "color": "@age" } },
                { "type": "text", "props": { "text": "Changes{{ if .selected.diff.files > 0 then \" \" + (.selected.diff.files | tostring) else \"\" end }}" }, "style": { "font_size": 13, "font_weight": "semibold" } },
                { "type": "spacer" },
                { "type": "DiffTools" },
                {
                  "type": "IconButton", "id": "changes-to-bottom",
                  "props": { "icon": "panel-bottom", "tooltip": "Move changes back to the bottom panel", "do": [{ "do": "state.set", "key": "changes_place", "value": "bottom" }, { "do": "state.set", "key": "bottom_tab", "value": "changes" }, { "do": "state.set", "key": "terminal_open", "value": true }] }
                },
                { "type": "IconButton", "props": { "icon": "x", "tooltip": "Close", "do": { "do": "state.set", "key": "changes_place", "value": "bottom" } } }
              ]
            },
            {
              "type": "column",
              "style": { "grow": 1, "min_height": 0, "background": "@card", "border": 1, "border_color": "@line", "radius": 13, "overflow": "hidden" },
              "children": [{ "id": "panel-diff", "type": "diff", "style": { "grow": 1, "min_height": 0 } }]
            }
          ]
        },
        {
          "type": "resize_handle",
          "props": { "state": "changes_width", "axis": "x", "invert": true, "min": 320, "max": 1400 },
          "style": { "position": "absolute", "top": 0, "left": -3, "width": 6, "height": "full" }
        }
      ]
    },

    "BottomTab": {
      "about": "A tab in the bottom card. props: tab (the state.bottom_tab value it selects), text, icon.",
      "type": "row",
      "style": {
        "height": 26, "padding": [0, 11], "gap": 6, "align": "center", "radius": 13, "border": 1, "font_size": 13, "cursor": "pointer",
        "border_color": "{{ if .state.bottom_tab == .props.tab then \"@tab_border\" else \"transparent\" end }}",
        "background": "{{ if .state.bottom_tab == .props.tab then \"@tab_bg\" else \"transparent\" end }}",
        "color": "{{ if .state.bottom_tab == .props.tab then \"@text\" else \"@age\" end }}",
        "hover": { "color": "@text" }
      },
      "on": { "click": { "do": "state.set", "key": "bottom_tab", "value": "{{ .props.tab }}" } },
      "children": [
        { "if": ".props.icon", "type": "icon", "props": { "name": "{{ .props.icon }}", "size": 13 } },
        { "type": "text", "props": { "text": "{{ .props.text }}" } }
      ]
    },

    "MeterOption": {
      "about": "One choice of what the toolbar gauge reports, previewed with that mode's own gauge. props: mode (smart | session | weekly), text, about.",
      "type": "row",
      "style": {
        "gap": 10, "padding": [6, 6], "align": "center", "radius": 8, "cursor": "pointer",
        "background": "{{ if .usage.plan.meter_mode == .props.mode then \"@selection\" else \"transparent\" end }}",
        "hover": { "background": "@hover" }
      },
      "on": { "click": { "do": "state.set", "key": "usage_meter", "value": "{{ .props.mode }}" } },
      "children": [
        {
          "type": "box", "style": { "width": 30, "height": 30, "shrink": 0, "radius": 15, "align": "center", "justify": "center", "background": "@window", "border": 1, "border_color": "@line" },
          "children": [{ "type": "icon", "props": { "name": "{{ .usage.plan.meters[.props.mode].icon // \"circle-gauge\" }}", "size": 18, "color": "{{ {\"danger\": \"@danger\", \"warning\": \"@warning\", \"ok\": \"@success\"}[.usage.plan.meters[.props.mode].level] // \"@text_muted\" }}" } }]
        },
        {
          "type": "column", "style": { "grow": 1, "shrink": 1, "min_width": 0, "gap": 1 },
          "children": [
            { "type": "text", "props": { "text": "{{ .props.text }}" } },
            { "type": "text", "props": { "text": "{{ .props.about }}" }, "style": { "font_size": 12, "color": "@text_faint" } }
          ]
        },
        { "if": ".usage.plan.meter_mode == .props.mode", "type": "icon", "props": { "name": "check", "size": 14, "color": "@accent" } }
      ]
    },

    "Segment": {
      "about": "One option of a segmented control bound to a state key. props: key, value, text, tooltip.",
      "type": "row",
      "style": {
        "height": 24, "padding": [0, 9], "align": "center", "radius": 6, "font_size": 12, "cursor": "pointer",
        "background": "{{ if .state[.props.key] == .props.value then \"@selection\" else \"transparent\" end }}",
        "color": "{{ if .state[.props.key] == .props.value then \"@text\" else \"@age\" end }}",
        "hover": { "color": "@text" }
      },
      "tooltip": "{{ .props.tooltip // \"\" }}",
      "on": { "click": { "do": "state.set", "key": "{{ .props.key }}", "value": "{{ .props.value }}" } },
      "children": [{ "type": "text", "props": { "text": "{{ .props.text }}" } }]
    }
  },

  // What happens when things happen (SETTINGS.md, Events, lists them all: app.start, app.focus,
  // host.connected, chat.added, chat.message, worktree.mr, select, hook, usage.level, ...). Each event:
  // {"if": jq, "do": action} or a list of them; the chat is .chat.
  "events": {
    // A banner (notify.system without its own `on_click`) was clicked: bring the window up on its chat.
    "notification.click": { "do": ["app.activate", { "do": "chat.show", "chat": "{{ .chat.id }}" }] },
    // Typing with nothing focused (chat.type_to_focus): into the selected chat's message box.
    "type_to_focus": { "do": [{ "do": "focus", "area": "composer" }, { "do": "composer.type", "text": "{{ .text }}" }] },
    "chat.waiting": {
      "if": ".app.focused | not",
      "do": [
        { "do": "notify.system", "chat": "{{ .chat.id }}", "title": "{{ .chat.name }} needs you", "text": "{{ .chat.waiting_on.tool_input.questions[0].question // .chat.waiting_on.message // \"It's waiting for an answer.\" }}", "sound": false },
        "dock.bounce"
      ]
    },
    "chat.finished": {
      "if": ".app.focused | not",
      "do": { "do": "notify.system", "chat": "{{ .chat.id }}", "title": "{{ .chat.name }} finished", "text": "{{ .chat.last_message // \"Ready for your next message.\" }}", "sound": false }
    },
    "designer.finished": {
      "if": ".app.focused | not",
      "do": { "do": "notify.system", "chat": "designer", "title": "The designer finished", "text": "Your changes are in.", "sound": false }
    },
    // The setup guide's steps (components.Setup), each running bin/setup (settings setup.command).
    "setup.check": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "check" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} check", "timeout": 60, "then": [
        { "do": "state.set", "key": "setup_facts", "value": "{{ (.output.stdout | fromjson)? // {} }}" },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] },
    "setup.terminal": { "do": { "do": "shell", "run": "osascript -e 'on run argv' -e 'tell application \"Terminal\" to do script (item 1 of argv)' -e 'tell application \"Terminal\" to activate' -e 'end run' \"$CMD\"", "env": { "CMD": "{{ .payload.run }}" } } },
    "setup.box_check": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "box" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} box \"$HOST\"", "env": { "HOST": "{{ .state.setup_ssh }}" }, "timeout": 60, "then": [
        { "do": "state.set", "key": "setup_box", "value": "{{ ((.output.stdout | fromjson)? // {ok: false, error: \"no answer\"}) + {host: .state.setup_ssh} }}" },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] },
    "setup.box_install": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "box_install" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} box-install \"$HOST\"", "env": { "HOST": "{{ .state.setup_box.host }}" }, "timeout": 1900, "then": [
        { "do": "state.set", "key": "setup_box", "value": "{{ ((.output.stdout | fromjson)? // {ok: false, error: \"no answer\"}) + {host: .state.setup_box.host} }}" },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] },
    "setup.backup_create": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "backup" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} backup-create", "timeout": 90, "then": [
        { "do": "if", "cond": "{{ ((.output.stdout | fromjson)? // {}).ok }}",
          "then": [{ "do": "settings.set", "key": "daemon.state_repo_url", "value": "{{ ((.output.stdout | fromjson)? // {}).url }}" }, { "do": "state.set", "key": "setup_backup_error", "value": null }],
          "else": { "do": "state.set", "key": "setup_backup_error", "value": "{{ ((.output.stdout | fromjson)? // {}).error // \"no answer\" }}" } },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] },
    "setup.backup_use": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "backup_check" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} backup-check \"$URL\"", "env": { "URL": "{{ .state.setup_backup_url }}" }, "timeout": 60, "then": [
        { "do": "if", "cond": "{{ ((.output.stdout | fromjson)? // {}).ok }}",
          "then": [{ "do": "settings.set", "key": "daemon.state_repo_url", "value": "{{ .state.setup_backup_url }}" }, { "do": "state.set", "key": "setup_backup_error", "value": null }],
          "else": { "do": "state.set", "key": "setup_backup_error", "value": "Can't read it: {{ ((.output.stdout | fromjson)? // {}).error // \"no answer\" }}" } },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] },
    "setup.finish": { "do": [
      { "do": "state.set", "key": "setup_busy", "value": "finish" },
      { "do": "shell", "run": "{{ .settings.setup.command // (.settings.app.source_dir + \"/bin/setup\") }} finish", "timeout": 600, "then": [
        { "do": "state.set", "key": "setup_finish", "value": "{{ (.output.stdout | fromjson)? // {ok: false, error: \"no answer\"} }}" },
        { "do": "state.set", "key": "setup_busy", "value": null }
      ] }
    ] }
  },

  // Which chat state changes are which events: {from: state | [states] | "*", to, event}.
  "events_options": {
    "transitions": [
      { "from": "*", "to": "waiting", "event": "chat.waiting" },
      { "from": "working", "to": "idle", "event": "chat.finished" },
      { "from": ["working", "waiting", "idle"], "to": "stopped", "event": "chat.stopped" }
    ]
  },

  // The designer (the palette button's agent that edits these settings). It runs without a terminal, so
  // it can't ask for permissions: add_dirs are the folders it may read besides this one (uploads hold
  // the images you paste or drop into it).
  "designer": {
    // The designer's instructions (null: the built-in ones) and the claude it runs.
    "prompt": null,
    "claude": "~/.local/bin/claude",
    "add_dirs": ["~/.agent-box/uploads", "~/Desktop", "~/Downloads"],
    "tools": ["Read", "Edit", "Write", "Glob", "Grep"],
    "permission_mode": "acceptEdits",
    // Where its conversations are kept (null: Claude Code's folder for the settings folder; {slug} is
    // that folder's name), more arguments for claude, and whether Claude Code's own hooks run for it.
    "sessions_dir": null,
    "extra_args": [],
    "hooks": false
  },

  // `settings.agent`'s one-shot run: {dir} the settings folder, {claude} designer.claude, $REQUEST the
  // request (null: the built-in command).
  "settings_agent": { "command": null },

  // Where chats and worktrees run. Tabs, worktree rows, and the closed-chats list show the host's icon.
  // A host with "connection": {"ssh_host", "daemon", "ssh_options"?, "retry_seconds"?} is connected to
  // (no ssh_host: its daemon runs here); app.default_host uses `connection` and app.local_host uses
  // `local` unless they have their own.
  "hosts": {
    "box": { "label": "On the box", "icon": "cloud", "color": "@text_faint" },
    "mac": { "label": "On this Mac", "icon": "laptop", "color": "@success" }
  },

  // Sounds when things happen, focused or not ("when": "unfocused" to only play in the background).
  // A name is a macOS sound (Basso Blow Bottle Frog Funk Glass Hero Morse Ping Pop Purr Sosumi
  // Submarine Tink) or an audio file path; null silences one. chat.question: a turn that ends asking you.
  "sounds": {
    "enabled": true,
    "volume": 1,
    "when": "always",
    "chat.finished": "Glass",
    "chat.question": "Ping",
    "chat.waiting": "Funk",
    "chat.stopped": null,
    "designer.finished": "Glass",
    // The events whose sound becomes chat.question when the chat's last reply asks something.
    "question_event": "chat.finished"
  },

  // The Dock icon's badge (how many chats are waiting on you), and the items of its right-click menu
  // ({label, do, if, checked} like menu_bar items).
  "dock": { "badge": "{{ [.chats[] | select(.state == \"waiting\")] | length }}", "menu": [] },

  "keys": [
    // `not_in`: leave the key to the focused "terminal", "composer", or other "input" (cmd-k clears a terminal).
    { "key": "cmd-k", "do": "palette.open", "not_in": ["terminal"] },
    { "key": "cmd-shift-p", "do": "palette.open" },
    { "key": "cmd-\\", "do": { "do": "state.toggle", "key": "sidebar_open" } },
    { "key": "cmd-j", "do": { "do": "state.toggle", "key": "terminal_open" } },
    { "key": "cmd-,", "do": "settings.open" },
    { "key": "cmd-shift-d", "do": { "do": "state.toggle", "key": "designer_open" } },
    { "key": "cmd-n", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
    { "key": "ctrl-shift-t", "if": ".selected.worktree", "do": "terminal.new" },
    { "key": "cmd-shift-c", "if": ".selected.worktree", "do": { "do": "clipboard.copy", "text": "{{ .selected.worktree.path }}" } },
    { "key": "cmd-shift-n", "if": ".selected.worktree", "do": { "do": "worktree.new", "repo": "{{ .selected.worktree.repo }}", "host": "{{ .selected.worktree.host }}" } },
    // Back and forward through where you've been (the mouse's side buttons and trackpad swipes do too).
    { "key": "cmd-[", "do": "nav.back" },
    { "key": "cmd-]", "do": "nav.forward" },
    { "key": "cmd-alt-]", "do": { "do": "select", "offset": 1 } },
    { "key": "cmd-alt-[", "do": { "do": "select", "offset": -1 } },
    { "key": "cmd-q", "do": "app.quit" },
    { "key": "escape", "if": ".app.confirm", "do": "confirm.cancel" },
    { "key": "escape", "if": ".state.setup_step == \"tour\"", "do": { "do": "state.set", "key": "setup_step", "value": "done" } },
    { "key": "cmd-w", "if": ".selected.chat", "do": { "do": "if", "cond": "{{ .selected.chat.state == \"working\" or .selected.chat.state == \"waiting\" }}", "then": { "do": "confirm", "title": "Stop “{{ .selected.chat.name }}”?", "text": "It's still working. Closing the tab stops its {{ .agents[.selected.chat.agent].name // \"agent\" }} process; the chat stays under the clock to reopen later.", "confirm": "Stop and close", "cancel": "Keep it running", "then": { "do": "chat.close", "chat": "{{ .selected.chat.id }}" } }, "else": { "do": "chat.close", "chat": "{{ .selected.chat.id }}" } } }
  ],

  "commands": [
    { "label": "Set up a.box…", "do": [{ "do": "state.set", "key": "setup_step", "value": "welcome" }, { "do": "emit", "event": "setup.check" }] },
    { "label": "Take the tour", "do": [{ "do": "state.set", "key": "setup_tour", "value": 0 }, { "do": "state.set", "key": "setup_step", "value": "tour" }] },
    { "label": "Redesign the app (open the designer)", "do": { "do": "state.set", "key": "designer_open", "value": true } },
    { "label": "Undo the last design change", "do": "settings.undo" },
    { "label": "New chat here", "if": ".selected.worktree", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}" } },
    { "label": "New Codex chat here", "if": ".selected.worktree", "do": { "do": "chat.new", "dir": "{{ .selected.worktree.path }}", "agent": "codex" } },
    { "label": "New orchestrator chat in redo", "do": { "do": "chat.new", "repo": "redo", "kind": "orchestrator" } },
    { "label": "New feature chat in redo…", "do": { "do": "prompt", "title": "Branch name", "then": { "do": "chat.new", "repo": "redo", "kind": "feature", "branch": "{{ .input }}" } } },
    { "label": "New section…", "do": "section.new" },
    { "label": "Sidebar: sort by recent activity", "if": ".state.sidebar_order != \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "recent" } },
    { "label": "Sidebar: sort manually", "if": ".state.sidebar_order == \"recent\"", "do": { "do": "state.set", "key": "sidebar_order", "value": "manual" } },
    { "label": "Restore removed projects", "if": ".app.removed_projects | length > 0", "do": "project.restore" },
    { "label": "Sidebar: list chats under worktrees", "if": ".state.sidebar_rows != \"chats\"", "do": { "do": "state.set", "key": "sidebar_rows", "value": "chats" } },
    { "label": "Sidebar: worktrees only", "if": ".state.sidebar_rows == \"chats\"", "do": { "do": "state.set", "key": "sidebar_rows", "value": "worktrees" } },
    { "label": "Toggle sidebar", "do": { "do": "state.toggle", "key": "sidebar_open" } },
    { "label": "Toggle terminal", "do": { "do": "state.toggle", "key": "terminal_open" } },
    { "label": "Open in Cursor", "if": ".selected.worktree", "do": { "do": "open", "url": "{{ if .selected.worktree.host == \"mac\" then \"cursor://file\" + .selected.worktree.path else \"cursor://vscode-remote/ssh-remote+\" + .app.ssh_host + .selected.worktree.path end }}" } },
    { "label": "Open in VS Code", "if": ".selected.worktree", "do": { "do": "open", "url": "vscode://vscode-remote/ssh-remote+{{ .app.ssh_host }}{{ .selected.worktree.path }}" } },
    { "label": "Open merge request", "if": ".selected.worktree.mr", "do": { "do": "open", "url": "{{ .selected.worktree.mr.url }}" } },
    { "label": "Commit and push", "if": ".selected.chat", "do": { "do": "chat.send", "text": "Commit and push your changes." } },
    { "label": "Test this branch on the Mac", "if": ".selected.worktree.branch and (.selected.worktree.is_primary | not)", "do": { "do": "worktree.test_local", "branch": "{{ .selected.worktree.branch }}" } },
    { "label": "Move {{ .selected.move.scope }} to the Mac", "if": ".selected.chat.host == \"box\"", "do": { "do": "chat.move", "to": "mac" } },
    { "label": "Move {{ .selected.move.scope }} to the cloud (the box)", "if": ".selected.chat.host == \"mac\"", "do": { "do": "chat.move", "to": "box" } },
    { "label": "Move only this chat to the Mac", "if": ".selected.chat.host == \"box\" and .selected.move.scope != \"chat\"", "do": { "do": "chat.move", "to": "mac", "scope": "chat" } },
    { "label": "Move only this chat to the cloud (the box)", "if": ".selected.chat.host == \"mac\" and .selected.move.scope != \"chat\"", "do": { "do": "chat.move", "to": "box", "scope": "chat" } },
    { "label": "Stop chat", "if": ".selected.chat.alive", "do": "chat.stop" },
    { "label": "Start chat", "if": ".selected.chat and (.selected.chat.alive | not)", "do": "chat.start" },
    { "label": "Archive chat", "if": ".selected.chat", "do": "chat.archive" },
    { "label": "Expand all steps", "if": ".selected.chat", "do": "steps.expand_all" },
    { "label": "Collapse all steps", "if": ".selected.chat", "do": "steps.collapse_all" },
    { "label": "Settings", "do": "settings.open" },
    { "label": "Settings reference", "do": "settings.docs" },
    { "label": "Reload settings", "do": "settings.reload" },
    { "label": "Quit", "do": "app.quit" }
  ],

  "chat": {
    // ---- Transcript text and look ----
    // Lines Claude Code writes that aren't conversation: meta and wrappers show as notices when true;
    // compaction / agent_messages: "step" | "message" | "hidden"; task_notifications: "notice" | "message" | "hidden".
    // pasted: text you pasted, which Claude Code wraps in <pasted_content> tags: "plain" (just the text),
    // "quote" (as a quote) or "tags" (as written).
    "show": { "meta": false, "sidechain": false, "wrappers": false, "compaction": "step", "agent_messages": "step", "task_notifications": "notice", "errors": true, "pasted": "plain" },
    // The "Thinking…"/"Working…" row while the agent works. It shows the agent's own status line when
    // the daemon reads one (verb, time, tokens), and "nothing new for {time}" once the token count (or,
    // without a status line, the transcript) hasn't moved for quiet_secs.
    "pending": { "show": true, "quiet_secs": 60 },
    // Tool step summaries are cut to this many characters.
    "summary_chars": 140,
    // Counted labels may have KEY_one / KEY_other forms (e.g. "steps_one"); {s} is `plural` unless n is 1.
    "labels": {
      "plural": "s",
      "steps": "{n} step{s}{failed}", "steps_failed": ", {n} failed", "earlier_steps": "{n} earlier step{s}",
      "thinking": "Thinking", "thought": "Thought", "pending_thinking": "Thinking", "pending_working": "Working",
      "activity_thinking": "Thinking", "activity_writing": "Writing", "more_lines": "… {n} more lines",
      // A finished thought's title: its summary's first line.
      "thought_summary": "{summary}",
      "pending_status": "{verb}", "pending_elapsed": " · {time}", "pending_tokens": " · {tokens}", "pending_note": " · {note}",
      "pending_quiet": " · nothing new for {time}",
      "compacted": "Compacted the conversation", "compacted_auto": "Compacted the conversation automatically",
      "message_from": "Message from {from}", "message_from_summary": "Message from {from}: {summary}",
      "skill_subject": "the {skill} skill", "background_finished": "A background task finished", "another_session": "another session"
    },
    // Per tool name (or "*"): { "doing", "done", "failed", "icon", "activity" }; any field overrides the built-in table.
    // "subject": what follows the prefix, as jq or a {{ }} template over .input, .summary, .name.
    // "detail": what an open step shows: diff | command | result | json | markdown, or a component (gets
    // .props {input, result, is_error, name, id}).
    "tools": {},
    // Replace a transcript part with a component name or node; it gets the item as .props: user and
    // assistant {kind, text, index, chat, key, uploads, raw}, notice, step {kind: tool | thinking, id, title,
    // icon, running, error, open, tool, input, result, summary, text}; waiting (the `waiting` node's card)
    // {chat, message, questions, options: [{label, index, do}], cancel: {label, do}, tool}. null: built in.
    "render": { "user": null, "assistant": null, "step": null, "notice": null, "waiting": null },
    // A scrollbar on the transcript: never | scrolling | hover | always.
    "scrollbar": "never",
    // Each run of thinking and tool calls as one row (false: a row per step); fold_running: a long run
    // folds its earlier steps while it's still going.
    "group_steps": true, "fold_running": true,
    // Show thinking as Markdown instead of plain text.
    "thinking_markdown": false,
    // A failed step's line: style keys over trace_line.
    "trace_line_error": { "color": "@danger" },
    "tool_names": { "strip": "mcp__", "separator": " · " },
    // icons may also set pending_thinking / pending_working (each falls back to pending).
    "step_line": {
      "icon_size": 14, "chevron_size": 12, "pulse_ms": 1400, "pulse_min": 0.35, "pulse_max": 1,
      "icons": { "pending": "brain", "thinking": "brain", "fold": "list-checks", "open": "chevron-down", "closed": "chevron-right" }
    },
    "step_detail": {
      "removed": "@diff_del", "removed_background": "@diff_del_bg", "added": "@diff_add", "added_background": "@diff_add_bg",
      "error": "@danger", "removed_prefix": "- ", "added_prefix": "+ ", "command_prefix": "$ ", "json_fallback": true,
      "tab_width": 4, "padding_x": 8, "padding_bottom": 12,
      // The "… N more lines" row: style keys over italic.
      "more": {}
    },
    // strip_prefix_min_digits: how many leading digits before a dash make a timestamp to hide, for step
    // titles, chips, and files in sent messages (or one number for all). on_click: an action with
    // .path, .agent_path, .name, .index, .chat.
    "attachments": {
      "size": 64, "image_width_factor": 2.5, "image_extensions": ["png", "jpg", "jpeg", "gif", "webp"], "strip_prefix": true,
      "strip_prefix_min_digits": { "steps": 10, "chips": 10, "messages": 1 },
      "file_icon": "file", "file_icon_size": 18, "gap": 4, "padding": 4, "name_size": 10, "uploading_overlay": "#00000073",
      "failed_border": "@danger", "failed_border_width": 2, "on_click": null,
      "remove": { "size": 18, "icon_size": 11, "icon": "x", "top": 3, "right": 3, "background": "#000000a6", "color": "#ffffff", "hover": {} }
    },
    // The file icon in a sent message's file chips (`file` styles the chip).
    "file_icon_size": 14,
    // ---- Chips over the transcript ----
    "jump_icon": "arrow-down", "jump_icon_size": 13, "jump_bottom": 14,
    // The "Loading earlier messages…" chip (its look falls back to `jump`), and how close to the top loads more.
    "loading_chip_top": 10, "load_earlier_within": 0,
    "drop_overlay_icon": "paperclip", "drop_overlay_icon_size": 22,
    // ---- The message box ----
    "composer_lines": { "min": 1, "max": 10 }, "composer_gap": 6, "composer_radius": 6,
    "suggestion_hint": "   ⇥ Tab",
    // Keys besides Tab that take Claude's suggestion into an empty message box.
    "suggestion_keys": [],
    "cmd_enter_sends": true,
    // The completion list's keys, and what the keys the message box binds itself do while it's open
    // (next, prev, accept, close; null leaves the key to the box).
    "completion_keys": { "next": ["ctrl-n"], "prev": ["ctrl-p"], "accept": [], "close": [] },
    "completion_builtin_keys": { "up": "prev", "down": "next", "enter": "accept", "tab": "accept", "escape": "close" },
    // Keys the message box binds that you can give other jobs: send, newline, suggestion (take the
    // agent's suggestion). Names: enter, shift-enter, cmd-enter, tab, up, down, escape.
    "composer_keys": { "send": [], "newline": [], "suggestion": ["tab"] },
    "completion_limit": 12, "completion_cache_secs": 20,
    // ---- Waiting chats ----
    // Choices when a waiting chat gives none (a permission prompt); every question shows when there are several.
    "waiting_options": ["Yes", "Yes, don't ask again", "No"], "waiting_all_questions": true,
    // ---- Behavior ----
    // What makes a chat show as a tab (besides opening it yourself): alive, working, waiting, running_elsewhere.
    "open_when": ["alive", "working", "waiting", "running_elsewhere"],
    // A reply "asks" (the chat.question sound) when it ends with one of these.
    "asks_endings": ["?"],
    // A chat shows as working this long after you send, until its hook says so.
    "working_after_send_secs": 10,
    // Wait at least this long between queued messages to one chat.
    "queue_resend_secs": 8,
    // Closing a Mac chat's tab: "archive" (ends it in super.engineering too) or "stop".
    "close_on_mac": "archive",
    // A new chat's kind: with no folder, and in a folder without a branch.
    "new_kind": "orchestrator", "new_kind_in_folder": "primary",
    // Show a new chat once it starts (chat.new's `select`), and follow a moved one (chat.move's `follow`).
    "select_new": true, "move_follow": true,
    // Pasted files and images attach to the chat; files dropped anywhere on its transcript do too.
    "paste_attach": true, "drop_on_transcript": true,
    // Where this Mac keeps a repo whose worktree is on another machine (for "/" skills): {project}, {repo}.
    "local_repo_path": "~/dev/{project}",
    // Which tools start background shells and subagents (the background chips), and which stop them.
    "background_tools": { "shell": ["Bash"], "agent": ["Agent", "Task"], "kill": ["TaskStop", "KillShell", "KillBash"] },
    "last_message_chars": 280,
    "enter_sends": true,
    "placeholder": "Message the agent…",
    "designer_placeholder": "Describe a change to the app…",
    // Trace-style transcript (after shadcn's Trace): user turns as bubbles, replies as text, steps as quiet lines.
    "fold_steps_after": 5,
    "step_detail_lines": 40,
    // How many of a chat's newest transcript entries to load when it opens (long chats run to 40,000+).
    "transcript_tail": 600,
    // How many more older entries to load each time you scroll to the top of a long chat.
    "transcript_page": 600,
    // Typing one of these at the start of a word opens a list of matches under the composer.
    // Messages sent while the agent is working wait here and go out one per turn as it finishes.
    "queue": true,
    // Before continuing a chat super.engineering still runs ({name}: the chat). confirm: false skips the question.
    "takeover": { "confirm": true },
    // Typing with nothing focused goes to the selected chat's message box.
    "type_to_focus": true,
    // Claude Code's suggested next prompt shows in the empty message box; Tab fills it in (doesn't send).
    "suggestions": true,
    // Copy and Fork under each message while you hover it. An object sets buttons (["copy", "fork"], or
    // {icon, tooltip, do, id?} with templates over .text .chat .index), show (hover | always), designer (true:
    // also in the designer), icons, tooltips, icon_size, padding, radius, height, gap, color, hover.
    "message_actions": true,
    // Select and copy message text with the mouse.
    "selectable": true,
    // How replies' Markdown looks. Style objects take the usual style keys (padding, radius, font_size,
    // font_family, background, overflow_x...). Tables scroll sideways instead of squeezing.
    "markdown": {
      // theme: "dark" | "light" | "auto" (follows window.appearance); highlight: a code theme, or null for the theme's.
      "theme": "dark", "highlight": null,
      // Show <placeholders> as text instead of hiding them as HTML.
      "show_angle_brackets": true,
      "paragraph_gap": 0.75,
      "heading_sizes": [20, 17, 15, 14, 13, 13],
      "code_block": { "radius": 8, "padding": [10, 12], "font_family": "@font_mono", "font_size": 12.5 },
      "table": { "overflow_x": "scroll" },
      "table_head": {},
      "table_cell": { "padding": [6, 10] }
    },
    "completion_triggers": ["/"],
    // What each trigger offers: commands (slash_commands), skills (skill_dirs), files (the worktree's, up to
    // completion_files_max). Names starting with a skip prefix are left out. rank: default (prefix, then
    // contains, then description) or fuzzy (letters in order).
    "completion_sources": { "/": ["commands", "skills"], "@": ["files"] },
    "completion_skip_prefixes": ["_", "."], "completion_rank": "default", "completion_files_max": 5000,
    // What "/" offers: these commands, then the skills and commands in skill_dirs ({worktree}: the chat's
    // worktree; box worktrees read this Mac's checkout of the same repo).
    "slash_commands": [
      { "name": "clear", "description": "Start a fresh conversation" },
      { "name": "compact", "description": "Summarize the conversation to free up context" },
      { "name": "model", "description": "Switch the model" },
      { "name": "loop", "description": "Run a prompt on a schedule or self-paced" },
      { "name": "review", "description": "Review the current changes" },
      { "name": "context", "description": "Show what's using the context window" },
      { "name": "cost", "description": "Show this session's cost and usage" },
      { "name": "resume", "description": "Resume an earlier conversation" },
      { "name": "init", "description": "Write a CLAUDE.md for this repo" }
    ],
    // Each a path, or {path, kind: skill | command, source: project | personal}.
    "skill_dirs": ["{worktree}/.claude/skills", "{worktree}/.claude/commands", "{worktree}/.agents/skills", "~/.claude/skills", "~/.claude/commands", "~/.agents/skills"],
    // Selecting a worktree opens its live chat, if any: "open" (default) shows no chat when none is
    // running; "recent" shows the chat with the newest activity even when it isn't; "first" its first tab.
    "open_on_select": "open",
    // Code in expanded steps: long lines scroll sideways with a horizontal swipe, or with shift + scroll
    // (shift), which holds the transcript still. shift_holds_transcript: shift + scroll elsewhere in the
    // transcript doesn't scroll it either. scrollbar: hover | always | scrolling | never.
    // Shown over a chat while files are dragged onto it, naming the chat they'll attach to.
    // Where dropped files land: "card" (one DropOverlay over the whole chat, messages and message box) or
    // "parts" (the transcript and the message box each take drops, with drop_overlay / composer_drop).
    "drop_target": "card",
    "drop_overlay": { "radius": 12, "border": 2, "border_color": "@accent", "background": "#488efc1f", "gap": 8, "font_size": 14, "color": "@text" },
    // The message box while files are dragged over it.
    "composer_drop": { "border_color": "@accent", "background": "#488efc26" },
    "code_scroll": { "shift": true, "speed": 1, "shift_holds_transcript": true, "scrollbar": "hover" },
    "list": { "gap": 22, "padding": [20, 28], "width": "full", "max_width": 780, "self": "center" },
    // New messages: "at_bottom" keeps you at the newest while you're there (scroll up and it stays put),
    // "always" jumps to each one, "never" doesn't move. Scrolled up, a chip offers to jump down (false hides it).
    "follow": "at_bottom",
    "jump": { "padding": [5, 12], "radius": 14, "background": "@pill", "border": 1, "border_color": "@line", "font_size": 12.5, "color": "@text", "hover": { "background": "@pill_hover" }, "shadow": "md" },
    "jump_labels": { "new": "New messages", "latest": "Jump to latest" },
    "user": { "max_width": "80%", "padding": [8, 14], "radius": 16, "background": "@user_bubble", "font_size": 14, "line_height": 1.5, "gap": 6 },
    "assistant": { "font_size": 14, "line_height": 1.6 },
    "trace": { "gap": 8 },
    "trace_line": { "gap": 8, "align": "center", "font_size": 13.5, "color": "@text_muted", "hover": { "color": "@text" } },
    "trace_content": { "margin": [8, 0, 4, 7], "border_left": 1, "border_color": "@line", "padding": [0, 4, 0, 16], "color": "@text_muted", "font_size": 13, "line_height": 1.55, "gap": 6 },
    "step_code": { "font_family": "@font_mono", "font_size": 12, "radius": 6, "background": "@code_bg", "padding": [6, 0], "overflow": "hidden", "color": "@age" },
    "image": { "max_width": 360, "max_height": 240, "radius": 10, "margin": [6, 0, 0, 0] },
    "file": { "margin": [6, 0, 0, 0], "padding": [4, 8], "radius": 6, "background": "@pill", "font_size": 12.5, "color": "@age" },
    "notice": { "font_size": 12.5, "color": "@danger" },
    "empty": { "color": "@text_muted", "width": "full", "padding": [0, 32], "text_align": "center", "line_height": 1.5 },
    "waiting": { "padding": 12, "radius": 10, "border": 1, "border_color": "@warning", "background": "@waiting_bg", "font_size": 13 },
    "waiting_option": { "height": 26, "padding": [0, 10], "radius": 13, "border": 1, "border_color": "@line", "background": "@pill", "hover": { "background": "@pill_hover" }, "font_size": 12.5, "align": "center" },
    // The row of answer buttons in the waiting card.
    "waiting_row": { "gap": 6, "wrap": true }
  },

  "diff": {
    "row_height": 20, "gutter_width": 44, "sign_width": 14, "note_font_size": 12,
    "header": { "font_family": "@font_ui", "font_size": 12.5 },
    // Style objects over the built-in rows: a file's header, a hunk's @@ line, and each code line.
    // gutter is the line numbers (click opens the line); its hover applies while pointed at.
    "file_header": {}, "hunk": {}, "line": {}, "gutter": { "hover": { "opacity": 0.7 } },
    "tab_width": 4,
    "icons": { "open": "chevron-down", "closed": "chevron-right" },
    // {n} is the count. context_sign is shown for unchanged lines; expand/collapse name header clicks for agents.
    "labels": { "add_sign": "+", "del_sign": "−", "context_sign": " ", "arrow": "→", "added": "+{n}", "removed": "−{n}", "expand": "Expand", "collapse": "Collapse" },
    // Long lines wrap instead of scrolling sideways (rows then size to their text).
    "wrap": false,
    // Where the file list sits: "left", "right", or "hidden".
    "file_list_side": "left",
    // A component name (or node) to draw instead of a built-in part, with the item as .props:
    // file_row {path, old_path, status, adds, dels, dir, name, binary, collapsed, index, worktree, base};
    // line {kind: add|del|context|meta, old, new, text, file, sign, row, worktree, base}. null: built in.
    "render": { "file_row": null, "line": null },
    "max_lines_per_file": 4000, "refresh_ms": 2000,
    // Each a color or @token. status_A, status_D, status_M, status_R... color a file's status letter
    // (unset: A uses add, D uses del, the rest muted).
    "colors": { "add_bg": "@diff_add_bg", "del_bg": "@diff_del_bg", "add": "@diff_add", "del": "@diff_del", "muted": "@text_faint", "hunk_bg": "@diff_hunk_bg", "file_bg": "@diff_file_bg", "hover": "@hover" },
    // The line link for Mac worktrees (open_url is for box ones); both take {host} {machine} {path} {line}.
    "open_url_local": "cursor://file{path}:{line}",
    "font_size": 12,
    "open_url": "cursor://vscode-remote/ssh-remote+{host}{path}:{line}",
    "file_list": { "width": 260, "shrink": 0, "height": "full", "border_right": 1, "border_color": "@line", "padding": [6, 0] },
    "file_row": { "padding": [4, 12], "gap": 6, "font_size": 12.5 },
    "empty": { "color": "@text_muted" }
  },

  "terminal": {
    // Open the selected worktree's shell as soon as it's selected (false: when a terminal shows it).
    "open_on_select": true,
    // The 16 ANSI colors, normal then bright.
    "palette": ["#1e1e1f", "#e5534b", "#3fb950", "#d29922", "#488efc", "#bc8cff", "#39c5cf", "#d6d6d8",
                "#6e7681", "#ff7b72", "#56d364", "#e3b341", "#79c0ff", "#d2a8ff", "#56d4dd", "#ffffff"],
    // shape: block | bar | underline | hollow | app; optional "color"; thickness: bar/underline points;
    // blink_ms: blink half-period while focused (0: steady).
    "cursor": { "shape": "block", "focused_alpha": 0.75, "unfocused_alpha": 0.3, "thickness": 2, "blink_ms": 0 },
    // Bold text's weight; bold_is_bright draws bold base colors (0-7) in their bright twins; dim text's opacity.
    "bold_weight": 700, "bold_is_bright": false, "dim_alpha": 0.66,
    // OSC-8 links programs print: underlined (in color, when set); a click with modifier (cmd | ctrl | alt |
    // shift | none) opens them. inspect.json lists the ones on screen.
    "links": { "enabled": true, "modifier": "cmd", "color": null },
    // Cmd combos go to the app; true (or a list like ["cmd-b"]) sends them to the shell as meta (ESC + key).
    "cmd_passthrough": false,
    "size": { "cols": 100, "rows": 30 },
    "scrollback": 10000,
    // The wheel: "auto" (to the program when it asks for the mouse; in a tmux shell, tmux's own history,
    // without tmux's mouse mode so drags still select here; else this view's scrollback), "tmux", "local",
    // "app", or "off". Typing while scrolled back returns to the prompt.
    "wheel": "auto", "wheel_lines": 1,
    // Drag to select (double-click a word, triple-click a line); copy_key copies it.
    "select": true, "selection": "#3a425299", "copy_key": "cmd-c",
    "font_family": "Menlo",
    "font_size": 13,
    "line_height": 1.25,
    "padding": [14, 6],
    "foreground": "#f5f5f7",
    "background": "#1e1e1f",
    // Mac-style editing: each combo sends this text to the shell (readline/zsh codes). Use opt or alt,
    // cmd, ctrl, shift. {"paste": true} pastes the clipboard; {"do": ...} (or {"action": ...}) runs an app
    // action; null hands the combo back to the app. A `terminal` node's props font_size, font_family,
    // line_height and padding override these for that view.
    "keys": {
      "cmd-backspace": "\u0015",
      "alt-backspace": "\u001b\u007f",
      "cmd-delete": "\u000b",
      "alt-delete": "\u001bd",
      "cmd-left": "\u0001",
      "cmd-right": "\u0005",
      "alt-left": "\u001bb",
      "alt-right": "\u001bf",
      "shift-enter": "\u001b\r",
      "cmd-v": { "paste": true },
      "cmd-k": "\u000c"
    }
  },

  // A picture behind the whole window: a file (absolute, ~/, or in the settings folder) or URL; fit
  // cover | contain | fill | scale_down | none; dim lays a color over it. Panels need see-through colors
  // in `theme` (e.g. "#2e2218cc") for it to show.
  "background": { "image": null, "fit": "cover", "opacity": 1, "dim": null },

  // The window: title, starting size, the traffic lights' position, and the component kit's look
  // ("dark" | "light" | "system"; the app's own colors are `theme`). Read at launch.
  // native_titlebar: let macOS drag and zoom the window from the top strip itself (it then zooms on any
  // double click there, buttons included); off, the header rows' window.move / window.zoom do it.
  // remember_frame: reopen where it was (window.json in the settings folder); on_close: "close" (the window
  // closes, the app keeps running), "hide" (the app), "quit", or "keep" (the window stays).
  "window": { "title": "a.box", "width": 1500, "height": 940, "traffic_lights": { "x": 20, "y": 15 }, "appearance": "dark", "native_titlebar": false,
              "remember_frame": true, "activate_on_start": true, "on_close": "close" },

  // Words the app shows that aren't in the layout above. {name} parts are filled in.
  "strings": {
    "app_name": "a.box", "connected": "Connected", "reconnecting": "Reconnecting to {host}… ({why})",
    "starting_chat": "Starting a chat…", "start_failed": "Couldn't start the chat: {error}", "making_worktree": "Making a worktree for {branch}…",
    "working": "Working…", "done": "Done", "failed": "Failed", "copied": "Copied", "nothing_to_undo": "Nothing to undo", "no_window": "No window to capture",
    "sending_after_upload": "Sending when the upload finishes", "stop_elsewhere": "This chat is running in super.engineering: stop it there, or take it over first",
    "rename_branch_failed": "Couldn't rename the branch: {error}", "new_worktree_failed": "Couldn't make the worktree: {error}", "no_remote": "This project has no origin remote",
    "no_chat": "No chat here yet.", "new_chat_name": "New chat", "terminal_n": "Terminal {n}", "background_shell": "Background shell", "subagent": "Subagent",
    "waiting": "The agent is waiting for you", "waiting_cancel": "Cancel", "drop_to_attach": "Drop to attach to {chat}", "drag_move_to": "Move to {name}",
    "the_designer": "the designer", "this_chat": "this chat", "a_file": "a file", "n_files": "{n} files",
    "attaching": "Attaching {what} to {chat}", "attach_failed": "Couldn't attach: {error}", "upload_failed": "Upload failed: {error}",
    "dialog_save": "Save", "dialog_name": "Name", "settings_title": "Settings", "new_section_title": "New section",
    "menu_settings": "Settings…", "menu_palette": "Command Palette", "menu_quit": "Quit {app}",
    "settings_intro": "Everything about the app is here. Your file is merged over the built-in defaults; set a key to null to remove a default. Reference for you and agents: {docs}",
    "connecting": "Connecting…", "terminal": "Terminal", "settings_reference": "Reference", "settings_save": "Save", "prompt_title": "Enter a value",
    "rename_section_title": "Rename section", "rename_worktree_title": "Rename worktree", "rename_branch_title": "Rename branch",
    "new_worktree_title": "New {repo} worktree from branch (new or existing)", "project_settings_title": "{name} settings",
    "project_field_name": "Name", "project_field_letter": "Badge letter", "project_field_hue": "Badge color (hue, 0–360)",
    "usage_session": "Session", "usage_daily": "Daily", "usage_weekly": "Weekly", "usage_days": "{n} days", "usage_hours": "{n}h",
    "usage_weekly_model": "Weekly · {model}", "usage_just_now": "just now", "usage_ago": "{t} ago",
    "diff.select_worktree": "Select a worktree", "diff.no_changes": "No changes", "diff.loading": "Loading changes…", "diff.binary": "Binary file",
    "diff.more_lines": "{n} more lines; open the file to see them"
  },

  // How ages read in the sidebar and lists.
  "format": { "age": { "now": "now", "m": "{n}m", "h": "{n}h", "d": "{n}d", "w": "{n}w" } },

  // In-window notifications: shown at all, hidden after a few seconds, and how many recent ones `.app.notifications` keeps.
  "notifications": { "show": true, "autohide": true, "keep": 20 },

  // The command palette.
  "palette": { "placeholder": "Type a command or a worktree…", "worktrees": true, "worktree_label": "Go to {title}" },

  // Keep a.box itself current: every update_check_secs, fast-forward ~/dev/agent-box to its remote's main
  // (when the checkout is clean, on main), rebuild the daemon if it changed, and bundle and restart the app if
  // it did. Changes pushed from the box ship to the Mac this way.
  // update_command / restart_command: null runs the built-in ones (the update gets the checkout as
  // $AGENT_BOX_SOURCE). local_host: the machine the app runs on; default_host: where things go when
  // nothing says. source_dir: a.box's checkout; bin_dir: its scripts (null: source_dir/bin); path: PATH
  // for everything the app runs.
  "app": {
    "auto_update": true, "update_check_secs": 60, "min_update_check_secs": 15, "update_off_check_secs": 300,
    "update_command": null, "restart_command": null,
    "local_host": "mac", "default_host": "mac",
    "source_dir": "~/dev/agent-box", "bin_dir": null,
    "path": ["~/.local/bin", "~/.cargo/bin", "~/.super.engineering/bin", "~/dev/redo-monorepo-worktrees/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
  },

  // The setup guide a fresh install opens with (components.Setup; the palette's "Set up a.box…" reopens
  // it). command: what does its checks and steps (null: bin/setup in app.source_dir); tools: the CLIs its
  // Agents step looks for ({key: the name bin/setup check reports, name, about, required, install,
  // sign_in: commands it opens in Terminal}); tour: its stops ({id: a node id, or null for a card in the
  // middle, title, text}); welcome.points: {icon, title?, text}.
  "setup": {
    "command": null,
    "welcome": {
      "title": "Welcome to a.box",
      "text": "A box for your coding agents, shaped however you like. What it's built on, then a few quick steps and you're set.",
      "points": [
        { "icon": "box", "title": "Just a box", "text": "The app is a framework; the rest is liquid. Open the designer and shape its look and what it does, live, with no reloads." },
        { "icon": "bot", "title": "Agents are full users", "text": "Everything in the app is open to agents: they can read it, drive it, and start and steer other chats." },
        { "icon": "refresh-cw", "title": "Work syncs", "text": "Chats move between this Mac and a cloud box with their branch and uncommitted work, and outlive the app and the machine." },
        { "icon": "git-branch", "title": "Git-native", "text": "Projects are repos; each task is a worktree on its branch, with its merge request and checks on its row." },
        { "icon": "code", "title": "Ships as source", "text": "It builds and updates itself from its own git checkout, so agents can change a.box's code too." }
      ]
    },
    "tools": [
      { "key": "claude", "name": "Claude Code", "about": "Runs your chats.", "required": true, "install": "curl -fsSL https://claude.ai/install.sh | bash", "sign_in": "claude" },
      { "key": "codex", "name": "Codex", "about": "OpenAI's agent, for Codex chats.", "install": "brew install codex", "sign_in": "codex login" },
      { "key": "glab", "name": "GitLab CLI", "about": "Makes your private backup repo for you.", "install": "brew install glab", "sign_in": "glab auth login" },
      { "key": "coder", "name": "Coder CLI", "about": "Finds your Coder workspaces for the cloud box.", "install": "brew install coder", "sign_in": "coder login && coder config-ssh" }
    ],
    "tour": [
      { "id": "sidebar", "title": "Your work", "text": "Every project and section, with a row per worktree; a worktree's chats are its tabs. Drag rows and sections to arrange them, and right-click for more." },
      { "id": "footer-new-chat", "title": "Start a chat", "text": "⌘N starts a chat in the selected worktree. ⌘⇧N makes a new worktree for a new branch." },
      { "id": "designer-button", "title": "Make it yours", "text": "The designer is an agent that changes a.box while you watch. Ask for a new layout, a theme, or a button that runs a script." },
      { "id": null, "title": "One more thing", "text": "⌘K opens the command palette: every command, and every worktree by name. Settings (⌘,) hold every option. \"Set up a.box…\" in the palette brings this guide back." }
    ]
  },

  // Where pasted and dropped files are copied: here, and on the other machine for its chats.
  "uploads": { "dir": "~/.agent-box/uploads", "remote_dir": "~/.agent-box/uploads" },

  // worktree.new without repo / host (default_host null: app.default_host); select: show it once made.
  "worktree": { "default_repo": "redo", "default_host": null, "select": true },

  // project.open_remote's page for a remote: {host} and {path} (group/repo).
  "project": { "remote_url_template": "https://{host}/{path}" },

  // input: how long one press counts as the same press for every node under it.
  "input": { "press_dedupe_ms": 50 },

  "settings_editor": { "width": 760 },

  // Cost and plan usage (the $ pill and the gauge in the toolbar). rates: per model id (or prefix),
  // dollars per million tokens {input, output, cache_read, cache_write, cache_write_1h}, over models.dev's.
  "usage": {
    "refresh_secs": 120, "min_refresh_secs": 15, "rates_max_age_hours": 24, "rates_url": "https://models.dev/api.json",
    "rates": {},
    // A rate a table lacks, as a multiple of its input rate.
    "rate_fallbacks": { "output": 5, "cache_write": 1.25, "cache_write_1h": 2, "cache_read": 0.1 },
    // The agents' providers: name, icon and color in the popovers; rates: the models.dev tables that price
    // their models; plan: where the plan's limits come from. claude_oauth reads plan_file and refreshes it
    // with plan_command (default: Claude Code's usage endpoint) when older than plan_max_age_secs;
    // codex_rollouts takes the rate limits Codex writes into its sessions on either machine (filed under
    // plan_provider, default the provider's id); {"source": "file", "path", "jq", "command"?, "max_age_secs"?}
    // reads any file, its jq giving [{name?, kind, window_minutes, used (percent), resets_at}].
    "providers": {
      "anthropic": { "name": "Claude Code", "icon": "asterisk", "color": "@claude", "rates": ["anthropic"], "plan": "claude_oauth", "plan_file": "~/.claude/oauth-usage-cache.json", "plan_command": null, "plan_max_age_secs": 300 },
      "openai": { "name": "Codex", "icon": "aperture", "color": "@text", "rates": ["openai"], "plan": "codex_rollouts" }
    },
    // What the toolbar gauge reports: smart (the window closest to running out), session (the
    // shortest window) or weekly (the longest). The popover's picker saves its choice in state
    // usage_meter, which wins over this. The gauge turns warning/danger below these percents left.
    // meter_providers: only these providers' limits drive the gauge (null: every provider's).
    "meter": "smart", "meter_providers": null, "meter_levels": { "warning": 50, "danger": 20 }
  },

  // The macOS menu bar: app_menu is the a.box menu ({"splice": "app"} puts `app`'s items there); each of
  // `menus` is a menu of its own ({name, items}). Items: {label, do, if, checked, disabled, shortcut,
  // items (a submenu), id} or {separator: true}; label, if and checked are jq against the context.
  "menu_bar": {
    "app_menu": [
      { "id": "settings", "label": "{{ .settings.strings.menu_settings // \"Settings…\" }}", "do": "settings.open" },
      { "id": "palette", "label": "{{ .settings.strings.menu_palette // \"Command Palette\" }}", "do": "palette.open" },
      { "splice": "app" },
      { "separator": true },
      { "id": "quit", "label": "{{ .settings.strings.menu_quit // \"Quit {app}\" }}", "do": "app.quit" }
    ],
    "app": [], "menus": []
  },

  "sidebar": {
    // Which status a worktree shows when several apply (idle when none).
    "status_order": ["working", "waiting", "merged", "failing", "pending", "dirty", "behind"],
    // A section's orchestrator first, its workers after.
    "orchestrators_first": true,
    // Whose worktrees come first in a project shared by both machines.
    "host_order": ["mac", "box"],
    // The sidebar's order for select {offset} and picking a worktree (jq giving paths).
    "select_order": "[.projects[].items[].path] + [.sections[] | select(.collapsed | not) | .items[].path]"
  },

  // Back and forward: how many visits to remember.
  "nav": { "max": 200 },

  // The History list: how many past chats to fetch from each machine.
  "history": { "limit": 300 },

  // The mouse's extra buttons: an action each (back and forward default to nav.back / nav.forward).
  "mouse": { "back": "nav.back", "forward": "nav.forward", "middle": null },

  // Dragging: where a row's before/after split is, and how much of it means "inside".
  "drag": { "edge": 0.5, "inside_band": 0.25 },

  // inspect.json, activity.log and perf, for agents.
  "inspect": {
    "interval_ms": 500, "activity_lines": 400, "activity_chars": 600, "perf_window_secs": 2,
    "hook_events": 50, "transcript_items": 20, "transcript_chars": 2000, "terminal_lines": 40,
    // Presses go in activity.log too ({"input": ..., "node": id, "count": n}), to see where clicks land.
    "log_input": true,
    // inspect.json, activity.log, problems.txt and snapshot.png also go to the other machines' settings
    // folders (at most this often), so agents there see the app; their `abx do` reaches the app too.
    "mirror_ms": 1500,
    // Which of those relayed actions run: "all", "none", or a list of action names.
    "remote_actions": "all"
  },

  // keep_data: what scripts publish (.data) survives a script reload.
  // Scripts (Rust, compiled to WebAssembly; see SETTINGS.md, Scripts): one run is stopped after time_limit_ms;
  // dependencies are crates every script may use ({"regex": "1"}); build_dir holds builds (null: ~/.agent-box/script-build).
  "scripts_options": { "context_cache_ms": 250, "min_timer_ms": 16, "keep_data": true, "time_limit_ms": 1000, "dependencies": {}, "build_dir": null },
  "settings_options": { "reload_debounce_ms": 80 },

  // Each machine's daemon and scripts (sent to it on connect and when settings change; kept in
  // ~/.agent-box/config.json there for bin/chat and sync-worker).
  "daemon": {
    "tool_text_max": 20000,              // cut tool output at this many characters (0: never)
    "tool_text_cut_note": "\n… (cut here; the full output is in the transcript file)",
    "drop_tool_images": true,            // drop image bytes from tool results
    "drop_tool_use_result": true,        // drop the toolUseResult copy from entries
    "events_poll_ms": 250, "events_batch": 500,
    "model_poll_ms": 2000, "model_debounce_ms": 250,
    "transcripts_poll_ms": 300,
    "warm_index_chats": 60,              // newest chats line-indexed at startup
    "transcript_page": 600, "history_limit": 200,
    "send_paste_wait_ms": 150, "send_enter_tries": 4, "send_enter_wait_ms": 350,
    "prompt_char": "❯",                  // Claude's input prompt ("" skips Enter retries); other agents set theirs in `agents`
    "escape_marks_idle": true,           // stop (Esc) marks the chat idle
    "connect_tries": 50, "connect_wait_ms": 200,
    "git_ttl_secs": 90, "git_at_once": 2, "mr_ttl_secs": 90,
    "hook_states": {},                   // {hook event: state, or null to ignore}, over the built-in map
    "waiting_notification_types": ["permission_prompt", "elicitation_dialog"],
    "idle_notification_prefix": "Claude is waiting for your input",
    "waiting_pattern": "(?i)Enter to select|Esc to cancel|Do you want to proceed|❯ 1\\. Yes",
    "waiting_pane_lines": 25,
    // A working chat's status line in its pane (groups verb and rest; agents may set their own):
    // rest splits on status_separator into a time, a token count and notes, less parts matching status_drop.
    "status_pattern": "^\\s*[^\\w\\s]\\s+(?P<verb>\\w[^…]*?)…\\s*\\((?P<rest>[^)]*)\\)\\s*$",
    "status_separator": " · ", "status_drop": "(?i)esc to interrupt",
    "suggestion_prompt": "❯\u00a0", "suggestion_rule": "──", "suggestion_placeholder_prefix": "Try \"",
    "diff_max_bytes": 3000000, "diff_max_untracked": 200, "diff_include_untracked": true, "diff_default_base": null,  // null: origin/HEAD, else origin/<default_base>
    // Moving a chat between the Mac and the box takes along: "section" (every worktree in its sidebar
    // section and all their chats, so a section lives in one place), "worktree" (its worktree's chats)
    // or "chat" (just it). A section move rebuilds the section on the other machine and removes it here
    // unless move_keep_section; it also copies move_sync_paths (the factory skills' ledgers, newer files
    // winning, paths rewritten for the other machine), as does moving an orchestrator: a chat whose kind is
    // in move_note_kinds or whose name or folder matches move_note_match. Moved orchestrators then get
    // move_note ({from}, {to}, {section}, {paths}).
    "move_together": "section", "move_keep_section": false,
    // The worktrees a move leaves on the machine it left: "keep" (listed under their project), "hide"
    // (from the sidebar; the project menu shows them again), "remove" (the folder goes and wt frees its
    // slot; the branch keeps its commits) or "delete" (also its bazel cache and local branch).
    "move_leftovers": "hide",
    "move_sync_paths": ["~/.local/state/redo/", "~/.factory/", "~/.config/redo/"],
    "move_note_kinds": ["orchestrator"], "move_note_match": "(?i)ship.feature|orchestrat",
    "move_note": "a.box moved this chat from the {from} to the {to}, with its section {section}. Worktree paths changed: {paths}. Your ledger files were copied over and point at the new paths. Pick up where you left off, and re-arm any loop or wakeup you had scheduled.",
    "terminal_mouse": false,             // tmux mouse mode on terminal shells (wheel scrolls tmux history)
    "terminal_history_limit": null,
    "chat_tmux_cols": 220, "chat_tmux_rows": 60, "rc_url_wait_secs": 45, "chat_send_pause_secs": 0.5, "supervise_secs": 30,
    "sync_transcript_max_mb": 95, "sync_bundle_warn_mb": 50, "sync_lock_wait_secs": 600,
    // How long scripts keep one ssh connection per machine open for the next call (0: a new one each
    // time; through Coder each takes seconds). An app not heard from in config_source_days stops counting
    // toward this machine's merged options (several apps can configure one daemon).
    "ssh_mux_secs": 120, "config_source_days": 30,
    // A chat whose name nobody chose (made as default_chat_name, or brought from super.engineering) takes its
    // agent's own title (agents.AGENT.title) as the agent updates it; renaming it yourself stops that.
    // Orchestrators keep theirs (auto_title_keep: these kinds, or a name or folder matching).
    "auto_title": true, "default_chat_name": "New chat",
    "auto_title_keep": { "kinds": ["orchestrator"], "match": "(?i)ship.feature|orchestrat" },
    // The agent a new chat runs when chat.new names none.
    "default_agent": "claude",
    // A new Codex chat's session id: bin/chat watches for its rollout this long after launch or a send.
    "session_wait_secs": 180, "session_poll_secs": 1,
    "codex_state_tail_kb": 512,          // how much of a rollout's end is read for its newest turn event
    // Machines (bin/abxcfg.py resolves these for the daemon and every script). A host is AGENT_BOX_HOST, else
    // ~/.agent-box/host, else the first entry whose `detect` matches ({env: VAR}, {os: darwin|linux},
    // {hostname: regex}). Per host: label, ssh (how the others reach it; null: they can't), home, agent_box_dir,
    // sc_store (its sidebar file), sessions_branch (default from `sessions_branch`), supervise (keep its chats
    // running), relay_app_actions, sync_transcripts ("all" | "registry": only its registry chats), stacks
    // (stack-start allowed), foreign_sessions (report super.engineering's running sessions), build_unwatched,
    // env, agent_env, claude_settings (merged into ~/.claude/settings.json), agent_bin_dirs, boot ({kill_patterns,
    // packages, install, claude_onboarding, git_insteadof, bashrc_hook, tmux_status_off, services: [{name, cmd,
    // build}]}). Entries merge over the built-in box and mac; null removes one.
    "hosts": {
      "box": { "label": "box", "detect": { "env": "CODER_AGENT_URL" }, "agent_box_dir": "~/agent-box", "sc_store": "sc.json",
               "supervise": true, "relay_app_actions": true, "sync_transcripts": "all", "stacks": false },
      "mac": { "label": "Mac", "detect": { "os": "darwin" }, "ssh": null, "agent_box_dir": "~/dev/agent-box", "sc_store": "sc-mac.json",
               "supervise": false, "relay_app_actions": false, "sync_transcripts": "registry", "stacks": true, "foreign_sessions": true }
    },
    // The box's ssh name for the daemon and scripts (null: the app's connection.ssh_host, else $AGENT_BOX_SSH);
    // `remote_host` is the host id it names.
    "ssh_host": null, "remote_host": "box",
    "registry_default_host": "box",       // the host of a registry chat that names none
    // Repos: primary checkout, worktrees (a path template: {branch_slug} {branch} {name} {repo}), names (other
    // folder names for it), hue, forge ("gitlab" | "github" | "command" with forge_cmd | "none"; default from the
    // origin's host), forge_project (default: origin's path), worktree_tool ({bin, bin_paths, create, remove,
    // delete, list, start: argv templates with {bin} {branch} {path} {name} {primary} {worktrees_base} {force};
    // env}; none: git worktree). A repo not listed is keyed by its folder name with a hue from it.
    "repos": {
      "redo": { "primary": "~/dev/redo", "worktrees": "~/dev/redo-worktrees/{branch_slug}", "hue": 210, "forge_project": "redo/redoapp/product/redo",
                "worktree_tool": { "bin": "wt", "bin_paths": ["~/redo-monorepo-worktrees/bin/wt", "~/dev/redo-monorepo-worktrees/bin/wt"],
                                   "create": ["{bin}", "{branch}", "--no-start"], "adopt": ["{bin}", "adopt", "{path}", "--no-start"],
                                   "remove": ["{bin}", "remove", "{path}", ["{force}"]],
                                   "delete": ["{bin}", "remove", "{path}", "--force", "--purge-cache"], "list": ["{bin}", "list"],
                                   "start": ["{bin}", "start", "{branch}", "-d"], "partial_note": "run `wt adopt {path}` before starting its stack",
                                   "env": { "WT_PRIMARY": "{primary}", "WT_BASE": "{worktrees_base}" } } },
      "internal-tools": { "primary": "~/dev/redotech-internal-tools", "worktrees": "~/dev/redotech-internal-tools-worktrees/{name}", "hue": 120,
                          "forge_project": "redo/redoapp/internal/redotech-internal-tools", "names": ["redotech-internal-tools", "internal-tools"] },
      "redo-data": { "primary": "~/dev/redo-data", "worktrees": "~/dev/redo-data-worktrees/{name}", "hue": 30, "forge_project": "redo/redoapp/product/redo-data" }
    },
    "default_repo": "redo", "default_base": "main", "forge": null, "forge_cmd": null,
    // Folders that are the same checkout on each host ({host: path}, or [mac path, box path]).
    "path_aliases": [{ "mac": "~/dev/redo", "box": "~/project" }],
    // Where the state and sessions branches live: a private git repo, since they hold every transcript and
    // uncommitted work (null: no backup; chats stay on their machine and can't move). Who commits to them
    // (email null: git's user.email).
    "state_repo_url": null, "state_branch": "state", "sessions_branch": "sessions/{host}",
    "git_author": { "name": "agent-box ({host})", "email": null },
    // New chats: kinds, the kinds that get a worktree of their own (orchestrator_branch: {slug} {id4}), what a
    // fork of each kind becomes; sc worktree create's default folder name ({hex6}).
    "chat_kinds": ["orchestrator", "feature", "primary"], "branch_kinds": ["orchestrator"], "fork_kinds": { "orchestrator": "feature" },
    "orchestrator_branch": "sc-{slug}-{id4}", "worktree_name": "sc-{hex6}",
    "tmux_prefix": "chat-", "tmux_id_chars": 8, "supervise_session": "agent-box",
    // super.engineering, sharing this machine's sessions and worktrees (null: no such tool).
    "foreign_tools": { "sc_bin": "~/.super.engineering/bin/sc", "managed_bases": ["~/.superconductor/worktrees"],
                       "env_prefixes": ["SUPER_ENGINEERING_", "SUPERCONDUCTOR_"], "path_drop": ["~/.super.engineering/bin"] },
    // What bin/agent-env gives every agent (hosts.HOST.agent_env adds to it).
    "agent_env": { "secrets_file": "~/.config/agent-box/secrets.env", "path_prepend": [], "set": {}, "unset_prefixes": [] },
    // bin/env-push (from the Mac): paths [{path, two_way, replace, exclude, deletes (a two-way folder's deletes
    // carry over)}], memory (memory_deletes: theirs carry over too), max_deletes (more in one run are skipped,
    // with a line in agent-box.log), skills_link, hooks_match {matcher (exact), command (regex)}, hosts (null:
    // every other host with ssh).
    "env_push": {
      "hosts": null,
      "paths": [
        { "path": "~/.agents/skills/", "two_way": true, "deletes": true, "exclude": [".git", "__pycache__"] },
        { "path": "~/.claude/CLAUDE.md", "two_way": true },
        { "path": "~/.agent-box/uploads/" },
        { "path": "~/.config/redo/cursor-environments.json" },
        { "path": "~/.config/redo/cursor-typecheck-agents.json" },
        { "path": "~/.claude/hooks/block-squash.py", "replace": true }
      ],
      "memory": true, "memory_deletes": true, "max_deletes": 25, "skills_link": true,
      "hooks_match": { "matcher": "mcp__.+__save_issue", "command": "block-squash" }
    },
    // Logs log_tail may read.
    "logs": { "boxd": "~/.agent-box/boxd.log", "agent-box": "~/.agent-box/log/agent-box.log", "supervisor": "~/.agent-box/log/supervisor.log",
              "boxd-build": "~/.agent-box/log/boxd-build.log", "dashboard": "~/.agent-box/log/dashboard.log", "ttyd": "~/.agent-box/log/ttyd.log" },
    "log_tail_lines": 200, "hook_events_limit": 1000, "subscribe_replay_max": 1000,
    "app_files": ["inspect.json", "activity.log", "problems.txt", "snapshot.png"],
    "exec_allowed": true,                // the exec call (any shell command on this host)
    "usage_size_bounds": [100000, 128000, 200000, 272000, 400000, 1000000],
    // Timeouts (seconds) and polls.
    "exec_timeout_secs": 120, "sc_timeout_secs": 600, "sc_list_timeout_secs": 60, "chat_new_timeout_secs": 900,
    "chat_start_timeout_secs": 300, "chat_timeout_secs": 120, "chat_send_timeout_secs": 60, "chat_session_timeout_secs": 10,
    "chat_move_timeout_secs": 1800, "wip_timeout_secs": 120, "hooks_timeout_secs": 60, "env_push_timeout_secs": 300,
    "git_timeout_secs": 30, "forge_timeout_secs": 30, "tmux_timeout_secs": 5, "db_busy_ms": 3000, "app_action_poll_ms": 300,
    // Script retries and waits.
    "state_push_tries": 3, "state_push_wait_secs": 2, "stop_elsewhere_wait_secs": 5, "stop_elsewhere_kill_secs": 15,
    "fork_chain_max": 50, "rc_scan_lines": 200, "wip_fetch_tries": 3, "abx_call_secs": 15,
    // The agent CLIs a chat can run (bin/chat launches them; the app shows name, icon, color; tab_icon puts
    // the icon on its tabs). Templates are argv: {bin} {id} (chat) {session} (the agent's) {from} (a fork's
    // source session) {name} {model} {prompt} {dir} {realdir}; a nested list drops when one of its values is
    // empty. session: "assigned" (the chat id) or "discovered" (found under sessions_dir after launch).
    // transcripts: "claude" | "codex" | "jsonl" (jsonl_fields {type, role, text, timestamp: JSON pointers}, roles,
    // transcript_path {id} {session} {dir} {dir_slug}). turn_events: rollout events that set working/idle. trust:
    // "claude" or {file, path, value}. rc_url_pattern, process_names + process_session_pattern (group 1: the
    // session), transcripts_root + backup_dir (backed up by sync-worker; backup: false skips), hooks_file +
    // hook_events (bin/agent-hooks), provider, limits_field. Claude's prompt_char and waiting_pattern are the
    // top-level keys above. The app presses interrupt_keys to stop a turn and cancel_keys to cancel a question
    // (default ["Escape"]), and answer_key ("{n}") to pick option n.
    "agents": {
      "claude": {
        // --settings showThinkingSummaries: without it Claude Code logs thinking as empty blocks.
        "name": "Claude", "icon": "asterisk", "color": "@claude", "tab_icon": false,
        "bin": "claude", "session": "assigned", "transcripts": "claude", "trust": "claude", "remote_control": true, "stop_elsewhere": true,
        "new": ["{bin}", "--session-id", "{id}", "--remote-control", "{name}", "--settings", "{\"showThinkingSummaries\":true}", ["--model", "{model}"], ["{prompt}"]],
        "resume": ["{bin}", "--resume", "{session}", "--remote-control", "{name}", "--settings", "{\"showThinkingSummaries\":true}", ["--model", "{model}"]],
        "fork": ["{bin}", "--resume", "{from}", "--fork-session", "--session-id", "{id}", "--remote-control", "{name}", "--settings", "{\"showThinkingSummaries\":true}", ["--model", "{model}"]],
        "rc_url_pattern": "https://claude\\.ai/code/session_[A-Za-z0-9]+", "provider": "anthropic",
        "transcripts_root": "~/.claude/projects", "backup_dir": "projects", "hooks_file": "~/.claude/settings.json",
        "process_names": ["claude"], "process_session_pattern": "--(?:resume|session-id)[ =]([0-9a-f]{8}-[0-9a-f-]{27})",
        // Its own name for the chat (auto_title): the latest of the first record kind the transcript has.
        "title": { "records": [{ "type": "custom-title", "field": "customTitle" }, { "type": "ai-title", "field": "aiTitle" }] }
      },
      "codex": {
        "name": "Codex", "icon": "aperture", "color": "@text", "tab_icon": true,
        "bin": "codex", "session": "discovered", "sessions_dir": "~/.codex/sessions", "transcripts": "codex",
        "new": ["{bin}", "-c", "check_for_update_on_startup=false", "-c", "projects={\"{realdir}\"={trust_level=\"trusted\"}}", ["--model", "{model}"], ["{prompt}"]],
        "resume": ["{bin}", "resume", "{session}", "-c", "check_for_update_on_startup=false", "-c", "projects={\"{realdir}\"={trust_level=\"trusted\"}}", ["--model", "{model}"]],
        "fork": ["{bin}", "fork", "{from}", "-c", "check_for_update_on_startup=false", "-c", "projects={\"{realdir}\"={trust_level=\"trusted\"}}", ["--model", "{model}"]],
        "prompt_char": "›",
        "waiting_pattern": "(?i)Would you like to|Trust this folder|Hooks need review|enter to (confirm|continue|select)|esc to (cancel|skip|quit)|Allow .* to run",
        "turn_events": { "task_started": "working", "task_complete": "idle", "turn_aborted": "idle" },
        "provider": "openai", "transcripts_root": "~/.codex/sessions", "backup_dir": "codex-sessions",
        // Codex names threads in its session index.
        "title": { "index": "~/.codex/session_index.jsonl", "id": "id", "field": "thread_name" },
        "hooks_file": "~/.codex/hooks.json", "hooks_home_env": "CODEX_HOME"
      }
    }
  }
}
